petiole main

import "bufio"
import "race-to-the-crystal/game" as gamepkg
import "stdlib/cast"
import "stdlib/fetch"
import "stdlib/json" as jsonpkg
import "stdlib/log"
import "strings"

type Payload = map of string to any

type Session
    baseUrl: string
    playerId: string
    playerName: string
    token: string
    gameId: string
    sseUrl: string
    active: bool

func NewSession(baseUrl: string) Session
    return Session{baseUrl: strings.TrimRight(baseUrl, "/"), active: true}

type createRequest
    gameName: string
    playerName: string

type joinRequest
    playerName: string

type playerSessionData
    playerId: string
    playerName: string
    token: string
    gameId: string
    sseUrl: string

type createJoinAPIResponse
    success: bool
    message: string
    data: playerSessionData

func fillSessionFromData on s: reference Session(d: playerSessionData)
    if d.playerId isnt ""
        s.playerId = d.playerId
    if d.playerName isnt ""
        s.playerName = d.playerName
    if d.token isnt ""
        s.token = d.token
    if d.gameId isnt ""
        s.gameId = d.gameId
    if d.sseUrl isnt ""
        s.sseUrl = d.sseUrl

    log.Info("Authenticated as {s.playerName} (player_id={s.playerId}, game_id={s.gameId})")
    if s.sseUrl isnt ""
        log.Info("SSE URL: {s.sseUrl}")

func CreateGame on s: reference Session(gameName: string, playerName: string) bool
    url := "{s.baseUrl}/api/game/create"
    body := createRequest{
        gameName: gameName,
        playerName: playerName,
    }
    resp := fetch.New(url)
        |> fetch.Method("POST")
        |> fetch.Header("Content-Type", "application/json")
        |> fetch.Body(body)
        |> fetch.Retry(3, 500)
        |> fetch.Do() onerr
            log.Error("CreateGame: {error}")
            return false

    defer resp.Close()

    status := resp.StatusCode
    if status isnt 200
        log.Error("CreateGame: status {resp.StatusCode}")
        return false

    data := createJoinAPIResponse{}
    fetch.Decode(resp, reference of data) onerr
        log.Error("CreateGame: decode failed: {error}")
        return false

    if not data.success
        log.Error("CreateGame failed: {data.message}")
        return false

    s.fillSessionFromData(data.data)
    return true

func JoinGame on s: reference Session(gameId: string, playerName: string) bool
    url := "{s.baseUrl}/api/game/{gameId}/join"
    body := joinRequest{playerName: playerName}

    resp := fetch.New(url)
        |> fetch.Method("POST")
        |> fetch.Header("Content-Type", "application/json")
        |> fetch.Body(body)
        |> fetch.Retry(3, 500)
        |> fetch.Do() onerr
            log.Error("JoinGame: {error}")
            return false

    defer resp.Close()

    status := resp.StatusCode
    if status isnt 200
        log.Error("JoinGame: status {resp.StatusCode}")
        return false

    data := createJoinAPIResponse{}
    fetch.Decode(resp, reference of data) onerr
        log.Error("JoinGame: decode failed: {error}")
        return false

    if not data.success
        log.Error("JoinGame failed: {data.message}")
        return false

    s.fillSessionFromData(data.data)
    return true

func FetchState on s: reference Session Payload
    url := "{s.baseUrl}/api/game/{s.gameId}/state"
    resp := fetch.New(url)
        |> fetch.Method("GET")
        |> fetch.Header("Authorization", "Bearer {s.token}")
        |> fetch.Retry(3, 500)
        |> fetch.Do() onerr
            log.Error("FetchState: {error}")
            return empty Payload

    defer resp.Close()

    status := resp.StatusCode
    if status equals 400 or status equals 404
        return empty Payload
    if status isnt 200
        log.Error("FetchState: status {resp.StatusCode}")
        return empty Payload

    wrapper := mapResponse{}
    fetch.Decode(resp, reference of wrapper) onerr
        log.Error("FetchState: decode failed: {error}")
        return empty Payload

    if wrapper.data is Payload as state
        return state
    return empty Payload

type mapResponse
    success: bool
    message: string
    data: any

type actionsData
    phase: string
    actions: list of any

type actionsAPIResponse
    success: bool
    message: string
    data: actionsData

func FetchActions on s: reference Session Payload
    url := "{s.baseUrl}/api/game/{s.gameId}/actions"
    resp := fetch.New(url)
        |> fetch.Method("GET")
        |> fetch.Header("Authorization", "Bearer {s.token}")
        |> fetch.Retry(3, 500)
        |> fetch.Do() onerr
            log.Error("FetchActions: {error}")
            return empty Payload

    defer resp.Close()

    status := resp.StatusCode
    if status equals 400 or status equals 404
        return empty Payload
    if status isnt 200
        log.Error("FetchActions: status {resp.StatusCode}")
        return empty Payload

    wrapper := actionsAPIResponse{}
    fetch.Decode(resp, reference of wrapper) onerr
        log.Error("FetchActions: decode failed: {error}")
        return empty Payload

    result := make(Payload)
    result["phase"] = wrapper.data.phase
    result["actions"] = wrapper.data.actions
    return result

func SendAction on s: reference Session(action: gamepkg.ChosenAction) Payload
    url := "{s.baseUrl}/api/game/{s.gameId}/action"
    body := gamepkg.ChosenToActionMap(action)

    resp := fetch.New(url)
        |> fetch.Method("POST")
        |> fetch.Header("Content-Type", "application/json")
        |> fetch.Header("Authorization", "Bearer {s.token}")
        |> fetch.Body(body)
        |> fetch.Retry(3, 500)
        |> fetch.Do() onerr
            log.Error("SendAction: {error}")
            return empty Payload

    defer resp.Close()

    wrapper := make(Payload)
    fetch.Decode(resp, reference of wrapper) onerr
        log.Error("SendAction: decode failed: {error}")
        return empty Payload

    return wrapper

func TryAutoStart on s: reference Session bool
    lobby := s.GetLobby()
    if lobby is empty
        return false

    hostIdAny, has := lobby["host_player_id"]
    if not has
        return false
    hostId := ""
    if hostIdAny is string as hv
        hostId = hv
    if hostId isnt s.playerId
        return false

    statusAny, hasS := lobby["status"]
    if not hasS
        return false
    status := ""
    if statusAny is string as sv
        status = sv
    if status isnt "WAITING"
        return true

    curAny, hasC := lobby["current_players"]
    if not hasC
        return false
    cur := cast.ToIntOr(curAny, 0)
    minAny, hasM := lobby["min_players"]
    if not hasM
        return false
    minP := cast.ToIntOr(minAny, 0)
    if cur < minP
        return false

    playersAny, hasP := lobby["players"]
    if not hasP
        return false
    if playersAny is list of any as players
        for p in players
            if p is Payload as pMap
                readyAny, hasR := pMap["is_ready"]
                if not hasR
                    return false
                ready := false
                if readyAny is bool as bv
                    ready = bv
                if not ready
                    return false
            else
                return false
    else
        return false

    log.Info("Auto-starting game as host")
    return s.StartGame()

type readyRequest
    ready: bool

func SetReady on s: reference Session(ready: bool) bool
    url := "{s.baseUrl}/api/game/{s.gameId}/ready"
    body := readyRequest{ready: ready}

    resp := fetch.New(url)
        |> fetch.Method("POST")
        |> fetch.Header("Content-Type", "application/json")
        |> fetch.Header("Authorization", "Bearer {s.token}")
        |> fetch.Body(body)
        |> fetch.Retry(3, 500)
        |> fetch.Do() onerr
            log.Error("SetReady: {error}")
            return false

    defer resp.Close()

    status := resp.StatusCode
    if status isnt 200
        log.Error("SetReady: status {resp.StatusCode}")
        return false
    return true

func StartGame on s: reference Session bool
    url := "{s.baseUrl}/api/game/{s.gameId}/start"

    resp := fetch.New(url)
        |> fetch.Method("POST")
        |> fetch.Header("Authorization", "Bearer {s.token}")
        |> fetch.Retry(3, 500)
        |> fetch.Do() onerr
            log.Error("StartGame: {error}")
            return false

    defer resp.Close()

    status := resp.StatusCode
    if status isnt 200
        log.Error("StartGame: status {resp.StatusCode}")
        return false
    return true

type lobbiesData
    games: list of any

type lobbiesAPIResponse
    success: bool
    message: string
    data: lobbiesData

func ListLobbies on s: reference Session list of Payload
    url := "{s.baseUrl}/api/games"
    resp := fetch.New(url)
        |> fetch.Method("GET")
        |> fetch.Retry(3, 500)
        |> fetch.Do() onerr
            log.Error("ListLobbies: {error}")
            return empty list of Payload

    defer resp.Close()

    status := resp.StatusCode
    if status isnt 200
        return empty list of Payload

    wrapper := lobbiesAPIResponse{}
    fetch.Decode(resp, reference of wrapper) onerr
        return empty list of Payload

    result := empty list of Payload
    for item in wrapper.data.games
        if item is Payload as m
            result = append(result, m)
    return result

func GetLobby on s: reference Session Payload
    lobbies := s.ListLobbies()
    for lobby in lobbies
        gidAny, has := lobby["game_id"]
        if not has
            continue
        gid := ""
        if gidAny is string as gv
            gid = gv
        if gid equals s.gameId
            return lobby
    return empty Payload

func IsMyTurn(state: Payload, playerId: string) bool
    if state is empty
        return false
    cur, has := state["current_turn_player_id"]
    if not has
        return false
    curStr := ""
    if cur is string as cv
        curStr = cv
    return curStr equals playerId

func IsGameOver(state: Payload) bool
    if state is empty
        return false
    phase, has := state["phase"]
    if not has
        return false
    phaseStr := ""
    if phase is string as pv
        phaseStr = pv
    return phaseStr equals "ENDED"

func IsGameActive(state: Payload) bool
    if state is empty
        return false
    phase, has := state["phase"]
    if not has
        return false
    phaseStr := ""
    if phase is string as pv
        phaseStr = pv
    return phaseStr equals "PLAYING"

func PickAction(actions: list of Payload, strategy: gamepkg.AIStrategyName) gamepkg.ChosenAction
    actionsTyped := gamepkg.ActionsFromDicts(actions)
    if actionsTyped is empty
        return gamepkg.ChosenEndTurn
    chosenRef := gamepkg.ChooseAction(strategy, actionsTyped, empty, "")
    if chosenRef is empty
        return gamepkg.ChosenEndTurn
    return dereference chosenRef

type SSEEvent
    eventType: string
    data: string

func ConnectSSE on s: reference Session(handler: func(SSEEvent) bool)
    if s.sseUrl equals ""
        log.Warn("ConnectSSE: no SSE URL configured")
        return

    resp := fetch.New(s.sseUrl)
        |> fetch.Method("GET")
        |> fetch.Header("Authorization", "Bearer {s.token}")
        |> fetch.Header("Accept", "text/event-stream")
        |> fetch.Retry(3, 500)
        |> fetch.Do() onerr
            log.Error("SSE connect failed: {error}")
            return

    raw := resp.Raw()
    if raw is empty
        log.Error("SSE raw empty")
        return
    defer raw.Body.Close()
    body := raw.Body
    scanner := bufio.NewScanner(body)
    scanner.Buffer(make(list of byte, 0, 64 * 1024), 1024 * 1024)

    currentEvent := "message"
    dataBuf := strings.Builder{}

    for scanner.Scan()
        line := scanner.Text()

        if line equals ""
            if dataBuf.Len() > 0
                ev := SSEEvent{eventType: currentEvent, data: dataBuf.String()}
                keepGoing := handler(ev)
                dataBuf.Reset()
                currentEvent = "message"
                if not keepGoing
                    return
        else if strings.HasPrefix(line, "event:")
            currentEvent = strings.TrimSpace(strings.TrimPrefix(line, "event:"))
        else if strings.HasPrefix(line, "data:")
            chunk := strings.TrimPrefix(line, "data:")
            if dataBuf.Len() > 0
                dataBuf.WriteString("\n") onerr discard
            dataBuf.WriteString(strings.TrimLeft(chunk, " ")) onerr discard

    err := scanner.Err()
    if err isnt empty
        log.Error("SSE scan error: {err}")

func ExtractStateFromSSE(ev: SSEEvent) Payload
    parsed := make(Payload)
    jsonpkg.ParseInto(ev.data, reference of parsed) onerr return empty Payload

    stateAny, hasState := parsed["state"]
    if hasState
        if stateAny is Payload as state
            return state

    gsAny, hasGs := parsed["game_state"]
    if hasGs
        if gsAny is Payload as gs
            return gs

    return parsed
