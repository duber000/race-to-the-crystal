petiole main

import "bufio"
import "race-to-the-crystal/game" as gamepkg
import "stdlib/fetch"
import "stdlib/json" as jsonpkg
import "stdlib/log"
import "strings"

type Session
    base_url: string
    player_id: string
    player_name: string
    token: string
    game_id: string
    sse_url: string
    active: bool

func NewSession(base_url: string) Session
    return Session{base_url: strings.TrimRight(base_url, "/"), active: true}

type createRequest
    game_name: string
    player_name: string

type joinRequest
    player_name: string

type playerSessionData
    player_id: string
    player_name: string
    token: string
    game_id: string
    sse_url: string

type createJoinAPIResponse
    success: bool
    message: string
    data: playerSessionData

func fillSessionFromData on s: reference Session(d: playerSessionData)
    if d.player_id isnt ""
        s.player_id = d.player_id
    if d.player_name isnt ""
        s.player_name = d.player_name
    if d.token isnt ""
        s.token = d.token
    if d.game_id isnt ""
        s.game_id = d.game_id
    if d.sse_url isnt ""
        s.sse_url = d.sse_url

    log.Info("Authenticated as {s.player_name} (player_id={s.player_id}, game_id={s.game_id})")
    if s.sse_url isnt ""
        log.Info("SSE URL: {s.sse_url}")

func CreateGame on s: reference Session(game_name: string, player_name: string) bool
    url := "{s.base_url}/api/game/create"
    body := createRequest{
        game_name: game_name,
        player_name: player_name,
    }
    resp := fetch.New(url)
        |> fetch.Method("POST")
        |> fetch.Header("Content-Type", "application/json")
        |> fetch.Body(body)
        |> fetch.Do() onerr
            log.Error("CreateGame: {error}")
            return false

    defer
        if resp isnt empty
            dereference resp.Body.Close()

    status := resp.StatusCode
    if status isnt 200
        log.Error("CreateGame: status {resp.StatusCode}")
        return false

    data := createJoinAPIResponse{}
    fetch.Decode(resp, reference of data) onerr
        log.Error("CreateGame: decode failed: {error}")
        return false

    if not data.success
        log.Error("CreateGame failed: {data.message}")
        return false

    s.fillSessionFromData(data.data)
    return true

func JoinGame on s: reference Session(game_id: string, player_name: string) bool
    url := "{s.base_url}/api/game/{game_id}/join"
    body := joinRequest{player_name: player_name}

    resp := fetch.New(url)
        |> fetch.Method("POST")
        |> fetch.Header("Content-Type", "application/json")
        |> fetch.Body(body)
        |> fetch.Do() onerr
            log.Error("JoinGame: {error}")
            return false

    defer
        if resp isnt empty
            dereference resp.Body.Close()

    status := resp.StatusCode
    if status isnt 200
        log.Error("JoinGame: status {resp.StatusCode}")
        return false

    data := createJoinAPIResponse{}
    fetch.Decode(resp, reference of data) onerr
        log.Error("JoinGame: decode failed: {error}")
        return false

    if not data.success
        log.Error("JoinGame failed: {data.message}")
        return false

    s.fillSessionFromData(data.data)
    return true

func FetchState on s: reference Session map of string to any
    url := "{s.base_url}/api/game/{s.game_id}/state"
    resp := fetch.New(url)
        |> fetch.Method("GET")
        |> fetch.Header("Authorization", "Bearer {s.token}")
        |> fetch.Do() onerr
            log.Error("FetchState: {error}")
            return empty map of string to any

    defer
        if resp isnt empty
            dereference resp.Body.Close()

    status := resp.StatusCode
    if status equals 400 or status equals 404
        return empty map of string to any
    if status isnt 200
        log.Error("FetchState: status {resp.StatusCode}")
        return empty map of string to any

    wrapper := mapResponse{}
    fetch.Decode(resp, reference of wrapper) onerr
        log.Error("FetchState: decode failed: {error}")
        return empty map of string to any

    state, ok := wrapper.data.(map of string to any)
    if not ok
        return empty map of string to any
    return state

type mapResponse
    success: bool
    message: string
    data: any

type actionsData
    phase: string
    actions: list of any

type actionsAPIResponse
    success: bool
    message: string
    data: actionsData

func FetchActions on s: reference Session map of string to any
    url := "{s.base_url}/api/game/{s.game_id}/actions"
    resp := fetch.New(url)
        |> fetch.Method("GET")
        |> fetch.Header("Authorization", "Bearer {s.token}")
        |> fetch.Do() onerr
            log.Error("FetchActions: {error}")
            return empty map of string to any

    defer
        if resp isnt empty
            dereference resp.Body.Close()

    status := resp.StatusCode
    if status equals 400 or status equals 404
        return empty map of string to any
    if status isnt 200
        log.Error("FetchActions: status {resp.StatusCode}")
        return empty map of string to any

    wrapper := actionsAPIResponse{}
    fetch.Decode(resp, reference of wrapper) onerr
        log.Error("FetchActions: decode failed: {error}")
        return empty map of string to any

    result := make(map of string to any)
    result["phase"] = wrapper.data.phase
    result["actions"] = wrapper.data.actions
    return result

func SendAction on s: reference Session(action: gamepkg.ChosenAction) map of string to any
    url := "{s.base_url}/api/game/{s.game_id}/action"
    body := gamepkg.ChosenToActionMap(action)

    resp := fetch.New(url)
        |> fetch.Method("POST")
        |> fetch.Header("Content-Type", "application/json")
        |> fetch.Header("Authorization", "Bearer {s.token}")
        |> fetch.Body(body)
        |> fetch.Do() onerr
            log.Error("SendAction: {error}")
            return empty map of string to any

    defer
        if resp isnt empty
            dereference resp.Body.Close()

    wrapper := make(map of string to any)
    fetch.Decode(resp, reference of wrapper) onerr
        log.Error("SendAction: decode failed: {error}")
        return empty map of string to any

    return wrapper

func TryAutoStart on s: reference Session bool
    lobby := s.GetLobby()
    if lobby equals empty
        return false

    host_id_any, has := lobby["host_player_id"]
    if not has
        return false
    host_id := host_id_any.(string) onerr ""
    if host_id isnt s.player_id
        return false

    status_any, has_s := lobby["status"]
    if not has_s
        return false
    status := status_any.(string) onerr ""
    if status isnt "WAITING"
        return true

    cur_any, has_c := lobby["current_players"]
    if not has_c
        return false
    cur := cur_any.(int) onerr 0
    min_any, has_m := lobby["min_players"]
    if not has_m
        return false
    min_p := min_any.(int) onerr 0
    if cur < min_p
        return false

    players_any, has_p := lobby["players"]
    if not has_p
        return false
    players, players_ok := players_any.(list of any)
    if not players_ok
        return false
    for p in players
        p_map, p_ok := p.(map of string to any)
        if not p_ok
            return false
        ready_any, has_r := p_map["is_ready"]
        if not has_r
            return false
        ready := ready_any.(bool) onerr false
        if not ready
            return false

    log.Info("Auto-starting game as host")
    return s.StartGame()

type readyRequest
    ready: bool

func SetReady on s: reference Session(ready: bool) bool
    url := "{s.base_url}/api/game/{s.game_id}/ready"
    body := readyRequest{ready: ready}

    resp := fetch.New(url)
        |> fetch.Method("POST")
        |> fetch.Header("Content-Type", "application/json")
        |> fetch.Header("Authorization", "Bearer {s.token}")
        |> fetch.Body(body)
        |> fetch.Do() onerr
            log.Error("SetReady: {error}")
            return false

    defer
        if resp isnt empty
            dereference resp.Body.Close()

    status := resp.StatusCode
    if status isnt 200
        log.Error("SetReady: status {resp.StatusCode}")
        return false
    return true

func StartGame on s: reference Session bool
    url := "{s.base_url}/api/game/{s.game_id}/start"

    resp := fetch.New(url)
        |> fetch.Method("POST")
        |> fetch.Header("Authorization", "Bearer {s.token}")
        |> fetch.Do() onerr
            log.Error("StartGame: {error}")
            return false

    defer
        if resp isnt empty
            dereference resp.Body.Close()

    status := resp.StatusCode
    if status isnt 200
        log.Error("StartGame: status {resp.StatusCode}")
        return false
    return true

type lobbiesData
    games: list of any

type lobbiesAPIResponse
    success: bool
    message: string
    data: lobbiesData

func ListLobbies on s: reference Session list of map of string to any
    url := "{s.base_url}/api/games"
    resp := fetch.New(url)
        |> fetch.Method("GET")
        |> fetch.Do() onerr
            log.Error("ListLobbies: {error}")
            return empty list of map of string to any

    defer
        if resp isnt empty
            dereference resp.Body.Close()

    status := resp.StatusCode
    if status isnt 200
        return empty list of map of string to any

    wrapper := lobbiesAPIResponse{}
    fetch.Decode(resp, reference of wrapper) onerr
        return empty list of map of string to any

    result := empty list of map of string to any
    for item in wrapper.data.games
        m, m_ok := item.(map of string to any)
        if m_ok
            result = append(result, m)
    return result

func GetLobby on s: reference Session map of string to any
    lobbies := s.ListLobbies()
    for lobby in lobbies
        gid_any, has := lobby["game_id"]
        if not has
            continue
        gid := gid_any.(string) onerr ""
        if gid equals s.game_id
            return lobby
    return empty map of string to any

func IsMyTurn(state: map of string to any, player_id: string) bool
    if state equals empty
        return false
    cur, has := state["current_turn_player_id"]
    if not has
        return false
    cur_str := cur.(string) onerr ""
    return cur_str equals player_id

func IsGameOver(state: map of string to any) bool
    if state equals empty
        return false
    phase, has := state["phase"]
    if not has
        return false
    phase_str := phase.(string) onerr ""
    return phase_str equals "ENDED"

func IsGameActive(state: map of string to any) bool
    if state equals empty
        return false
    phase, has := state["phase"]
    if not has
        return false
    phase_str := phase.(string) onerr ""
    return phase_str equals "PLAYING"

func PickAction(actions: list of map of string to any, strategy: gamepkg.AIStrategyName) gamepkg.ChosenAction
    actions_typed := gamepkg.ActionsFromDicts(actions)
    if len(actions_typed) equals 0
        return gamepkg.ChosenEndTurn
    chosen_ref := gamepkg.ChooseAction(strategy, actions_typed, empty, "")
    if chosen_ref equals empty
        return gamepkg.ChosenEndTurn
    return dereference chosen_ref

type SSEEvent
    event_type: string
    data: string

func ConnectSSE on s: reference Session(handler: func(SSEEvent) bool)
    if s.sse_url equals ""
        log.Warn("ConnectSSE: no SSE URL configured")
        return

    resp := fetch.New(s.sse_url)
        |> fetch.Method("GET")
        |> fetch.Header("Authorization", "Bearer {s.token}")
        |> fetch.Header("Accept", "text/event-stream")
        |> fetch.Do() onerr
            log.Error("SSE connect failed: {error}")
            return

    defer
        dereference resp.Body.Close()

    body := dereference resp.Body
    scanner := bufio.NewScanner(body)
    scanner.Buffer(make(list of byte, 0, 64 * 1024), 1024 * 1024)

    current_event := "message"
    data_buf := strings.Builder{}

    for scanner.Scan()
        line := scanner.Text()

        if line equals ""
            if data_buf.Len() > 0
                ev := SSEEvent{event_type: current_event, data: data_buf.String()}
                keep_going := handler(ev)
                data_buf.Reset()
                current_event = "message"
                if not keep_going
                    return
        else if strings.HasPrefix(line, "event:")
            current_event = strings.TrimSpace(strings.TrimPrefix(line, "event:"))
        else if strings.HasPrefix(line, "data:")
            chunk := strings.TrimPrefix(line, "data:")
            if data_buf.Len() > 0
                data_buf.WriteString("\n") onerr discard
            data_buf.WriteString(strings.TrimLeft(chunk, " ")) onerr discard

    err := scanner.Err()
    if err isnt empty
        log.Error("SSE scan error: {err}")

func ExtractStateFromSSE(ev: SSEEvent) map of string to any
    parsed := make(map of string to any)
    jsonpkg.ParseStringInto(ev.data, reference of parsed) onerr return empty map of string to any

    state_any, has_state := parsed["state"]
    if has_state
        state := state_any.(map of string to any)
        return state

    gs_any, has_gs := parsed["game_state"]
    if has_gs
        gs := gs_any.(map of string to any)
        return gs

    return parsed
