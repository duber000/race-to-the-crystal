petiole main

import "race-to-the-crystal/game" as gamepkg
import "stdlib/cast"
import "stdlib/cli"
import "stdlib/log"
import "stdlib/random"
import "stdlib/signal"
import "time"

const DEFAULT_BASE_URL = "http://localhost:8080"

const DEFAULT_POLL_MS = 1500

const DEFAULT_THINK_MS = 500

type Mode
    Mode: string

const POLL = "poll"

const SSE = "sse"

func parseStrategy(s: string) gamepkg.AIStrategyName
    name := gamepkg.ParseAIStrategyName(s) onerr gamepkg.AIStrategyNameRANDOM
    return name

func defaultPlayerName() string
    return "AI_{random.Int(1000, 9999)}"

func openSession(args: cli.Args) Session
    baseUrl := cli.GetStringOr(args, "server", DEFAULT_BASE_URL)
    if cli.GetBool(args, "debug")
        log.SetLevel(log.LevelDebug)

    sess := NewSession(baseUrl)
    sess.playerName = cli.GetStringOr(args, "name", defaultPlayerName())

    joinId := cli.GetStringOr(args, "join", "")
    createName := cli.GetStringOr(args, "create", "")

    if joinId isnt ""
        log.Info("Joining game {joinId} as {sess.playerName}")
        ok := sess.JoinGame(joinId, sess.playerName)
        if not ok
            log.Fatal("failed to join game {joinId}")
        log.Info("Marking as ready")
        sess.SetReady(true)
    else if createName isnt ""
        log.Info("Creating game {createName} as {sess.playerName}")
        ok := sess.CreateGame(createName, sess.playerName)
        if not ok
            log.Fatal("failed to create game {createName}")
        log.Info("Marking as ready")
        sess.SetReady(true)
    else
        log.Fatal("--join <game-id> or --create <game-name> is required")

    return sess

func takeTurn(sess: reference Session, strategy: gamepkg.AIStrategyName)
    state := sess.FetchState()
    if state is empty
        sess.TryAutoStart()
        return

    if IsGameOver(state)
        log.Info("Game ended")
        sess.active = false
        return

    perspective, hasP := state["perspective_player_id"]
    var myGameId: string
    if hasP
        if perspective is string as p
            myGameId = p

    log.Debug(
        "takeTurn: state size={len(state)}, perspective={myGameId}, my_net_id={sess.playerId}",
    )
    if myGameId equals ""
        return

    cur, has := state["current_turn_player_id"]
    if not has
        return
    var curStr: string
    if cur is string as s
        curStr = s
    log.Debug("takeTurn: current={curStr}, my={myGameId}")
    if curStr isnt myGameId
        return

    log.Info("Our turn (turn {cast.ToIntOr(state["turnNumber"], 0)})")
    time.Sleep((DEFAULT_THINK_MS * 1000000) as time.Duration)

    payload := sess.FetchActions()
    if payload is empty
        log.Warn("empty actions response")
        return

    actionsAny, hasActions := payload["actions"]
    if not hasActions
        return

    if actionsAny is list of any as actionsRaw
        actions := empty list of map of string to any
        for item in actionsRaw
            if item is map of string to any as m
                actions = append(actions, m)
        log.Info("Available actions: {len(actions)}")
        if actions isnt empty
            chosen := PickAction(actions, strategy)
            log.Info("Sending {gamepkg.ChosenActionName(chosen)}")
            result := sess.SendAction(chosen)
            if result isnt empty
                if msg, has := result["message"]; has
                    var msgStr: string
                    if msg is string as ms
                        msgStr = ms
                    log.Debug("Server: {msgStr}")
        return
    return

func runPoll(args: cli.Args)
    sess := openSession(args)
    strategy := parseStrategy(cli.GetStringOr(args, "strategy", "random"))
    pollMs := cli.GetIntOr(args, "poll-interval", DEFAULT_POLL_MS)

    log.Info("Polling every {pollMs}ms with strategy {strategy}")

    ch := make(channel of bool)
    signal.OnInterrupt(() =>
        log.Info("Shutting down")
        send true to ch
    )

    for true
        select
            when receive from ch
                return
            default
                takeTurn(reference of sess, strategy)
                if not sess.active
                    return
                time.Sleep((pollMs * 1000000) as time.Duration)

func runSSE(args: cli.Args)
    sess := openSession(args)
    strategy := parseStrategy(cli.GetStringOr(args, "strategy", "random"))

    log.Info("Subscribing to SSE stream with strategy {strategy}")

    sess.ConnectSSE((ev: SSEEvent) =>
        evtType := ev.eventType
        if evtType equals "" or evtType equals "message"
            evtType = "message"

        if evtType equals "GAME_WON" or evtType equals "GAME_OVER"
            log.Info("Game over event received")
            sess.active = false
            return false

        state := ExtractStateFromSSE(ev)
        if state is empty
            return true

        if IsGameOver(state)
            log.Info("Game over (state)")
            sess.active = false
            return false

        perspective, hasP := state["perspective_player_id"]
        var myGameId: string
        if hasP
            if perspective is string as p
                myGameId = p

        if myGameId equals ""
            return true

        cur, has := state["current_turn_player_id"]
        if not has
            return true
        var curStr: string
        if cur is string as s
            curStr = s
        if curStr isnt myGameId
            return true

        if not IsGameActive(state)
            return true

        log.Info("Our turn (turn {cast.ToIntOr(state["turnNumber"], 0)})")
        time.Sleep((DEFAULT_THINK_MS * 1000000) as time.Duration)

        payload := sess.FetchActions()
        if payload is empty
            return true

        actionsAny, hasActions := payload["actions"]
        if not hasActions
            return true

        if actionsAny is list of any as actionsRaw
            actions := empty list of map of string to any
            for item in actionsRaw
                if item is map of string to any as m
                    actions = append(actions, m)
            if actions isnt empty
                chosen := PickAction(actions, strategy)
                log.Info("Sending {gamepkg.ChosenActionName(chosen)}")
                result := sess.SendAction(chosen)
                if result isnt empty
                    if msg, has := result["message"]; has
                        var msgStr: string
                        if msg is string as s
                            msgStr = s
                        log.Debug("Server: {msgStr}")

        return true
    )

func main()
    pollCmd := cli.NewCommand(POLL, "Polling-based AI client (GET /state on timer)")
        |> .StringFlag("server", "Game server URL", DEFAULT_BASE_URL)
        |> .StringFlag("join", "Game ID to join", "")
        |> .StringFlag("create", "Game name to create", "")
        |> .StringFlag("name", "AI player name", "")
        |> .StringFlag("strategy", "AI strategy (random|aggressive|defensive)", "random")
        |> .IntFlag("poll-interval", "Poll interval in ms", DEFAULT_POLL_MS)
        |> .BoolFlag("debug", "Enable debug logging", false)
        |> .Action(runPoll)

    sseCmd := cli.NewCommand(SSE, "SSE-based AI client (subscribe to Mercure stream)")
        |> .StringFlag("server", "Game server URL", DEFAULT_BASE_URL)
        |> .StringFlag("join", "Game ID to join", "")
        |> .StringFlag("create", "Game name to create", "")
        |> .StringFlag("name", "AI player name", "")
        |> .StringFlag("strategy", "AI strategy (random|aggressive|defensive)", "random")
        |> .BoolFlag("debug", "Enable debug logging", false)
        |> .Action(runSSE)

    app := cli.New("race-ai-client")
        |> cli.Description("AI player for Race to the Crystal")
        |> cli.Version("1.0.0")
        |> cli.WithCommands(pollCmd, sseCmd)

    cli.Run(app)
