petiole main

import "race-to-the-crystal/game" as gamepkg
import "stdlib/cli"
import "stdlib/datetime"
import "stdlib/log"
import "stdlib/random"
import "stdlib/signal"

const DEFAULT_BASE_URL = "http://localhost:8080"

const DEFAULT_POLL_MS = 1500

const DEFAULT_THINK_MS = 500

type Mode
    Mode: string

const POLL = "poll"

const SSE = "sse"

func parseStrategy(s: string) gamepkg.AIStrategyName
    name := gamepkg.ParseAIStrategyName(s) onerr gamepkg.AIStrategyNameRANDOM
    return name

func defaultPlayerName() string
    return "AI_{random.Int(1000, 9999)}"

func openSession(args: cli.Args) Session
    base_url := cli.GetStringOr(args, "server", DEFAULT_BASE_URL)
    if cli.GetBool(args, "debug")
        log.SetLevel(log.LevelDebug)

    sess := NewSession(base_url)
    sess.player_name = cli.GetStringOr(args, "name", defaultPlayerName())

    join_id := cli.GetStringOr(args, "join", "")
    create_name := cli.GetStringOr(args, "create", "")

    if join_id isnt ""
        log.Info("Joining game {join_id} as {sess.player_name}")
        ok := sess.JoinGame(join_id, sess.player_name)
        if not ok
            log.Fatal("failed to join game {join_id}")
        log.Info("Marking as ready")
        sess.SetReady(true)
    else if create_name isnt ""
        log.Info("Creating game {create_name} as {sess.player_name}")
        ok := sess.CreateGame(create_name, sess.player_name)
        if not ok
            log.Fatal("failed to create game {create_name}")
        log.Info("Marking as ready")
        sess.SetReady(true)
    else
        log.Fatal("--join <game-id> or --create <game-name> is required")

    return sess

func takeTurn(sess: reference Session, strategy: gamepkg.AIStrategyName)
    state := sess.FetchState()
    if len(state) equals 0
        sess.TryAutoStart()
        return

    if IsGameOver(state)
        log.Info("Game ended")
        sess.active = false
        return

    perspective, has_p := state["perspective_player_id"]
    var my_game_id: string
    if has_p
        if perspective is string as p
            my_game_id = p

    log.Debug(
        "takeTurn: state size={len(state)}, perspective={my_game_id}, my_net_id={sess.player_id}",
    )
    if my_game_id equals ""
        return

    cur, has := state["current_turn_player_id"]
    if not has
        return
    var cur_str: string
    if cur is string as s
        cur_str = s
    log.Debug("takeTurn: current={cur_str}, my={my_game_id}")
    if cur_str isnt my_game_id
        return

    log.Info("Our turn (turn {castInt(state, "turn_number")})")
    datetime.SleepMilliseconds(DEFAULT_THINK_MS)

    payload := sess.FetchActions()
    if len(payload) equals 0
        log.Warn("empty actions response")
        return

    actions_any, has_actions := payload["actions"]
    if not has_actions
        return

    if actions_any is list of any as actions_raw
        actions := empty list of map of string to any
        for item in actions_raw
            if item is map of string to any as m
                actions = append(actions, m)
        log.Info("Available actions: {len(actions)}")
        if len(actions) > 0
            chosen := PickAction(actions, strategy)
            log.Info("Sending {gamepkg.ChosenActionName(chosen)}")
            result := sess.SendAction(chosen)
            if len(result) > 0
                if msg, has := result["message"]; has
                    var msg_str: string
                    if msg is string as ms
                        msg_str = ms
                    log.Debug("Server: {msg_str}")
        return
    return

func castInt(m: map of string to any, key: string) int
    v, has := m[key]
    if not has
        return 0
    if v is int as v_int
        return v_int
    return 0

func runPoll(args: cli.Args)
    sess := openSession(args)
    strategy := parseStrategy(cli.GetStringOr(args, "strategy", "random"))
    poll_ms := cli.GetIntOr(args, "poll-interval", DEFAULT_POLL_MS)

    log.Info("Polling every {poll_ms}ms with strategy {strategy}")

    ch := make(channel of bool)
    signal.OnInterrupt(() =>
        log.Info("Shutting down")
        send true to ch
    )

    for true
        select
            when receive from ch
                return
            default
                takeTurn(reference of sess, strategy)
                if not sess.active
                    return
                datetime.SleepMilliseconds(poll_ms as int64)

func runSSE(args: cli.Args)
    sess := openSession(args)
    strategy := parseStrategy(cli.GetStringOr(args, "strategy", "random"))

    log.Info("Subscribing to SSE stream with strategy {strategy}")

    sess.ConnectSSE((ev: SSEEvent) =>
        evt_type := ev.event_type
        if evt_type equals "" or evt_type equals "message"
            evt_type = "message"

        if evt_type equals "GAME_WON" or evt_type equals "GAME_OVER"
            log.Info("Game over event received")
            sess.active = false
            return false

        state := ExtractStateFromSSE(ev)
        if len(state) equals 0
            return true

        if IsGameOver(state)
            log.Info("Game over (state)")
            sess.active = false
            return false

        perspective, has_p := state["perspective_player_id"]
        var my_game_id: string
        if has_p
            if perspective is string as p
                my_game_id = p

        if my_game_id equals ""
            return true

        cur, has := state["current_turn_player_id"]
        if not has
            return true
        var cur_str: string
        if cur is string as s
            cur_str = s
        if cur_str isnt my_game_id
            return true

        if not IsGameActive(state)
            return true

        log.Info("Our turn (turn {castInt(state, "turn_number")})")
        datetime.SleepMilliseconds(DEFAULT_THINK_MS)

        payload := sess.FetchActions()
        if len(payload) equals 0
            return true

        actions_any, has_actions := payload["actions"]
        if not has_actions
            return true

        if actions_any is list of any as actions_raw
            actions := empty list of map of string to any
            for item in actions_raw
                if item is map of string to any as m
                    actions = append(actions, m)
            if len(actions) > 0
                chosen := PickAction(actions, strategy)
                log.Info("Sending {gamepkg.ChosenActionName(chosen)}")
                result := sess.SendAction(chosen)
                if len(result) > 0
                    if msg, has := result["message"]; has
                        var msg_str: string
                        if msg is string as s
                            msg_str = s
                        log.Debug("Server: {msg_str}")

        return true
    )

func main()
    poll_cmd := cli.NewCommand(POLL, "Polling-based AI client (GET /state on timer)")
        |> .StringFlag("server", "Game server URL", DEFAULT_BASE_URL)
        |> .StringFlag("join", "Game ID to join", "")
        |> .StringFlag("create", "Game name to create", "")
        |> .StringFlag("name", "AI player name", "")
        |> .StringFlag("strategy", "AI strategy (random|aggressive|defensive)", "random")
        |> .IntFlag("poll-interval", "Poll interval in ms", DEFAULT_POLL_MS)
        |> .BoolFlag("debug", "Enable debug logging", false)
        |> .Action(runPoll)

    sse_cmd := cli.NewCommand(SSE, "SSE-based AI client (subscribe to Mercure stream)")
        |> .StringFlag("server", "Game server URL", DEFAULT_BASE_URL)
        |> .StringFlag("join", "Game ID to join", "")
        |> .StringFlag("create", "Game name to create", "")
        |> .StringFlag("name", "AI player name", "")
        |> .StringFlag("strategy", "AI strategy (random|aggressive|defensive)", "random")
        |> .BoolFlag("debug", "Enable debug logging", false)
        |> .Action(runSSE)

    app := cli.New("race-ai-client")
        |> cli.Description("AI player for Race to the Crystal")
        |> cli.Version("1.0.0")
        |> cli.WithCommands(poll_cmd, sse_cmd)

    cli.Run(app) onerr
        cli.Fatal("race-ai-client: {error}")
