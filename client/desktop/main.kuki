petiole main

import "image/color"
import "race-to-the-crystal/game" as gamepkg
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as typespkg
import "stdlib/log"

import "github.com/hajimehoshi/ebiten/v2"

const WINDOW_WIDTH = 1280

const WINDOW_HEIGHT = 720

const CELL_SIZE = 32

enum ScreenKind
    MainMenu = 0
    Lobby = 1
    Game = 2
    Victory = 3

type DesktopPos
    X: int
    Y: int

func DPos(x: int, y: int) DesktopPos
    return DesktopPos{X: x, Y: y}

type DesktopToken
    id: int
    playerId: string
    health: int
    maxHealth: int
    position: DesktopPos
    isAlive: bool
    isDeployed: bool

type DesktopPlayer
    id: string
    name: string
    colorName: string
    colorIdx: int
    isActive: bool

type DesktopGenerator
    position: DesktopPos
    capturingPlayer: string
    turnsHeld: int
    isDisabled: bool

type DesktopGameState
    players: list of DesktopPlayer
    tokens: list of DesktopToken
    generators: list of DesktopGenerator
    crystalPos: DesktopPos
    crystalHolder: string
    boardWidth: int
    boardHeight: int
    currentTurnPlayer: string
    phase: string
    turnPhase: string
    winner: string

type DesktopApp
    currentScreen: ScreenKind
    gameState: optional reference DesktopGameState
    realGame: optional reference gamepkg.GameState
    realApi: optional reference gamepkg.GameAPI
    humanPlayer: typespkg.PlayerID
    aiStrategy: gamepkg.AIStrategyName
    selectedTokenId: int
    validMoves: list of DesktopPos
    validAttacks: list of DesktopPos
    hoverCell: DesktopPos
    menuSelection: int
    viewOffsetX: float64
    viewOffsetY: float64
    message: string
    frameCount: int

type DesktopAdapter

var app: DesktopApp

func init()
    app = DesktopApp{
        currentScreen: ScreenKind.MainMenu,
        humanPlayer: typespkg.PlayerID("player_0"),
        aiStrategy: gamepkg.AIStrategyNameRANDOM,
        viewOffsetX: 0.0,
        viewOffsetY: 0.0,
        menuSelection: 0,
        frameCount: 0,
        selectedTokenId: -1,
        validMoves: empty list of DesktopPos,
        validAttacks: empty list of DesktopPos,
    }

func RGBA(r: int, g: int, b: int, a: int) color.RGBA
    return color.RGBA{R: r as uint8, G: g as uint8, B: b as uint8, A: a as uint8}

var ColorBlack = RGBA(0, 0, 0, 255)

var ColorWhite = RGBA(255, 255, 255, 255)

var ColorGray = RGBA(60, 60, 60, 255)

var ColorLightGray = RGBA(100, 100, 100, 255)

var ColorDarkGray = RGBA(30, 30, 30, 255)

var ColorCyan = RGBA(0, 255, 255, 255)

var ColorMagenta = RGBA(255, 0, 255, 255)

var ColorYellow = RGBA(255, 255, 0, 255)

var ColorGreen = RGBA(0, 200, 0, 255)

var ColorOrange = RGBA(255, 165, 0, 255)

var ColorPurple = RGBA(180, 0, 255, 255)

var ColorRed = RGBA(255, 50, 50, 255)

func PlayerColorByName(name: string) color.RGBA
    switch name
        when "cyan"
            return ColorCyan
        when "magenta"
            return ColorMagenta
        when "yellow"
            return ColorYellow
        when "green"
            return ColorGreen
        default
            return ColorWhite

func main()
    ebiten.SetWindowTitle("Race to the Crystal")
    ebiten.SetWindowSize(WINDOW_WIDTH, WINDOW_HEIGHT)
    ebiten.SetWindowResizingMode(ebiten.WindowResizingModeEnabled)
    err := ebiten.RunGame(reference of DesktopAdapter{})
    if err isnt empty
        log.Fatal("{err}")

func Update on a: reference DesktopAdapter error
    app.frameCount = app.frameCount + 1
    switch app.currentScreen
        when ScreenKind.MainMenu
            HandleMainMenuInput()
        when ScreenKind.Lobby
            HandleLobbyInput()
        when ScreenKind.Game
            RunAiTurns()
            SyncDesktopState()
            HandleGameInput()
            SyncDesktopState()
            CheckVictory()
        when ScreenKind.Victory
            HandleVictoryInput()
    return empty

func Draw on a: reference DesktopAdapter(screen: reference ebiten.Image)
    screen.Fill(ColorBlack)
    switch app.currentScreen
        when ScreenKind.MainMenu
            DrawMainMenu(screen)
        when ScreenKind.Lobby
            DrawLobby(screen)
        when ScreenKind.Game
            DrawGame(screen)
        when ScreenKind.Victory
            DrawVictory(screen)

func Layout on a: reference DesktopAdapter(outsideWidth: int, outsideHeight: int) (int, int)
    return WINDOW_WIDTH, WINDOW_HEIGHT

func SetScreen(s: ScreenKind)
    app.currentScreen = s
    app.menuSelection = 0
    app.message = ""

func StartLocalGame()
    gs := gamepkg.CreateGame(2)
    gs.StartGame()
    app.realGame = reference of gs
    api := gamepkg.NewGameAPI(reference of gs, app.humanPlayer)
    app.realApi = reference of api
    deselect()
    app.message = ""
    SyncDesktopState()
    SetScreen(ScreenKind.Game)

func SyncDesktopState()
    gs := app.realGame
    if gs is empty
        app.gameState = empty
        return
    ds := DesktopGameState{
        players: empty list of DesktopPlayer,
        tokens: empty list of DesktopToken,
        generators: empty list of DesktopGenerator,
        boardWidth: gs.BoardWidth(),
        boardHeight: gs.BoardHeight(),
        crystalPos: DPos(0, 0),
        crystalHolder: "",
        currentTurnPlayer: gs.CurrentTurnPlayerID() as string,
        phase: "{gs.Phase()}",
        turnPhase: "{gs.TurnPhase()}",
        winner: gs.WinnerID() as string,
    }
    for pid, p in gs.Players()
        dp := DesktopPlayer{
            id: pid as string,
            name: p.Name(),
            colorName: p.Color() as string,
            colorIdx: enums.PlayerIndex(p.Color()),
            isActive: p.IsActive(),
        }
        ds.players = append(ds.players, dp)
    winnerId := ds.winner
    if winnerId isnt empty
        for p in ds.players
            if p.id equals winnerId
                ds.winner = p.name
    for tid, t in gs.Tokens()
        dt := DesktopToken{
            id: tid as int,
            playerId: t.PlayerID() as string,
            health: t.Health(),
            maxHealth: t.MaxHealth(),
            position: DPos(t.Position().X, t.Position().Y),
            isAlive: t.IsAlive(),
            isDeployed: t.IsDeployed(),
        }
        ds.tokens = append(ds.tokens, dt)
    for g in gs.Generators()
        dg := DesktopGenerator{
            position: DPos(g.Position().X, g.Position().Y),
            capturingPlayer: g.CapturingPlayer() as string,
            turnsHeld: g.TurnsHeld(),
            isDisabled: g.IsDisabled(),
        }
        ds.generators = append(ds.generators, dg)
    crystalRef := gs.CrystalInstance()
    if crystalRef isnt empty
        c := dereference crystalRef
        ds.crystalPos = DPos(c.Position().X, c.Position().Y)
        ds.crystalHolder = c.HoldingPlayer() as string
    app.gameState = reference of ds

func RunAiTurns()
    gs := app.realGame
    if gs is empty
        return
    guard := 0
    for guard < 2000
        if gs.Phase() isnt enums.PLAYING
            return
        if gs.CurrentTurnPlayerID() equals app.humanPlayer
            return
        aiPid := gs.CurrentTurnPlayerID()
        runAiTurn(gs, aiPid)
        if gs.Phase() equals enums.PLAYING
            if gs.CurrentTurnPlayerID() equals aiPid
                gamepkg.ExecuteAction(gamepkg.NewEndTurnAction(), gs, aiPid)
        guard = guard + 1

func runAiTurn(gs: reference gamepkg.GameState, aiPid: typespkg.PlayerID)
    aiApi := gamepkg.NewGameAPI(gs, aiPid)
    guard := 0
    for guard < 30
        if gs.Phase() isnt enums.PLAYING
            return
        if gs.CurrentTurnPlayerID() isnt aiPid
            return
        actions := aiApi.Actions()
        if actions is empty
            return
        chosenRef := gamepkg.ChooseAction(app.aiStrategy, actions, gs, aiPid)
        if chosenRef is empty
            return
        result := gamepkg.ExecuteAction(chosenToAction(dereference chosenRef), gs, aiPid)
        if not result.Success
            return
        guard = guard + 1

func chosenToAction(c: gamepkg.ChosenAction) gamepkg.AIAction
    switch c as v
        when gamepkg.ChosenMove
            dest := typespkg.Pos(v.Destination[0], v.Destination[1])
            return gamepkg.NewMoveAction(v.TokenID, dest)
        when gamepkg.ChosenAttack
            return gamepkg.NewAttackAction(v.AttackerID, v.DefenderID)
        when gamepkg.ChosenDeploy
            pos := typespkg.Pos(v.Position[0], v.Position[1])
            return gamepkg.NewDeployAction(v.HealthValue, pos)
        default
            return gamepkg.NewEndTurnAction()

func CheckVictory()
    gs := app.realGame
    if gs is empty
        return
    if gs.Phase() equals enums.ENDED
        SetScreen(ScreenKind.Victory)
