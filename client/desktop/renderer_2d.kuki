petiole main

import "image/color"
import "math"

import "github.com/hajimehoshi/bitmapfont/v4"
import "github.com/hajimehoshi/ebiten/v2"
import "github.com/hajimehoshi/ebiten/v2/text/v2" as textpkg
import "github.com/hajimehoshi/ebiten/v2/vector"

# defaultFace is the built-in bitmap font used for all on-screen text.
variable defaultFace: textpkg.Face = textpkg.NewGoXFace(bitmapfont.Face)

func DrawMainMenu(screen: reference ebiten.Image)
    title := "RACE TO THE CRYSTAL"
    DrawTextCentered(screen, title, WINDOW_WIDTH / 2, 100, ColorWhite)

    items := list of string{"Local Game", "Network Game", "Quit"}
    for i, text in items
        y := 280 + i * 60
        c := ColorLightGray
        if app.menuSelection equals i
            c = ColorCyan
        DrawTextCentered(screen, text, WINDOW_WIDTH / 2, y, c)

    DrawTextCentered(
        screen,
        "Use UP/DOWN arrows, ENTER to select",
        WINDOW_WIDTH / 2,
        WINDOW_HEIGHT - 60,
        ColorGray,
    )

func DrawLobby(screen: reference ebiten.Image)
    DrawTextCentered(screen, "GAME LOBBY", WINDOW_WIDTH / 2, 40, ColorWhite)

    if app.gameState isnt empty
        gs := dereference app.gameState
        for i, p in gs.players
            y := 120 + i * 40
            pc := PlayerColorByName(p.colorName)
            status := "Ready"
            if p.isActive
                status = "Waiting"
            msg := "{p.name} ({p.colorName}) - {status}"
            DrawText(screen, msg, 200, y, pc)

    DrawTextCentered(
        screen,
        "Press ENTER to start game, ESC to return",
        WINDOW_WIDTH / 2,
        WINDOW_HEIGHT - 40,
        ColorGray,
    )

func DrawGame(screen: reference ebiten.Image)
    if app.gameState isnt empty
        gs := dereference app.gameState
        offsetX := app.viewOffsetX as int
        offsetY := app.viewOffsetY as int

        DrawGrid(screen, gs.boardWidth, gs.boardHeight, offsetX, offsetY)

        for g in gs.generators
            sx := g.position.X * CELL_SIZE + offsetX
            sy := g.position.Y * CELL_SIZE + offsetY
            gc := ColorOrange
            if g.isDisabled
                gc = ColorGray
            vector.DrawFilledRect(
                screen,
                sx as float32,
                sy as float32,
                CELL_SIZE as float32,
                CELL_SIZE as float32,
                gc,
                false,
            )
            vector.StrokeLine(
                screen,
                (sx + 4) as float32,
                (sy + 4) as float32,
                (sx + CELL_SIZE - 4) as float32,
                (sy + CELL_SIZE - 4) as float32,
                2,
                gc,
                false,
            )
            vector.StrokeLine(
                screen,
                (sx + CELL_SIZE - 4) as float32,
                (sy + 4) as float32,
                (sx + 4) as float32,
                (sy + CELL_SIZE - 4) as float32,
                2,
                gc,
                false,
            )

        cx := gs.crystalPos.X * CELL_SIZE + offsetX
        cy := gs.crystalPos.Y * CELL_SIZE + offsetY
        pulse := math.Sin(app.frameCount as float64 * 0.05) * 0.3 + 0.7
        crystalColor := RGBA(200, 100, 255, (pulse * 255) as int)
        vector.DrawFilledRect(
            screen,
            cx as float32,
            cy as float32,
            CELL_SIZE as float32,
            CELL_SIZE as float32,
            crystalColor,
            false,
        )
        DrawTextCentered(screen, "C", cx + CELL_SIZE / 2, cy + 8, ColorWhite)

        for t in gs.tokens
            if t.isAlive and t.isDeployed
                tx := t.position.X * CELL_SIZE + offsetX
                ty := t.position.Y * CELL_SIZE + offsetY
                tc := PlayerColorByName(t.playerId)

                if t.id equals app.selectedTokenId
                    vector.StrokeCircle(
                        screen,
                        (tx + CELL_SIZE / 2) as float32,
                        (ty + CELL_SIZE / 2) as float32,
                        (CELL_SIZE / 2 - 2) as float32,
                        3,
                        ColorWhite,
                        false,
                    )

                vector.DrawFilledCircle(
                    screen,
                    (tx + CELL_SIZE / 2) as float32,
                    (ty + CELL_SIZE / 2) as float32,
                    (CELL_SIZE / 2 - 2) as float32,
                    tc,
                    false,
                )
                hpText := "{t.health}"
                DrawTextCentered(screen, hpText, tx + CELL_SIZE / 2, ty + 8, ColorBlack)

        for mv in app.validMoves
            mx := mv.X * CELL_SIZE + offsetX
            my := mv.Y * CELL_SIZE + offsetY
            vector.StrokeCircle(
                screen,
                (mx + CELL_SIZE / 2) as float32,
                (my + CELL_SIZE / 2) as float32,
                6,
                2,
                ColorGreen,
                false,
            )

        for av in app.validAttacks
            ax := av.X * CELL_SIZE + offsetX
            ay := av.Y * CELL_SIZE + offsetY
            vector.StrokeCircle(
                screen,
                (ax + CELL_SIZE / 2) as float32,
                (ay + CELL_SIZE / 2) as float32,
                (CELL_SIZE / 2 - 2) as float32,
                3,
                ColorRed,
                false,
            )

        hud := "Turn: {gs.currentTurnPlayer} | Phase: {gs.turnPhase} | Click token, click move | SPACE: end turn | ESC: menu | Arrows: pan"
        DrawText(screen, hud, 10, WINDOW_HEIGHT - 20, ColorGray)

        if app.message isnt empty
            DrawTextCentered(screen, app.message, WINDOW_WIDTH / 2, WINDOW_HEIGHT / 2, ColorYellow)

func DrawVictory(screen: reference ebiten.Image)
    DrawTextCentered(screen, "VICTORY!", WINDOW_WIDTH / 2, WINDOW_HEIGHT / 2 - 40, ColorYellow)
    if app.gameState isnt empty
        gs := dereference app.gameState
        if gs.winner isnt empty
            msg := "{gs.winner} wins!"
            DrawTextCentered(screen, msg, WINDOW_WIDTH / 2, WINDOW_HEIGHT / 2 + 20, ColorWhite)
    DrawTextCentered(
        screen,
        "Press ENTER for main menu",
        WINDOW_WIDTH / 2,
        WINDOW_HEIGHT / 2 + 80,
        ColorGray,
    )

func DrawGrid(screen: reference ebiten.Image, w: int, h: int, ox: int, oy: int)
    for x from 0 to w + 1
        xp := x * CELL_SIZE + ox
        vector.StrokeLine(
            screen,
            xp as float32,
            oy as float32,
            xp as float32,
            (h * CELL_SIZE + oy) as float32,
            1,
            ColorDarkGray,
            false,
        )
    for y from 0 to h + 1
        yp := y * CELL_SIZE + oy
        vector.StrokeLine(
            screen,
            ox as float32,
            yp as float32,
            (w * CELL_SIZE + ox) as float32,
            yp as float32,
            1,
            ColorDarkGray,
            false,
        )

func DrawText(screen: reference ebiten.Image, text: string, x: int, y: int, c: color.RGBA)
    opts := textpkg.DrawOptions{}
    opts.GeoM.Translate(x as float64, y as float64)
    opts.ColorScale.SetWithColor(c)
    textpkg.Draw(screen, text, defaultFace, reference of opts)

func DrawTextCentered(screen: reference ebiten.Image, text: string, x: int, y: int, c: color.RGBA)
    width, _ := textpkg.Measure(text, defaultFace, 0.0)
    DrawText(screen, text, x - (width / 2.0) as int, y, c)
