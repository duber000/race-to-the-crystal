petiole main

import "race-to-the-crystal/game" as gamepkg
import "race-to-the-crystal/shared/types" as typespkg

import "github.com/hajimehoshi/ebiten/v2"
import "github.com/hajimehoshi/ebiten/v2/inpututil"

func HandleMainMenuInput()
    if inpututil.IsKeyJustPressed(ebiten.KeyArrowUp)
        app.menuSelection = maxInt(app.menuSelection - 1, 0)
    if inpututil.IsKeyJustPressed(ebiten.KeyArrowDown)
        app.menuSelection = minInt(app.menuSelection + 1, 2)
    if inpututil.IsKeyJustPressed(ebiten.KeyEnter)
        switch app.menuSelection
            when 0
                StartLocalGame()
            when 1
                SetScreen(ScreenKind.Lobby)
            when 2
                SetScreen(ScreenKind.MainMenu)

func HandleLobbyInput()
    if inpututil.IsKeyJustPressed(ebiten.KeyEscape)
        SetScreen(ScreenKind.MainMenu)
    if inpututil.IsKeyJustPressed(ebiten.KeyEnter)
        SetScreen(ScreenKind.Game)

func HandleGameInput()
    panSpeed := 8
    if ebiten.IsKeyPressed(ebiten.KeyArrowLeft)
        app.viewOffsetX = app.viewOffsetX + panSpeed as float64
    if ebiten.IsKeyPressed(ebiten.KeyArrowRight)
        app.viewOffsetX = app.viewOffsetX - panSpeed as float64
    if ebiten.IsKeyPressed(ebiten.KeyArrowUp)
        app.viewOffsetY = app.viewOffsetY + panSpeed as float64
    if ebiten.IsKeyPressed(ebiten.KeyArrowDown)
        app.viewOffsetY = app.viewOffsetY - panSpeed as float64

    if inpututil.IsKeyJustPressed(ebiten.KeyEscape)
        SetScreen(ScreenKind.MainMenu)
        return

    gs := app.realGame
    if gs is empty
        return

    if inpututil.IsKeyJustPressed(ebiten.KeySpace) or inpututil.IsKeyJustPressed(ebiten.KeyEnter)
        EndHumanTurn()
        return

    if gs.CurrentTurnPlayerID() isnt app.humanPlayer
        return

    mx, my := ebiten.CursorPositionF()
    cellX := (mx - app.viewOffsetX) as int / CELL_SIZE
    cellY := (my - app.viewOffsetY) as int / CELL_SIZE
    app.hoverCell = DPos(cellX, cellY)

    if inpututil.IsMouseButtonJustPressed(ebiten.MouseButtonLeft)
        HandleBoardClick(gs, cellX, cellY)

func HandleBoardClick(gs: reference gamepkg.GameState, cellX: int, cellY: int)
    if app.selectedTokenId >= 0
        if TryMove(cellX, cellY)
            return
        if TryAttack(cellX, cellY)
            return
    clicked := FindTokenAt(gs, cellX, cellY)
    if clicked >= 0
        tokRef := gs.GetToken(typespkg.TokenID(clicked))
        if tokRef isnt empty
            tok := dereference tokRef
            if tok.PlayerID() equals app.humanPlayer
                if app.selectedTokenId equals clicked
                    deselect()
                else
                    app.selectedTokenId = clicked
                    app.validMoves = ComputeValidMoves(clicked)
                    app.validAttacks = ComputeValidAttacks(clicked)
                return
    if app.selectedTokenId >= 0
        deselect()

func FindTokenAt(gs: reference gamepkg.GameState, x: int, y: int) int
    for tid, t in gs.Tokens()
        if t.IsAlive() and t.IsDeployed()
            pos := t.Position()
            if pos.X equals x and pos.Y equals y
                return tid as int
    return -1

func ComputeValidMoves(tokenId: int) list of DesktopPos
    result := empty list of DesktopPos
    if app.realApi is empty
        return result
    api := dereference app.realApi
    for a in api.Actions()
        switch a as v
            when gamepkg.MoveAction
                if v.TokenID as int equals tokenId
                    for d in v.ValidDestinations
                        result = append(result, DPos(d[0], d[1]))
    return result

func ComputeValidAttacks(tokenId: int) list of DesktopPos
    result := empty list of DesktopPos
    if app.realApi is empty
        return result
    api := dereference app.realApi
    for a in api.Actions()
        switch a as v
            when gamepkg.AttackAction
                if v.AttackerID as int equals tokenId
                    result = append(result, DPos(v.DefenderPosition[0], v.DefenderPosition[1]))
    return result

func TryMove(cellX: int, cellY: int) bool
    for mv in app.validMoves
        if mv.X equals cellX and mv.Y equals cellY
            if app.realApi is empty
                return false
            api := dereference app.realApi
            result := api.Move(typespkg.TokenID(app.selectedTokenId), cellX, cellY)
            app.message = result.Message
            deselect()
            return true
    return false

func TryAttack(cellX: int, cellY: int) bool
    if app.realApi is empty
        return false
    api := dereference app.realApi
    for a in api.Actions()
        switch a as v
            when gamepkg.AttackAction
                if v.AttackerID as int equals app.selectedTokenId
                    if v.DefenderPosition[0] equals cellX and v.DefenderPosition[1] equals cellY
                        result := api.Attack(typespkg.TokenID(app.selectedTokenId), v.DefenderID)
                        app.message = result.Message
                        deselect()
                        return true
    return false

func EndHumanTurn()
    if app.realApi is empty
        return
    api := dereference app.realApi
    result := api.EndTurn()
    if not result.Success
        app.message = result.Message
    deselect()

func deselect()
    app.selectedTokenId = -1
    app.validMoves = empty list of DesktopPos
    app.validAttacks = empty list of DesktopPos

func HandleVictoryInput()
    if inpututil.IsKeyJustPressed(ebiten.KeyEnter)
        SetScreen(ScreenKind.MainMenu)

func maxInt(a: int, b: int) int
    if a > b
        return a
    return b

func minInt(a: int, b: int) int
    if a < b
        return a
    return b
