# Race to the Crystal - Environment Configuration Example
# Copy this file to .env and customize the values

# =============================================================================
# Server Configuration
# =============================================================================

# TCP port for desktop clients (Arcade)
TCP_PORT=8888

# HTTP/WebSocket port for web clients (Babylon.js)
HTTP_PORT=8080

# Server host binding (use 0.0.0.0 for Docker)
SERVER_HOST=0.0.0.0

# =============================================================================
# Mercure Configuration (Optional - for Server-Sent Events)
# =============================================================================

# Mercure hub URL
# For Docker: http://mercure:3000/.well-known/mercure
# For local: http://localhost:3000/.well-known/mercure
MERCURE_HUB_URL=http://localhost:3000/.well-known/mercure

# JWT token for publishing to Mercure hub
# Generate at: https://jwt.io/ with payload: {"mercure":{"publish":["*"]}}
# Secret must match MERCURE_PUBLISHER_JWT_KEY in Mercure hub
MERCURE_PUBLISHER_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJtZXJjdXJlIjp7InB1Ymxpc2giOlsiKiJdfX0.iJd1H2qK5JvVJvVl1Kx9aSvVz9-dKz1jM7p4qKVqH_k

# Topic prefix for game state updates
MERCURE_TOPIC_PREFIX=https://api.game.com/game

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Game Configuration (Future - not yet implemented)
# =============================================================================

# Maximum players per game
# MAX_PLAYERS=4

# Game timeout in seconds
# GAME_TIMEOUT=3600

# AI difficulty level
# AI_DIFFICULTY=medium
