[Unit]
Description=Race to the Crystal - Web Server (Web Client Frontend)
Documentation=https://github.com/duber000/race-to-the-crystal
After=network-online.target game-api.service
Wants=network-online.target
Wants=game-api.service

[Container]
Image=localhost/race-web-server:latest
ContainerName=race-web-server
Network=game-net.network

# Environment configuration
Environment=WEB_PORT=8000
Environment=GAME_SERVER_URL=http://race-game-api:8080
Environment=MERCURE_HUB_URL=http://race-caddy/.well-known/mercure
Environment=MERCURE_TOPIC_PREFIX=https://api.game.local/game
# WebSocket-primary: SSE state-sync is disabled until the Mercure payload
# shapes and per-player perspective topics are implemented
Environment=MERCURE_ENABLED=false

# Secrets loaded from file (created during deployment)
EnvironmentFile=%h/.config/containers/systemd/race-secrets.env

[Service]
Type=notify
Restart=unless-stopped
RestartSec=5s

[Install]
WantedBy=default.target
