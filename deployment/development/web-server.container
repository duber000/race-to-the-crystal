[Unit]
Description=Race to the Crystal - Web Server (Web Client Frontend)
Documentation=https://github.com/duber000/race-to-the-crystal
After=network-online.target game-api.service
Wants=network-online.target
Wants=game-api.service

[Container]
Image=localhost/race-web-server:latest
ContainerName=race-web-server
Network=game-net.network

# Environment configuration
Environment=WEB_PORT=8000
Environment=GAME_SERVER_URL=http://race-game-api:8080
Environment=MERCURE_HUB_URL=http://127.0.0.1:8880/.well-known/mercure
Environment=MERCURE_TOPIC_PREFIX=https://api.game.local/game
Environment=MERCURE_ENABLED=true

[Service]
Type=notify
Restart=unless-stopped
RestartSec=5s

[Install]
WantedBy=default.target
