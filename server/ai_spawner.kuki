petiole main

import "os"
import "os/exec"
import "stdlib/log"

type SpawnedAI
    processId: int
    playerName: string
    strategy: string
    gameId: string

type AISpawner
    processes: map of int to reference exec.Cmd
    aiCounter: int
    strategies: list of string

func NewAISpawner() AISpawner
    return AISpawner{
        processes: empty map of int to reference exec.Cmd,
        aiCounter: 0,
        strategies: list of string{"random", "aggressive", "defensive"},
    }

func SpawnAIForGame on sp: reference AISpawner(gameId: string, numAi: int, host: string, port: int, strategies: list of string) list of SpawnedAI
    result := empty list of SpawnedAI
    if strategies is empty
        strategies = sp.strategies

    for i from 0 to numAi
        sp.aiCounter = sp.aiCounter + 1
        aiName := "AI-{sp.aiCounter}"
        strategy := strategies[i % len(strategies)]

        args := list of string{
            "run",
            "race-ai-client",
            "--host",
            host,
            "--port",
            "{port}",
            "--game-id",
            gameId,
            "--player-name",
            aiName,
            "--strategy",
            strategy,
        }

        cmd := exec.Command("uv", many args)
        cmd.Stdout = os.Stdout
        cmd.Stderr = os.Stderr
        err := cmd.Start()
        if err isnt empty
            log.Error("Failed to spawn AI process {aiName}: {err}")
            continue

        spawned := SpawnedAI{
            processId: sp.aiCounter,
            playerName: aiName,
            strategy: strategy,
            gameId: gameId,
        }
        result = append(result, spawned)
        sp.processes[sp.aiCounter] = cmd
        log.Info("Spawned AI player {aiName} (strategy={strategy}) for game {gameId}")

    return result

func CleanupAIForGame on sp: reference AISpawner(gameId: string)
    toRemove := empty list of int
    for pid, cmd in sp.processes
        err := cmd.Process.Kill()
        if err isnt empty
            log.Error("Failed to kill AI process {pid}: {err}")
        else
            log.Info("Killed AI process {pid} for game {gameId}")
        toRemove = append(toRemove, pid)

    for pid in toRemove
        delete sp.processes[pid]

func CleanupAll on sp: reference AISpawner
    for pid, cmd in sp.processes
        err := cmd.Process.Kill()
        if err isnt empty
            log.Error("Failed to kill AI process {pid}: {err}")
        else
            log.Info("Killed AI process {pid}")
    sp.processes = empty map of int to reference exec.Cmd
    sp.aiCounter = 0
