petiole main

import "crypto/subtle"
import "stdlib/crypto"
import "stdlib/encoding" as encpkg
import "stdlib/json" as jsonpkg
import "stdlib/string" as strpkg
import "time"

type TokenPayload
    playerId: string
    gameId: string
    issuedAt: int64
    expiresAt: int64

func GenerateSecretKey() (string, error)
    return crypto.RandomToken(32)

func CreatePlayerToken(playerId: string, gameId: string, secretKey: string, expirationHours: int) string
    if expirationHours equals 0
        expirationHours = 24
    now := time.Now().Unix()
    headerJson := map of string to string{"alg": "HS256", "typ": "JWT"}
    headerBytes := jsonpkg.Bytes(headerJson) onerr return ""
    payloadData := JWTClaims{
        PlayerID: playerId,
        GameID: gameId,
        Iat: now,
        Exp: now + (expirationHours * 3600) as int64,
    }
    payloadBytes := jsonpkg.Bytes(payloadData) onerr return ""

    # JWT requires UNPadded base64url (RawURLEncoding semantics); the
    # padded encoder silently broke strict JWT consumers.
    headerB64 := encpkg.Base64URLNoPadEncode(headerBytes)
    payloadB64 := encpkg.Base64URLNoPadEncode(payloadBytes)
    signingInput := "{headerB64}.{payloadB64}"
    # crypto.HMAC(data, key): the signing input is the message, the secret
    # key is the key. Reversing these makes the public header+payload the
    # HMAC key and the secret the message — see the security review.
    signature := crypto.HMAC(signingInput, crypto.HMACKey{Value: secretKey})
    sigBytes := signature as list of byte
    signatureB64 := encpkg.Base64URLNoPadEncode(sigBytes)
    return "{headerB64}.{payloadB64}.{signatureB64}"

type JWTClaims
    PlayerID: string as "player_id"
    GameID: string as "game_id"
    Iat: int64 as "iat"
    Exp: int64 as "exp"

func VerifyPlayerToken(tokenStr: string, secretKey: string) optional reference TokenPayload
    parts := strpkg.Split(tokenStr, ".")
    if len(parts) isnt 3
        return empty

    headerB64 := parts[0]
    payloadB64 := parts[1]
    signatureB64 := parts[2]

    # Validate the header before doing any crypto work: the token must declare
    # the algorithm we always use. Defense in depth — the signature covers the
    # header, but an unknown alg should be rejected outright.
    headerBytes := encpkg.Base64URLNoPadDecodeOr(headerB64, empty list of byte)
    if headerBytes is empty
        return empty
    headerClaims := empty map of string to string
    jsonpkg.ParseBytesInto(headerBytes, reference of headerClaims) onerr return empty
    algVal, hasAlg := headerClaims["alg"]
    if not hasAlg or algVal isnt "HS256"
        return empty

    signingInput := "{headerB64}.{payloadB64}"
    expectedSig := crypto.HMAC(signingInput, crypto.HMACKey{Value: secretKey})
    expectedSigB64 := encpkg.Base64URLNoPadEncode(expectedSig as list of byte)

    # Constant-time compare: a timing signal on the signature would let an
    # attacker forge tokens byte by byte.
    if subtle.ConstantTimeCompare(signatureB64 as list of byte, expectedSigB64 as list of byte) isnt 1
        return empty

    payloadBytes := encpkg.Base64URLNoPadDecodeOr(payloadB64, empty list of byte)
    claims := JWTClaims{}
    jsonpkg.ParseBytesInto(payloadBytes, reference of claims) onerr return empty

    now := time.Now().Unix()
    if now > claims.Exp
        return empty

    result := TokenPayload{
        playerId: claims.PlayerID,
        gameId: claims.GameID,
        issuedAt: claims.Iat,
        expiresAt: claims.Exp,
    }
    return reference of result

func ExtractTokenFromHeader(authorizationHeader: string) string
    if authorizationHeader is empty
        return ""
    prefix := "Bearer "
    if strpkg.HasPrefix(authorizationHeader, prefix)
        return strpkg.TrimPrefix(authorizationHeader, prefix)
    return ""

func ValidateTokenForGame(payload: optional reference TokenPayload, gameId: string) bool
    if payload is empty
        return false
    return payload.gameId equals gameId
