petiole server

import "time"

import "github.com/kukichalang/kukicha/stdlib/crypto"
import "github.com/kukichalang/kukicha/stdlib/encoding" as encpkg
import "github.com/kukichalang/kukicha/stdlib/json" as jsonpkg
import "github.com/kukichalang/kukicha/stdlib/string" as strpkg

type TokenPayload
    player_id string
    game_id string
    issued_at int64
    expires_at int64

func GenerateSecretKey() string
    token := crypto.RandomToken(32) onerr return ""
    return token

func base64url_encode(data: list of byte) string
    return encpkg.Base64URLEncode(data)

func base64url_decode(s: string) list of byte
    result := encpkg.Base64URLDecode(s) onerr return "" as list of byte
    return result

func CreatePlayerToken(player_id: string, game_id: string, secret_key: string, expiration_hours: int) string
    if expiration_hours == 0
        expiration_hours = 24
    now := time.Now().Unix()
    header_json := map of string to string{"alg": "HS256", "typ": "JWT"}
    header_bytes := jsonpkg.Bytes(header_json) onerr return ""
    payload_data := JWTClaims{
        PlayerID: player_id,
        GameID: game_id,
        Iat: now,
        Exp: now + int64(expiration_hours * 3600),
    }
    payload_bytes := jsonpkg.Bytes(payload_data) onerr return ""

    header_b64 := base64url_encode(header_bytes)
    payload_b64 := base64url_encode(payload_bytes)
    signing_input := "{header_b64}.{payload_b64}"
    signature := crypto.HMAC(secret_key, signing_input)
    sig_bytes := signature as list of byte
    signature_b64 := base64url_encode(sig_bytes)
    return "{header_b64}.{payload_b64}.{signature_b64}"

type JWTClaims
    PlayerID string as "player_id"
    GameID string as "game_id"
    Iat int64 as "iat"
    Exp int64 as "exp"

func VerifyPlayerToken(token_str: string, secret_key: string) nullable reference TokenPayload
    parts := strpkg.Split(token_str, ".")
    if len(parts) != 3
        return empty

    header_b64 := parts[0]
    payload_b64 := parts[1]
    signature_b64 := parts[2]

    signing_input := "{header_b64}.{payload_b64}"
    expected_sig := crypto.HMAC(secret_key, signing_input)
    expected_sig_b64 := base64url_encode(expected_sig as list of byte)

    if signature_b64 != expected_sig_b64
        return empty

    payload_bytes := base64url_decode(payload_b64)
    claims := JWTClaims{}
    jsonpkg.ParseInto(payload_bytes, reference of claims) onerr return empty

    now := time.Now().Unix()
    if now > claims.Exp
        return empty

    result := TokenPayload{
        player_id: claims.PlayerID,
        game_id: claims.GameID,
        issued_at: claims.Iat,
        expires_at: claims.Exp,
    }
    return reference of result

func ExtractTokenFromHeader(authorization_header: string) string
    if authorization_header == ""
        return ""
    prefix := "Bearer "
    if strpkg.HasPrefix(authorization_header, prefix)
        return strpkg.TrimPrefix(authorization_header, prefix)
    return ""

func ValidateTokenForGame(payload: nullable reference TokenPayload, game_id: string) bool
    if payload equals empty
        return false
    p := dereference payload
    return p.game_id == game_id
