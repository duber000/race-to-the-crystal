petiole main

import "stdlib/random"
import "stdlib/regex"
import "stdlib/sort"
import "stdlib/string" as strpkg
import "sync"

const MAX_GAME_NAME_LENGTH = 50

const MAX_PLAYER_NAME_LENGTH = 30

const ALLOWED_NAME_PATTERN = `^[a-zA-Z0-9_\- \.]+$`

var NAME_REGEX = regex.MustCompile('^[a-zA-Z0-9_\- \.]+$')

enum ClientType: string
    HUMAN = "HUMAN"
    AI = "AI"
    WEB_BROWSER = "WEB_BROWSER"
    HTTP_AI = "HTTP_AI"

enum GameStatus: string
    WAITING = "WAITING"
    READY = "READY"
    STARTING = "STARTING"
    IN_PROGRESS = "IN_PROGRESS"
    FINISHED = "FINISHED"

type PlayerInfo
    playerId: string
    playerName: string
    clientType: ClientType
    isReady: bool
    colorIndex: int
    isAgent: bool
    model: string
    agentKind: string

func NewPlayerInfo(playerId: string, playerName: string, clientType: ClientType, colorIndex: int) PlayerInfo
    return PlayerInfo{
        playerId: playerId,
        playerName: playerName,
        clientType: clientType,
        isReady: false,
        colorIndex: colorIndex,
        isAgent: false,
        model: "",
        agentKind: "",
    }

func toDict on p: PlayerInfo JSONMap
    ctStr := p.clientType.String()
    return JSONMap{
        "player_id": p.playerId,
        "player_name": p.playerName,
        "client_type": ctStr,
        "is_ready": p.isReady,
        "color_index": p.colorIndex,
        "is_agent": p.isAgent,
        "model": p.model,
        "agent_kind": p.agentKind,
    }

func ValidateGameName(gameName: string) error
    if (gameName is empty) or (strpkg.TrimSpace(gameName) is empty)
        return error "Game name cannot be empty"
    if len(gameName) > MAX_GAME_NAME_LENGTH
        return error "Game name too long (max {MAX_GAME_NAME_LENGTH} characters)"
    if not NAME_REGEX.Match(gameName)
        return error "Game name contains invalid characters"
    if strpkg.Contains(gameName, "..")
        return error "Game name cannot contain '..' sequence"
    if strpkg.TrimSpace(gameName) isnt gameName
        return error "Game name cannot have leading or trailing whitespace"
    return empty

func ValidatePlayerName(playerName: string) error
    if (playerName is empty) or (strpkg.TrimSpace(playerName) is empty)
        return error "Player name cannot be empty"
    if len(playerName) > MAX_PLAYER_NAME_LENGTH
        return error "Player name too long (max {MAX_PLAYER_NAME_LENGTH} characters)"
    if not NAME_REGEX.Match(playerName)
        return error "Player name contains invalid characters"
    if strpkg.TrimSpace(playerName) isnt playerName
        return error "Player name cannot have leading or trailing whitespace"
    return empty

type GameLobby
    gameId: string
    gameName: string
    hostPlayerId: string
    maxPlayers: int
    minPlayers: int
    players: map of string to PlayerInfo
    status: GameStatus
    # Guards every field above. Handlers on many goroutines read and
    # mutate lobbies (join/ready/leave/broadcast lobby.toDict()). Do not
    # take this and then call back into LobbyManager — lock order is
    # always manager then lobby, never the reverse.
    mu: sync.Mutex

func NewGameLobby(gameId: string, gameName: string, hostPlayerId: string, maxPlayers: int) GameLobby
    return GameLobby{
        gameId: gameId,
        gameName: gameName,
        hostPlayerId: hostPlayerId,
        maxPlayers: maxPlayers,
        minPlayers: 2,
        players: empty map of string to PlayerInfo,
        status: GameStatus.WAITING,
    }

func addPlayer on l: reference GameLobby(playerId: string, playerName: string, clientType: ClientType) bool
    err := ValidatePlayerName(playerName)
    if err isnt empty
        return false

    l.mu.Lock()
    defer l.mu.Unlock()
    _, exists := l.players[playerId]
    if exists
        return false

    if len(l.players) >= l.maxPlayers
        return false

    colorIndex := len(l.players)
    info := NewPlayerInfo(playerId, playerName, clientType, colorIndex)
    l.players[playerId] = info
    return true

func removePlayer on l: reference GameLobby(playerId: string) bool
    l.mu.Lock()
    defer l.mu.Unlock()
    _, exists := l.players[playerId]
    if not exists
        return false
    delete l.players[playerId]

    if playerId equals l.hostPlayerId and l.players isnt empty
        for pid in l.players
            l.hostPlayerId = pid
            break

    l.reassignColorsLocked()
    return true

func setPlayerReady on l: reference GameLobby(playerId: string, isReady: bool) bool
    l.mu.Lock()
    defer l.mu.Unlock()
    info, exists := l.players[playerId]
    if not exists
        return false
    info.isReady = isReady
    l.players[playerId] = info
    return true

func playerCount on l: reference GameLobby int
    l.mu.Lock()
    defer l.mu.Unlock()
    return len(l.players)

func hostPlayerIdOf on l: reference GameLobby string
    l.mu.Lock()
    defer l.mu.Unlock()
    return l.hostPlayerId

# Update agent metadata for a seat, atomically. Used right after joining —
# the HTTP create/join paths label their seats as agent seats.
func setAgentInfo on l: reference GameLobby(playerId: string, model: string, agentKind: string)
    l.mu.Lock()
    defer l.mu.Unlock()
    info, exists := l.players[playerId]
    if not exists
        return
    info.isAgent = true
    info.model = model
    info.agentKind = agentKind
    l.players[playerId] = info

# The lobby summary the create/join protocol returns. Built under one lock
# hold so every field is consistent.
func summaryDict on l: reference GameLobby JSONMap
    l.mu.Lock()
    defer l.mu.Unlock()
    statusStr := l.status.String()
    return JSONMap{
        "game_id": l.gameId,
        "game_name": l.gameName,
        "host_player_id": l.hostPlayerId,
        "max_players": l.maxPlayers,
        "current_players": len(l.players),
        "status": statusStr,
        "players": l.getPlayerListLocked(),
    }

# Expects the caller to hold `l.mu`.
func getPlayerListLocked on l: reference GameLobby list of JSONMap
    result := empty list of JSONMap
    for info in l.orderedPlayersLocked()
        result = append(result, info.toDict())
    return result

func hasPlayer on l: reference GameLobby(playerId: string) bool
    l.mu.Lock()
    defer l.mu.Unlock()
    _, exists := l.players[playerId]
    return exists

func isEmpty on l: reference GameLobby bool
    l.mu.Lock()
    defer l.mu.Unlock()
    return l.players is empty

func setStatus on l: reference GameLobby(status: GameStatus)
    l.mu.Lock()
    l.status = status
    l.mu.Unlock()

func statusOf on l: reference GameLobby GameStatus
    l.mu.Lock()
    defer l.mu.Unlock()
    return l.status

func allPlayersReadyLocked on l: reference GameLobby bool
    if len(l.players) < l.minPlayers
        return false
    for _, info in l.players
        if not info.isReady
            return false
    return true

func canStartLocked on l: reference GameLobby bool
    return l.status equals GameStatus.WAITING and l.allPlayersReadyLocked() and len(l.players) >= l.minPlayers

# Atomically checks the lobby can start and flips it to STARTING, so two
# racing "start game" messages cannot both win and spawn two sessions for
# the same lobby.
func tryStart on l: reference GameLobby bool
    l.mu.Lock()
    defer l.mu.Unlock()
    if not l.canStartLocked()
        return false
    l.status = GameStatus.STARTING
    return true

func getAiNeededCountLocked on l: reference GameLobby int
    if len(l.players) >= l.maxPlayers
        return 0
    return l.maxPlayers - len(l.players)

# Callers must hold `l.mu` — this mutates the colour index of every player
# in the lobby.
func reassignColorsLocked on l: reference GameLobby
    # Players are stored in a map, so iteration order is random. Sort by the
    # current colour index (which tracks join order) before re-indexing, or
    # seats and colours shuffle on every call.
    ordered := l.orderedPlayersLocked()
    idx := 0
    for info in ordered
        updated := info
        updated.colorIndex = idx
        l.players[info.playerId] = updated
        idx = idx + 1

# Players in stable join order (by colour index). `l.players` is a map, so
# raw iteration order is random — never iterate it directly for anything
# order-dependent. Expects the caller to hold `l.mu`.
func orderedPlayersLocked on l: reference GameLobby list of PlayerInfo
    infos := empty list of PlayerInfo
    for _, info in l.players
        infos = append(infos, info)
    return sort.ByKey(infos, (p: PlayerInfo) => p.colorIndex)

# Variant taking the lock — use it from outside the lobby.
func orderedPlayers on l: reference GameLobby list of PlayerInfo
    l.mu.Lock()
    defer l.mu.Unlock()
    return l.orderedPlayersLocked()

func getPlayerList on l: reference GameLobby list of JSONMap
    l.mu.Lock()
    defer l.mu.Unlock()
    return l.getPlayerListLocked()

func toDict on l: reference GameLobby JSONMap
    l.mu.Lock()
    defer l.mu.Unlock()
    statusStr := l.status.String()
    return JSONMap{
        "game_id": l.gameId,
        "game_name": l.gameName,
        "host_player_id": l.hostPlayerId,
        "max_players": l.maxPlayers,
        "min_players": l.minPlayers,
        "current_players": len(l.players),
        "status": statusStr,
        "players": l.getPlayerListLocked(),
    }

type LobbyManager
    lobbies: map of string to reference GameLobby
    # Guards the `lobbies` map. Lobbies themselves have their own `mu`;
    # this guards the map of lobbies. Lock order is manager then lobby,
    # never the reverse.
    mu: sync.Mutex

func NewLobbyManager() LobbyManager
    return LobbyManager{lobbies: empty map of string to reference GameLobby}

func createLobby on lm: reference LobbyManager(playerId: string, playerName: string, gameName: string, clientType: ClientType, maxPlayers: int) optional reference GameLobby
    err := ValidateGameName(gameName)
    if err isnt empty
        return empty
    err = ValidatePlayerName(playerName)
    if err isnt empty
        return empty

    if maxPlayers < 2
        maxPlayers = 2
    if maxPlayers > 4
        maxPlayers = 4

    gameId := random.String(16)
    lobby := NewGameLobby(gameId, gameName, playerId, maxPlayers)
    lobby.addPlayer(playerId, playerName, clientType)
    lobRef := reference of lobby
    lm.mu.Lock()
    # A player belongs to one lobby at a time. Leaving any previous lobby
    # keeps `getPlayerLobby` unambiguous — otherwise a stale lobby can
    # block the new one from starting.
    lm.removePlayerFromAllLocked(playerId)
    lm.lobbies[gameId] = lobRef
    lm.mu.Unlock()
    return lobRef

func getLobby on lm: reference LobbyManager(gameId: string) optional reference GameLobby
    lm.mu.Lock()
    defer lm.mu.Unlock()
    return lm.lobbies[gameId]

func joinLobby on lm: reference LobbyManager(gameId: string, playerId: string, playerName: string, clientType: ClientType) optional reference GameLobby
    lm.mu.Lock()
    defer lm.mu.Unlock()
    lobby := lm.lobbies[gameId]
    if lobby is empty
        return empty
    if lobby.statusOf() isnt GameStatus.WAITING
        return empty
    # A player belongs to one lobby at a time — leaving any previous lobby
    # keeps `getPlayerLobby` unambiguous.
    lm.removePlayerFromAllLocked(playerId)
    success := lobby.addPlayer(playerId, playerName, clientType)
    if not success
        return empty
    return lobby

func leaveLobby on lm: reference LobbyManager(gameId: string, playerId: string) bool
    lm.mu.Lock()
    defer lm.mu.Unlock()
    return lm.leaveLobbyLocked(gameId, playerId)

func leaveLobbyLocked on lm: reference LobbyManager(gameId: string, playerId: string) bool
    lobby := lm.lobbies[gameId]
    if lobby is empty
        return false
    success := lobby.removePlayer(playerId)
    if lobby.isEmpty()
        delete lm.lobbies[gameId]
    return success

func setReady on lm: reference LobbyManager(gameId: string, playerId: string, isReady: bool) bool
    lobby := lm.getLobby(gameId)
    if lobby is empty
        return false
    return lobby.setPlayerReady(playerId, isReady)

# Atomically validates that the lobby may start and flips it to STARTING,
# so two racing start messages cannot both proceed.
func startGame on lm: reference LobbyManager(gameId: string) optional reference GameLobby
    lm.mu.Lock()
    lobby := lm.lobbies[gameId]
    lm.mu.Unlock()
    if lobby is empty
        return empty
    if not lobby.tryStart()
        return empty
    return lobby

func setGameInProgress on lm: reference LobbyManager(gameId: string) bool
    lobby := lm.getLobby(gameId)
    if lobby is empty
        return false
    lobby.setStatus(GameStatus.IN_PROGRESS)
    return true

func finishGame on lm: reference LobbyManager(gameId: string) bool
    lobby := lm.getLobby(gameId)
    if lobby is empty
        return false
    lobby.setStatus(GameStatus.FINISHED)
    return true

func listAvailableLobbies on lm: reference LobbyManager list of JSONMap
    lm.mu.Lock()
    defer lm.mu.Unlock()
    result := empty list of JSONMap
    for _, lobby in lm.lobbies
        if lobby.statusOf() equals GameStatus.WAITING and lobby.playerCount() < lobby.maxPlayers
            result = append(result, lobby.toDict())
    return result

# In-progress games, for the (public) games list endpoint.
func listInProgress on lm: reference LobbyManager list of JSONMap
    lm.mu.Lock()
    defer lm.mu.Unlock()
    result := empty list of JSONMap
    for _, lobby in lm.lobbies
        if lobby.statusOf() equals GameStatus.IN_PROGRESS
            result = append(result, lobby.toDict())
    return result

func getPlayerLobby on lm: reference LobbyManager(playerId: string) optional reference GameLobby
    # A player can be in more than one lobby — for example after a match
    # ends without a leave. Prefer a lobby that is still joinable, so that
    # ready/start act on the right one.
    lm.mu.Lock()
    defer lm.mu.Unlock()
    for _gameId, lobby in lm.lobbies
        if not lobby.hasPlayer(playerId)
            continue
        status := lobby.statusOf()
        if status equals GameStatus.WAITING or status equals GameStatus.STARTING
            return lobby

    # Otherwise fall back to any lobby the player is in.
    for _gameId, lobby in lm.lobbies
        if lobby.hasPlayer(playerId)
            return lobby
    return empty

func removePlayerFromAll on lm: reference LobbyManager(playerId: string)
    lm.mu.Lock()
    defer lm.mu.Unlock()
    lm.removePlayerFromAllLocked(playerId)

# Caller must hold `lm.mu`. Collects the affected lobby ids first so the
# map is never mutated while it is being ranged.
func removePlayerFromAllLocked on lm: reference LobbyManager(playerId: string)
    gameIds := empty list of string
    for gid, lobby in lm.lobbies
        if lobby.hasPlayer(playerId)
            gameIds = append(gameIds, gid)
    for gid in gameIds
        lm.leaveLobbyLocked(gid, playerId)
