petiole main

import "github.com/kukichalang/kukicha/stdlib/random"
import "github.com/kukichalang/kukicha/stdlib/regex"
import "github.com/kukichalang/kukicha/stdlib/string" as strpkg

const MAX_GAME_NAME_LENGTH = 50

const MAX_PLAYER_NAME_LENGTH = 30

const ALLOWED_NAME_PATTERN = `^[a-zA-Z0-9_\- \.]+$`

var NAME_REGEX = regex.MustCompile(ALLOWED_NAME_PATTERN)

enum ClientType: string
    HUMAN = "HUMAN"
    AI = "AI"
    WEB_BROWSER = "WEB_BROWSER"
    HTTP_AI = "HTTP_AI"

enum GameStatus: string
    WAITING = "WAITING"
    READY = "READY"
    STARTING = "STARTING"
    IN_PROGRESS = "IN_PROGRESS"
    FINISHED = "FINISHED"

type PlayerInfo
    player_id string
    player_name string
    client_type ClientType
    is_ready bool
    color_index int

func NewPlayerInfo(player_id: string, player_name: string, client_type: ClientType, color_index: int) PlayerInfo
    return PlayerInfo{
        player_id: player_id,
        player_name: player_name,
        client_type: client_type,
        is_ready: false,
        color_index: color_index,
    }

func to_dict on p: PlayerInfo map of string to any
    ct_str := p.client_type.String()
    return map of string to any{
        "player_id": p.player_id,
        "player_name": p.player_name,
        "client_type": ct_str,
        "is_ready": p.is_ready,
        "color_index": p.color_index,
    }

func ValidateGameName(game_name: string) error
    if game_name == "" or strpkg.TrimSpace(game_name) == ""
        return error "Game name cannot be empty"
    if len(game_name) > MAX_GAME_NAME_LENGTH
        return error "Game name too long (max {MAX_GAME_NAME_LENGTH} characters)"
    if not regex.MatchCompiled(NAME_REGEX, game_name)
        return error "Game name contains invalid characters"
    if strpkg.Contains(game_name, "..")
        return error "Game name cannot contain '..' sequence"
    if strpkg.TrimSpace(game_name) != game_name
        return error "Game name cannot have leading or trailing whitespace"
    return empty

func ValidatePlayerName(player_name: string) error
    if player_name == "" or strpkg.TrimSpace(player_name) == ""
        return error "Player name cannot be empty"
    if len(player_name) > MAX_PLAYER_NAME_LENGTH
        return error "Player name too long (max {MAX_PLAYER_NAME_LENGTH} characters)"
    if not regex.MatchCompiled(NAME_REGEX, player_name)
        return error "Player name contains invalid characters"
    if strpkg.TrimSpace(player_name) != player_name
        return error "Player name cannot have leading or trailing whitespace"
    return empty

type GameLobby
    game_id string
    game_name string
    host_player_id string
    max_players int
    min_players int
    players map of string to PlayerInfo
    status GameStatus

func NewGameLobby(game_id: string, game_name: string, host_player_id: string, max_players: int) GameLobby
    return GameLobby{
        game_id: game_id,
        game_name: game_name,
        host_player_id: host_player_id,
        max_players: max_players,
        min_players: 2,
        players: make(map of string to PlayerInfo),
        status: GameStatus.WAITING,
    }

func add_player on l: reference GameLobby(player_id: string, player_name: string, client_type: ClientType) bool
    err := ValidatePlayerName(player_name)
    if err isnt empty
        return false

    _, exists := l.players[player_id]
    if exists
        return false

    if len(l.players) >= l.max_players
        return false

    color_index := len(l.players)
    info := NewPlayerInfo(player_id, player_name, client_type, color_index)
    l.players[player_id] = info
    return true

func remove_player on l: reference GameLobby(player_id: string) bool
    _, exists := l.players[player_id]
    if not exists
        return false
    delete l.players[player_id]

    if player_id == l.host_player_id and len(l.players) > 0
        for pid, _ in l.players
            l.host_player_id = pid
            break

    l.reassign_colors()
    return true

func set_player_ready on l: reference GameLobby(player_id: string, is_ready: bool) bool
    info, exists := l.players[player_id]
    if not exists
        return false
    info.is_ready = is_ready
    l.players[player_id] = info
    return true

func all_players_ready on l: reference GameLobby bool
    if len(l.players) < l.min_players
        return false
    for _, info in l.players
        if not info.is_ready
            return false
    return true

func can_start on l: reference GameLobby bool
    return l.status == GameStatus.WAITING and l.all_players_ready() and len(l.players) >= l.min_players

func get_ai_needed_count on l: reference GameLobby int
    if len(l.players) >= l.max_players
        return 0
    return l.max_players - len(l.players)

func reassign_colors on l: reference GameLobby
    idx := 0
    for _, info in l.players
        updated := info
        updated.color_index = idx
        l.players[info.player_id] = updated
        idx = idx + 1

func get_player_list on l: reference GameLobby list of map of string to any
    result := empty list of map of string to any
    for _, info in l.players
        result = append(result, info.to_dict())
    return result

func to_dict on l: GameLobby map of string to any
    status_str := l.status as string
    return map of string to any{
        "game_id": l.game_id,
        "game_name": l.game_name,
        "host_player_id": l.host_player_id,
        "max_players": l.max_players,
        "min_players": l.min_players,
        "current_players": len(l.players),
        "status": status_str,
        "players": l.get_player_list(),
    }

type LobbyManager
    lobbies map of string to reference GameLobby

func NewLobbyManager() LobbyManager
    return LobbyManager{lobbies: make(map of string to reference GameLobby)}

func create_lobby on lm: reference LobbyManager(player_id: string, player_name: string, game_name: string, client_type: ClientType, max_players: int) nullable reference GameLobby
    err := ValidateGameName(game_name)
    if err isnt empty
        return empty
    err = ValidatePlayerName(player_name)
    if err isnt empty
        return empty

    if max_players < 2
        max_players = 2
    if max_players > 4
        max_players = 4

    game_id := random.String(16)
    lobby := NewGameLobby(game_id, game_name, player_id, max_players)
    lobby.add_player(player_id, player_name, client_type)
    lm.lobbies[game_id] = reference of lobby
    return lm.lobbies[game_id]

func get_lobby on lm: reference LobbyManager(game_id: string) nullable reference GameLobby
    lobby, ok := lm.lobbies[game_id]
    if ok
        return lobby
    return empty

func join_lobby on lm: reference LobbyManager(game_id: string, player_id: string, player_name: string, client_type: ClientType) nullable reference GameLobby
    lobby := lm.get_lobby(game_id)
    if lobby equals empty
        return empty
    if dereference lobby.status != GameStatus.WAITING
        return empty
    success := lobby.add_player(player_id, player_name, client_type)
    if not success
        return empty
    return lobby

func leave_lobby on lm: reference LobbyManager(game_id: string, player_id: string) bool
    lobby := lm.get_lobby(game_id)
    if lobby equals empty
        return false
    success := lobby.remove_player(player_id)
    if len(dereference lobby.players) == 0
        delete lm.lobbies[game_id]
    return success

func set_ready on lm: reference LobbyManager(game_id: string, player_id: string, is_ready: bool) bool
    lobby := lm.get_lobby(game_id)
    if lobby equals empty
        return false
    return lobby.set_player_ready(player_id, is_ready)

func start_game on lm: reference LobbyManager(game_id: string) nullable reference GameLobby
    lobby := lm.get_lobby(game_id)
    if lobby equals empty
        return empty
    if not dereference lobby.can_start()
        return empty
    lobby.status = GameStatus.STARTING
    return lobby

func set_game_in_progress on lm: reference LobbyManager(game_id: string) bool
    lobby := lm.get_lobby(game_id)
    if lobby equals empty
        return false
    lobby.status = GameStatus.IN_PROGRESS
    return true

func finish_game on lm: reference LobbyManager(game_id: string) bool
    lobby := lm.get_lobby(game_id)
    if lobby equals empty
        return false
    lobby.status = GameStatus.FINISHED
    return true

func list_available_lobbies on lm: reference LobbyManager list of map of string to any
    result := empty list of map of string to any
    for _, lobby in lm.lobbies
        if dereference lobby.status == GameStatus.WAITING and len(dereference lobby.players) < dereference lobby.max_players
            result = append(result, dereference lobby.to_dict())
    return result

func get_player_lobby on lm: reference LobbyManager(player_id: string) nullable reference GameLobby
    for _, lobby in lm.lobbies
        lb := dereference lobby
        _, exists := lb.players[player_id]
        if exists
            return lobby
    return empty

func remove_player_from_all on lm: reference LobbyManager(player_id: string)
    lobby := lm.get_player_lobby(player_id)
    if lobby isnt empty
        lm.leave_lobby(dereference lobby.game_id, player_id)
