petiole main

import "race-to-the-crystal/game" as gamepkg
import "race-to-the-crystal/shared/constants" as constants
import "stdlib/json" as jsonpkg
import "stdlib/slice"
import "stdlib/string" as strpkg

type ValidationResult
    field: string
    errorCode: string
    message: string

func ValidateActionFields(actionType: gamepkg.ActionType, data: map of string to any) optional reference ValidationResult
    switch actionType
        when gamepkg.MOVE
            return ValidateMove(data)
        when gamepkg.ATTACK
            return ValidateAttack(data)
        when gamepkg.DEPLOY
            return ValidateDeploy(data)
        when gamepkg.END_TURN
            return empty
        default
            return reference of ValidationResult{
                field: "type",
                errorCode: "UNKNOWN_ACTION",
                message: "Unknown action type: {actionType}",
            }

func ValidateMove(data: map of string to any) optional reference ValidationResult
    _, hasTid := data["token_id"]
    if not hasTid
        return reference of ValidationResult{
            field: "token_id",
            errorCode: "MISSING_FIELD",
            message: "MOVE requires token_id",
        }

    destVal, hasDest := data["destination"]
    if not hasDest
        destVal, hasDest = data["position"]
    if not hasDest
        return reference of ValidationResult{
            field: "destination",
            errorCode: "MISSING_FIELD",
            message: "MOVE requires destination",
        }

    if data["token_id"] is int
        if not isPositionValue(destVal)
            return reference of ValidationResult{
                field: "destination",
                errorCode: "INVALID_TYPE",
                message: "destination must be [x, y]",
            }

        return empty
    else
        return reference of ValidationResult{
            field: "token_id",
            errorCode: "INVALID_TYPE",
            message: "token_id must be an integer",
        }

func ValidateAttack(data: map of string to any) optional reference ValidationResult
    _, hasAtk := data["attacker_id"]
    if not hasAtk
        return reference of ValidationResult{
            field: "attacker_id",
            errorCode: "MISSING_FIELD",
            message: "ATTACK requires attacker_id",
        }

    defVal, hasDef := data["defender_id"]
    if not hasDef
        defVal, hasDef = data["target_id"]
    if not hasDef
        return reference of ValidationResult{
            field: "defender_id",
            errorCode: "MISSING_FIELD",
            message: "ATTACK requires defender_id",
        }

    if data["attacker_id"] is int
        if defVal is int
            return empty
        else
            return reference of ValidationResult{
                field: "defender_id",
                errorCode: "INVALID_TYPE",
                message: "defender_id must be an integer",
            }
    else
        return reference of ValidationResult{
            field: "attacker_id",
            errorCode: "INVALID_TYPE",
            message: "attacker_id must be an integer",
        }

func ValidateDeploy(data: map of string to any) optional reference ValidationResult
    hvVal, hasHv := data["health_value"]
    if not hasHv
        return reference of ValidationResult{
            field: "health_value",
            errorCode: "MISSING_FIELD",
            message: "DEPLOY requires health_value",
        }

    posVal, hasPos := data["position"]
    if not hasPos
        return reference of ValidationResult{
            field: "position",
            errorCode: "MISSING_FIELD",
            message: "DEPLOY requires position",
        }

    if hvVal is int as hvInt
        if not slice.Contains(constants.TOKEN_HEALTH_VALUES, hvInt)
            return reference of ValidationResult{
                field: "health_value",
                errorCode: "INVALID_VALUE",
                message: "health_value must be one of {constants.TOKEN_HEALTH_VALUES}",
            }

        if not isPositionValue(posVal)
            return reference of ValidationResult{
                field: "position",
                errorCode: "INVALID_TYPE",
                message: "position must be [x, y]",
            }

        return empty
    else
        return reference of ValidationResult{
            field: "health_value",
            errorCode: "INVALID_TYPE",
            message: "health_value must be an integer",
        }

func isPositionValue(val: any) bool
    pos := empty list of int
    bytes := jsonpkg.Bytes(val) onerr return false
    jsonpkg.ParseBytesInto(bytes, reference of pos) onerr return false
    return len(pos) equals 2

func NormalizeActionData(data: map of string to any) map of string to any
    result := empty map of string to any
    for key, val in data
        lowerKey := strpkg.ToLower(key)
        if lowerKey equals "type"
            if val is string as typeStr
                result["type"] = strpkg.ToLower(typeStr)
            else
                result["type"] = ""
        else if lowerKey equals "target_id"
            result["defender_id"] = val
        else
            result[lowerKey] = val
    return result
