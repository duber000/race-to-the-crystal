petiole main

import "race-to-the-crystal/game" as gamepkg
import "race-to-the-crystal/shared/constants" as constants
import "stdlib/json" as jsonpkg
import "stdlib/string" as strpkg

type ValidationResult
    field: string
    error_code: string
    message: string

func ValidateActionFields(action_type: gamepkg.ActionType, data: map of string to any) optional reference ValidationResult
    switch action_type
        when gamepkg.MOVE
            return ValidateMove(data)
        when gamepkg.ATTACK
            return ValidateAttack(data)
        when gamepkg.DEPLOY
            return ValidateDeploy(data)
        when gamepkg.END_TURN
            return empty
        default
            return reference of ValidationResult{
                field: "type",
                error_code: "UNKNOWN_ACTION",
                message: "Unknown action type: {action_type}",
            }

func ValidateMove(data: map of string to any) optional reference ValidationResult
    _, has_tid := data["token_id"]
    if not has_tid
        return reference of ValidationResult{
            field: "token_id",
            error_code: "MISSING_FIELD",
            message: "MOVE requires token_id",
        }

    dest_val, has_dest := data["destination"]
    if not has_dest
        dest_val, has_dest = data["position"]
    if not has_dest
        return reference of ValidationResult{
            field: "destination",
            error_code: "MISSING_FIELD",
            message: "MOVE requires destination",
        }

    if data["token_id"] is int
        if not is_position_value(dest_val)
            return reference of ValidationResult{
                field: "destination",
                error_code: "INVALID_TYPE",
                message: "destination must be [x, y]",
            }

        return empty
    else
        return reference of ValidationResult{
            field: "token_id",
            error_code: "INVALID_TYPE",
            message: "token_id must be an integer",
        }

func ValidateAttack(data: map of string to any) optional reference ValidationResult
    _, has_atk := data["attacker_id"]
    if not has_atk
        return reference of ValidationResult{
            field: "attacker_id",
            error_code: "MISSING_FIELD",
            message: "ATTACK requires attacker_id",
        }

    def_val, has_def := data["defender_id"]
    if not has_def
        def_val, has_def = data["target_id"]
    if not has_def
        return reference of ValidationResult{
            field: "defender_id",
            error_code: "MISSING_FIELD",
            message: "ATTACK requires defender_id",
        }

    if data["attacker_id"] is int
        if def_val is int
            return empty
        else
            return reference of ValidationResult{
                field: "defender_id",
                error_code: "INVALID_TYPE",
                message: "defender_id must be an integer",
            }
    else
        return reference of ValidationResult{
            field: "attacker_id",
            error_code: "INVALID_TYPE",
            message: "attacker_id must be an integer",
        }

func ValidateDeploy(data: map of string to any) optional reference ValidationResult
    hv_val, has_hv := data["health_value"]
    if not has_hv
        return reference of ValidationResult{
            field: "health_value",
            error_code: "MISSING_FIELD",
            message: "DEPLOY requires health_value",
        }

    pos_val, has_pos := data["position"]
    if not has_pos
        return reference of ValidationResult{
            field: "position",
            error_code: "MISSING_FIELD",
            message: "DEPLOY requires position",
        }

    if hv_val is int as hv_int
        valid_hv := false
        for v in constants.TOKEN_HEALTH_VALUES
            if v equals hv_int
                valid_hv = true
        if not valid_hv
            return reference of ValidationResult{
                field: "health_value",
                error_code: "INVALID_VALUE",
                message: "health_value must be one of {constants.TOKEN_HEALTH_VALUES}",
            }

        if not is_position_value(pos_val)
            return reference of ValidationResult{
                field: "position",
                error_code: "INVALID_TYPE",
                message: "position must be [x, y]",
            }

        return empty
    else
        return reference of ValidationResult{
            field: "health_value",
            error_code: "INVALID_TYPE",
            message: "health_value must be an integer",
        }

func is_position_value(val: any) bool
    pos := empty list of int
    bytes := jsonpkg.Bytes(val) onerr return false
    jsonpkg.ParseBytesInto(bytes, reference of pos) onerr return false
    return len(pos) equals 2

func NormalizeActionData(data: map of string to any) map of string to any
    result := make(map of string to any)
    for key, val in data
        lower_key := strpkg.ToLower(key)
        if lower_key equals "type"
            if val is string as type_str
                result["type"] = strpkg.ToLower(type_str)
            else
                result["type"] = ""
        else if lower_key equals "target_id"
            result["defender_id"] = val
        else
            result[lower_key] = val
    return result
