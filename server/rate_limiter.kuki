petiole main

import "time"

const MAX_CONNECTIONS_PER_IP = 8

const MAX_ACTIONS_PER_SECOND = 5

const MAX_GAMES_CREATED_PER_HOUR = 10

const CONNECTION_WINDOW_SECONDS = 60

type TokenBucket
    capacity: int
    refill_rate: float64
    tokens: float64
    last_refill: float64

func NewTokenBucket(capacity: int, refill_rate: float64) TokenBucket
    now := time.Now().UnixNano() as float64 / 1e9
    return TokenBucket{
        capacity: capacity,
        refill_rate: refill_rate,
        tokens: capacity as float64,
        last_refill: now,
    }

func Consume on tb: reference TokenBucket(count: int) bool
    tb.refill()
    if tb.tokens < count as float64
        return false
    tb.tokens = tb.tokens - count as float64
    return true

func refill on tb: reference TokenBucket
    now := time.Now().UnixNano() as float64 / 1e9
    elapsed := now - tb.last_refill
    if elapsed > 0.0
        tb.tokens = tb.tokens + elapsed * tb.refill_rate
        if tb.tokens > tb.capacity as float64
            tb.tokens = tb.capacity as float64
        tb.last_refill = now

type TimedEvent
    timestamp: float64

type SlidingWindowCounter
    max_events: int
    window_seconds: int
    events: list of TimedEvent

func NewSlidingWindowCounter(max_events: int, window_seconds: int) SlidingWindowCounter
    return SlidingWindowCounter{
        max_events: max_events,
        window_seconds: window_seconds,
        events: empty list of TimedEvent,
    }

func TryEvent on sw: reference SlidingWindowCounter bool
    now := time.Now().UnixNano() as float64 / 1e9
    cutoff := now - sw.window_seconds as float64
    filtered := empty list of TimedEvent
    for evt in sw.events
        if evt.timestamp >= cutoff
            filtered = append(filtered, evt)
    sw.events = filtered
    if len(sw.events) >= sw.max_events
        return false
    sw.events = append(sw.events, TimedEvent{timestamp: now})
    return true

func GetCount on sw: reference SlidingWindowCounter int
    now := time.Now().UnixNano() as float64 / 1e9
    cutoff := now - sw.window_seconds as float64
    count := 0
    for evt in sw.events
        if evt.timestamp >= cutoff
            count = count + 1
    return count

type RateLimiter
    ip_connections: map of string to reference SlidingWindowCounter
    player_actions: map of string to reference TokenBucket
    player_game_creation: map of string to reference SlidingWindowCounter
    active_connections: map of string to int

func NewRateLimiter() RateLimiter
    return RateLimiter{
        ip_connections: make(map of string to reference SlidingWindowCounter),
        player_actions: make(map of string to reference TokenBucket),
        player_game_creation: make(map of string to reference SlidingWindowCounter),
        active_connections: make(map of string to int),
    }

func get_ip_counter on rl: reference RateLimiter(ip: string) reference SlidingWindowCounter
    counter, ok := rl.ip_connections[ip]
    if ok
        return counter
    new_counter := NewSlidingWindowCounter(MAX_CONNECTIONS_PER_IP, CONNECTION_WINDOW_SECONDS)
    rl.ip_connections[ip] = reference of new_counter
    return rl.ip_connections[ip]

func get_action_bucket on rl: reference RateLimiter(player_id: string) reference TokenBucket
    bucket, ok := rl.player_actions[player_id]
    if ok
        return bucket
    new_bucket := NewTokenBucket(10, MAX_ACTIONS_PER_SECOND as float64)
    rl.player_actions[player_id] = reference of new_bucket
    return rl.player_actions[player_id]

func get_game_creation_counter on rl: reference RateLimiter(player_id: string) reference SlidingWindowCounter
    counter, ok := rl.player_game_creation[player_id]
    if ok
        return counter
    new_counter := NewSlidingWindowCounter(MAX_GAMES_CREATED_PER_HOUR, 3600)
    rl.player_game_creation[player_id] = reference of new_counter
    return rl.player_game_creation[player_id]

func CheckConnection on rl: reference RateLimiter(ip_address: string) bool
    counter := rl.get_ip_counter(ip_address)
    if not counter.TryEvent()
        return false
    current := 0
    count, has := rl.active_connections[ip_address]
    if has
        current = count
    if current >= MAX_CONNECTIONS_PER_IP
        return false
    return true

func ReleaseConnection on rl: reference RateLimiter(ip_address: string)
    count, has := rl.active_connections[ip_address]
    if has and count > 0
        rl.active_connections[ip_address] = count - 1

func RecordConnection on rl: reference RateLimiter(ip_address: string)
    count, has := rl.active_connections[ip_address]
    if has
        rl.active_connections[ip_address] = count + 1
    else
        rl.active_connections[ip_address] = 1

func CheckAction on rl: reference RateLimiter(player_id: string) bool
    bucket := rl.get_action_bucket(player_id)
    if not bucket.Consume(1)
        return false
    return true

func CheckGameCreation on rl: reference RateLimiter(player_id: string) bool
    counter := rl.get_game_creation_counter(player_id)
    if not counter.TryEvent()
        return false
    return true

func CleanupPlayer on rl: reference RateLimiter(player_id: string)
    delete rl.player_actions[player_id]
    delete rl.player_game_creation[player_id]

func GetStats on rl: reference RateLimiter map of string to any
    return map of string to any{
        "active_ips": len(rl.ip_connections),
        "tracked_players": len(rl.player_actions),
    }
