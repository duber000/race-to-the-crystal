petiole main

import "race-to-the-crystal/game" as gamepkg
import "race-to-the-crystal/shared/types"
import "stdlib/json" as jsonpkg
import "stdlib/log"
import "stdlib/string" as strpkg
import "sync"

import "github.com/gorilla/websocket"

# The largest message the server will read from a client. A full state
# frame for a 18x18 board with 80 tokens is tens of kilobytes, so a
# kilobyte-sized cap would reject legitimate traffic.
const MAX_MESSAGE_SIZE = 262144

type WSClient
    clientId: string
    playerId: string
    playerName: string
    clientType: ClientType
    gameId: string
    connectedAt: float64
    ipAddress: string
    conn: optional reference websocket.Conn
    writeMu: sync.Mutex

func NewWSClient(clientId: string) WSClient
    return WSClient{
        clientId: clientId,
        playerId: "",
        playerName: "Unknown",
        clientType: ClientType.WEB_BROWSER,
        gameId: "",
        connectedAt: 0.0,
        ipAddress: "",
    }

# `reference WSClient`, not `WSClient`: the struct holds a sync.Mutex, and
# copying it would copy the lock.
func IsInGame on c: reference WSClient bool
    return c.gameId isnt empty

type WSMessage
    gameId: string
    data: JSONMap

func NewWSMessage(gameId: string, data: JSONMap) WSMessage
    return WSMessage{gameId: gameId, data: data}

type WebSocketHandler
    clients: map of string to reference WSClient
    gameSessions: map of string to string
    onConnect: optional reference func(string, string, string)
    onDisconnect: optional reference func(string)
    onMessage: optional reference func(string, string, JSONMap)

func NewWebSocketHandler() WebSocketHandler
    return WebSocketHandler{
        clients: empty map of string to reference WSClient,
        gameSessions: empty map of string to string,
    }

func SetOnConnect on wh: reference WebSocketHandler(handler: reference func(string, string, string))
    wh.onConnect = handler

func SetOnDisconnect on wh: reference WebSocketHandler(handler: reference func(string))
    wh.onDisconnect = handler

func SetOnMessage on wh: reference WebSocketHandler(handler: reference func(string, string, JSONMap))
    wh.onMessage = handler

func RegisterClient on wh: reference WebSocketHandler(client: reference WSClient)
    wh.clients[client.clientId] = client
    wh.gameSessions[client.clientId] = client.gameId
    if wh.onConnect isnt empty
        wh.onConnect(client.clientId, client.playerId, client.gameId)

func UnregisterClient on wh: reference WebSocketHandler(clientId: string)
    delete wh.clients[clientId]
    delete wh.gameSessions[clientId]
    if wh.onDisconnect isnt empty
        wh.onDisconnect(clientId)

func UpdateClientGameID on wh: reference WebSocketHandler(clientId: string, gameId: string)
    client, ok := wh.clients[clientId]
    if ok
        client.gameId = gameId
        wh.gameSessions[clientId] = gameId

func UpdateClientPlayerID on wh: reference WebSocketHandler(clientId: string, playerId: string, playerName: string)
    client, ok := wh.clients[clientId]
    if ok
        client.playerId = playerId
        client.playerName = playerName

func SendToClient on wh: reference WebSocketHandler(clientId: string, data: JSONMap) bool
    client, ok := wh.clients[clientId]
    if not ok
        return false
    if client.conn is empty
        return false
    jsonBytes := jsonpkg.Bytes(data) onerr return false
    client.writeMu.Lock()
    defer client.writeMu.Unlock()
    var err: error = client.conn.WriteMessage(websocket.TextMessage, jsonBytes)
    if err isnt empty
        log.Debug("WebSocket send to {clientId} failed: {err}")
        return false
    return true

func BroadcastToGame on wh: reference WebSocketHandler(gameId: string, data: JSONMap)
    jsonBytes := jsonpkg.Bytes(data) onerr return
    log.Debug("Broadcasting to game {gameId}: {jsonBytes as string}")
    for _client_id, client in wh.clients
        if client.gameId equals gameId and client.conn isnt empty
            client.writeMu.Lock()
            var err: error = client.conn.WriteMessage(websocket.TextMessage, jsonBytes)
            client.writeMu.Unlock()
            if err isnt empty
                log.Debug("WebSocket broadcast failed: {err}")

func ProcessMessage on wh: reference WebSocketHandler(clientId: string, rawData: string) JSONMap
    data := empty JSONMap
    jsonpkg.ParseInto(rawData, reference of data) onerr return data

    msgTypeVal, has := data["type"]
    if not has
        return data
    msgType := ""
    if msgTypeVal is string as s
        msgType = s
    msgType = strpkg.ToLower(msgType)
    data["type"] = msgType
    data["player_id"] = clientId

    normalized := NormalizeActionData(data)
    return normalized

func GetClientCount on wh: reference WebSocketHandler int
    return len(wh.clients)

func GetClientsInGame on wh: reference WebSocketHandler(gameId: string) list of string
    result := empty list of string
    for _client_id, client in wh.clients
        if client.gameId equals gameId and client.playerId isnt empty
            result = append(result, client.playerId)
    return result

func GetClientByID on wh: reference WebSocketHandler(clientId: string) optional reference WSClient
    client, ok := wh.clients[clientId]
    if ok
        return client
    return empty

# Broadcast the per-player full state to everyone in the session.
#
# The state is fogged: each player receives only what their own tokens can
# see. Both the WebSocket and the HTTP action paths use this, so a client
# sees the same state shape whichever transport submitted the action.
func BroadcastSessionState on wh: reference WebSocketHandler(session: reference GameSession)
    for nid, gamePid in session.networkToGameId
        state := session.gameState.VisibleStateDict(types.PlayerID(gamePid))
        wh.SendToClient(nid, JSONMap{
            "type": "FULL_STATE",
            "game_id": session.gameId,
            "game_state": state,
            "event_seq": session.playerEventSeqs[nid],
        })
        # This player's own event counter, so a resync repairs it.

    # Spectators (read-only) receive the unfiltered state.
    for specId, _ in session.spectators
        if _, ok := session.playerEventSeqs[specId]; not ok
            session.playerEventSeqs[specId] = 0
        wh.SendToClient(specId, JSONMap{
            "type": "FULL_STATE",
            "game_id": session.gameId,
            "game_state": session.gameState.ClientStateDict(""),
            "event_seq": session.playerEventSeqs[specId],
        })

# Broadcast event frames to the players in the session.
#
# Each frame carries a sequence number, so a client can detect a gap in the
# stream and resynchronise. The counter is *per player*: the fog hides some
# events from some players, and a shared counter would show them a gap for
# every hidden event.
func BroadcastSessionEvents on wh: reference WebSocketHandler(session: reference GameSession, events: list of gamepkg.GameEvent)
    if events is empty
        return
    for e in events
        session.eventSeq = session.eventSeq + 1
        for nid, gamePid in session.networkToGameId
            viewer := types.PlayerID(gamePid)
            visible := session.gameState.FilterEventForViewer(e, viewer)
            if visible is empty
                continue
            seq := session.playerEventSeqs[nid] + 1
            session.playerEventSeqs[nid] = seq
            wh.SendToClient(nid, JSONMap{
                "type": "EVENT",
                "game_id": session.gameId,
                "seq": seq,
                "event": gamepkg.EventToDict(visible[0]),
            })

        # Spectators receive every event unfiltered.
        for specId, _ in session.spectators
            if _, ok := session.playerEventSeqs[specId]; not ok
                session.playerEventSeqs[specId] = 0
            seq := session.playerEventSeqs[specId] + 1
            session.playerEventSeqs[specId] = seq
            wh.SendToClient(specId, JSONMap{
                "type": "EVENT",
                "game_id": session.gameId,
                "seq": seq,
                "event": gamepkg.EventToDict(e),
            })
