petiole main

import "net/http"
import "race-to-the-crystal/game" as gamepkg
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types"
import "stdlib/http" as httphelper
import "stdlib/json" as jsonpkg
import "stdlib/log"
import "stdlib/random"
import "stdlib/string" as strpkg
import "strings"
import "time"

import "github.com/gorilla/websocket"

var wsUpgrader = websocket.Upgrader{
    ReadBufferSize: 8192,
    WriteBufferSize: 8192,
    CheckOrigin: checkWsOrigin,
}

# Origins allowed to open a WebSocket. Empty means "any origin", which is
# the default for a local server; set WS_ALLOWED_ORIGINS in a deployment to
# lock it down.
var allowedWsOrigins: list of string = empty list of string

# Restrict the WebSocket to a set of origins. An empty list allows any.
func setAllowedWsOrigins(origins: string)
    allowedWsOrigins = empty list of string
    if origins is empty
        return
    for part in strings.Split(origins, ",")
        trimmed := strings.TrimSpace(part)
        if trimmed isnt empty
            allowedWsOrigins = append(allowedWsOrigins, trimmed)

func checkWsOrigin(r: reference http.Request) bool
    origin := r.Header.Get("Origin")

    # A request with no Origin is not a browser — the AI client, curl and
    # the Go tests all connect without one.
    if origin is empty
        return true

    if allowedWsOrigins is empty
        return true

    for allowed in allowedWsOrigins
        if origin equals allowed
            return true

    log.Warn("Rejected WebSocket connection from origin {origin}")
    return false

type WebSocketEndpoint
    coordinator: reference GameCoordinator
    lobbyMgr: reference LobbyManager
    wsHandler: reference WebSocketHandler
    mercure: reference MercurePublisher
    httpHandler: reference HTTPHandler

func NewWebSocketEndpoint(coordinator: reference GameCoordinator, lobbyMgr: reference LobbyManager, wsHandler: reference WebSocketHandler, mercure: reference MercurePublisher, httpHandler: reference HTTPHandler) WebSocketEndpoint
    return WebSocketEndpoint{
        coordinator: coordinator,
        lobbyMgr: lobbyMgr,
        wsHandler: wsHandler,
        mercure: mercure,
        httpHandler: httpHandler,
    }

# Start the watchdog that passes on stalled turns.
#
# Without it, a player who stops acting — a disconnected human, or an agent
# that never replies — blocks the whole match for everyone else.
func startTurnWatchdog on ep: reference WebSocketEndpoint
    go
        for true
            time.Sleep(time.Second)
            ep.checkTurnTimeouts()

# Pass on any turn that has run out of time.
func checkTurnTimeouts on ep: reference WebSocketEndpoint
    now := time.Now().UnixNano() as float64 / 1e9
    for _gameId, session in ep.coordinator.activeGames
        if session.gameState.Phase() isnt enums.PLAYING
            continue
        # turnSecondsRemaining returns 0 only when the time is up, and -1
        # when the turn is not being timed at all.
        if session.turnSecondsRemaining(now) isnt 0
            continue
        ep.timeOutTurn(session)

# Pass on a turn that ran out of time.
func timeOutTurn on ep: reference WebSocketEndpoint(session: reference GameSession)
    # The same lock the action path takes: a timed-out turn and a player's
    # action must not interleave on the shared game state.
    session.actionMu.Lock()
    defer session.actionMu.Unlock()

    # Re-check under the lock: the player may have acted while we waited
    # for it.
    now := time.Now().UnixNano() as float64 / 1e9
    if session.turnSecondsRemaining(now) isnt 0
        return

    networkPlayerId := session.turnNetworkPlayerId
    if networkPlayerId is empty
        return
    api, hasApi := session.apiMap[networkPlayerId]
    if not hasApi
        return

    gamePid := session.networkToGameId[networkPlayerId]
    playerName := "Unknown"
    pRef := session.gameState.GetPlayer(types.PlayerID(gamePid))
    if pRef isnt empty
        playerName = pRef.Name()

    log.Info(
        "Turn timed out for {playerName} ({gamePid}) after {session.currentTurnTimeoutSeconds}s",
    )

    result := api.EndTurn()
    if not result.Success
        return

    timeoutEvent := gamepkg.TurnTimedOut{
        PlayerID: types.PlayerID(gamePid),
        PlayerName: playerName,
        TimeoutSeconds: session.currentTurnTimeoutSeconds,
    }
    events := session.recordEvents(result.Data, list of gamepkg.GameEvent{timeoutEvent})
    ep.wsHandler.BroadcastSessionEvents(session, events)
    ep.wsHandler.BroadcastSessionState(session)

    # The turn passed to the next player; start their clock.
    currentNetwork := session.getCurrentNetworkPlayerId()
    if currentNetwork isnt empty
        session.beginTurn(currentNetwork)

    if session.isGameOver()
        ep.broadcastGameWon(session)
        ep.lobbyMgr.finishGame(session.gameId)

func HandleWebSocket on ep: reference WebSocketEndpoint(response: httphelper.Response, request: httphelper.Request)
    conn, err := wsUpgrader.Upgrade(response.Raw(), request.Raw(), empty)
    if err isnt empty
        log.Warn("WebSocket upgrade failed: {err}")
        return
    # Enforce a cap on the messages a client may send. Without it a client
    # could stream an arbitrarily large frame at the server.
    conn.SetReadLimit(MAX_MESSAGE_SIZE)
    clientId := random.String(16)
    client := NewWSClient(clientId)
    client.conn = conn
    ep.wsHandler.RegisterClient(reference of client)
    log.Info("WebSocket client connected: {clientId}")
    defer conn.Close()
    for true
        _msg_type, raw, rerr := conn.ReadMessage()
        if rerr isnt empty
            break
        ep.handleClientMessage(clientId, raw as string)
    ep.handleClientDisconnect(clientId)

func handleClientMessage on ep: reference WebSocketEndpoint(clientId: string, rawData: string)
    data := make(JSONMap)
    jsonpkg.ParseInto(rawData, reference of data) onerr
        ep.sendError(clientId, "Invalid JSON format")
        return

    msgTypeVal, has := data["type"]
    if not has
        return
    msgType := ""
    if msgTypeVal is string as s
        msgType = s
    msgType = strpkg.ToLower(msgType)
    switch msgType
        when "connect"
            ep.handleConnect(clientId, data)
        when "list_games"
            ep.handleListGames(clientId)
        when "create_game"
            ep.handleCreateGame(clientId, data)
        when "join_game"
            ep.handleJoinGame(clientId, data)
        when "leave_game"
            ep.handleLeaveGame(clientId, data)
        when "ready"
            ep.handleReady(clientId, data)
        when "start_game"
            ep.handleStartGame(clientId, data)
        when "move", "attack", "deploy", "end_turn"
            ep.handleGameAction(clientId, msgType, data)
        when "sse_fallback_request", "resync_state"
            ep.handleStateRequest(clientId)
        when "spectate"
            ep.handleSpectate(clientId, data)
        when "disconnect"
            ep.handleClientDisconnect(clientId)
        default
            ep.sendError(clientId, "Unknown message type: {msgType}")

func handleConnect on ep: reference WebSocketEndpoint(clientId: string, data: JSONMap)
    client := ep.wsHandler.GetClientByID(clientId)
    if client is empty
        return
    playerName := "Player"
    pnVal, hasPn := data["player_name"]
    if hasPn
        if pnVal is string as pn
            if pn isnt empty
                playerName = pn
    client.playerId = clientId
    client.playerName = playerName
    client.clientType = ClientType.WEB_BROWSER
    ep.wsHandler.SendToClient(clientId, JSONMap{
        "type": "CONNECT_ACK",
        "player_id": clientId,
        "player_name": playerName,
        "client_type": "WEB_BROWSER",
        "server_version": "1.0.0",
    })
    log.Info("WebSocket player connected: {playerName} ({clientId})")

func handleListGames on ep: reference WebSocketEndpoint(clientId: string)
    games := ep.lobbyMgr.listAvailableLobbies()
    ep.wsHandler.SendToClient(clientId, JSONMap{
        "type": "GAME_LIST",
        "games": games,
    })

func handleCreateGame on ep: reference WebSocketEndpoint(clientId: string, data: JSONMap)
    client := ep.wsHandler.GetClientByID(clientId)
    if client is empty
        ep.sendError(clientId, "Not connected")
        return
    if client.playerId is empty
        ep.sendError(clientId, "Not connected")
        return
    gameName := "Game"
    gnVal, hasGn := data["game_name"]
    if hasGn
        if gnVal is string as gn
            if gn isnt empty
                gameName = gn
    maxPlayers := 4
    mpVal, hasMp := data["max_players"]
    if hasMp
        if mpVal is int as mpParsed
            maxPlayers = mpParsed
    if maxPlayers < 2
        maxPlayers = 2
    if maxPlayers > 4
        maxPlayers = 4
    lobby := ep.lobbyMgr.createLobby(
        client.playerId,
        client.playerName,
        gameName,
        ClientType.WEB_BROWSER,
        maxPlayers,
    )
    if lobby is empty
        ep.sendError(clientId, "Failed to create game")
        return
    client.gameId = lobby.gameId
    ep.wsHandler.UpdateClientGameID(clientId, client.gameId)
    ep.wsHandler.SendToClient(clientId, JSONMap{
        "type": "CREATE_GAME",
        "game_id": lobby.gameId,
        "game_name": lobby.gameName,
        "host_player_id": lobby.hostPlayerId,
        "max_players": lobby.maxPlayers,
        "current_players": len(lobby.players),
        "status": lobby.status.String(),
        "players": lobby.getPlayerList(),
    })

func handleJoinGame on ep: reference WebSocketEndpoint(clientId: string, data: JSONMap)
    client := ep.wsHandler.GetClientByID(clientId)
    if client is empty
        ep.sendError(clientId, "Not connected")
        return
    if client.playerId is empty
        ep.sendError(clientId, "Not connected")
        return
    gameId := ""
    gidVal, hasGid := data["game_id"]
    if hasGid
        if gidVal is string as gid
            gameId = gid
    if gameId is empty
        ep.sendError(clientId, "No game_id provided")
        return
    lobby := ep.lobbyMgr.joinLobby(gameId, client.playerId, client.playerName, ClientType.WEB_BROWSER)
    if lobby is empty
        ep.sendError(clientId, "Cannot join game")
        return
    client.gameId = gameId
    ep.wsHandler.UpdateClientGameID(clientId, gameId)
    ep.wsHandler.SendToClient(clientId, JSONMap{
        "type": "JOIN_GAME",
        "game_id": lobby.gameId,
        "game_name": lobby.gameName,
        "host_player_id": lobby.hostPlayerId,
        "max_players": lobby.maxPlayers,
        "current_players": len(lobby.players),
        "status": lobby.status.String(),
        "players": lobby.getPlayerList(),
    })
    ep.wsHandler.BroadcastToGame(gameId, JSONMap{
        "type": "PLAYER_JOINED",
        "game_id": gameId,
        "player_id": client.playerId,
        "player_name": client.playerName,
        "lobby": lobby.toDict(),
    })

func handleLeaveGame on ep: reference WebSocketEndpoint(clientId: string, data: JSONMap)
    client := ep.wsHandler.GetClientByID(clientId)
    if client is empty
        return
    if client.gameId is empty
        return
    gameId := client.gameId
    playerId := client.playerId
    ep.lobbyMgr.leaveLobby(gameId, playerId)
    client.gameId = ""
    ep.wsHandler.UpdateClientGameID(clientId, "")
    ep.wsHandler.SendToClient(clientId, JSONMap{"type": "LEAVE_GAME", "game_id": gameId})
    lobby := ep.lobbyMgr.getLobby(gameId)
    if lobby isnt empty
        ep.wsHandler.BroadcastToGame(gameId, JSONMap{
            "type": "PLAYER_LEFT",
            "game_id": gameId,
            "player_id": playerId,
            "lobby": lobby.toDict(),
        })

func handleReady on ep: reference WebSocketEndpoint(clientId: string, data: JSONMap)
    client := ep.wsHandler.GetClientByID(clientId)
    if client is empty
        ep.sendError(clientId, "Not in a game")
        return
    if client.gameId is empty
        ep.sendError(clientId, "Not in a game")
        return
    ready := true
    rdyVal, hasRdy := data["ready"]
    if hasRdy
        if rdyVal is bool as rdy
            ready = rdy
    ep.lobbyMgr.setReady(client.gameId, client.playerId, ready)
    lobby := ep.lobbyMgr.getLobby(client.gameId)
    if lobby isnt empty
        ep.wsHandler.BroadcastToGame(client.gameId, JSONMap{
            "type": "READY",
            "game_id": client.gameId,
            "player_id": client.playerId,
            "ready": ready,
            "lobby": lobby.toDict(),
        })

func handleStartGame on ep: reference WebSocketEndpoint(clientId: string, data: JSONMap)
    client := ep.wsHandler.GetClientByID(clientId)
    if client is empty
        ep.sendError(clientId, "Not connected")
        return
    if client.playerId is empty
        ep.sendError(clientId, "Not connected")
        return
    lobby := ep.lobbyMgr.getPlayerLobby(client.playerId)
    if lobby is empty
        ep.sendError(clientId, "Not in a lobby")
        return
    if lobby.hostPlayerId isnt client.playerId
        ep.sendError(clientId, "Only the host can start the game")
        return
    startResult := ep.lobbyMgr.startGame(lobby.gameId)
    if startResult is empty
        ep.sendError(clientId, "Cannot start game")
        return
    session := ep.coordinator.createSession(lobby)
    ep.lobbyMgr.setGameInProgress(lobby.gameId)
    # Announce the first turn, so clients know the turn clock and timeout
    # before the first action.
    ep.wsHandler.BroadcastSessionEvents(session, session.recordStartEvents())
    ep.broadcastState(session)
    ep.wsHandler.BroadcastToGame(lobby.gameId, JSONMap{
        "type": "START_GAME",
        "game_id": lobby.gameId,
    })

func handleGameAction on ep: reference WebSocketEndpoint(clientId: string, msgType: string, data: JSONMap)
    client := ep.wsHandler.GetClientByID(clientId)
    if client is empty
        ep.sendError(clientId, "Not connected")
        return
    if client.playerId is empty
        ep.sendError(clientId, "Not connected")
        return
    session := ep.coordinator.getPlayerSession(client.playerId)
    if session is empty
        ep.sendError(clientId, "Not in a game")
        return

    # The WebSocket path was unlimited while the HTTP path was rate
    # limited, so a client could flood the server with actions.
    actionAllowed := ep.httpHandler.rateLimiter.CheckAction(client.playerId)
    if not actionAllowed
        ep.sendInvalidAction(clientId, msgType, "rate limit exceeded")
        return

    actionType := gamepkg.ParseActionType(strpkg.ToUpper(msgType)) onerr
        ep.sendInvalidAction(clientId, msgType, "unknown action type")
        return

    normalized := NormalizeActionData(data)
    validationErr := ValidateActionFields(actionType, normalized)
    if validationErr isnt empty
        ep.sendInvalidAction(clientId, msgType, "validation failed: {validationErr.message}")
        return
    action := ep.httpHandler.buildGameAction(client.playerId, actionType, normalized)
    success, message, _result_data, events := session.executeGameAction(client.playerId, action)
    if not success
        ep.sendInvalidAction(clientId, msgType, message)
        return
    ep.broadcastEvents(session, events)
    ep.broadcastState(session)
    if session.isGameOver()
        ep.broadcastGameWon(session)
        ep.lobbyMgr.finishGame(session.gameId)

func handleSpectate on ep: reference WebSocketEndpoint(clientId: string, data: JSONMap)
    client := ep.wsHandler.GetClientByID(clientId)
    if client is empty
        return
    gameId := ""
    gv, has := data["game_id"]
    if has
        if gv is string as gs
            gameId = gs
    if gameId is empty
        ep.sendError(clientId, "missing game_id")
        return
    session := ep.coordinator.getSession(gameId)
    if session is empty
        ep.sendError(clientId, "game session not found")
        return
    client.gameId = gameId
    ep.wsHandler.UpdateClientGameID(clientId, gameId)
    if _, ok := session.spectators[clientId]; !ok
        session.spectators[clientId] = true
    if _, ok := session.playerEventSeqs[clientId]; !ok
        session.playerEventSeqs[clientId] = 0
    ep.wsHandler.SendToClient(clientId, JSONMap{
        "type": "SPECTATE_ACK",
        "game_id": gameId,
    })
    # Push a fresh state to the spectator.
    ep.wsHandler.BroadcastSessionState(session)

func handleStateRequest on ep: reference WebSocketEndpoint(clientId: string)
    client := ep.wsHandler.GetClientByID(clientId)
    if client is empty
        return
    if client.gameId is empty
        return
    session := ep.coordinator.getSession(client.gameId)
    if session is empty
        return
    gamePid := ""
    gpVal, hasGp := session.networkToGameId[client.playerId]
    if hasGp
        gamePid = gpVal
    state := session.gameState.VisibleStateDict(types.PlayerID(gamePid))
    ep.wsHandler.SendToClient(clientId, JSONMap{
        "type": "FULL_STATE",
        "game_id": session.gameId,
        "game_state": state,
        "event_seq": session.playerEventSeqs[client.playerId],
    })
    # This client's own event counter, so the resync also repairs it.

func handleClientDisconnect on ep: reference WebSocketEndpoint(clientId: string)
    client := ep.wsHandler.GetClientByID(clientId)
    if client is empty
        return
    gameId := client.gameId
    playerId := client.playerId
    playerName := client.playerName
    ep.lobbyMgr.removePlayerFromAll(playerId)
    ep.coordinator.removePlayer(playerId)
    ep.wsHandler.UnregisterClient(clientId)
    if gameId isnt empty
        lobby := ep.lobbyMgr.getLobby(gameId)
        if lobby isnt empty
            ep.wsHandler.BroadcastToGame(gameId, JSONMap{
                "type": "PLAYER_DISCONNECTED",
                "game_id": gameId,
                "player_id": playerId,
                "player_name": playerName,
                "lobby": lobby.toDict(),
            })
    log.Info("WebSocket client disconnected: {clientId}")

func sendError on ep: reference WebSocketEndpoint(clientId: string, message: string)
    ep.wsHandler.SendToClient(clientId, JSONMap{"type": "ERROR", "error": message})

func sendInvalidAction on ep: reference WebSocketEndpoint(clientId: string, actionType: string, reason: string)
    ep.wsHandler.SendToClient(clientId, JSONMap{
        "type": "INVALID_ACTION",
        "action_type": actionType,
        "reason": reason,
    })

# Broadcast event frames to the players in the session.
func broadcastEvents on ep: reference WebSocketEndpoint(session: reference GameSession, events: list of gamepkg.GameEvent)
    ep.wsHandler.BroadcastSessionEvents(session, events)

func broadcastState on ep: reference WebSocketEndpoint(session: reference GameSession)
    ep.wsHandler.BroadcastSessionState(session)

func broadcastGameWon on ep: reference WebSocketEndpoint(session: reference GameSession)
    winnerNetworkId := session.getWinnerNetworkId()
    winnerName := "Unknown"
    wid := session.gameState.WinnerID()
    if wid isnt empty
        player := session.gameState.GetPlayer(wid)
        if player isnt empty
            winnerName = player.Name()
    ep.wsHandler.BroadcastToGame(session.gameId, JSONMap{
        "type": "GAME_WON",
        "game_id": session.gameId,
        "winner_id": winnerNetworkId,
        "winner_name": winnerName,
    })
