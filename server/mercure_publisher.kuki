petiole main

import "time"

import "github.com/kukichalang/kukicha/stdlib/crypto"
import "github.com/kukichalang/kukicha/stdlib/encoding" as encpkg
import "github.com/kukichalang/kukicha/stdlib/env"
import "github.com/kukichalang/kukicha/stdlib/fetch"
import "github.com/kukichalang/kukicha/stdlib/json" as jsonpkg
import "github.com/kukichalang/kukicha/stdlib/log"

type MercureConfig
    hub_url string
    publisher_jwt string
    topic_prefix string

func MercureConfigFromEnv() MercureConfig
    return MercureConfig{
        hub_url: env.GetOr("MERCURE_HUB_URL", "http://localhost:3000/.well-known/mercure"),
        publisher_jwt: env.GetOr("MERCURE_PUBLISHER_JWT", ""),
        topic_prefix: env.GetOr("MERCURE_TOPIC_PREFIX", "https://api.game.com/game"),
    }

type MercurePublisher
    config MercureConfig
    enabled bool

func NewMercurePublisher(config: MercureConfig) MercurePublisher
    return MercurePublisher{
        config: config,
        enabled: config.publisher_jwt != "",
    }

func Enabled on mp: MercurePublisher bool
    return mp.enabled

func PublishFullState on mp: reference MercurePublisher(game_id: string, state_dict: map of string to any, private: bool)
    if not mp.enabled
        return
    data := map of string to any{
        "type": "FULL_STATE",
        "game_id": game_id,
        "state": state_dict,
    }
    mp.publishInternal(game_id, data, private)

func PublishStateUpdate on mp: reference MercurePublisher(game_id: string, delta: map of string to any, private: bool)
    if not mp.enabled
        return
    data := map of string to any{
        "type": "STATE_UPDATE",
        "game_id": game_id,
        "delta": delta,
    }
    mp.publishInternal(game_id, data, private)

func PublishTurnChange on mp: reference MercurePublisher(game_id: string, current_player_id: string, turn_number: int, turn_phase: string)
    if not mp.enabled
        return
    data := map of string to any{
        "type": "TURN_CHANGE",
        "game_id": game_id,
        "current_player_id": current_player_id,
        "turn_number": turn_number,
        "turn_phase": turn_phase,
    }
    mp.publishInternal(game_id, data, false)

func PublishGameWon on mp: reference MercurePublisher(game_id: string, winner_id: string)
    if not mp.enabled
        return
    data := map of string to any{
        "type": "GAME_WON",
        "game_id": game_id,
        "winner_id": winner_id,
    }
    mp.publishInternal(game_id, data, false)

func publishInternal on mp: reference MercurePublisher(game_id: string, data: map of string to any, private: bool)
    topic := "{mp.config.topic_prefix}/{game_id}"
    json_bytes := jsonpkg.Bytes(data) onerr return
    encoded_data := encpkg.Base64URLEncode(json_bytes)

    form_body := "topic={topic}&data={encoded_data}"
    if private
        form_body = form_body + "&private=on"

    req := fetch.New(mp.config.hub_url)
    req = fetch.Method(req, "POST")
    req = fetch.Header(req, "Authorization", "Bearer {mp.config.publisher_jwt}")
    req = fetch.Header(req, "Content-Type", "application/x-www-form-urlencoded")
    req = fetch.Body(req, form_body)
    _ = fetch.Do(req) onerr
        log.Error("Failed to publish to Mercure: {error}")

func GeneratePublisherJWT on mp: reference MercurePublisher string
    now := time.Now().Unix()
    header_json := map of string to string{"alg": "HS256", "typ": "JWT"}
    header_bytes := jsonpkg.Bytes(header_json) onerr return ""
    payload_data := map of string to any{
        "mercure": map of string to any{"publish": list of string{"*"}},
        "iat": now,
        "exp": now + 3600,
    }
    payload_bytes := jsonpkg.Bytes(payload_data) onerr return ""

    header_b64 := encpkg.Base64URLEncode(header_bytes)
    payload_b64 := encpkg.Base64URLEncode(payload_bytes)
    signing_input := "{header_b64}.{payload_b64}"
    sig := crypto.HMAC(mp.config.publisher_jwt, signing_input)
    sig_b64 := encpkg.Base64URLEncode(sig as list of byte)
    return "{header_b64}.{payload_b64}.{sig_b64}"
