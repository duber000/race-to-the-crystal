petiole main

import "stdlib/crypto"
import "stdlib/encoding" as encpkg
import "stdlib/env"
import "stdlib/fetch"
import "stdlib/json" as jsonpkg
import "stdlib/log"
import "time"

type MercureConfig
    hubUrl: string
    publisherJwt: string
    topicPrefix: string

func MercureConfigFromEnv() MercureConfig
    return MercureConfig{
        hubUrl: env.GetOr("MERCURE_HUB_URL", "http://localhost:3000/.well-known/mercure"),
        publisherJwt: env.GetOr("MERCURE_PUBLISHER_JWT", ""),
        topicPrefix: env.GetOr("MERCURE_TOPIC_PREFIX", "https://api.game.com/game"),
    }

type MercurePublisher
    config: MercureConfig
    enabled: bool

func NewMercurePublisher(config: MercureConfig) MercurePublisher
    return MercurePublisher{
        config: config,
        enabled: config.publisherJwt isnt "",
    }

func Enabled on mp: MercurePublisher bool
    return mp.enabled

func PublishFullState on mp: reference MercurePublisher(gameId: string, stateDict: map of string to any, private: bool)
    if not mp.enabled
        return
    data := map of string to any{
        "type": "FULL_STATE",
        "game_id": gameId,
        "state": stateDict,
    }
    mp.publishInternal(gameId, data, private)

func PublishStateUpdate on mp: reference MercurePublisher(gameId: string, delta: map of string to any, private: bool)
    if not mp.enabled
        return
    data := map of string to any{
        "type": "STATE_UPDATE",
        "game_id": gameId,
        "delta": delta,
    }
    mp.publishInternal(gameId, data, private)

func PublishTurnChange on mp: reference MercurePublisher(gameId: string, currentPlayerId: string, turnNumber: int, turnPhase: string)
    if not mp.enabled
        return
    data := map of string to any{
        "type": "TURN_CHANGE",
        "game_id": gameId,
        "current_player_id": currentPlayerId,
        "turn_number": turnNumber,
        "turn_phase": turnPhase,
    }
    mp.publishInternal(gameId, data, false)

func PublishGameWon on mp: reference MercurePublisher(gameId: string, winnerId: string)
    if not mp.enabled
        return
    data := map of string to any{
        "type": "GAME_WON",
        "game_id": gameId,
        "winner_id": winnerId,
    }
    mp.publishInternal(gameId, data, false)

func publishInternal on mp: reference MercurePublisher(gameId: string, data: map of string to any, private: bool)
    topic := "{mp.config.topicPrefix}/{gameId}"
    jsonBytes := jsonpkg.Bytes(data) onerr return
    encodedData := encpkg.Base64URLEncode(jsonBytes)

    formBody := "topic={topic}&data={encodedData}"
    if private
        formBody = formBody + "&private=on"

    req := fetch.New(mp.config.hubUrl)
    req = fetch.Method(req, "POST")
    req = fetch.Header(req, "Authorization", "Bearer {mp.config.publisherJwt}")
    req = fetch.Header(req, "Content-Type", "application/x-www-form-urlencoded")
    req = fetch.Body(req, formBody)
    fetch.Do(req) onerr
        log.Warn("Mercure publish failed for game {gameId}: {error}")

func GeneratePublisherJWT on mp: reference MercurePublisher string
    now := time.Now().Unix()
    headerJson := map of string to string{"alg": "HS256", "typ": "JWT"}
    headerBytes := jsonpkg.Bytes(headerJson) onerr return ""
    payloadData := map of string to any{
        "mercure": map of string to any{"publish": list of string{"*"}},
        "iat": now,
        "exp": now + 3600,
    }
    payloadBytes := jsonpkg.Bytes(payloadData) onerr return ""

    # JWS for the mercure hub requires UNPadded base64url.
    headerB64 := encpkg.Base64URLNoPadEncode(headerBytes)
    payloadB64 := encpkg.Base64URLNoPadEncode(payloadBytes)
    signingInput := "{headerB64}.{payloadB64}"
    sig := crypto.HMAC(mp.config.publisherJwt, signingInput)
    sigB64 := encpkg.Base64URLNoPadEncode(sig as list of byte)
    return "{headerB64}.{payloadB64}.{sigB64}"
