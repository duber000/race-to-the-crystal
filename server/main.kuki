petiole main

import "net/http"
import "os"
import "path/filepath"
import "stdlib/env"
import "stdlib/http" as httphelper
import "stdlib/log"
import "stdlib/signal"
import "strings"

type ServerConfig
    http_port: int
    static_dir: string
    jwt_secret: string
    debug: bool

func ServerConfigFromEnv() ServerConfig
    return ServerConfig{
        http_port: env.GetIntOr("HTTP_PORT", 8080),
        static_dir: env.GetOr("STATIC_DIR", ""),
        jwt_secret: env.GetOr("JWT_SECRET_KEY", ""),
        debug: env.GetBoolOr("DEBUG", false),
    }

type GameServer
    config: ServerConfig
    coordinator: GameCoordinator
    lobby_mgr: LobbyManager
    ws_handler: WebSocketHandler
    mercure: MercurePublisher
    http_handler: HTTPHandler
    ws_endpoint: WebSocketEndpoint

func NewGameServer(config: ServerConfig) (GameServer, error)
    mercure_cfg := MercureConfigFromEnv()
    if config.jwt_secret equals ""
        sk, err := GenerateSecretKey()
        if err isnt empty
            return GameServer{}, error "failed to generate secret key: {err}"
        config.jwt_secret = sk

    gs := GameServer{
        config: config,
        lobby_mgr: NewLobbyManager(),
        ws_handler: NewWebSocketHandler(),
        mercure: NewMercurePublisher(mercure_cfg),
    }
    gs.coordinator = NewGameCoordinator()
    gs.http_handler = NewHTTPHandler(
        reference of gs.coordinator,
        reference of gs.lobby_mgr,
        reference of gs.ws_handler,
        mercure_cfg,
        config.jwt_secret,
        config.static_dir,
    )
    return gs, empty

func Start on gs: reference GameServer
    gs.ws_endpoint = NewWebSocketEndpoint(
        reference of gs.coordinator,
        reference of gs.lobby_mgr,
        reference of gs.ws_handler,
        reference of gs.mercure,
        reference of gs.http_handler,
    )
    mux := http.NewServeMux()
    gs.registerRoutes(mux)

    addr := ":{gs.config.http_port}"
    log.Info("Starting HTTP server on {addr}")

    go
        err := http.ListenAndServe(addr, mux)
        if err isnt empty
            log.Error("HTTP server error: {err}")

    log.Info("Server started. Press Ctrl+C to stop.")

    ch := make(channel of bool)
    signal.OnInterrupt(() =>
        log.Info("Shutting down server...")
        send true to ch
    )

    receive from ch

func registerRoutes on gs: reference GameServer(mux: reference http.ServeMux)
    mux.Handle("/ws", httphelper.Handler(gs.handleWebSocketRoute))
    mux.Handle("/", httphelper.Handler(gs.handleHTTP))
    mux.Handle("/api/game/create", httphelper.Handler(gs.handleCreateGameRoute))
    mux.Handle("/api/game/\{game_id\}/join", httphelper.Handler(gs.handleJoinGameRoute))
    mux.Handle("/api/game/\{game_id\}/action", httphelper.Handler(gs.handleActionRoute))
    mux.Handle("/api/game/\{game_id\}/state", httphelper.Handler(gs.handleGetStateRoute))
    mux.Handle("/api/game/\{game_id\}/actions", httphelper.Handler(gs.handleGetActionsRoute))
    mux.Handle("/api/game/\{game_id\}/leave", httphelper.Handler(gs.handleLeaveGameRoute))
    mux.Handle("/api/game/\{game_id\}/ready", httphelper.Handler(gs.handleReadyRoute))
    mux.Handle("/api/game/\{game_id\}/start", httphelper.Handler(gs.handleStartGameRoute))
    mux.Handle("/api/games", httphelper.Handler(gs.handleListGamesRoute))

func handleWebSocketRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    gs.ws_endpoint.HandleWebSocket(response, request)

func handleHTTP on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if gs.config.static_dir equals ""
        response.JSONNotFound("no static files configured") onerr discard
        return

    path := request.URL().Path
    if path equals "/"
        path = "/index.html"

    file_path := filepath.Join(gs.config.static_dir, path)
    file_path = filepath.Clean(file_path)

    prefix := filepath.Clean(gs.config.static_dir)
    if not strings.HasPrefix(file_path, prefix)
        response.JSONNotFound("not found") onerr discard
        return

    response.ServeFile(request, file_path)

func handleCreateGameRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsPost()
        response.MethodNotAllowed("POST")
        return

    ip := gs.http_handler.GetClientIP(
        request.RemoteAddr(),
        request.GetHeader("X-Forwarded-For"),
        request.GetHeader("X-Real-IP"),
    )
    auth_header := request.GetHeader("Authorization")

    body := make(map of string to any)
    request.ReadJSON(reference of body) onerr
        response.JSONBadRequest("invalid JSON body")
        return

    result := gs.http_handler.HandleCreateGame(auth_header, body, ip)
    gs.writeAPIResponse(response, result)

func handleJoinGameRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsPost()
        response.MethodNotAllowed("POST")
        return

    game_id := request.PathValue("game_id")
    ip := gs.http_handler.GetClientIP(
        request.RemoteAddr(),
        request.GetHeader("X-Forwarded-For"),
        request.GetHeader("X-Real-IP"),
    )

    body := make(map of string to any)
    request.ReadJSON(reference of body) onerr
        body = empty map of string to any

    result := gs.http_handler.HandleJoinGame(game_id, body, ip)
    gs.writeAPIResponse(response, result)

func handleActionRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsPost()
        response.MethodNotAllowed("POST")
        return

    game_id := request.PathValue("game_id")
    auth_header := request.GetHeader("Authorization")

    body := make(map of string to any)
    request.ReadJSON(reference of body) onerr
        response.JSONBadRequest("invalid JSON body")
        return

    result := gs.http_handler.HandleAction(game_id, auth_header, body)
    gs.writeAPIResponse(response, result)

func handleGetStateRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsGet()
        response.MethodNotAllowed("GET")
        return

    game_id := request.PathValue("game_id")
    auth_header := request.GetHeader("Authorization")

    result := gs.http_handler.HandleGetState(game_id, auth_header)
    gs.writeAPIResponse(response, result)

func handleGetActionsRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsGet()
        response.MethodNotAllowed("GET")
        return

    game_id := request.PathValue("game_id")
    auth_header := request.GetHeader("Authorization")

    result := gs.http_handler.HandleGetActions(game_id, auth_header)
    gs.writeAPIResponse(response, result)

func handleLeaveGameRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsPost()
        response.MethodNotAllowed("POST")
        return

    game_id := request.PathValue("game_id")
    auth_header := request.GetHeader("Authorization")

    result := gs.http_handler.HandleLeaveGame(game_id, auth_header)
    gs.writeAPIResponse(response, result)

func handleReadyRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsPost()
        response.MethodNotAllowed("POST")
        return

    game_id := request.PathValue("game_id")
    auth_header := request.GetHeader("Authorization")

    body := make(map of string to any)
    request.ReadJSON(reference of body) onerr
        log.Debug("Ready endpoint: empty or invalid body, using defaults")

    result := gs.http_handler.HandleReady(game_id, auth_header, body)
    gs.writeAPIResponse(response, result)

func handleStartGameRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsPost()
        response.MethodNotAllowed("POST")
        return

    game_id := request.PathValue("game_id")
    auth_header := request.GetHeader("Authorization")

    result := gs.http_handler.HandleStartGame(game_id, auth_header)
    gs.writeAPIResponse(response, result)

func handleListGamesRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsGet()
        response.MethodNotAllowed("GET")
        return

    result := gs.http_handler.HandleListGames()
    gs.writeAPIResponse(response, result)

func writeAPIResponse on gs: reference GameServer(response: httphelper.Response, result: APIResponse)
    status := 200
    if not result.success
        status = 400

    response_data := map of string to any{
        "success": result.success,
        "message": result.message,
        "data": result.data,
    }

    if result.success
        response.JSON(response_data) onerr
            log.Error("Failed to write JSON response")
    else
        response.JSONError(result.message, status) onerr
            log.Error("Failed to write JSON error response")

func main()
    config := ServerConfigFromEnv()
    server, err := NewGameServer(config)
    if err isnt empty
        log.Fatal("Failed to create game server: {err}")
        return
    server.Start()
