petiole main

import "net/http"
import "os"
import "path/filepath"
import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/types"
import "stdlib/env"
import "stdlib/errors" as errs
import "stdlib/http" as httphelper
import "stdlib/log"
import "stdlib/signal"
import "strings"

type ServerConfig
    httpPort: int
    staticDir: string
    jwtSecret: string
    debug: bool
    # How long a player has to complete a turn before it is passed on.
    # Agents get longer: a model may spend a while thinking before it acts.
    turnTimeoutSeconds: int
    agentTurnTimeoutSeconds: int

func ServerConfigFromEnv() ServerConfig
    httpPort := env.GetIntOr("HTTP_PORT", 8080) onerr panic "invalid HTTP_PORT: {error}"
    debug := env.GetBoolOr("DEBUG", false) onerr panic "invalid DEBUG: {error}"
    turnTimeout := env.GetIntOr("TURN_TIMEOUT_SECONDS", constants.TURN_TIMEOUT_SECONDS) onerr panic "invalid TURN_TIMEOUT_SECONDS: {error}"
    agentTimeout := env.GetIntOr("AGENT_TURN_TIMEOUT_SECONDS", constants.AGENT_TURN_TIMEOUT_SECONDS) onerr panic "invalid AGENT_TURN_TIMEOUT_SECONDS: {error}"
    return ServerConfig{
        httpPort: httpPort,
        staticDir: env.GetOr("STATIC_DIR", ""),
        jwtSecret: env.GetOr("JWT_SECRET_KEY", ""),
        debug: debug,
        turnTimeoutSeconds: turnTimeout,
        agentTurnTimeoutSeconds: agentTimeout,
    }

type GameServer
    config: ServerConfig
    coordinator: GameCoordinator
    lobbyMgr: LobbyManager
    wsHandler: WebSocketHandler
    httpHandler: HTTPHandler
    wsEndpoint: WebSocketEndpoint

func NewGameServer(config: ServerConfig) (GameServer, error)
    if config.jwtSecret is empty
        sk, err := GenerateSecretKey()
        if err isnt empty
            return GameServer{}, errs.Wrap(err, "failed to generate secret key")
        config.jwtSecret = sk

    gs := GameServer{
        config: config,
        lobbyMgr: NewLobbyManager(),
        wsHandler: NewWebSocketHandler(),
    }
    gs.coordinator = NewGameCoordinator(config.turnTimeoutSeconds, config.agentTurnTimeoutSeconds)
    gs.httpHandler = NewHTTPHandler(
        reference of gs.coordinator,
        reference of gs.lobbyMgr,
        reference of gs.wsHandler,
        config.jwtSecret,
        config.staticDir,
    )
    return gs, empty

func Start on gs: reference GameServer
    gs.wsEndpoint = NewWebSocketEndpoint(
        reference of gs.coordinator,
        reference of gs.lobbyMgr,
        reference of gs.wsHandler,
        reference of gs.httpHandler,
    )
    # Pass on turns that run out of time, so a stalled player cannot block
    # the match for everyone else.
    gs.wsEndpoint.startTurnWatchdog()
    # Restrict which origins may open a WebSocket. Empty allows any, which
    # is the default for a local server.
    setAllowedWsOrigins(env.GetOr("WS_ALLOWED_ORIGINS", ""))
    mux := http.NewServeMux()
    gs.registerRoutes(mux)

    addr := ":{gs.config.httpPort}"
    log.Info("Starting HTTP server on {addr}")

    go
        err := http.ListenAndServe(addr, mux)
        if err isnt empty
            log.Error("HTTP server error: {err}")

    log.Info("Server started. Press Ctrl+C to stop.")

    ch := make(channel of bool)
    signal.OnInterrupt(() =>
        log.Info("Shutting down server...")
        send true to ch
    )

    receive from ch

func registerRoutes on gs: reference GameServer(mux: reference http.ServeMux)
    mux.Handle("/ws", httphelper.Handler(gs.handleWebSocketRoute))
    mux.Handle("/", httphelper.Handler(gs.handleHTTP))
    mux.Handle("/api/game/create", httphelper.Handler(gs.handleCreateGameRoute))
    mux.Handle("/api/game/\{game_id\}/join", httphelper.Handler(gs.handleJoinGameRoute))
    mux.Handle("/api/game/\{game_id\}/action", httphelper.Handler(gs.handleActionRoute))
    mux.Handle("/api/game/\{game_id\}/state", httphelper.Handler(gs.handleGetStateRoute))
    mux.Handle("/api/game/\{game_id\}/actions", httphelper.Handler(gs.handleGetActionsRoute))
    mux.Handle("/api/game/\{game_id\}/leave", httphelper.Handler(gs.handleLeaveGameRoute))
    mux.Handle("/api/game/\{game_id\}/ready", httphelper.Handler(gs.handleReadyRoute))
    mux.Handle("/api/game/\{game_id\}/start", httphelper.Handler(gs.handleStartGameRoute))
    mux.Handle("/api/games", httphelper.Handler(gs.handleListGamesRoute))
    mux.Handle("/api/game/\{game_id\}/say", httphelper.Handler(gs.handleSayRoute))
    mux.Handle("/api/game/\{game_id\}/spectate", httphelper.Handler(gs.handleSpectateRoute))
    mux.Handle("/api/game/\{game_id\}/battle", httphelper.Handler(gs.handleBattleRoute))

func handleWebSocketRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    gs.wsEndpoint.HandleWebSocket(response, request)

func handleHTTP on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if gs.config.staticDir is empty
        response.JSONNotFound("no static files configured") onerr discard
        return

    path := request.URL().Path
    if path equals "/"
        path = "/index.html"

    filePath := filepath.Join(gs.config.staticDir, path)
    filePath = filepath.Clean(filePath)

    prefix := filepath.Clean(gs.config.staticDir)
    if not strings.HasPrefix(filePath, prefix)
        response.JSONNotFound("not found") onerr discard
        return

    response.ServeFile(request, filePath)

func handleCreateGameRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsPost()
        response.MethodNotAllowed("POST")
        return

    ip := gs.httpHandler.GetClientIP(
        request.RemoteAddr(),
        request.GetHeader("X-Forwarded-For"),
        request.GetHeader("X-Real-IP"),
    )
    authHeader := request.GetHeader("Authorization")

    body := empty JSONMap
    request.Decode(reference of body) onerr
        response.JSONBadRequest("invalid JSON body")
        return

    result := gs.httpHandler.HandleCreateGame(authHeader, body, ip)
    gs.writeAPIResponse(response, result)

func handleJoinGameRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsPost()
        response.MethodNotAllowed("POST")
        return

    gameId := request.PathValue("game_id")
    ip := gs.httpHandler.GetClientIP(
        request.RemoteAddr(),
        request.GetHeader("X-Forwarded-For"),
        request.GetHeader("X-Real-IP"),
    )

    body := empty JSONMap
    request.Decode(reference of body) onerr
        body = empty JSONMap

    result := gs.httpHandler.HandleJoinGame(gameId, body, ip)
    gs.writeAPIResponse(response, result)

func handleActionRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsPost()
        response.MethodNotAllowed("POST")
        return

    gameId := request.PathValue("game_id")
    authHeader := request.GetHeader("Authorization")

    body := empty JSONMap
