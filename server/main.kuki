func handleSpectateRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsPost()
        response.MethodNotAllowed("POST")
        return

    gameId := request.PathValue("game_id")

    body := empty JSONMap
    request.Decode(reference of body) onerr
        body = empty JSONMap

    result := gs.httpHandler.HandleSpectate(gameId, body, "")
    gs.writeAPIResponse(response, result)

func handleBattleRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsGet()
        response.MethodNotAllowed("GET")
        return

    gameId := request.PathValue("game_id")
    result := gs.httpHandler.HandleBattle(gameId)
    gs.writeAPIResponse(response, result)

func writeAPIResponse on gs: reference GameServer(response: httphelper.Response, result: APIResponse)
    status := httphelper.StatusOK
    if not result.success
        status = httphelper.StatusBadRequest

    responseData := JSONMap{
        "success": result.success,
        "message": result.message,
        "data": result.data,
    }

    if result.success
        response.JSON(responseData) onerr
            log.Error("Failed to write JSON response")
    else
        response.JSONError(result.message, status) onerr
            log.Error("Failed to write JSON error response")

func main()
    config := ServerConfigFromEnv()
    server, err := NewGameServer(config)
    if err isnt empty
        log.Fatal("Failed to create game server: {err}")
        return
    server.Start()
