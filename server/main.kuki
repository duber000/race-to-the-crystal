func handleListGamesRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsGet()
        response.MethodNotAllowed("GET")
        return

    result := gs.httpHandler.HandleListGames()
    gs.writeAPIResponse(response, result)

func handleSayRoute on gs: reference GameServer(response: httphelper.Response, request: httphelper.Request)
    response.SetSecureHeaders()
    if not request.IsPost()
