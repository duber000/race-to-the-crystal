petiole main

import "race-to-the-crystal/game" as gamepkg
import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types"
import "stdlib/log"
import "stdlib/maps"
import "stdlib/random"
import "sync"
import "time"

type GameSession
    gameId: string
    gameName: string
    gameState: gamepkg.GameState
    networkToGameId: map of string to string
    gameToNetworkId: map of string to string
    # Spectator network ids (not seated players) mapped to the seat they
    # follow ("player_0", "player_1", ...). They receive the fog-filtered
    # state and events of the seat they follow — same visibility as that
    # player, never the unfiltered board.
    spectators: map of string to string
    lastState: optional reference JSONMap
    apiMap: map of string to gamepkg.GameAPI
    # The event log: every event the session has produced, in order.
    events: list of gamepkg.GameEvent
    # Battle-log snapshots: the unfiltered state after each recorded action
    # (plus the opening state). Each snapshot carries the events that
    # produced it, so the replay viewer can re-emit them into the FX
    # pipeline. Deliberately unfiltered — this is a local file, not a
    # network payload served to players, and the spectator exception to
    # fog-of-war covers it. Only served once the match is finished.
    snapshots: list of JSONMap
    # Sequence number of the last event produced. This is the log index, not
    # a wire counter.
    eventSeq: int
    # Per-player event counters, keyed by network player id. The fog hides
    # some events from some players, so each player needs their own
    # sequence to detect gaps without seeing one for every hidden event.
    playerEventSeqs: map of string to int
    # The objective state as of the last event, used to detect generator and
    # crystal changes between actions.
    objectiveState: gamepkg.ObjectiveState
    # Turn timing. `turnStartedAt` is when the current turn began,
    # `turnNetworkPlayerId` is whose turn it is, and
    # `currentTurnTimeoutSeconds` is how long they have. The watchdog
    # passes a stalled turn on.
    turnStartedAt: float64
    turnNetworkPlayerId: string
    currentTurnTimeoutSeconds: int
    # Per-player turn timeouts, keyed by network player id.
    playerTimeouts: map of string to int
    # The configured timeouts for this session.
    defaultTurnTimeoutSeconds: int
    defaultAgentTurnTimeoutSeconds: int
    # Serialises actions on this session. Two actions arriving at once (a
    # fast client, or the watchdog ending a stalled turn while a player
    # acts) must not interleave on the shared game state.
    actionMu: sync.Mutex
    # Guards everything that reads or writes the session, the event log,
    # the snapshot list and the per-player counters — in particular every
    # read of the game state maps (tokens, players, generators), which
    # would otherwise race an action in flight and crash the process with
    # a concurrent map access. Always taken AFTER actionMu, never before,
    # so there is no lock-order cycle.
    broadcastMu: sync.Mutex

func NewGameSession(gameId: string, lobby: reference GameLobby, turnTimeoutSeconds: int, agentTurnTimeoutSeconds: int) reference GameSession
    seatCount := len(lobby.orderedPlayers())
    gs := gamepkg.CreateGame(seatCount)
    # Built as a reference from the start: the session holds a mutex, and
    # copying the struct would copy the lock.
    session := reference of GameSession{
        gameId: gameId,
        gameName: lobby.gameName,
        gameState: gs,
        networkToGameId: empty map of string to string,
        gameToNetworkId: empty map of string to string,
        spectators: empty map of string to string,
        lastState: empty,
        apiMap: empty map of string to gamepkg.GameAPI,
        events: empty list of gamepkg.GameEvent,
        snapshots: empty list of JSONMap,
        eventSeq: 0,
        playerEventSeqs: empty map of string to int,
        objectiveState: gamepkg.ObjectiveState{},
        turnStartedAt: 0.0,
        turnNetworkPlayerId: "",
        currentTurnTimeoutSeconds: 0,
        playerTimeouts: empty map of string to int,
        defaultTurnTimeoutSeconds: turnTimeoutSeconds,
        defaultAgentTurnTimeoutSeconds: agentTurnTimeoutSeconds,
    }

    session.initializePlayers(lobby)
    session.gameState.StartGame()
    # Baseline the objective state so the first action does not report every
    # generator and the crystal as changed.
    session.objectiveState = gamepkg.ObjectiveStateOf(reference of session.gameState)
    # Opening snapshot: the state the match starts from, so a replay begins
    # on the initial board rather than after the first action.
    session.recordSnapshot(empty list of gamepkg.GameEvent)
    # The first turn starts ticking now.
    session.beginTurn(session.getCurrentNetworkPlayerId())
    return session

func initializePlayers on s: reference GameSession(lobby: reference GameLobby)
    # `lobby.players` is a map, so iterating it directly assigns seats in
    # random order. Use the lobby's stable join order (colour index) instead,
    # so a player's seat, colour and corner quadrant never shuffle between
    # games.
    for info in lobby.orderedPlayers()
        gamePid := "player_{info.colorIndex}"
        s.networkToGameId[info.playerId] = gamePid
        s.gameToNetworkId[gamePid] = info.playerId
        api := gamepkg.NewGameAPI(reference of s.gameState, types.PlayerID(gamePid))
        log.Info("initialize_players: api created, api.game_state ref created")

        # Carry the lobby display name into the match. `pRef` is a reference —
        # calling through it mutates the player the game state holds. (Do not
        # `dereference` it first: that copies the struct and the rename is
        # lost.)
        pRef := s.gameState.GetPlayer(types.PlayerID(gamePid))
        if pRef isnt empty
            pRef.SetName(info.playerName)

            # A human gets a shorter turn than an agent, which may spend a
            # while thinking before it acts.
            timeout := s.defaultTurnTimeoutSeconds
            if info.clientType equals ClientType.HTTP_AI or info.clientType equals ClientType.AI
                timeout = s.defaultAgentTurnTimeoutSeconds
            if timeout <= 0
                timeout = constants.TURN_TIMEOUT_SECONDS
            pRef.SetTurnTimeout(timeout)
            s.playerTimeouts[info.playerId] = timeout

        s.apiMap[info.playerId] = api

# Start the turn clock for a player. Called when the game starts and
# whenever the turn passes to another player.
func beginTurn on s: reference GameSession(networkPlayerId: string)
    if networkPlayerId is empty
        return
    s.turnNetworkPlayerId = networkPlayerId
    s.turnStartedAt = time.Now().UnixNano() as float64 / 1e9
    timeout := s.playerTimeouts[networkPlayerId]
    if timeout <= 0
        timeout = constants.TURN_TIMEOUT_SECONDS
    s.currentTurnTimeoutSeconds = timeout

# Seconds left on the current turn, or -1 when the turn is not being timed.
func turnSecondsRemaining on s: reference GameSession(now: float64) int
    if s.currentTurnTimeoutSeconds <= 0 or s.turnStartedAt <= 0.0
        return -1
    elapsed := now - s.turnStartedAt
    remaining := s.currentTurnTimeoutSeconds - elapsed as int
    if remaining < 0
        return 0
    return remaining

func executeGameAction on s: reference GameSession(networkPlayerId: string, action: gamepkg.AIAction) (bool, string, gamepkg.ActionResultData, list of gamepkg.GameEvent)
    # Serialise: two actions must not interleave on the shared game state.
    s.actionMu.Lock()
    defer s.actionMu.Unlock()
    # Also hold the broadcast lock for the whole mutation, so a concurrent
    # broadcast can never iterate the game state maps mid-action. Lock
    # order is always actionMu then broadcastMu.
    s.broadcastMu.Lock()
    defer s.broadcastMu.Unlock()

    _, has := s.networkToGameId[networkPlayerId]
    if not has
        return false, "Player not in game", gamepkg.NewEmptyResultData(), empty list of gamepkg.GameEvent
    api, apiHas := s.apiMap[networkPlayerId]
    if not apiHas
        return false, "No API for player", gamepkg.NewEmptyResultData(), empty list of gamepkg.GameEvent
    log.Info(
        "Before action: s.game_state.current={s.gameState.CurrentTurnPlayerID()}, s.game_state.turn={s.gameState.TurnNumber()}",
    )
    var result: gamepkg.ActionResult = api.DoAction(action)

    log.Info(
        "After action: s.game_state.current={s.gameState.CurrentTurnPlayerID()}, s.game_state.turn={s.gameState.TurnNumber()}",
    )
    if result.Success
        events := s.recordEvents(result.Data, empty list of gamepkg.GameEvent)

        # If the turn passed to another player, start their clock.
        currentNetwork := s.getCurrentNetworkPlayerId()
        if currentNetwork isnt empty and currentNetwork isnt s.turnNetworkPlayerId
            s.beginTurn(currentNetwork)

        return true, result.Message, result.Data, events
    return false, result.Message, gamepkg.NewEmptyResultData(), empty list of gamepkg.GameEvent

# The event announcing the first turn of the match, so a client knows the
# turn clock and the timeout before the first action is taken.
func recordStartEvents on s: reference GameSession list of gamepkg.GameEvent
    s.broadcastMu.Lock()
    defer s.broadcastMu.Unlock()
    gamePid := s.getCurrentNetworkPlayerId()
    if gamePid is empty
        return empty list of gamepkg.GameEvent
    timeout := s.playerTimeouts[gamePid]
    if timeout <= 0
        timeout = constants.TURN_TIMEOUT_SECONDS
    event := gamepkg.TurnChanged{
        TurnNumber: s.gameState.TurnNumber(),
        CurrentPlayerID: types.PlayerID(gamePid),
        TurnPhase: "{s.gameState.TurnPhase()}",
        TurnTimeoutSeconds: timeout,
    }
    s.events = append(s.events, event)
    return list of gamepkg.GameEvent{event}

# Derive the events produced by an action, append them to the session's log
# and return them.
#
# Objective changes (generator capture, crystal capture) are detected by
# diffing the objective state across the action, so ownership changes are
# reported even when the action result only mentions newly *disabled*
# generators. Objectives update during an end-turn, before the turn itself
# advances, so the objective events come first.
#
# `leading` is an optional list of events to record before the derived ones
# — the server uses it to mark a turn that timed out.
# Caller must hold `broadcastMu` (via executeGameAction's critical section);
# the lock is NOT taken here, and the function must never be called with it
# already held twice — sync.Mutex does not nest.
func recordEvents on s: reference GameSession(data: gamepkg.ActionResultData, leading: list of gamepkg.GameEvent) list of gamepkg.GameEvent
    events := empty list of gamepkg.GameEvent

    for e in leading
        events = append(events, e)

    after := gamepkg.ObjectiveStateOf(reference of s.gameState)
    for e in gamepkg.ObjectiveEventsBetween(s.objectiveState, after)
        events = append(events, e)
    s.objectiveState = after

    for e in gamepkg.EventsForAction(reference of s.gameState, data)
        events = append(events, e)

    for e in events
        s.events = append(s.events, e)
    s.recordSnapshot(events)
    return events

# Append the current (unfiltered) state plus the events that produced it
# to the battle-log snapshots.
func recordSnapshot on s: reference GameSession(events: list of gamepkg.GameEvent)
    eventDicts := empty list of JSONMap
    for e in events
        eventDicts = append(eventDicts, gamepkg.EventToDict(e))
    s.snapshots = append(s.snapshots, JSONMap{
        "game_state": s.gameState.ClientStateDict(""),
        "events": eventDicts,
        "turn_number": s.gameState.TurnNumber(),
    })

# The full battle log for one finished match: every snapshot in order and
# the flat event log. Shape matches the replay viewer's
# `.rttc-battle.json` import.
func battleLog on s: reference GameSession JSONMap
    s.broadcastMu.Lock()
    defer s.broadcastMu.Unlock()
    eventDicts := empty list of JSONMap
    for e in s.events
        eventDicts = append(eventDicts, gamepkg.EventToDict(e))
    return JSONMap{
        "game_id": s.gameId,
        "game_name": s.gameName,
        "snapshots": s.snapshots,
        "events": eventDicts,
    }

# The seat id a spectator request should follow, given the requested
# `follow` value ("player_0", ...). Empty follow means "random seat".
# Returns (seatPid, seatName, ok). Caller must NOT hold broadcastMu.
func bindSpectator on s: reference GameSession(spectatorId: string, follow: string) (string, string, bool)
    s.broadcastMu.Lock()
    defer s.broadcastMu.Unlock()

    seats := empty list of string
    seatNames := empty map of string to string
    for _nid, seat in s.networkToGameId
        seats = append(seats, seat)
        pref := s.gameState.GetPlayer(types.PlayerID(seat))
        name := seat
        if pref isnt empty
            name = pref.Name()
        seatNames[seat] = name

    seat := follow
    if seat is empty
        # ChoiceOr returns "" when no seats are bound — the not-ok return
        # below then mirrors the empty-lobby outcome.
        seat = random.ChoiceOr(seats, "")
        if seat is empty
            return "", "", false
    else
        found := false
        for candidate in seats
            if candidate equals seat
                found = true
                break
        if not found
            return "", "", false

    s.spectators[spectatorId] = seat
    if _, ok := s.playerEventSeqs[spectatorId]; not ok
        s.playerEventSeqs[spectatorId] = 0

    return seat, seatNames[seat], true

# The valid spectate seats in this session, for error messages.
func validSpectatorSeats on s: reference GameSession list of string
    s.broadcastMu.Lock()
    defer s.broadcastMu.Unlock()
    seats := empty list of string
    for _nid, seat in s.networkToGameId
        seats = append(seats, seat)
    return seats

func getStateDict on s: reference GameSession JSONMap
    return s.gameState.ToDict()

func isGameOver on s: reference GameSession bool
    return s.gameState.Phase() equals enums.ENDED

func getWinnerNetworkId on s: reference GameSession string
    wid := s.gameState.WinnerID()
    if wid is empty
        return ""
    nid, has := s.gameToNetworkId[wid as string]
    if has
        return nid
    return ""

# Shared winner announcement frame used by both end-of-game broadcasts —
# the WebSocket path (broadcastGameWonLocked) and the HTTP action path.
# Every client, whichever transport carried the final action, receives the
# same GAME_WON frame.
func winnerBroadcastFrame on s: reference GameSession JSONMap
    winnerNetworkId := s.getWinnerNetworkId()
    winnerName := "Unknown"
    wid := s.gameState.WinnerID()
    if wid isnt empty
        player := s.gameState.GetPlayer(wid)
        if player isnt empty
            winnerName = player.Name()
    return JSONMap{
        "type": "GAME_WON",
        "game_id": s.gameId,
        "winner_id": winnerNetworkId,
        "winner_name": winnerName,
    }

func getCurrentNetworkPlayerId on s: reference GameSession string
    cpid := s.gameState.CurrentTurnPlayerID()
    if cpid is empty
        return ""
    nid, has := s.gameToNetworkId[cpid as string]
    if has
        return nid as string
    return ""

type GameCoordinator
    activeGames: map of string to reference GameSession
    playerToGame: map of string to string
    # Guards both maps above. Handlers run on many goroutines (one per
    # WebSocket connection plus the HTTP workers), and Go maps are not
    # safe for concurrent read/write.
    mu: sync.Mutex
    # Turn timeouts handed to each new session.
    turnTimeoutSeconds: int
    agentTurnTimeoutSeconds: int

func NewGameCoordinator(turnTimeoutSeconds: int, agentTurnTimeoutSeconds: int) GameCoordinator
    return GameCoordinator{
        activeGames: empty map of string to reference GameSession,
        playerToGame: empty map of string to string,
        turnTimeoutSeconds: turnTimeoutSeconds,
        agentTurnTimeoutSeconds: agentTurnTimeoutSeconds,
    }

func createSession on gc: reference GameCoordinator(lobby: reference GameLobby) reference GameSession
    gameId := lobby.gameId
    session := NewGameSession(gameId, lobby, gc.turnTimeoutSeconds, gc.agentTurnTimeoutSeconds)
    players := lobby.getPlayerList()
    gc.mu.Lock()
    gc.activeGames[gameId] = session
    for info in players
        pidStr := maps.StringOr(info, "player_id", "")
        if pidStr isnt empty
            gc.playerToGame[pidStr] = gameId
    gc.mu.Unlock()
    return session

func getSession on gc: reference GameCoordinator(gameId: string) optional reference GameSession
    gc.mu.Lock()
    defer gc.mu.Unlock()
    return gc.activeGames[gameId]

func getPlayerSession on gc: reference GameCoordinator(playerId: string) optional reference GameSession
    gc.mu.Lock()
    gameId, has := gc.playerToGame[playerId]
    gc.mu.Unlock()
    if not has
        return empty
    return gc.getSession(gameId)

func endSession on gc: reference GameCoordinator(gameId: string) bool
    session := gc.getSession(gameId)
    if session is empty
        return false
    session.broadcastMu.Lock()
    nids := empty list of string
    for nid, _game_id in session.networkToGameId
        nids = append(nids, nid)
    session.broadcastMu.Unlock()
    gc.mu.Lock()
    for nid in nids
        delete gc.playerToGame[nid]
    delete gc.activeGames[gameId]
    gc.mu.Unlock()
    return true

func removePlayer on gc: reference GameCoordinator(playerId: string) string
    gc.mu.Lock()
    gameId, has := gc.playerToGame[playerId]
    if not has
        gc.mu.Unlock()
        return ""
    delete gc.playerToGame[playerId]
    gc.mu.Unlock()
    session := gc.getSession(gameId)
    if session isnt empty
        session.broadcastMu.Lock()
        delete session.networkToGameId[playerId]
        # Also retire the per-player sequence counter so broadcasts stop
        # allocating for a departed player.
        delete session.playerEventSeqs[playerId]
        # If this id was spectating the game (HTTP spectate), drop that too.
        delete session.spectators[playerId]
        session.broadcastMu.Unlock()
    return gameId

# Snapshot the ids of the live sessions, so a watchdog goroutine can range
# them without holding the coordinator lock for the whole scan.
func activeGameIds on gc: reference GameCoordinator list of string
    gc.mu.Lock()
    defer gc.mu.Unlock()
    ids := empty list of string
    for gameId, _session in gc.activeGames
        ids = append(ids, gameId)
    return ids

func getActiveGameCount on gc: reference GameCoordinator int
    gc.mu.Lock()
    defer gc.mu.Unlock()
    return len(gc.activeGames)

func listActiveGames on gc: reference GameCoordinator list of JSONMap
    gc.mu.Lock()
    defer gc.mu.Unlock()
    result := empty list of JSONMap
    for _game_id, session in gc.activeGames
        turnNumber := 0
        isFinished := false
        session.broadcastMu.Lock()
        turnNumber = session.gameState.TurnNumber()
        isFinished = session.isGameOver()
        session.broadcastMu.Unlock()
        entry := JSONMap{
            "id": session.gameId,
            "name": session.gameName,
            "turn": turnNumber,
            "is_finished": isFinished,
        }
        result = append(result, entry)
    return result
