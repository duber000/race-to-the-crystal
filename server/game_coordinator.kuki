petiole main

import "race-to-the-crystal/game" as gamepkg
import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types"
import "stdlib/json" as jsonpkg
import "stdlib/log"
import "stdlib/maps"

type GameSession
    gameId: string
    gameName: string
    gameState: gamepkg.GameState
    networkToGameId: map of string to string
    gameToNetworkId: map of string to string
    lastState: reference JSONMap
    apiMap: map of string to gamepkg.GameAPI
    # The event log: every event the session has produced, in order.
    events: list of gamepkg.GameEvent
    # Sequence number of the last event broadcast. Clients use it to detect
    # gaps and resynchronise.
    eventSeq: int
    # The objective state as of the last event, used to detect generator and
    # crystal changes between actions.
    objectiveState: gamepkg.ObjectiveState

func NewGameSession(gameId: string, lobby: reference GameLobby) reference GameSession
    gs := gamepkg.CreateGame(len(lobby.players))
    session := GameSession{
        gameId: gameId,
        gameName: lobby.gameName,
        gameState: gs,
        networkToGameId: empty map of string to string,
        gameToNetworkId: empty map of string to string,
        lastState: empty,
        apiMap: empty map of string to gamepkg.GameAPI,
        events: empty list of gamepkg.GameEvent,
        eventSeq: 0,
        objectiveState: gamepkg.ObjectiveState{},
    }
    session.initializePlayers(lobby)
    session.gameState.StartGame()
    # Baseline the objective state so the first action does not report every
    # generator and the crystal as changed.
    session.objectiveState = gamepkg.ObjectiveStateOf(reference of session.gameState)
    return reference of session

func initializePlayers on s: reference GameSession(lobby: reference GameLobby)
    # `lobby.players` is a map, so iterating it directly assigns seats in
    # random order. Use the lobby's stable join order (colour index) instead,
    # so a player's seat, colour and corner quadrant never shuffle between
    # games.
    for info in lobby.orderedPlayers()
        gamePid := "player_{info.colorIndex}"
        s.networkToGameId[info.playerId] = gamePid
        s.gameToNetworkId[gamePid] = info.playerId
        api := gamepkg.NewGameAPI(reference of s.gameState, types.PlayerID(gamePid))
        log.Info("initialize_players: api created, api.game_state ref created")

        # Carry the lobby display name into the match. `pRef` is a reference —
        # calling through it mutates the player the game state holds. (Do not
        # `dereference` it first: that copies the struct and the rename is
        # lost.)
        pRef := s.gameState.GetPlayer(types.PlayerID(gamePid))
        if pRef isnt empty
            pRef.SetName(info.playerName)

        s.apiMap[info.playerId] = api

func executeGameAction on s: reference GameSession(networkPlayerId: string, action: gamepkg.AIAction) (bool, string, gamepkg.ActionResultData, list of gamepkg.GameEvent)
    _, has := s.networkToGameId[networkPlayerId]
    if not has
        return false, "Player not in game", gamepkg.NewEmptyResultData(), empty list of gamepkg.GameEvent
    api, apiHas := s.apiMap[networkPlayerId]
    if not apiHas
        return false, "No API for player", gamepkg.NewEmptyResultData(), empty list of gamepkg.GameEvent
    log.Info(
        "Before action: s.game_state.current={s.gameState.CurrentTurnPlayerID()}, s.game_state.turn={s.gameState.TurnNumber()}",
    )
    var result: gamepkg.ActionResult = api.DoAction(action)

    log.Info(
        "After action: s.game_state.current={s.gameState.CurrentTurnPlayerID()}, s.game_state.turn={s.gameState.TurnNumber()}",
    )
    if result.Success
        events := s.recordEvents(result.Data)
        return true, result.Message, result.Data, events
    return false, result.Message, gamepkg.NewEmptyResultData(), empty list of gamepkg.GameEvent

# Derive the events produced by an action, append them to the session's log
# and return them.
#
# Objective changes (generator capture, crystal capture) are detected by
# diffing the objective state across the action, so ownership changes are
# reported even when the action result only mentions newly *disabled*
# generators. Objectives update during an end-turn, before the turn itself
# advances, so the objective events come first.
func recordEvents on s: reference GameSession(data: gamepkg.ActionResultData) list of gamepkg.GameEvent
    events := empty list of gamepkg.GameEvent

    after := gamepkg.ObjectiveStateOf(reference of s.gameState)
    for e in gamepkg.ObjectiveEventsBetween(s.objectiveState, after)
        events = append(events, e)
    s.objectiveState = after

    for e in gamepkg.EventsForAction(reference of s.gameState, data)
        events = append(events, e)

    for e in events
        s.events = append(s.events, e)
    return events

func getStateDict on s: reference GameSession JSONMap
    return s.gameState.ToDict()

func getStateForPlayer on s: reference GameSession(networkPlayerId: string) JSONMap
    return s.gameState.ToDict()

func isGameOver on s: reference GameSession bool
    return s.gameState.Phase() equals enums.ENDED

func getWinnerNetworkId on s: reference GameSession string
    wid := s.gameState.WinnerID()
    if wid is empty
        return ""
    nid, has := s.gameToNetworkId[wid as string]
    if has
        return nid
    return ""

func getCurrentNetworkPlayerId on s: reference GameSession string
    cpid := s.gameState.CurrentTurnPlayerID()
    if cpid is empty
        return ""
    nid, has := s.gameToNetworkId[cpid as string]
    if has
        return nid as string
    return ""

type GameCoordinator
    activeGames: map of string to reference GameSession
    playerToGame: map of string to string

func NewGameCoordinator() GameCoordinator
    return GameCoordinator{
        activeGames: empty map of string to reference GameSession,
        playerToGame: empty map of string to string,
    }

func createSession on gc: reference GameCoordinator(lobby: reference GameLobby) reference GameSession
    gameId := lobby.gameId
    session := NewGameSession(gameId, lobby)
    gc.activeGames[gameId] = session
    players := lobby.getPlayerList()
    for info in players
        pidStr := maps.StringOr(info, "player_id", "")
        if pidStr isnt empty
            gc.playerToGame[pidStr] = gameId
    return gc.activeGames[gameId]

func getSession on gc: reference GameCoordinator(gameId: string) optional reference GameSession
    return gc.activeGames[gameId]

func getPlayerSession on gc: reference GameCoordinator(playerId: string) optional reference GameSession
    gameId, has := gc.playerToGame[playerId]
    if not has
        return empty
    return gc.getSession(gameId)

func endSession on gc: reference GameCoordinator(gameId: string) bool
    session := gc.getSession(gameId)
    if session is empty
        return false
    nids := empty list of string
    for nid, _game_id in session.networkToGameId
        nids = append(nids, nid)
    for nid in nids
        delete gc.playerToGame[nid]
    delete gc.activeGames[gameId]
    return true

func removePlayer on gc: reference GameCoordinator(playerId: string) string
    gameId, has := gc.playerToGame[playerId]
    if not has
        return ""
    delete gc.playerToGame[playerId]
    session := gc.getSession(gameId)
    if session isnt empty
        delete session.networkToGameId[playerId]
    return gameId

func getActiveGameCount on gc: reference GameCoordinator int
    return len(gc.activeGames)

func listActiveGames on gc: reference GameCoordinator list of JSONMap
    result := empty list of JSONMap
    for _game_id, session in gc.activeGames
        entry := JSONMap{
            "id": session.gameId,
            "name": session.gameName,
            "turn": session.gameState.TurnNumber(),
            "is_finished": session.gameState.Phase() equals enums.ENDED,
        }
        result = append(result, entry)
    return result
