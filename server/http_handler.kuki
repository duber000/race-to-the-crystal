petiole main

import "net"
import "race-to-the-crystal/game" as gamepkg
import "race-to-the-crystal/shared/types" as typespkg
import "stdlib/cast"
import "stdlib/json" as jsonpkg
import "stdlib/log"
import "stdlib/random"
import "stdlib/string" as strpkg
import "strings"

type JSONMap = map of string to any

type HTTPHandler
    coordinator: reference GameCoordinator
    lobby_mgr: reference LobbyManager
    ws_handler: reference WebSocketHandler
    mercure_cfg: MercureConfig
    jwt_secret: string
    rate_limiter: RateLimiter
    static_dir: string

type APIResponse
    success: bool
    message: string
    data: map of string to any

func NewHTTPHandler(coord: reference GameCoordinator, lobby_mgr: reference LobbyManager, ws_handler: reference WebSocketHandler, mercure_cfg: MercureConfig, jwt_secret: string, static_dir: string) HTTPHandler
    return HTTPHandler{
        coordinator: coord,
        lobby_mgr: lobby_mgr,
        ws_handler: ws_handler,
        mercure_cfg: mercure_cfg,
        jwt_secret: jwt_secret,
        rate_limiter: NewRateLimiter(),
        static_dir: static_dir,
    }

func HandleJoinGame on h: reference HTTPHandler(game_id: string, body: map of string to any, client_ip: string) APIResponse
    allowed := h.rate_limiter.CheckConnection(client_ip)
    if not allowed
        return APIResponse{
            success: false,
            message: "rate limit exceeded",
            data: empty map of string to any,
        }

    player_name_val, has_pn := body["player_name"]
    if not has_pn
        return APIResponse{
            success: false,
            message: "missing player_name",
            data: empty map of string to any,
        }
    player_name := ""
    if player_name_val is string as pn
        player_name = pn
    if player_name equals ""
        return APIResponse{
            success: false,
            message: "invalid player_name",
            data: empty map of string to any,
        }

    err_result := ValidatePlayerName(player_name)
    if err_result isnt empty
        return APIResponse{
            success: false,
            message: "invalid player_name: {err_result}",
            data: empty map of string to any,
        }

    lobby := h.lobby_mgr.get_lobby(game_id)
    if lobby equals empty
        return APIResponse{success: false, message: "game not found", data: empty map of string to any}
    if lobby.status isnt GameStatus.WAITING
        return APIResponse{
            success: false,
            message: "game is not accepting new players",
            data: empty map of string to any,
        }

    player_id := random.String(16)
    join_result := h.lobby_mgr.join_lobby(game_id, player_id, player_name, ClientType.WEB_BROWSER)
    if join_result equals empty
        return APIResponse{
            success: false,
            message: "failed to join game",
            data: empty map of string to any,
        }

    h.lobby_mgr.set_ready(game_id, player_id, true)
    h.ws_handler.UpdateClientPlayerID(player_id, player_id, player_name)
    h.ws_handler.UpdateClientGameID(player_id, game_id)

    token := CreatePlayerToken(player_id, game_id, h.jwt_secret, 24)

    return APIResponse{
        success: true,
        message: "joined",
        data: map of string to any{
            "player_id": player_id,
            "token": token,
            "game_id": game_id,
            "player_name": player_name,
            "sse_url": "{h.mercure_cfg.hub_url}?topic={h.mercure_cfg.topic_prefix}/{game_id}",
        },
    }

func HandleAction on h: reference HTTPHandler(game_id: string, auth_header: string, body: map of string to any) APIResponse
    token_str := ExtractTokenFromHeader(auth_header)
    if token_str equals ""
        return APIResponse{success: false, message: "missing auth token", data: empty map of string to any}

    payload := VerifyPlayerToken(token_str, h.jwt_secret)
    if payload equals empty
        return APIResponse{success: false, message: "invalid token", data: empty map of string to any}
    if not ValidateTokenForGame(payload, game_id)
        return APIResponse{
            success: false,
            message: "token not valid for this game",
            data: empty map of string to any,
        }

    player_id := payload.player_id

    action_allowed := h.rate_limiter.CheckAction(player_id)
    if not action_allowed
        return APIResponse{
            success: false,
            message: "rate limit exceeded",
            data: empty map of string to any,
        }

    action_type_val, has_at := body["type"]
    if not has_at
        return APIResponse{
            success: false,
            message: "missing action type",
            data: empty map of string to any,
        }
    type_str := ""
    if action_type_val is string as ts
        type_str = ts
    if type_str equals ""
        return APIResponse{
            success: false,
            message: "invalid action type",
            data: empty map of string to any,
        }

    action_type := gamepkg.ParseActionType(strpkg.ToUpper(type_str)) onerr
        return APIResponse{
            success: false,
            message: "unknown action type: {type_str}",
            data: empty map of string to any,
        }

    action_data_raw, has_ad := body["data"]
    action_map := empty map of string to any
    if has_ad
        switch action_data_raw as v
            when map of string to any
                action_map = v
            default
                action_map = empty map of string to any

    normalized := NormalizeActionData(action_map)
    validation_err := ValidateActionFields(action_type, normalized)
    if validation_err isnt empty
        msg := validation_err.message
        return APIResponse{
            success: false,
            message: "action validation failed: {msg}",
            data: empty map of string to any,
        }

    session := h.coordinator.get_session(game_id)
    if session equals empty
        return APIResponse{
            success: false,
            message: "game session not found",
            data: empty map of string to any,
        }

    action := h.buildGameAction(player_id, action_type, normalized)
    success, message, result_data := session.execute_game_action(player_id, action)

    if success
        state := session.get_state_dict()
        h.ws_handler.BroadcastToGame(game_id, map of string to any{
            "type": "STATE_UPDATE",
            "game_id": game_id,
            "state": state,
        })
        if session.is_game_over()
            winner_id := session.get_winner_network_id()
            h.ws_handler.BroadcastToGame(game_id, map of string to any{
                "type": "GAME_OVER",
                "game_id": game_id,
                "winner": winner_id,
            })
            h.lobby_mgr.finish_game(game_id)

    result_any := actionResultDataToMap(result_data)

    return APIResponse{
        success: success,
        message: message,
        data: result_any,
    }

func HandleGetState on h: reference HTTPHandler(game_id: string, auth_header: string) APIResponse
    token_str := ExtractTokenFromHeader(auth_header)
    if token_str equals ""
        return APIResponse{success: false, message: "missing auth token", data: empty map of string to any}

    payload := VerifyPlayerToken(token_str, h.jwt_secret)
    if payload equals empty
        return APIResponse{success: false, message: "invalid token", data: empty map of string to any}

    session := h.coordinator.get_session(game_id)
    if session equals empty
        return APIResponse{
            success: false,
            message: "game session not found",
            data: empty map of string to any,
        }

    state := session.get_state_dict()
    game_pid, has_pid := session.network_to_game_id[payload.player_id]
    if has_pid
        state["perspective_player_id"] = game_pid
        state["your_player_id"] = game_pid

    return APIResponse{success: true, message: "ok", data: state}

func HandleGetActions on h: reference HTTPHandler(game_id: string, auth_header: string) APIResponse
    token_str := ExtractTokenFromHeader(auth_header)
    if token_str equals ""
        return APIResponse{success: false, message: "missing auth token", data: empty map of string to any}

    payload := VerifyPlayerToken(token_str, h.jwt_secret)
    if payload equals empty
        return APIResponse{success: false, message: "invalid token", data: empty map of string to any}

    session := h.coordinator.get_session(game_id)
    if session equals empty
        return APIResponse{
            success: false,
            message: "game session not found",
            data: empty map of string to any,
        }

    api, api_has := session.api_map[payload.player_id]
    if not api_has
        return APIResponse{
            success: false,
            message: "no api for player",
            data: empty map of string to any,
        }

    phase_resp := api.ActionsWithPhase()
    return APIResponse{
        success: true,
        message: "ok",
        data: map of string to any{
            "phase": phase_resp.Phase,
            "actions": gamepkg.ActionsToDicts(phase_resp.Actions),
        },
    }

func HandleListGames on h: reference HTTPHandler APIResponse
    lobbies := h.lobby_mgr.list_available_lobbies()
    return APIResponse{success: true, message: "ok", data: map of string to any{"games": lobbies}}

func HandleCreateGame on h: reference HTTPHandler(auth_header: string, body: map of string to any, client_ip: string) APIResponse
    creation_allowed := h.rate_limiter.CheckGameCreation(client_ip)
    if not creation_allowed
        return APIResponse{
            success: false,
            message: "rate limit exceeded",
            data: empty map of string to any,
        }

    token_str := ExtractTokenFromHeader(auth_header)

    player_id := ""
    if token_str isnt ""
        payload := VerifyPlayerToken(token_str, h.jwt_secret)
        if payload isnt empty
            player_id = payload.player_id

    if player_id equals ""
        player_id = random.String(16)

    player_name := "Player"
    pn_val, has_pn := body["player_name"]
    if has_pn
        if pn_val is string as pn
            if pn isnt ""
                player_name = pn

    game_name := "Game"
    gn_val, has_gn := body["game_name"]
    if has_gn
        if gn_val is string as gn
            if gn isnt ""
                game_name = gn

    max_players := 4
    mp_val, has_mp := body["max_players"]
    if has_mp
        if mp_val is int as mp_parsed
            max_players = mp_parsed
    if max_players < 2
        max_players = 2
    if max_players > 4
        max_players = 4

    lobby := h.lobby_mgr.create_lobby(player_id, player_name, game_name, ClientType.WEB_BROWSER, max_players)
    if lobby equals empty
        return APIResponse{
            success: false,
            message: "failed to create game",
            data: empty map of string to any,
        }

    token := CreatePlayerToken(player_id, lobby.game_id, h.jwt_secret, 24)

    return APIResponse{
        success: true,
        message: "game created",
        data: map of string to any{
            "game_id": lobby.game_id,
            "player_id": player_id,
            "token": token,
            "game_name": lobby.game_name,
        },
    }

func HandleLeaveGame on h: reference HTTPHandler(game_id: string, auth_header: string) APIResponse
    token_str := ExtractTokenFromHeader(auth_header)
    if token_str equals ""
        return APIResponse{success: false, message: "missing auth token", data: empty map of string to any}

    payload := VerifyPlayerToken(token_str, h.jwt_secret)
    if payload equals empty
        return APIResponse{success: false, message: "invalid token", data: empty map of string to any}

    player_id := payload.player_id
    h.lobby_mgr.leave_lobby(game_id, player_id)

    return APIResponse{success: true, message: "left game", data: empty map of string to any}

func HandleReady on h: reference HTTPHandler(game_id: string, auth_header: string, body: map of string to any) APIResponse
    token_str := ExtractTokenFromHeader(auth_header)
    if token_str equals ""
        return APIResponse{success: false, message: "missing auth token", data: empty map of string to any}

    payload := VerifyPlayerToken(token_str, h.jwt_secret)
    if payload equals empty
        return APIResponse{success: false, message: "invalid token", data: empty map of string to any}

    player_id := payload.player_id

    ready := true
    ready_val, has_rdy := body["ready"]
    if has_rdy
        if ready_val is bool as ready_parsed
            ready = ready_parsed

    h.lobby_mgr.set_ready(game_id, player_id, ready)

    lobby := h.lobby_mgr.get_lobby(game_id)
    if lobby isnt empty
        h.ws_handler.BroadcastToGame(game_id, map of string to any{
            "type": "LOBBY_UPDATE",
            "game_id": game_id,
            "lobby": lobby.to_dict(),
        })

    return APIResponse{
        success: true,
        message: "ready status updated",
        data: map of string to any{"ready": ready},
    }

func HandleStartGame on h: reference HTTPHandler(game_id: string, auth_header: string) APIResponse
    token_str := ExtractTokenFromHeader(auth_header)
    if token_str equals ""
        return APIResponse{success: false, message: "missing auth token", data: empty map of string to any}

    payload := VerifyPlayerToken(token_str, h.jwt_secret)
    if payload equals empty
        return APIResponse{success: false, message: "invalid token", data: empty map of string to any}

    player_id := payload.player_id

    lobby := h.lobby_mgr.get_lobby(game_id)
    if lobby equals empty
        return APIResponse{success: false, message: "game not found", data: empty map of string to any}

    if lobby.host_player_id isnt player_id
        return APIResponse{
            success: false,
            message: "only the host can start the game",
            data: empty map of string to any,
        }

    if not lobby.can_start()
        return APIResponse{
            success: false,
            message: "game cannot start yet",
            data: empty map of string to any,
        }

    start_result := h.lobby_mgr.start_game(game_id)
    if start_result equals empty
        return APIResponse{
            success: false,
            message: "failed to start game",
            data: empty map of string to any,
        }

    session := h.coordinator.create_session(lobby)
    h.lobby_mgr.set_game_in_progress(game_id)

    state := session.get_state_dict()
    h.ws_handler.BroadcastToGame(game_id, map of string to any{
        "type": "GAME_STARTED",
        "game_id": game_id,
        "state": state,
    })

    return APIResponse{
        success: true,
        message: "game started",
        data: map of string to any{
            "game_id": game_id,
            "state": state,
        },
    }

func GetClientIP on h: reference HTTPHandler(remote_addr: string, xff: string, real_ip: string) string
    if xff isnt ""
        parts := strings.Split(xff, ",")
        if len(parts) > 0
            return strings.TrimSpace(parts[0])
    if real_ip isnt ""
        return real_ip
    host, _port, err := net.SplitHostPort(remote_addr)
    if err isnt empty
        return remote_addr
    return host

func buildGameAction on h: reference HTTPHandler(player_id: string, action_type: gamepkg.ActionType, data: map of string to any) gamepkg.AIAction
    switch action_type
        when gamepkg.MOVE
            tid := h.getIntField(data, "token_id", 0)
            dest := h.getPositionField(data, "destination")
            return gamepkg.NewMoveAction(typespkg.TokenID(tid), dest)
        when gamepkg.ATTACK
            attacker_id := typespkg.TokenID(h.getIntField(data, "attacker_id", 0))
            defender_id := typespkg.TokenID(h.getIntField(data, "defender_id", 0))
            return gamepkg.NewAttackAction(attacker_id, defender_id)
        when gamepkg.DEPLOY
            hv := h.getIntField(data, "health_value", 1)
            pos := h.getPositionField(data, "position")
            return gamepkg.NewDeployAction(hv, pos)
        default
            return gamepkg.NewEndTurnAction()

func getIntField on h: reference HTTPHandler(data: map of string to any, key: string, default_val: int) int
    val, has := data[key]
    if not has
        return default_val
    result, err := cast.ToInt(val)
    if err isnt empty
        return default_val
    return result

func getPositionField on h: reference HTTPHandler(data: map of string to any, key: string) typespkg.Position
    val, has := data[key]
    if not has
        return typespkg.Position{X: 0, Y: 0}

    json_bytes := jsonpkg.Bytes(val) onerr
        return typespkg.Position{X: 0, Y: 0}

    pos := empty list of any
    pos_str := json_bytes as string
    err := jsonpkg.ParseInto(pos_str, reference of pos)
    if err isnt empty
        return typespkg.Position{X: 0, Y: 0}

    if len(pos) < 2
        return typespkg.Position{X: 0, Y: 0}
    x := cast.ToIntOr(pos[0], 0)
    y := cast.ToIntOr(pos[1], 0)
    return typespkg.Position{X: x, Y: y}

func actionResultDataToMap(data: gamepkg.ActionResultData) map of string to any
    return gamepkg.ActionDataToDict(data)
