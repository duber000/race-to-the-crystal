petiole main

import "net"
import "race-to-the-crystal/game" as gamepkg
import "race-to-the-crystal/shared/types"
import "stdlib/cast"
import "stdlib/json" as jsonpkg
import "stdlib/log"
import "stdlib/maps"
import "stdlib/random"
import "stdlib/string" as strpkg
import "strings"

type JSONMap = map of string to any

# The maximum length of a radio-chatter message. Anything longer is almost
# certainly an attempt to amplify broadcast traffic or memory usage.
const MAX_RADIO_TEXT_LENGTH = 280

type HTTPHandler
    coordinator: reference GameCoordinator
    lobbyMgr: reference LobbyManager
    wsHandler: reference WebSocketHandler
    jwtSecret: string
    rateLimiter: RateLimiter
    staticDir: string

type APIResponse
    success: bool
    message: string
    data: JSONMap

func NewHTTPHandler(coord: reference GameCoordinator, lobbyMgr: reference LobbyManager, wsHandler: reference WebSocketHandler, jwtSecret: string, staticDir: string) HTTPHandler
    return HTTPHandler{
        coordinator: coord,
        lobbyMgr: lobbyMgr,
        wsHandler: wsHandler,
        jwtSecret: jwtSecret,
        rateLimiter: NewRateLimiter(),
        staticDir: staticDir,
    }

func HandleJoinGame on h: reference HTTPHandler(gameId: string, body: JSONMap, clientIp: string) APIResponse
    allowed := h.rateLimiter.CheckConnection(clientIp)
    if not allowed
        return APIResponse{
            success: false,
            message: "rate limit exceeded",
            data: empty JSONMap,
        }

    playerName := maps.StringOr(body, "player_name", "")
    if playerName is empty
        return APIResponse{
            success: false,
            message: "missing or invalid player_name",
            data: empty JSONMap,
        }

    errResult := ValidatePlayerName(playerName)
    if errResult isnt empty
        return APIResponse{
            success: false,
            message: "invalid player_name: {errResult}",
            data: empty JSONMap,
        }

    lobby := h.lobbyMgr.getLobby(gameId)
    if lobby is empty
        return APIResponse{success: false, message: "game not found", data: empty JSONMap}
    if lobby.statusOf() isnt GameStatus.WAITING
        return APIResponse{
            success: false,
            message: "game is not accepting new players",
            data: empty JSONMap,
        }

    playerId := random.String(16)
    # The HTTP join path is the agent path — the browser joins over the
    # WebSocket. Labelling it WEB_BROWSER gave agent seats the short human
    # turn timeout, and hid them from the lobby's client-type column.
    joinResult := h.lobbyMgr.joinLobby(gameId, playerId, playerName, ClientType.HTTP_AI)
    if joinResult is empty
        return APIResponse{
            success: false,
            message: "failed to join game",
            data: empty JSONMap,
        }

    # Record agent metadata for HTTP (agent) seats.
    model := ""
    agentKind := ""
    mVal, hasM := body["model"]
    if hasM
        if mVal is string as ms
            model = ms
    aVal, hasA := body["agent_kind"]
    if hasA
        if aVal is string as akv
            agentKind = akv
    lobby.setAgentInfo(playerId, model, agentKind)

    h.lobbyMgr.setReady(gameId, playerId, true)
    # No WebSocket registration: an HTTP client has no connection, so it
    # never receives pushed state and polls GET /api/game/{id}/state
    # instead. Registering a client with no connection would only create a
    # phantom the broadcaster skips.

    token := CreatePlayerToken(playerId, gameId, h.jwtSecret, 24)

    return APIResponse{
        success: true,
        message: "joined",
        data: JSONMap{
            "player_id": playerId,
            "token": token,
            "game_id": gameId,
            "player_name": playerName,
        },
    }

func HandleAction on h: reference HTTPHandler(gameId: string, authHeader: string, body: JSONMap) APIResponse
    tokenStr := ExtractTokenFromHeader(authHeader)
    if tokenStr is empty
        return APIResponse{success: false, message: "missing auth token", data: empty JSONMap}

    payload := VerifyPlayerToken(tokenStr, h.jwtSecret)
    if payload is empty
        return APIResponse{success: false, message: "invalid token", data: empty JSONMap}
    if not ValidateTokenForGame(payload, gameId)
        return APIResponse{
            success: false,
            message: "token not valid for this game",
            data: empty JSONMap,
        }

    playerId := payload.playerId

    actionAllowed := h.rateLimiter.CheckAction(playerId)
    if not actionAllowed
        return APIResponse{
            success: false,
            message: "rate limit exceeded",
            data: empty JSONMap,
        }

    typeStr := maps.StringOr(body, "type", "")
    if typeStr is empty
        return APIResponse{
            success: false,
            message: "missing or invalid action type",
            data: empty JSONMap,
        }

    actionType := gamepkg.ParseActionType(strpkg.ToUpper(typeStr)) onerr
        return APIResponse{
            success: false,
            message: "unknown action type: {typeStr}",
            data: empty JSONMap,
        }

    actionDataRaw, hasAd := body["data"]
    actionMap := empty JSONMap
    if hasAd
        switch actionDataRaw as v
            when JSONMap
                actionMap = v
            default
                actionMap = empty JSONMap

    normalized := NormalizeActionData(actionMap)
    validationErr := ValidateActionFields(actionType, normalized)
    if validationErr isnt empty
        msg := validationErr.message
        return APIResponse{
            success: false,
            message: "action validation failed: {msg}",
            data: empty JSONMap,
        }

    session := h.coordinator.getSession(gameId)
    if session is empty
        return APIResponse{
            success: false,
            message: "game session not found",
            data: empty JSONMap,
        }

    action := h.buildGameAction(playerId, actionType, normalized)
    success, message, resultData, events := session.executeGameAction(playerId, action)

    if success
        # Broadcast the same frames the WebSocket path would: the event
        # stream, then the per-player full state.
        h.wsHandler.BroadcastSessionEvents(session, events)
        h.wsHandler.BroadcastSessionState(session)
        session.broadcastMu.Lock()
        over := session.isGameOver()
        winnerId := ""
        if over
            winnerId = session.getWinnerNetworkId()
        session.broadcastMu.Unlock()
        if over
            h.wsHandler.BroadcastToGame(gameId, JSONMap{
                "type": "GAME_OVER",
                "game_id": gameId,
                "winner": winnerId,
            })
            h.lobbyMgr.finishGame(gameId)

    resultAny := actionResultDataToMap(resultData)

    return APIResponse{
        success: success,
        message: message,
        data: resultAny,
    }

func HandleGetState on h: reference HTTPHandler(gameId: string, authHeader: string) APIResponse
    tokenStr := ExtractTokenFromHeader(authHeader)
    if tokenStr is empty
        return APIResponse{success: false, message: "missing auth token", data: empty JSONMap}

    payload := VerifyPlayerToken(tokenStr, h.jwtSecret)
    if payload is empty
        return APIResponse{success: false, message: "invalid token", data: empty JSONMap}
    if not ValidateTokenForGame(payload, gameId)
        return APIResponse{
            success: false,
            message: "token not valid for this game",
            data: empty JSONMap,
        }

    session := h.coordinator.getSession(gameId)
    if session is empty
        return APIResponse{
            success: false,
            message: "game session not found",
            data: empty JSONMap,
        }

    # The full per-player state, the same shape the WebSocket path sends.
    # The slim dict has no board, tokens or generators, so a polling client
    # could never render the game from it. It is fogged like the WebSocket
    # path: a client only sees what its own tokens can see.
    session.broadcastMu.Lock()
    state := empty JSONMap
    # Spectators see everything (no fog).
    if _, isSpec := session.spectators[payload.playerId]; isSpec
        state = session.gameState.ClientStateDict("")
    else
        gamePid := ""
        pidVal, hasPid := session.networkToGameId[payload.playerId]
        if hasPid
            gamePid = pidVal
        state = session.gameState.VisibleStateDict(types.PlayerID(gamePid))
    session.broadcastMu.Unlock()

    return APIResponse{success: true, message: "ok", data: state}

func HandleGetActions on h: reference HTTPHandler(gameId: string, authHeader: string) APIResponse
    tokenStr := ExtractTokenFromHeader(authHeader)
    if tokenStr is empty
        return APIResponse{success: false, message: "missing auth token", data: empty JSONMap}

    payload := VerifyPlayerToken(tokenStr, h.jwtSecret)
    if payload is empty
        return APIResponse{success: false, message: "invalid token", data: empty JSONMap}
    if not ValidateTokenForGame(payload, gameId)
        return APIResponse{
            success: false,
            message: "token not valid for this game",
            data: empty JSONMap,
        }

    session := h.coordinator.getSession(gameId)
    if session is empty
        return APIResponse{
            success: false,
            message: "game session not found",
            data: empty JSONMap,
        }

    session.broadcastMu.Lock()
    api, apiHas := session.apiMap[payload.playerId]
    if not apiHas
        session.broadcastMu.Unlock()
        return APIResponse{
            success: false,
            message: "no api for player",
            data: empty JSONMap,
        }

    phaseResp := api.ActionsWithPhase()
    session.broadcastMu.Unlock()
    return APIResponse{
        success: true,
        message: "ok",
        data: JSONMap{
            "phase": phaseResp.Phase,
            "actions": gamepkg.ActionsToDicts(phaseResp.Actions),
        },
    }

func HandleListGames on h: reference HTTPHandler APIResponse
    lobbies := h.lobbyMgr.listAvailableLobbies()
    for g in h.lobbyMgr.listInProgress()
        lobbies = append(lobbies, g)
    return APIResponse{success: true, message: "ok", data: JSONMap{"games": lobbies}}

func HandleCreateGame on h: reference HTTPHandler(authHeader: string, body: JSONMap, clientIp: string) APIResponse
    creationAllowed := h.rateLimiter.CheckGameCreation(clientIp)
    if not creationAllowed
        return APIResponse{
            success: false,
            message: "rate limit exceeded",
            data: empty JSONMap,
        }

    tokenStr := ExtractTokenFromHeader(authHeader)

    playerId := ""
    if tokenStr isnt empty
        payload := VerifyPlayerToken(tokenStr, h.jwtSecret)
        if payload isnt empty
            playerId = payload.playerId

    if playerId is empty
        playerId = random.String(16)

    playerName := "Player"
    pnVal, hasPn := body["player_name"]
    if hasPn
        if pnVal is string as pn
            if pn isnt empty
                playerName = pn

    gameName := "Game"
    gnVal, hasGn := body["game_name"]
    if hasGn
        if gnVal is string as gn
            if gn isnt empty
                gameName = gn

    maxPlayers := 4
    mpVal, hasMp := body["max_players"]
    if hasMp
        if mpVal is int as mpParsed
            maxPlayers = mpParsed
    if maxPlayers < 2
        maxPlayers = 2
    if maxPlayers > 4
        maxPlayers = 4

    # The HTTP create path is the agent path — the browser creates over the
    # WebSocket. See HandleJoinGame.
    lobby := h.lobbyMgr.createLobby(playerId, playerName, gameName, ClientType.HTTP_AI, maxPlayers)
    if lobby is empty
        return APIResponse{
            success: false,
            message: "failed to create game",
            data: empty JSONMap,
        }

    # Record agent metadata for the HTTP (agent) host seat.
    model := ""
    agentKind := ""
    mVal, hasM := body["model"]
    if hasM
        if mVal is string as ms
            model = ms
    aVal, hasA := body["agent_kind"]
    if hasA
        if aVal is string as akv
            agentKind = akv
    lobby.setAgentInfo(playerId, model, agentKind)

    token := CreatePlayerToken(playerId, lobby.gameId, h.jwtSecret, 24)

    return APIResponse{
        success: true,
        message: "game created",
        data: JSONMap{
            "game_id": lobby.gameId,
            "player_id": playerId,
            "token": token,
            "game_name": lobby.gameName,
        },
    }

func HandleLeaveGame on h: reference HTTPHandler(gameId: string, authHeader: string) APIResponse
    tokenStr := ExtractTokenFromHeader(authHeader)
    if tokenStr is empty
        return APIResponse{success: false, message: "missing auth token", data: empty JSONMap}

    payload := VerifyPlayerToken(tokenStr, h.jwtSecret)
    if payload is empty
        return APIResponse{success: false, message: "invalid token", data: empty JSONMap}
    if not ValidateTokenForGame(payload, gameId)
        return APIResponse{
            success: false,
            message: "token not valid for this game",
            data: empty JSONMap,
        }

    playerId := payload.playerId
    h.lobbyMgr.leaveLobby(gameId, playerId)

    return APIResponse{success: true, message: "left game", data: empty JSONMap}

func HandleReady on h: reference HTTPHandler(gameId: string, authHeader: string, body: JSONMap) APIResponse
    tokenStr := ExtractTokenFromHeader(authHeader)
    if tokenStr is empty
        return APIResponse{success: false, message: "missing auth token", data: empty JSONMap}

    payload := VerifyPlayerToken(tokenStr, h.jwtSecret)
    if payload is empty
        return APIResponse{success: false, message: "invalid token", data: empty JSONMap}
    if not ValidateTokenForGame(payload, gameId)
        return APIResponse{
            success: false,
            message: "token not valid for this game",
            data: empty JSONMap,
        }

    playerId := payload.playerId

    ready := true
    readyVal, hasRdy := body["ready"]
    if hasRdy
        if readyVal is bool as readyParsed
            ready = readyParsed

    h.lobbyMgr.setReady(gameId, playerId, ready)

    lobby := h.lobbyMgr.getLobby(gameId)
    if lobby isnt empty
        h.wsHandler.BroadcastToGame(gameId, JSONMap{
            "type": "LOBBY_UPDATE",
            "game_id": gameId,
            "lobby": lobby.toDict(),
        })

    return APIResponse{
        success: true,
        message: "ready status updated",
        data: JSONMap{"ready": ready},
    }

func HandleStartGame on h: reference HTTPHandler(gameId: string, authHeader: string) APIResponse
    tokenStr := ExtractTokenFromHeader(authHeader)
    if tokenStr is empty
        return APIResponse{success: false, message: "missing auth token", data: empty JSONMap}

    payload := VerifyPlayerToken(tokenStr, h.jwtSecret)
    if payload is empty
        return APIResponse{success: false, message: "invalid token", data: empty JSONMap}
    if not ValidateTokenForGame(payload, gameId)
        return APIResponse{
            success: false,
            message: "token not valid for this game",
            data: empty JSONMap,
        }

    playerId := payload.playerId

    lobby := h.lobbyMgr.getLobby(gameId)
    if lobby is empty
        return APIResponse{success: false, message: "game not found", data: empty JSONMap}

    if lobby.hostPlayerIdOf() isnt playerId
        return APIResponse{
            success: false,
            message: "only the host can start the game",
            data: empty JSONMap,
        }

    # The atomic can-start check lives in `lobbyMgr.startGame` (tryStart):
    # a lobby that is not ready, or was caught by a racing start, returns
    # empty here.
    startResult := h.lobbyMgr.startGame(gameId)
    if startResult is empty
        return APIResponse{
            success: false,
            message: "failed to start game",
            data: empty JSONMap,
        }

    session := h.coordinator.createSession(lobby)
    h.lobbyMgr.setGameInProgress(gameId)

    # Broadcast the same frames the WebSocket path would, so a client sees
    # one state shape whichever transport it used.
    h.wsHandler.BroadcastSessionEvents(session, session.recordStartEvents())
    h.wsHandler.BroadcastSessionState(session)
    h.wsHandler.BroadcastToGame(gameId, JSONMap{
        "type": "GAME_STARTED",
        "game_id": gameId,
    })

    return APIResponse{
        success: true,
        message: "game started",
        data: JSONMap{
            "game_id": gameId,
        },
    }

# Returns the client address for rate limiting. In the supported deployment
# the edge proxy (Caddy) overwrites X-Forwarded-For with the true remote
# host, and the web server appends only the immediate upstream — so the
# FIRST entry is the real client. NEVER publish port 8080 directly to
# clients: without that edge hop the header is fully client-controlled and
# the per-IP rate limits are trivially bypassed. Taking the first entry
# without a trusted-proxy configuration is only safe behind that edge.
func GetClientIP on h: reference HTTPHandler(remoteAddr: string, xff: string, realIp: string) string
    if xff isnt empty
        parts := strings.Split(xff, ",")
        if parts isnt empty
            return strings.TrimSpace(parts[0])
    if realIp isnt empty
        return realIp
    host, _port, err := net.SplitHostPort(remoteAddr)
    if err isnt empty
        return remoteAddr
    return host

func buildGameAction on h: reference HTTPHandler(playerId: string, actionType: gamepkg.ActionType, data: JSONMap) gamepkg.AIAction
    switch actionType
        when gamepkg.MOVE
            tid := h.getIntField(data, "token_id", 0)
            dest := h.getPositionField(data, "destination")
            return gamepkg.NewMoveAction(types.TokenID(tid), dest)
        when gamepkg.ATTACK
            attackerId := types.TokenID(h.getIntField(data, "attacker_id", 0))
            defenderId := types.TokenID(h.getIntField(data, "defender_id", 0))
            return gamepkg.NewAttackAction(attackerId, defenderId)
        when gamepkg.DEPLOY
            hv := h.getIntField(data, "health_value", 1)
            pos := h.getPositionField(data, "position")
            return gamepkg.NewDeployAction(hv, pos)
        default
            return gamepkg.NewEndTurnAction()

func getIntField on h: reference HTTPHandler(data: JSONMap, key: string, defaultVal: int) int
    val, has := data[key]
    if not has
        return defaultVal
    result, err := cast.ToInt(val)
    if err isnt empty
        return defaultVal
    return result

func getPositionField on h: reference HTTPHandler(data: JSONMap, key: string) types.Position
    val, has := data[key]
    if not has
        return types.Position{X: 0, Y: 0}

    jsonBytes := jsonpkg.Bytes(val) onerr
        return types.Position{X: 0, Y: 0}

    pos := empty list of any
    posStr := jsonBytes as string
    err := jsonpkg.ParseInto(posStr, reference of pos)
    if err isnt empty
        return types.Position{X: 0, Y: 0}

    if len(pos) < 2
        return types.Position{X: 0, Y: 0}
    x := cast.ToIntOr(pos[0], 0)
    y := cast.ToIntOr(pos[1], 0)
    return types.Position{X: x, Y: y}

func actionResultDataToMap(data: gamepkg.ActionResultData) JSONMap
    return gamepkg.ActionDataToDict(data)

func HandleSay on h: reference HTTPHandler(gameId: string, authHeader: string, body: JSONMap) APIResponse
    tokenStr := ExtractTokenFromHeader(authHeader)
    if tokenStr is empty
        return APIResponse{success: false, message: "missing auth token", data: empty JSONMap}

    payload := VerifyPlayerToken(tokenStr, h.jwtSecret)
    if payload is empty
        return APIResponse{success: false, message: "invalid token", data: empty JSONMap}
    if not ValidateTokenForGame(payload, gameId)
        return APIResponse{
            success: false,
            message: "token not valid for this game",
            data: empty JSONMap,
        }

    session := h.coordinator.getPlayerSession(payload.playerId)
    if session is empty
        return APIResponse{success: false, message: "not in a game", data: empty JSONMap}

    text := maps.StringOr(body, "text", "")
    if text is empty
        return APIResponse{success: false, message: "missing text", data: empty JSONMap}
    if len(text) > MAX_RADIO_TEXT_LENGTH
        return APIResponse{
            success: false,
            message: "radio message too long (max {MAX_RADIO_TEXT_LENGTH} characters)",
            data: empty JSONMap,
        }

    # The display name always comes from the session — a client-supplied
    # player_name could impersonate another player.
    playerName := "Unknown"
    session.broadcastMu.Lock()
    gpVal, hasGp := session.networkToGameId[payload.playerId]
    if hasGp
        pRef := session.gameState.GetPlayer(types.PlayerID(gpVal))
        if pRef isnt empty
            playerName = pRef.Name()
    session.broadcastMu.Unlock()

    # The comms sidebar keys its tone indicator off this field. Unknown
    # tones fall back to neutral rather than inventing a new badge.
    tone := maps.StringOr(body, "tone", "neutral")
    if tone isnt "confident" and tone isnt "aggressive" and tone isnt "cautious" and tone isnt "neutral"
        tone = "neutral"

    event := gamepkg.RadioChatter{
        PlayerID: types.PlayerID(payload.playerId),
        PlayerName: playerName,
        Text: text,
        Tone: tone,
    }
    session.broadcastMu.Lock()
    session.events = append(session.events, event)
    session.broadcastMu.Unlock()
    h.wsHandler.BroadcastSessionEvents(session, list of gamepkg.GameEvent{event})

    return APIResponse{
        success: true,
        message: "ok",
        data: empty JSONMap,
    }

func HandleSpectate on h: reference HTTPHandler(gameId: string, body: JSONMap, clientIp: string) APIResponse
    session := h.coordinator.getSession(gameId)
    if session is empty
        return APIResponse{
            success: false,
            message: "game session not found",
            data: empty JSONMap,
        }

    spectatorId := random.String(16)
    session.broadcastMu.Lock()
    session.spectators[spectatorId] = true
    if _, ok := session.playerEventSeqs[spectatorId]; not ok
        session.playerEventSeqs[spectatorId] = 0
    session.broadcastMu.Unlock()

    token := CreatePlayerToken(spectatorId, gameId, h.jwtSecret, 24)

    return APIResponse{
        success: true,
        message: "spectating",
        data: JSONMap{
            "spectator_id": spectatorId,
            "token": token,
            "game_id": gameId,
        },
    }

# The battle log for a finished match, for download as
# `<game_id>.rttc-battle.json`. Unauthenticated like `/api/games`: the
# browser client has no JWT, and the log is only served post-match, so
# there is no fog-of-war leak — mid-match the unfiltered board would
# reveal hidden tokens.
func HandleBattle on h: reference HTTPHandler(gameId: string) APIResponse
    session := h.coordinator.getSession(gameId)
    if session is empty
        return APIResponse{
            success: false,
            message: "game session not found",
            data: empty JSONMap,
        }
    session.broadcastMu.Lock()
    finished := session.isGameOver()
    session.broadcastMu.Unlock()
    if not finished
        return APIResponse{
            success: false,
            message: "battle log is available once the game has finished",
            data: empty JSONMap,
        }
    return APIResponse{
        success: true,
        message: "ok",
        data: session.battleLog(),
    }
