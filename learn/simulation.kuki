petiole learn

# The Simulation runs a full Race to the Crystal game in-process for a
# learner script. You are player_0; the other players are driven by the
# game's AI strategies (random, aggressive, defensive).
#
# The simulation calls your PlayTurn function once at the start of each of
# your turns. Whatever you leave unfinished when PlayTurn returns is ended
# for you — the turn ends automatically.

import "race-to-the-crystal/game" as gamepkg
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types

const DEFAULT_PLAYERS = 2

const DEFAULT_MAX_TURNS = 200

const MAX_ACTIONS_PER_AI_TURN = 30

type Config
    Players: int
    AIStrategy: gamepkg.AIStrategyName
    MaxTurns: int

func NewConfig() Config
    return Config{
        Players: DEFAULT_PLAYERS,
        AIStrategy: gamepkg.AIStrategyNameRANDOM,
        MaxTurns: DEFAULT_MAX_TURNS,
    }

type Result
    WinnerName: string
    TurnsPlayed: int
    GameEnded: bool
    Reason: string

type Simulation
    game: reference gamepkg.GameState
    learnerId: types.PlayerID
    config: Config

func NewSimulation(cfg: Config) Simulation
    playerCount := cfg.Players
    if playerCount < 1
        playerCount = 1
    if playerCount > 4
        playerCount = 4
    gs := gamepkg.CreateGame(playerCount)
    return Simulation{game: reference of gs, learnerId: types.PlayerID("player_0"), config: cfg}

# Run plays the game until someone wins, the AI gives up, or the turn
# budget runs out. Your play function is called once per learner turn.
func Run on s: reference Simulation(play: func(reference LearnerAPI)) Result
    s.game.StartGame()
    api := NewLearnerAPI(s.game, s.learnerId)

    learnerName := s.playerName(s.learnerId)
    api.Say("Game on! You are {learnerName}. The board is 24x24.")
    api.Say(api.Board())

    turn := 0
    for turn < s.config.MaxTurns
        if s.game.Phase() equals enums.ENDED
            break
        turn = turn + 1

        if s.game.CurrentTurnPlayerID() equals s.learnerId
            play(reference of api)
            if s.game.Phase() isnt enums.ENDED
                if s.game.CurrentTurnPlayerID() equals s.learnerId
                    api.Done()
        else
            aiPid := s.game.CurrentTurnPlayerID()
            s.runAiTurn(aiPid, reference of api)

            # Safety: if the AI failed to advance the turn, force it to end.
            if s.game.Phase() equals enums.PLAYING
                if s.game.CurrentTurnPlayerID() equals aiPid
                    gamepkg.ExecuteAction(gamepkg.NewEndTurnAction(), s.game, aiPid)

    return s.finish(reference of api, turn)

func finish on s: reference Simulation(api: reference LearnerAPI, turn: int) Result
    if s.game.Phase() equals enums.ENDED
        winner := s.playerName(s.game.WinnerID())
        api.Say("")
        api.Say("GAME OVER - {winner} wins!")
        api.Say(api.Board())
        return Result{WinnerName: winner, TurnsPlayed: turn, GameEnded: true, Reason: "winner"}

    api.Say("")
    api.Say("Simulation stopped after {turn} turns (turn budget exhausted).")
    return Result{WinnerName: "", TurnsPlayed: turn, GameEnded: false, Reason: "max_turns"}

func playerName on s: reference Simulation(pid: types.PlayerID) string
    pRef := s.game.GetPlayer(pid)
    if pRef is empty
        return pid as string
    return pRef.Name()

func runAiTurn on s: reference Simulation(aiPid: types.PlayerID, api: reference LearnerAPI)
    aiApi := gamepkg.NewGameAPI(s.game, aiPid)
    guard := 0
    for guard < MAX_ACTIONS_PER_AI_TURN
        if s.game.Phase() isnt enums.PLAYING
            return
        if s.game.CurrentTurnPlayerID() isnt aiPid
            return

        actions := aiApi.Actions()
        if actions is empty
            return

        chosenRef := gamepkg.ChooseAction(s.config.AIStrategy, actions, s.game, aiPid)
        if chosenRef is empty
            return

        action := chosenToAction(dereference chosenRef)
        result := gamepkg.ExecuteAction(action, s.game, aiPid)
        if not result.Success
            return
        guard = guard + 1

func chosenToAction(c: gamepkg.ChosenAction) gamepkg.AIAction
    switch c as v
        when gamepkg.ChosenMove
            dest := types.Pos(v.Destination[0], v.Destination[1])
            return gamepkg.NewMoveAction(v.TokenID, dest)
        when gamepkg.ChosenAttack
            return gamepkg.NewAttackAction(v.AttackerID, v.DefenderID)
        when gamepkg.ChosenDeploy
            pos := types.Pos(v.Position[0], v.Position[1])
            return gamepkg.NewDeployAction(v.HealthValue, pos)
        default
            return gamepkg.NewEndTurnAction()
