petiole main

# 06-loops: for i from and for item in.
#
# Run it with:  kukicha run learn/examples/06-loops/
#
# New ideas: counting loops (for x from 0 to 3), iterating a collection
# (for tid in api.MyTokens()), and break to stop a loop early.

import "race-to-the-crystal/learn" as learn

func DeployIfRoom(api: reference learn.LearnerAPI)
    reserve := api.Reserve()
    if reserve[10] equals 0
        return
    for x from 0 to 3
        result := api.Place(10, x, 2)
        if result.Success
            api.Say("deployed at ({x}, 2)")
            break

func MarchAll(api: reference learn.LearnerAPI)
    moved := 0
    for tid in api.MyTokens()
        pos := api.TokenPosition(tid)
        dx := 0
        dy := 0
        if pos.X < 12
            dx = 1
        else if pos.X > 12
            dx = -1
        if pos.Y < 12
            dy = 1
        else if pos.Y > 12
            dy = -1
        if dx isnt 0 or dy isnt 0
            _ = api.Move(tid, pos.X + dx, pos.Y + dy)
            moved = moved + 1
    api.Say("moved {moved} token(s)")

func PlayTurn(api: reference learn.LearnerAPI)
    api.Say("--- Turn {api.TurnNumber()} ---")
    DeployIfRoom(api)
    MarchAll(api)
    _ = api.Done()

func main()
    sim := learn.NewSimulation(learn.NewConfig())
    sim.Run(PlayTurn)
