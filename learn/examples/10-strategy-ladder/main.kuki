petiole main

# 10-strategy-ladder: the final rung — pick the best attack from the
# game's own action list (kill first, then highest damage), march
# otherwise.
#
# Run it with:  kukicha run learn/examples/10-strategy-ladder/
#
# New ideas: switching over the typed actions api.Actions() returns
# (AttackAction, MoveAction, DeployAction, EndTurnAction) and combining
# everything from the previous chapters into one strategy.

import "race-to-the-crystal/game" as gamepkg
import "race-to-the-crystal/learn" as learn

func BestAttack(api: reference learn.LearnerAPI, actions: list of gamepkg.ActionResponse) bool
    bestDamage := 0
    bestAttacker := 0
    bestDefender := 0
    found := false
    for a in actions
        switch a as v
            when gamepkg.AttackAction
                if not found or v.WillKill or v.Damage > bestDamage
                    bestDamage = v.Damage
                    bestAttacker = v.AttackerID as int
                    bestDefender = v.DefenderID as int
                    found = true
            default
                continue

    if found
        api.Attack(bestAttacker, bestDefender)
    return found

func StepOne(api: reference learn.LearnerAPI, tid: int) bool
    pos := api.TokenPosition(tid)
    dx := 0
    dy := 0
    if pos.X < 12
        dx = 1
    else if pos.X > 12
        dx = -1
    if pos.Y < 12
        dy = 1
    else if pos.Y > 12
        dy = -1
    if dx equals 0 and dy equals 0
        return false
    api.Move(tid, pos.X + dx, pos.Y + dy)
    return true

func PlayTurn(api: reference learn.LearnerAPI)
    api.Say("--- Turn {api.TurnNumber()} ---")

    actions := api.Actions()
    if BestAttack(api, actions)
        return

    moved := false
    for tid in api.MyTokens()
        if StepOne(api, tid)
            moved = true
    if not moved
        if api.Reserve()[10] > 0
            api.Place(10, 2, 2)

    api.Done()

func main()
    sim := learn.NewSimulation(learn.NewConfig())
    sim.Run(PlayTurn)
