# Race to the Crystal - Caddy with Mercure/Vulcain
# Uses custom Caddy binary with mercure and vulcain plugins

FROM caddy:2-alpine

# Copy custom Caddy binary and make executable
COPY caddy /usr/bin/caddy
RUN chmod +x /usr/bin/caddy

# Copy Caddyfile configuration
COPY Caddyfile /etc/caddy/Caddyfile

# Run Caddy
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile"]
