.PHONY: help check build clean-generated desktop desktop-run server server-run web-server web-server-run test test-verbose test-specific clean lint format learn learn-run learn-check learn-test

help: ## Show this help message
	@echo "Race to the Crystal - Available Commands:"
	@echo ""

check: ## Validate all Kukicha syntax
	kukicha check ./...

# `kukicha build` and `kukicha brew` both write the transpiled Go, but only
# build stamps the "Generated by Kukicha" header — and build refuses to
# overwrite a file without it. Removing the generated .go files first keeps
# the two commands from blocking each other.
clean-generated: ## Remove generated .go files (kukicha build/brew artifacts)
	find . -type f -name '*.go' ! -path './.kukicha/*' -delete

build: ## Transpile and build all Kukicha packages
	$(MAKE) clean-generated
	kukicha build ./...

server: ## Build the game server
	$(MAKE) clean-generated
	kukicha build ./server
	go build -o race-server ./server/

server-run: ## Build and run the game server
	$(MAKE) server
	./race-server

desktop: ## Build the desktop client (pure Go; Ebitengine 2.10 needs no C toolchain)
	$(MAKE) clean-generated
	kukicha build ./client/desktop/
	go build -o race-desktop ./client/desktop/

desktop-run: ## Build and run the desktop client
	$(MAKE) desktop
	./race-desktop

ai-client: ## Build the AI client
	$(MAKE) clean-generated
	kukicha build ./client/ai/
	go build -o race-ai-client ./client/ai/

ai-client-run: ## Build and run the AI client
	$(MAKE) ai-client
	./race-ai-client

web-server: ## Build the web server
	$(MAKE) clean-generated
	kukicha build ./web_server

web-server-run: ## Build and run the web server
	$(MAKE) web-server
	./web_server/web_server

learn: ## List learner example scripts
	@ls learn/examples/

learn-run: ## Run a learner example (usage: make learn-run NAME=02-formation)
	kukicha run ./learn/examples/$(NAME)/

learn-check: ## Type-check the learn package and every learner example
	kukicha check ./learn/
	@for d in learn/examples/*/; do kukicha check "$$d"; done

learn-test: ## Brew and run the learn package tests
	kukicha brew ./learn/
	go test ./learn/

# `kukicha brew` transpiles the *_test.kuki sources into *_test.go as well
# as the package sources. `kukicha build` skips the test files, so without
# brew the tests would run against stale, previously-transpiled artifacts.
test: ## Run all tests
	kukicha brew ./...
	go test ./...

test-verbose: ## Run tests with verbose output
	kukicha brew ./...
	go test -v ./...

test-specific: ## Run specific test (usage: make test-specific PKG=./game/...)
	kukicha brew ./...
	go test $(PKG)

clean: ## Remove build artifacts and empty dirs
	$(MAKE) clean-generated
	rm -f desktop race-desktop race-ai-client ai race-server web_server/web_server
	find . -type d -empty -delete 2>/dev/null; true

lint: ## Check formatting
	kukicha fmt --check .

format: ## Auto-format all Kukicha files
	kukicha fmt -w .
