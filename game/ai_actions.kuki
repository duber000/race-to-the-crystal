petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types

type JSONMap = map of string to any

enum AIAction
    Move
        TokenID: types.TokenID
        Destination: types.Position
    Attack
        AttackerID: types.TokenID
        DefenderID: types.TokenID
    Deploy
        HealthValue: int
        Position: types.Position
    EndTurn

type ValidationResult
    IsValid: bool
    Message: string

enum ActionResultData
    NoData
    MoveData
        TokenID: types.TokenID
        OldPosition: list of int
        NewPosition: list of int
        MysteryTriggered: bool
        MysteryEffect: enums.MysteryEffect
    AttackData
        AttackerID: types.TokenID
        DefenderID: types.TokenID
        DamageDealt: int
        DefenderKilled: bool
    DeployData
        NewTokenID: types.TokenID
        HealthValue: int
        Position: list of int
        TokensRemaining: int
    TurnEndData
        TurnNumber: int
        NextPlayerID: types.PlayerID
        GeneratorsDisabled: list of int
        CrystalCaptured: bool

type ActionResult
    Success: bool
    Message: string
    Data: ActionResultData

func ValidResult(msg: string) ValidationResult
    return ValidationResult{IsValid: true, Message: msg}

func InvalidResult(msg: string) ValidationResult
    return ValidationResult{IsValid: false, Message: msg}

func SuccessResult(msg: string, d: ActionResultData) ActionResult
    return ActionResult{Success: true, Message: msg, Data: d}

func FailureResult(msg: string) ActionResult
    return ActionResult{Success: false, Message: msg, Data: NoData{}}

func NewEmptyResultData() ActionResultData
    return NoData{}

func ValidateGamePhase on gs: reference GameState optional reference ValidationResult
    if gs.phase isnt enums.PLAYING
        r := InvalidResult("ACTION_FAILED: wrong_game_phase | current={gs.phase} | required=PLAYING")
        return reference of r
    return empty

func ValidatePlayerTurn on gs: reference GameState(player_id: types.PlayerID) optional reference ValidationResult
    if gs.current_turn_player_id isnt player_id
        r := InvalidResult(
            "ACTION_FAILED: not_your_turn | current_player={gs.current_turn_player_id} | you={player_id}",
        )
        return reference of r
    return empty

func ValidateTurnPhase on gs: reference GameState(required: enums.TurnPhase, action_name: string) optional reference ValidationResult
    if gs.turn_phase isnt required
        r := InvalidResult(
            "{action_name}_FAILED: wrong_phase | current={gs.turn_phase} | required={required}",
        )
        return reference of r
    return empty

func ValidateTokenExists on gs: reference GameState(TokenID: types.TokenID, action_name: string) (ValidationResult, optional reference Token)
    tok := gs.GetToken(TokenID)
    if tok equals empty
        r := InvalidResult("{action_name}_FAILED: token_not_found | token_id={TokenID}")
        return r, empty
    return ValidResult(""), tok

func ValidateTokenOwnership(tok: reference Token, player_id: types.PlayerID, action_name: string) ValidationResult
    if tok.player_id isnt player_id
        return InvalidResult("{action_name}_FAILED: not_owner | token_id={tok.id} | owner={tok.player_id}")
    return ValidResult("")

func ValidateTokenDeployed(tok: reference Token, action_name: string) ValidationResult
    if not tok.is_deployed
        return InvalidResult(
            "{action_name}_FAILED: not_deployed | token_id={tok.id} | hint=Use DEPLOY action first",
        )
    return ValidResult("")

func ValidateTokenAlive(tok: reference Token, action_name: string) ValidationResult
    if not tok.is_alive
        return InvalidResult("{action_name}_FAILED: token_dead | token_id={tok.id}")
    return ValidResult("")

func ValidateAction(action: AIAction, gs: reference GameState, player_id: types.PlayerID) ValidationResult
    phase_result := gs.ValidateGamePhase()
    if phase_result isnt empty
        return dereference phase_result

    turn_result := gs.ValidatePlayerTurn(player_id)
    if turn_result isnt empty
        return dereference turn_result

    switch action
        when Move
            return ValidateMove(action.TokenID, action.Destination, gs, player_id)
        when Attack
            return ValidateAttack(action.AttackerID, action.DefenderID, gs, player_id)
        when Deploy
            return ValidateDeploy(action.HealthValue, action.Position, gs, player_id)
        when EndTurn
            return ValidateEndTurn(gs)

func ValidateMove(TokenID: types.TokenID, dest: types.Position, gs: reference GameState, player_id: types.PlayerID) ValidationResult
    tp_result := gs.ValidateTurnPhase(enums.MOVEMENT, "MOVE")
    if tp_result isnt empty
        return dereference tp_result

    tok_result, tok_ref := gs.ValidateTokenExists(TokenID, "MOVE")
    if tok_ref equals empty
        return tok_result

    own_result := ValidateTokenOwnership(tok_ref, player_id, "MOVE")
    if not own_result.IsValid
        return own_result

    dep_result := ValidateTokenDeployed(tok_ref, "MOVE")
    if not dep_result.IsValid
        return dep_result

    alive_result := ValidateTokenAlive(tok_ref, "MOVE")
    if not alive_result.IsValid
        return alive_result

    effective_range := gs.GetTokenMovementRange(tok_ref)
    valid_moves := get_valid_moves(tok_ref, reference of gs.board, effective_range, gs.tokens)
    found := false
    for m in valid_moves
        if m equals dest
            found = true
            break
    if not found
        return InvalidResult(
            "MOVE_FAILED: invalid_destination | dest=({dest.X},{dest.Y}) | token_pos=({tok_ref.position.X},{tok_ref.position.Y}) | range={effective_range} | valid_count={len(valid_moves)}",
        )
    return ValidResult("Move is valid")

func ValidateAttack(AttackerID: types.TokenID, DefenderID: types.TokenID, gs: reference GameState, player_id: types.PlayerID) ValidationResult
    tp_result := gs.ValidateTurnPhase(enums.ACTION, "ATTACK")
    if tp_result isnt empty
        return dereference tp_result

    att_result, att_ref := gs.ValidateTokenExists(AttackerID, "ATTACK")
    if att_ref equals empty
        return att_result

    own_result := ValidateTokenOwnership(att_ref, player_id, "ATTACK")
    if not own_result.IsValid
        return own_result

    dep_result := ValidateTokenDeployed(att_ref, "ATTACK")
    if not dep_result.IsValid
        return dep_result

    alive_result := ValidateTokenAlive(att_ref, "ATTACK")
    if not alive_result.IsValid
        return alive_result

    def_result, def_ref := gs.ValidateTokenExists(DefenderID, "ATTACK")
    if def_ref equals empty
        return def_result

    if def_ref.player_id equals player_id
        return InvalidResult(
            "ATTACK_FAILED: friendly_fire | defender_id={DefenderID} | hint=Cannot attack own tokens",
        )

    def_dep := ValidateTokenDeployed(def_ref, "ATTACK")
    if not def_dep.IsValid
        return def_dep

    def_alive := ValidateTokenAlive(def_ref, "ATTACK")
    if not def_alive.IsValid
        return def_alive

    if not can_attack(att_ref, def_ref)
        return InvalidResult(
            "ATTACK_FAILED: not_adjacent | attacker_pos=({att_ref.position.X},{att_ref.position.Y}) | defender_pos=({def_ref.position.X},{def_ref.position.Y})",
        )
    return ValidResult("Attack is valid")

func ValidateDeploy(HealthValue: int, pos: types.Position, gs: reference GameState, player_id: types.PlayerID) ValidationResult
    tp_result := gs.ValidateTurnPhase(enums.MOVEMENT, "DEPLOY")
    if tp_result isnt empty
        return dereference tp_result

    valid_hv := false
    for hv in constants.TOKEN_HEALTH_VALUES
        if hv equals HealthValue
            valid_hv = true
            break
    if not valid_hv
        return InvalidResult(
            "DEPLOY_FAILED: invalid_health | value={HealthValue} | valid={constants.TOKEN_HEALTH_VALUES}",
        )

    reserve_counts := gs.GetReserveTokenCounts(player_id)
    if reserve_counts[HealthValue] <= 0
        return InvalidResult("DEPLOY_FAILED: no_reserve | health={HealthValue}")

    if not gs.board.is_valid_position(pos.X, pos.Y)
        return InvalidResult("DEPLOY_FAILED: out_of_bounds | pos=({pos.X},{pos.Y}) | board_size=24x24")

    cell := gs.board.get_cell_at(pos)
    if cell isnt empty and dereference cell.is_occupied()
        return InvalidResult("DEPLOY_FAILED: cell_occupied | pos=({pos.X},{pos.Y})")

    p_ref := gs.GetPlayer(player_id)
    if p_ref equals empty
        return InvalidResult("DEPLOY_FAILED: player_not_found | player_id={player_id}")
    p := dereference p_ref

    valid_positions := gs.board.get_deployable_positions(enums.PlayerIndex(p.color))
    in_zone := false
    for vp in valid_positions
        if vp equals pos
            in_zone = true
            break
    if not in_zone
        return InvalidResult("DEPLOY_FAILED: invalid_position | pos=({pos.X},{pos.Y})")
    return ValidResult("Deployment is valid")

func ValidateEndTurn(gs: reference GameState) ValidationResult
    if gs.turn_phase isnt enums.MOVEMENT and gs.turn_phase isnt enums.ACTION
        return InvalidResult("Cannot end turn: Invalid phase ({gs.turn_phase})")
    return ValidResult("Can end turn")

func ExecuteAction(action: AIAction, gs: reference GameState, player_id: types.PlayerID) ActionResult
    validation := ValidateAction(action, gs, player_id)
    if not validation.IsValid
        return FailureResult(validation.Message)

    switch action
        when Move
            return ExecuteMove(action.TokenID, action.Destination, gs, player_id)
        when Attack
            return ExecuteAttack(action.AttackerID, action.DefenderID, gs, player_id)
        when Deploy
            return ExecuteDeploy(action.HealthValue, action.Position, gs, player_id)
        when EndTurn
            return ExecuteEndTurn(gs)

func ExecuteMove(TokenID: types.TokenID, dest: types.Position, gs: reference GameState, player_id: types.PlayerID) ActionResult
    tok_ref := gs.GetToken(TokenID)
    if tok_ref equals empty
        return FailureResult("Token {TokenID} not found")
    tok := dereference tok_ref
    old_pos := tok.position

    success := gs.MoveToken(TokenID, dest)
    if not success
        return FailureResult("Move failed unexpectedly")

    message := "Token #{TokenID} moved from ({old_pos.X},{old_pos.Y}) to ({dest.X},{dest.Y})"
    mystery_triggered := false
    var mystery_eff enums.MysteryEffect

    cell := gs.board.get_cell_at(dest)
    if cell isnt empty and dereference cell.cell_type equals enums.MYSTERY
        p_ref := gs.GetPlayer(player_id)
        if p_ref isnt empty
            p := dereference p_ref
            player_index := enums.PlayerIndex(p.color)
            mystery_result := trigger_mystery_event(tok_ref, reference of gs.board, player_index)

            gs.last_triggered_mystery_event = reference of MysteryEvent{
                TokenID: TokenID,
                Position: dest,
                effect: enums.MysteryEffectName(mystery_result.effect),
            }

            message = message + "\n  Token landed on a MYSTERY square!"
            mystery_triggered = true
            mystery_eff = mystery_result.effect

            if mystery_result.effect equals enums.HEAL
                message = message + "\n  HEADS! Token healed from {mystery_result.old_health} to {mystery_result.new_health} HP!"
            else
                gs.board.clear_occupant(dest, TokenID)
                gs.board.set_occupant(mystery_result.new_position, TokenID)
                message = message + "\n  TAILS! Token teleported back to deployment area ({mystery_result.new_position.X},{mystery_result.new_position.Y})!"

    gs.turn_phase = enums.ACTION
    message = message + "\n  Phase changed to ACTION (you can attack or end turn)"

    if mystery_triggered
        return SuccessResult(message, MoveData{
            TokenID: TokenID,
            OldPosition: list of int{old_pos.X, old_pos.Y},
            NewPosition: list of int{dest.X, dest.Y},
            MysteryTriggered: true,
            MysteryEffect: mystery_eff,
        })
    return SuccessResult(message, MoveData{
        TokenID: TokenID,
        OldPosition: list of int{old_pos.X, old_pos.Y},
        NewPosition: list of int{dest.X, dest.Y},
    })

func ExecuteAttack(AttackerID: types.TokenID, DefenderID: types.TokenID, gs: reference GameState, player_id: types.PlayerID) ActionResult
    def_ref := gs.GetToken(DefenderID)
    if def_ref equals empty
        return FailureResult("Defender token {DefenderID} not found")
    defn := dereference def_ref
    def_player := gs.GetPlayer(defn.player_id)
    def_owner := "Unknown"
    if def_player isnt empty
        def_owner = dereference def_player.name

    outcome := gs.AttackToken(AttackerID, DefenderID)
    if outcome equals empty
        return FailureResult("Attack failed (invalid attacker or defender)")
    o := dereference outcome

    message := "Token #{AttackerID} attacked token #{DefenderID} ({def_owner})\n  Dealt {o.damage_dealt} damage"

    if o.defender_killed
        message = message + "\n  Token #{DefenderID} was KILLED!"
    else
        current_hp := defn.health
        if def_ref isnt empty
            current_hp = dereference def_ref.health
        message = message + "\n  Token #{DefenderID} now has {current_hp}hp"

    return SuccessResult(message, AttackData{
        AttackerID: AttackerID,
        DefenderID: DefenderID,
        DamageDealt: o.damage_dealt,
        DefenderKilled: o.defender_killed,
    })

func ExecuteDeploy(HealthValue: int, pos: types.Position, gs: reference GameState, player_id: types.PlayerID) ActionResult
    new_tok := gs.DeployToken(player_id, HealthValue, pos)
    if new_tok equals empty
        return FailureResult("Deployment failed unexpectedly")

    t := dereference new_tok
    message := "Deployed {HealthValue}hp token #{t.id} at ({pos.X},{pos.Y})"

    reserve_counts := gs.GetReserveTokenCounts(player_id)
    remaining := reserve_counts[HealthValue]
    message = message + "\n  {remaining} x {HealthValue}hp tokens remaining in reserve"

    gs.turn_phase = enums.ACTION
    message = message + "\n  Phase changed to ACTION (you can attack or end turn)"

    return SuccessResult(message, DeployData{
        NewTokenID: t.id,
        HealthValue: HealthValue,
        Position: list of int{pos.X, pos.Y},
        TokensRemaining: remaining,
    })

func ExecuteEndTurn(gs: reference GameState) ActionResult
    newly_disabled, crystal_captured, _ := gs.EndTurnWithObjectiveUpdate()

    new_player := gs.GetCurrentPlayer()
    new_player_name := "Unknown"
    if new_player isnt empty
        new_player_name = dereference new_player.name

    message := "Turn ended\n  Turn {gs.turn_number} begins\n  Current player: {new_player_name}"

    return SuccessResult(message, TurnEndData{
        TurnNumber: gs.turn_number,
        NextPlayerID: gs.current_turn_player_id,
        GeneratorsDisabled: newly_disabled,
        CrystalCaptured: crystal_captured,
    })

func NewMoveAction(token_id: types.TokenID, dest: types.Position) AIAction
    return Move{TokenID: token_id, Destination: dest}

func NewAttackAction(attacker_id: types.TokenID, defender_id: types.TokenID) AIAction
    return Attack{AttackerID: attacker_id, DefenderID: defender_id}

func NewDeployAction(health_value: int, pos: types.Position) AIAction
    return Deploy{HealthValue: health_value, Position: pos}

func NewEndTurnAction() AIAction
    return EndTurn{}

func ActionDataToDict(d: ActionResultData) map of string to any
    switch d
        when NoData
            return map of string to any{"type": "NoData"}
        when MoveData
            m := map of string to any{
                "type": "MoveData",
                "token_id": d.TokenID,
                "old_position": d.OldPosition,
                "new_position": d.NewPosition,
                "mystery_triggered": d.MysteryTriggered,
            }
            if d.MysteryTriggered
                m["mystery_effect"] = d.MysteryEffect.String()
            return m
        when AttackData
            return map of string to any{
                "type": "AttackData",
                "attacker_id": d.AttackerID,
                "defender_id": d.DefenderID,
                "damage_dealt": d.DamageDealt,
                "defender_killed": d.DefenderKilled,
            }
        when DeployData
            return map of string to any{
                "type": "DeployData",
                "new_token_id": d.NewTokenID,
                "health_value": d.HealthValue,
                "position": d.Position,
                "tokens_remaining": d.TokensRemaining,
            }
        when TurnEndData
            return map of string to any{
                "type": "TurnEndData",
                "turn_number": d.TurnNumber,
                "next_player_id": d.NextPlayerID,
                "generators_disabled": d.GeneratorsDisabled,
                "crystal_captured": d.CrystalCaptured,
            }
