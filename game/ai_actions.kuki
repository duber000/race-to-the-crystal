petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/slice"

type JSONMap = map of string to any

enum AIAction
    Move
        TokenID: types.TokenID
        Destination: types.Position
    Attack
        AttackerID: types.TokenID
        DefenderID: types.TokenID
    Deploy
        HealthValue: int
        Position: types.Position
    EndTurn

type ValidationResult
    IsValid: bool
    Message: string

enum ActionResultData
    NoData
    MoveData
        TokenID: types.TokenID
        OldPosition: list of int
        NewPosition: list of int
        MysteryTriggered: bool
        MysteryEffect: enums.MysteryEffect
    AttackData
        AttackerID: types.TokenID
        DefenderID: types.TokenID
        DamageDealt: int
        DefenderKilled: bool
    DeployData
        NewTokenID: types.TokenID
        HealthValue: int
        Position: list of int
        TokensRemaining: int
    TurnEndData
        TurnNumber: int
        NextPlayerID: types.PlayerID
        GeneratorsDisabled: list of int
        CrystalCaptured: bool

type ActionResult
    Success: bool
    Message: string
    Data: ActionResultData

func ValidResult(msg: string) ValidationResult
    return ValidationResult{IsValid: true, Message: msg}

func InvalidResult(msg: string) ValidationResult
    return ValidationResult{IsValid: false, Message: msg}

func SuccessResult(msg: string, d: ActionResultData) ActionResult
    return ActionResult{Success: true, Message: msg, Data: d}

func FailureResult(msg: string) ActionResult
    return ActionResult{Success: false, Message: msg, Data: NoData{}}

func NewEmptyResultData() ActionResultData
    return NoData{}

func ValidateGamePhase on gs: reference GameState optional reference ValidationResult
    if gs.phase isnt enums.PLAYING
        r := InvalidResult("ACTION_FAILED: wrong_game_phase | current={gs.phase} | required=PLAYING")
        return reference of r
    return empty

func ValidatePlayerTurn on gs: reference GameState(playerId: types.PlayerID) optional reference ValidationResult
    if gs.currentTurnPlayerId isnt playerId
        r := InvalidResult(
            "ACTION_FAILED: not_your_turn | current_player={gs.currentTurnPlayerId} | you={playerId}",
        )
        return reference of r
    return empty

func ValidateTurnPhase on gs: reference GameState(required: enums.TurnPhase, actionName: string) optional reference ValidationResult
    if gs.turnPhase isnt required
        r := InvalidResult(
            "{actionName}_FAILED: wrong_phase | current={gs.turnPhase} | required={required}",
        )
        return reference of r
    return empty

func ValidateTokenExists on gs: reference GameState(TokenID: types.TokenID, actionName: string) (ValidationResult, optional reference Token)
    tok := gs.GetToken(TokenID)
    if tok is empty
        r := InvalidResult("{actionName}_FAILED: token_not_found | token_id={TokenID}")
        return r, empty
    return ValidResult(""), tok

func ValidateTokenOwnership(tok: reference Token, playerId: types.PlayerID, actionName: string) ValidationResult
    if tok.playerId isnt playerId
        return InvalidResult("{actionName}_FAILED: not_owner | token_id={tok.id} | owner={tok.playerId}")
    return ValidResult("")

func ValidateTokenDeployed(tok: reference Token, actionName: string) ValidationResult
    if not tok.isDeployed
        return InvalidResult(
            "{actionName}_FAILED: not_deployed | token_id={tok.id} | hint=Use DEPLOY action first",
        )
    return ValidResult("")

func ValidateTokenAlive(tok: reference Token, actionName: string) ValidationResult
    if not tok.isAlive
        return InvalidResult("{actionName}_FAILED: token_dead | token_id={tok.id}")
    return ValidResult("")

func ValidateAction(action: AIAction, gs: reference GameState, playerId: types.PlayerID) ValidationResult
    phaseResult := gs.ValidateGamePhase()
    if phaseResult isnt empty
        return dereference phaseResult

    turnResult := gs.ValidatePlayerTurn(playerId)
    if turnResult isnt empty
        return dereference turnResult

    switch action
        when Move
            return ValidateMove(action.TokenID, action.Destination, gs, playerId)
        when Attack
            return ValidateAttack(action.AttackerID, action.DefenderID, gs, playerId)
        when Deploy
            return ValidateDeploy(action.HealthValue, action.Position, gs, playerId)
        when EndTurn
            return ValidateEndTurn(gs)

func ValidateMove(TokenID: types.TokenID, dest: types.Position, gs: reference GameState, playerId: types.PlayerID) ValidationResult
    tpResult := gs.ValidateTurnPhase(enums.MOVEMENT, "MOVE")
    if tpResult isnt empty
        return dereference tpResult

    tokResult, tokRef := gs.ValidateTokenExists(TokenID, "MOVE")
    if tokRef is empty
        return tokResult

    ownResult := ValidateTokenOwnership(tokRef, playerId, "MOVE")
    if not ownResult.IsValid
        return ownResult

    depResult := ValidateTokenDeployed(tokRef, "MOVE")
    if not depResult.IsValid
        return depResult

    aliveResult := ValidateTokenAlive(tokRef, "MOVE")
    if not aliveResult.IsValid
        return aliveResult

    effectiveRange := gs.GetTokenMovementRange(tokRef)
    validMoves := getValidMoves(tokRef, reference of gs.board, effectiveRange, gs.tokens)
    if not slice.Contains(validMoves, dest)
        return InvalidResult(
            "MOVE_FAILED: invalid_destination | dest=({dest.X},{dest.Y}) | token_pos=({tokRef.position.X},{tokRef.position.Y}) | range={effectiveRange} | valid_count={len(validMoves)}",
        )
    return ValidResult("Move is valid")

func ValidateAttack(AttackerID: types.TokenID, DefenderID: types.TokenID, gs: reference GameState, playerId: types.PlayerID) ValidationResult
    tpResult := gs.ValidateTurnPhase(enums.ACTION, "ATTACK")
    if tpResult isnt empty
        return dereference tpResult

    attResult, attRef := gs.ValidateTokenExists(AttackerID, "ATTACK")
    if attRef is empty
        return attResult

    ownResult := ValidateTokenOwnership(attRef, playerId, "ATTACK")
    if not ownResult.IsValid
        return ownResult

    depResult := ValidateTokenDeployed(attRef, "ATTACK")
    if not depResult.IsValid
        return depResult

    aliveResult := ValidateTokenAlive(attRef, "ATTACK")
    if not aliveResult.IsValid
        return aliveResult

    defResult, defRef := gs.ValidateTokenExists(DefenderID, "ATTACK")
    if defRef is empty
        return defResult

    if defRef.playerId equals playerId
        return InvalidResult(
            "ATTACK_FAILED: friendly_fire | defender_id={DefenderID} | hint=Cannot attack own tokens",
        )

    defDep := ValidateTokenDeployed(defRef, "ATTACK")
    if not defDep.IsValid
        return defDep

    defAlive := ValidateTokenAlive(defRef, "ATTACK")
    if not defAlive.IsValid
        return defAlive

    if not canAttack(attRef, defRef)
        return InvalidResult(
            "ATTACK_FAILED: not_adjacent | attacker_pos=({attRef.position.X},{attRef.position.Y}) | defender_pos=({defRef.position.X},{defRef.position.Y})",
        )
    return ValidResult("Attack is valid")

func ValidateDeploy(HealthValue: int, pos: types.Position, gs: reference GameState, playerId: types.PlayerID) ValidationResult
    tpResult := gs.ValidateTurnPhase(enums.MOVEMENT, "DEPLOY")
    if tpResult isnt empty
        return dereference tpResult

    if not slice.Contains(constants.TOKEN_HEALTH_VALUES, HealthValue)
        return InvalidResult(
            "DEPLOY_FAILED: invalid_health | value={HealthValue} | valid={constants.TOKEN_HEALTH_VALUES}",
        )

    reserveCounts := gs.GetReserveTokenCounts(playerId)
    if reserveCounts[HealthValue] <= 0
        return InvalidResult("DEPLOY_FAILED: no_reserve | health={HealthValue}")

    if not gs.board.isValidPosition(pos.X, pos.Y)
        return InvalidResult("DEPLOY_FAILED: out_of_bounds | pos=({pos.X},{pos.Y}) | board_size=24x24")

    cell := gs.board.getCellAt(pos)
    if cell isnt empty
        if cell.isOccupied()
            return InvalidResult("DEPLOY_FAILED: cell_occupied | pos=({pos.X},{pos.Y})")

    pRef := gs.GetPlayer(playerId)
    if pRef is empty
        return InvalidResult("DEPLOY_FAILED: player_not_found | player_id={playerId}")
    p := dereference pRef

    validPositions := gs.board.getDeployablePositions(enums.PlayerIndex(p.color))
    if not slice.Contains(validPositions, pos)
        return InvalidResult("DEPLOY_FAILED: invalid_position | pos=({pos.X},{pos.Y})")
    return ValidResult("Deployment is valid")

func ValidateEndTurn(gs: reference GameState) ValidationResult
    if gs.turnPhase isnt enums.MOVEMENT and gs.turnPhase isnt enums.ACTION
        return InvalidResult("Cannot end turn: Invalid phase ({gs.turnPhase})")
    return ValidResult("Can end turn")

func ExecuteAction(action: AIAction, gs: reference GameState, playerId: types.PlayerID) ActionResult
    validation := ValidateAction(action, gs, playerId)
    if not validation.IsValid
        return FailureResult(validation.Message)

    switch action
        when Move
            return ExecuteMove(action.TokenID, action.Destination, gs, playerId)
        when Attack
            return ExecuteAttack(action.AttackerID, action.DefenderID, gs, playerId)
        when Deploy
            return ExecuteDeploy(action.HealthValue, action.Position, gs, playerId)
        when EndTurn
            return ExecuteEndTurn(gs)

func ExecuteMove(TokenID: types.TokenID, dest: types.Position, gs: reference GameState, playerId: types.PlayerID) ActionResult
    tokRef := gs.GetToken(TokenID)
    if tokRef is empty
        return FailureResult("Token {TokenID} not found")
    tok := dereference tokRef
    oldPos := tok.position

    success := gs.MoveToken(TokenID, dest)
    if not success
        return FailureResult("Move failed unexpectedly")

    message := "Token #{TokenID} moved from ({oldPos.X},{oldPos.Y}) to ({dest.X},{dest.Y})"
    mysteryTriggered := false
    var mysteryEff: enums.MysteryEffect

    cell := gs.board.getCellAt(dest)
    if cell isnt empty
        if cell.cellType equals enums.MYSTERY
            pRef := gs.GetPlayer(playerId)
            if pRef isnt empty
                p := dereference pRef
                playerIndex := enums.PlayerIndex(p.color)
                mysteryResult := triggerMysteryEvent(tokRef, reference of gs.board, playerIndex)

                gs.lastTriggeredMysteryEvent = reference of MysteryEvent{
                    TokenID: TokenID,
                    Position: dest,
                    effect: "{mysteryResult.effect}",
                }

                message = message + "\n  Token landed on a MYSTERY square!"
                mysteryTriggered = true
                mysteryEff = mysteryResult.effect

                if mysteryResult.effect equals enums.HEAL
                    message = message + "\n  HEADS! Token healed from {mysteryResult.oldHealth} to {mysteryResult.newHealth} HP!"
                else
                    gs.board.clearOccupant(dest, TokenID)
                    gs.board.setOccupant(mysteryResult.newPosition, TokenID)
                    message = message + "\n  TAILS! Token teleported back to deployment area ({mysteryResult.newPosition.X},{mysteryResult.newPosition.Y})!"

    gs.turnPhase = enums.ACTION
    message = message + "\n  Phase changed to ACTION (you can attack or end turn)"

    if mysteryTriggered
        return SuccessResult(message, MoveData{
            TokenID: TokenID,
            OldPosition: list of int{oldPos.X, oldPos.Y},
            NewPosition: list of int{dest.X, dest.Y},
            MysteryTriggered: true,
            MysteryEffect: mysteryEff,
        })
    return SuccessResult(message, MoveData{
        TokenID: TokenID,
        OldPosition: list of int{oldPos.X, oldPos.Y},
        NewPosition: list of int{dest.X, dest.Y},
    })

func ExecuteAttack(AttackerID: types.TokenID, DefenderID: types.TokenID, gs: reference GameState, playerId: types.PlayerID) ActionResult
    defRef := gs.GetToken(DefenderID)
    if defRef is empty
        return FailureResult("Defender token {DefenderID} not found")
    defn := dereference defRef
    defPlayer := gs.GetPlayer(defn.playerId)
    defOwner := "Unknown"
    if defPlayer isnt empty
        defOwner = defPlayer.name

    outcome := gs.AttackToken(AttackerID, DefenderID)
    if outcome is empty
        return FailureResult("Attack failed (invalid attacker or defender)")
    o := dereference outcome

    message := "Token #{AttackerID} attacked token #{DefenderID} ({defOwner})\n  Dealt {o.damageDealt} damage"

    if o.defenderKilled
        message = message + "\n  Token #{DefenderID} was KILLED!"
    else
        currentHp := defn.health
        if defRef isnt empty
            currentHp = defRef.health
        message = message + "\n  Token #{DefenderID} now has {currentHp}hp"

    return SuccessResult(message, AttackData{
        AttackerID: AttackerID,
        DefenderID: DefenderID,
        DamageDealt: o.damageDealt,
        DefenderKilled: o.defenderKilled,
    })

func ExecuteDeploy(HealthValue: int, pos: types.Position, gs: reference GameState, playerId: types.PlayerID) ActionResult
    newTok := gs.DeployToken(playerId, HealthValue, pos)
    if newTok is empty
        return FailureResult("Deployment failed unexpectedly")

    t := dereference newTok
    message := "Deployed {HealthValue}hp token #{t.id} at ({pos.X},{pos.Y})"

    reserveCounts := gs.GetReserveTokenCounts(playerId)
    remaining := reserveCounts[HealthValue]
    message = message + "\n  {remaining} x {HealthValue}hp tokens remaining in reserve"

    gs.turnPhase = enums.ACTION
    message = message + "\n  Phase changed to ACTION (you can attack or end turn)"

    return SuccessResult(message, DeployData{
        NewTokenID: t.id,
        HealthValue: HealthValue,
        Position: list of int{pos.X, pos.Y},
        TokensRemaining: remaining,
    })

func ExecuteEndTurn(gs: reference GameState) ActionResult
    newlyDisabled, crystalCaptured, _ := gs.EndTurnWithObjectiveUpdate()

    newPlayer := gs.GetCurrentPlayer()
    newPlayerName := "Unknown"
    if newPlayer isnt empty
        newPlayerName = newPlayer.name

    message := "Turn ended\n  Turn {gs.turnNumber} begins\n  Current player: {newPlayerName}"

    return SuccessResult(message, TurnEndData{
        TurnNumber: gs.turnNumber,
        NextPlayerID: gs.currentTurnPlayerId,
        GeneratorsDisabled: newlyDisabled,
        CrystalCaptured: crystalCaptured,
    })

func NewMoveAction(tokenId: types.TokenID, dest: types.Position) AIAction
    return Move{TokenID: tokenId, Destination: dest}

func NewAttackAction(attackerId: types.TokenID, defenderId: types.TokenID) AIAction
    return Attack{AttackerID: attackerId, DefenderID: defenderId}

func NewDeployAction(healthValue: int, pos: types.Position) AIAction
    return Deploy{HealthValue: healthValue, Position: pos}

func NewEndTurnAction() AIAction
    return EndTurn{}

func ActionDataToDict(d: ActionResultData) map of string to any
    switch d
        when NoData
            return map of string to any{"type": "NoData"}
        when MoveData
            m := map of string to any{
                "type": "MoveData",
                "token_id": d.TokenID,
                "old_position": d.OldPosition,
                "new_position": d.NewPosition,
                "mystery_triggered": d.MysteryTriggered,
            }
            if d.MysteryTriggered
                m["mystery_effect"] = "{d.MysteryEffect}"
            return m
        when AttackData
            return map of string to any{
                "type": "AttackData",
                "attacker_id": d.AttackerID,
                "defender_id": d.DefenderID,
                "damage_dealt": d.DamageDealt,
                "defender_killed": d.DefenderKilled,
            }
        when DeployData
            return map of string to any{
                "type": "DeployData",
                "new_token_id": d.NewTokenID,
                "health_value": d.HealthValue,
                "position": d.Position,
                "tokens_remaining": d.TokensRemaining,
            }
        when TurnEndData
            return map of string to any{
                "type": "TurnEndData",
                "turn_number": d.TurnNumber,
                "next_player_id": d.NextPlayerID,
                "generators_disabled": d.GeneratorsDisabled,
                "crystal_captured": d.CrystalCaptured,
            }
