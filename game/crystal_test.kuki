petiole game

import "race-to-the-crystal/shared/types" as types
import "stdlib/test"
import "testing"

func TestNewCrystal(t: reference testing.T)
    c := NewCrystal(types.Pos(12, 12))
    test.AssertEqual(t, c.position, types.Pos(12, 12))
    test.AssertEqual(t, c.holdingPlayerId, types.PlayerID(""))
    test.AssertEqual(t, len(c.holdingTokenIds), 0)
    test.AssertEqual(t, c.turnsHeld, 0)
    test.AssertEqual(t, c.baseTokensRequired, 12)
    test.AssertFalse(t, c.isContested())

func TestCrystalTurnsRequired(t: reference testing.T)
    c := NewCrystal(types.Pos(12, 12))
    test.AssertEqual(t, c.turnsRequired(), 3)

func TestCrystalTokensRequiredNoGenerators(t: reference testing.T)
    c := NewCrystal(types.Pos(12, 12))
    test.AssertEqual(t, c.getTokensRequired(0), 12)

func TestCrystalTokensRequiredWithGenerators(t: reference testing.T)
    c := NewCrystal(types.Pos(12, 12))
    test.AssertEqual(t, c.getTokensRequired(1), 10)
    test.AssertEqual(t, c.getTokensRequired(2), 8)
    test.AssertEqual(t, c.getTokensRequired(3), 6)
    test.AssertEqual(t, c.getTokensRequired(4), 4)

func TestCrystalTokensRequiredMinimum(t: reference testing.T)
    c := NewCrystal(types.Pos(12, 12))
    test.AssertEqual(t, c.getTokensRequired(10), 1)
    test.AssertEqual(t, c.getTokensRequired(100), 1)

func TestCrystalCaptureNoTokens(t: reference testing.T)
    c := NewCrystal(types.Pos(12, 12))
    outcome := c.updateCaptureStatus(empty list of TokenAtPos, 0)
    test.AssertFalse(t, outcome.isWinner)
    test.AssertEqual(t, outcome.winnerId, types.PlayerID(""))

func TestCrystalCaptureInsufficientTokens(t: reference testing.T)
    c := NewCrystal(types.Pos(12, 12))
    tokens := list of TokenAtPos{
        {tokenId: types.TokenID(1), playerId: types.PlayerID("p1")},
    }
    outcome := c.updateCaptureStatus(tokens, 0)
    test.AssertFalse(t, outcome.isWinner)

func TestCrystalCaptureStart(t: reference testing.T)
    c := NewCrystal(types.Pos(12, 12))
    tokens := make12Tokens("p1")
    outcome := c.updateCaptureStatus(tokens, 0)
    test.AssertFalse(t, outcome.isWinner)
    test.AssertEqual(t, c.holdingPlayerId, types.PlayerID("p1"))
    test.AssertEqual(t, c.turnsHeld, 1)

func TestCrystalCaptureWin(t: reference testing.T)
    c := NewCrystal(types.Pos(12, 12))
    tokens := make12Tokens("p1")
    c.updateCaptureStatus(tokens, 0)
    outcome := c.updateCaptureStatus(tokens, 0)
    test.AssertFalse(t, outcome.isWinner)
    outcome = c.updateCaptureStatus(tokens, 0)
    test.AssertTrue(t, outcome.isWinner)
    test.AssertEqual(t, outcome.winnerId, types.PlayerID("p1"))

func make12Tokens(pidStr: string) list of TokenAtPos
    result := make(list of TokenAtPos, 0, 12)
    for i from 0 to 12
        result = append(result, TokenAtPos{
            tokenId: types.TokenID(i),
            playerId: types.PlayerID(pidStr),
        })
    return result
