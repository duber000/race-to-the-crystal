petiole game

import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types

import "github.com/kukichalang/kukicha/stdlib/random"

type MysteryEventResult
    effect enums.MysteryEffect
    token_id types.TokenID
    old_position types.Position
    new_position types.Position
    old_health int
    new_health int

func trigger_mystery_event(tok: reference Token, brd: reference Board, player_index: int) MysteryEventResult
    old_pos := tok.position
    old_hp := tok.health

    is_heads := random.Int(0, 2) == 0

    if is_heads
        tok.heal_to_full()
        return MysteryEventResult{
            effect: enums.HEAL,
            token_id: tok.id,
            old_position: old_pos,
            new_position: tok.position,
            old_health: old_hp,
            new_health: tok.health,
        }

    deploy_positions := brd.get_deployable_positions(player_index)
    teleport_pos := types.Pos(-1, -1)
    found := false

    for pos in deploy_positions
        cell := brd.get_cell_at(pos)
        if cell isnt empty
            c := dereference cell
            if not c.is_occupied()
                teleport_pos = pos
                found = true
                break

    if not found
        teleport_pos = brd.get_starting_position(player_index)

    tok.move_to(teleport_pos)
    return MysteryEventResult{
        effect: enums.TELEPORT,
        token_id: tok.id,
        old_position: old_pos,
        new_position: tok.position,
        old_health: old_hp,
        new_health: tok.health,
    }
