petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/sort"
import "stdlib/string" as strpkg

const SEPARATOR_WIDTH = 60

const SYMBOL_EMPTY = "."

const SYMBOL_GENERATOR = "G"

const SYMBOL_CRYSTAL = "C"

const SYMBOL_MYSTERY = "M"

const SYMBOL_CORNER = "*"

func separatorLine() string
    s := ""
    for _ from 0 to SEPARATOR_WIDTH
        s = s + "="
    return s

func colorName(c: enums.PlayerColor) string
    switch c
        when enums.CYAN
            return "Cyan"
        when enums.MAGENTA
            return "Magenta"
        when enums.YELLOW
            return "Yellow"
        when enums.GREEN
            return "Green"
        default
            return "Unknown"

func tokenSymbol(c: enums.PlayerColor) string
    switch c
        when enums.CYAN
            return "c"
        when enums.MAGENTA
            return "m"
        when enums.YELLOW
            return "y"
        when enums.GREEN
            return "g"
        default
            return "?"

func generatorStatus(gen: reference Generator, gs: reference GameState) string
    if gen.isDisabled
        return "DISABLED"
    if gen.capturingPlayerId isnt ""
        pRef := gs.GetPlayer(gen.capturingPlayerId)
        if pRef isnt empty
            p := dereference pRef
            cn := colorName(p.color)
            tc := len(gen.captureTokenIds)
            th, tr := gen.getCaptureProgress()
            return "Being captured by {p.name} ({cn}) - {tc} tokens, {th}/{tr} turns"
    return "Uncontested"

func crystalHolders(crys: reference Crystal, gs: reference GameState) map of types.PlayerID to int
    result := empty map of types.PlayerID to int
    tokensAt := gs.GetTokensAtPosition(crys.position)
    for t in tokensAt
        _, exists := result[t.playerId]
        if not exists
            result[t.playerId] = 0
        result[t.playerId] = result[t.playerId] + 1
    return result

func joinLines(lines: list of string) string
    if lines is empty
        return ""
    result := lines[0]
    for i from 1 to len(lines)
        result = result + "\n" + lines[i]
    return result

func describeGameState(gs: reference GameState, perspective: types.PlayerID) string
    lines := empty list of string
    lines = append(lines, separatorLine())

    if gs.phase equals enums.ENDED
        winnerRef := gs.GetPlayer(gs.winnerId)
        winnerName := "Unknown"
        if winnerRef isnt empty
            winnerName = winnerRef.name
        lines = append(lines, "GAME OVER - Winner: {winnerName}")
    else if gs.phase equals enums.SETUP
        lines = append(lines, "GAME SETUP - Waiting for players")
    else
        currentRef := gs.GetCurrentPlayer()
        isYourTurn := gs.currentTurnPlayerId equals perspective
        turnIndicator := "YOUR TURN"
        if not isYourTurn
            turnIndicator = "WAITING"
        playerName := "Unknown"
        playerColor := "Unknown"
        if currentRef isnt empty
            cp := dereference currentRef
            playerName = cp.name
            playerColor = colorName(cp.color)
        lines = append(
            lines,
            "TURN {gs.turnNumber} - {turnIndicator} (Current: {playerName} - {playerColor})",
        )
    lines = append(lines, separatorLine())
    lines = append(lines, "")

    if gs.phase equals enums.PLAYING
        lines = append(lines, "Phase: {gs.turnPhase}")
        if gs.turnPhase equals enums.MOVEMENT
            lines = append(lines, "  -> You can move a token or deploy a new token")
        else if gs.turnPhase equals enums.ACTION
            lines = append(lines, "  -> You can attack with a token or end your turn")
        lines = append(lines, "")

    lines = appendPlayerTokens(lines, gs, perspective)
    lines = appendEnemyTokens(lines, gs, perspective)

    if gs.generators isnt empty
        lines = appendGeneratorInfo(lines, gs)

    if gs.crystalInstance isnt empty
        lines = appendCrystalInfo(lines, gs)

    lines = append(lines, separatorLine())
    return joinLines(lines)

func appendPlayerTokens(lines: list of string, gs: reference GameState, playerId: types.PlayerID) list of string
    pRef := gs.GetPlayer(playerId)
    if pRef is empty
        lines = append(lines, "YOUR TOKENS: (player not found)")
        lines = append(lines, "")
        return lines
    p := dereference pRef

    deployed := empty list of Token
    for tid in p.tokenIds
        tRef := gs.GetToken(tid)
        if tRef isnt empty
            t := dereference tRef
            if t.isDeployed and t.isAlive
                deployed = append(deployed, t)

    reserve := gs.GetReserveTokens(playerId)
    reserveCounts := gs.GetReserveTokenCounts(playerId)

    lines = append(lines, "YOUR TOKENS ({len(deployed)} deployed, {len(reserve)} in reserve):")
    if deployed isnt empty
        sorted := sort.ByKey(deployed, (t: Token) => t.id)
        for t in sorted
            lines = append(
                lines,
                "  Token #{t.id} @ ({t.position.X},{t.position.Y}) - {t.health}/{t.maxHealth}hp  [Move range: {t.movementRange()}]",
            )
    else
        lines = append(lines, "  (none deployed)")

    lines = append(lines, "")
    lines = append(lines, "RESERVE TOKENS:")
    lines = append(
        lines,
        "  10hp: {reserveCounts[10]}  |  8hp: {reserveCounts[8]}  |  6hp: {reserveCounts[6]}  |  4hp: {reserveCounts[4]}",
    )
    lines = append(lines, "")
    return lines

func appendEnemyTokens(lines: list of string, gs: reference GameState, perspective: types.PlayerID) list of string
    for pid, pRef in gs.players
        if pid equals perspective
            continue
        enemyDeployed := empty list of Token
        for tid in pRef.tokenIds
            tRef := gs.GetToken(tid)
            if tRef isnt empty
                t := dereference tRef
                if t.isDeployed and t.isAlive
                    enemyDeployed = append(enemyDeployed, t)
        cn := colorName(pRef.color)
        lines = append(lines, "{pRef.name} ({cn}): {len(enemyDeployed)} deployed")
        sorted := sort.ByKey(enemyDeployed, (t: Token) => t.id)
        for t in sorted
            lines = append(
                lines,
                "  Token #{t.id} @ ({t.position.X},{t.position.Y}) - {t.health}/{t.maxHealth}hp",
            )
    lines = append(lines, "")
    return lines

func appendGeneratorInfo(lines: list of string, gs: reference GameState) list of string
    lines = append(lines, "GENERATORS:")
    for i from 0 to len(gs.generators)
        genRef := reference of gs.generators[i]
        status := generatorStatus(genRef, gs)
        gen := dereference genRef
        lines = append(lines, "  G{i + 1} @ ({gen.position.X},{gen.position.Y}): {status}")
    lines = append(lines, "")
    return lines

func appendCrystalInfo(lines: list of string, gs: reference GameState) list of string
    if gs.crystalInstance is empty
        lines = append(lines, "CRYSTAL: (not available)")
        lines = append(lines, "")
        return lines
    crys := dereference gs.crystalInstance
    disabledCount := countDisabledGenerators(gs.generators)
    tokensRequired := crys.getTokensRequired(disabledCount)

    lines = append(lines, "CRYSTAL:")
    lines = append(lines, "  Location: ({crys.position.X},{crys.position.Y})")
    lines = append(lines, "  Tokens needed to capture: {tokensRequired}")
    if disabledCount > 0
        lines = append(
            lines,
            "  (Base: {constants.CRYSTAL_BASE_TOKENS_REQUIRED}, reduced by {disabledCount} disabled generator(s))",
        )

    holders := crystalHolders(reference of crys, gs)
    if holders isnt empty
        lines = append(lines, "  Current holders:")
        for pid, count in holders
            hpRef := gs.GetPlayer(pid)
            if hpRef isnt empty
                hp := dereference hpRef
                cn := colorName(hp.color)
                lines = append(lines, "    {hp.name} ({cn}): {count} tokens")
    lines = append(lines, "")
    return lines

func getBoardMap(gs: reference GameState, perspective: types.PlayerID) string
    lines := empty list of string
    lines = append(lines, "BOARD MAP (24x24):")
    lines = append(lines, "")

    boardGrid := createBoardGrid(gs, perspective)
    lines = renderBoardHeader(lines, gs)
    lines = renderBoardRows(lines, boardGrid, gs)
    lines = renderBoardFooter(lines, gs)
    lines = renderLegend(lines, gs, perspective)

    return joinLines(lines)

func createBoardGrid(gs: reference GameState, perspective: types.PlayerID) list of list of string
    grid := make(list of list of string, constants.BOARD_HEIGHT)
    for y from 0 to constants.BOARD_HEIGHT
        row := make(list of string, constants.BOARD_WIDTH)
        for x from 0 to constants.BOARD_WIDTH
            row[x] = SYMBOL_EMPTY
        grid[y] = row

    grid = markSpecialCells(grid, gs)
    grid = placeTokensOnGrid(grid, gs, perspective)
    return grid

func markSpecialCells(grid: list of list of string, gs: reference GameState) list of list of string
    for i from 0 to len(gs.generators)
        x := gs.generators[i].position.X
        y := gs.generators[i].position.Y
        grid[y][x] = "{i + 1}"

    if gs.crystalInstance isnt empty
        c := dereference gs.crystalInstance
        grid[c.position.Y][c.position.X] = SYMBOL_CRYSTAL

    mysteryPos := gs.board.getMysteryPositions()
    for mp in mysteryPos
        if grid[mp.Y][mp.X] equals SYMBOL_EMPTY
            grid[mp.Y][mp.X] = SYMBOL_MYSTERY

    for i from 0 to 4
        sp := gs.board.getStartingPosition(i)
        if grid[sp.Y][sp.X] equals SYMBOL_EMPTY
            grid[sp.Y][sp.X] = SYMBOL_CORNER
    return grid

func placeTokensOnGrid(grid: list of list of string, gs: reference GameState, perspective: types.PlayerID) list of list of string
    for _, t in gs.tokens
        if t.isDeployed and t.isAlive
            pRef := gs.GetPlayer(t.playerId)
            if pRef isnt empty
                p := dereference pRef
                sym := tokenSymbol(p.color)
                if t.playerId equals perspective
                    sym = strpkg.ToUpper(sym)
                grid[t.position.Y][t.position.X] = sym
    return grid

func renderBoardHeader(lines: list of string, gs: reference GameState) list of string
    header := "     "
    for i from 0 to constants.BOARD_WIDTH
        if i % 2 equals 0
            header = header + strpkg.PadLeft("{i}", 2, " ")
    lines = append(lines, header)
    border := "   +"
    for _ from 0 to constants.BOARD_WIDTH * 2
        border = border + "-"
    border = border + "+"
    lines = append(lines, border)
    return lines

func renderBoardRows(lines: list of string, grid: list of list of string, gs: reference GameState) list of string
    for y from 0 to constants.BOARD_HEIGHT
        rowStr := strpkg.PadLeft("{y}", 2, " ") + " | "
        for x from 0 to constants.BOARD_WIDTH
            rowStr = rowStr + grid[y][x] + " "
        rowStr = rowStr + "|"
        lines = append(lines, rowStr)
    return lines

func renderBoardFooter(lines: list of string, gs: reference GameState) list of string
    border := "   +"
    for _ from 0 to constants.BOARD_WIDTH * 2
        border = border + "-"
    border = border + "+"
    lines = append(lines, border)
    lines = append(lines, "")
    return lines

func renderLegend(lines: list of string, gs: reference GameState, perspective: types.PlayerID) list of string
    lines = append(lines, "LEGEND:")
    pRef := gs.GetPlayer(perspective)
    if pRef isnt empty
        p := dereference pRef
        yourSym := strpkg.ToUpper(tokenSymbol(p.color))
        lines = append(lines, "  {yourSym} = Your tokens")
    lines = append(lines, "  c/m/y/g = Enemy tokens (cyan/magenta/yellow/green)")
    lines = append(lines, "  C = Crystal")
    lines = append(lines, "  1,2,3,4 = Generators (G1-G4)")
    lines = append(lines, "  M = Mystery square")
    lines = append(lines, "  * = Deployment corner")
    lines = append(lines, "  . = Empty cell")
    lines = append(lines, "")
    return lines

func listAvailableActions(gs: reference GameState, playerId: types.PlayerID) AvailableActionsResponse
    if gs.phase isnt enums.PLAYING
        return AvailableActionsResponse{Phase: "NOT_PLAYING", Actions: empty list of ActionResponse}

    if gs.currentTurnPlayerId isnt playerId
        return AvailableActionsResponse{
            Phase: "NOT_YOUR_TURN",
            Actions: empty list of ActionResponse,
        }

    actions := empty list of ActionResponse
    phaseStr := "{gs.turnPhase}"

    pRef := gs.GetPlayer(playerId)
    if pRef is empty
        return AvailableActionsResponse{Phase: phaseStr, Actions: actions}

    p := dereference pRef

    deployedTokens := empty list of Token
    for tid in p.tokenIds
        tRef := gs.GetToken(tid)
        if tRef isnt empty
            t := dereference tRef
            if t.isDeployed and t.isAlive
                deployedTokens = append(deployedTokens, t)

    if gs.turnPhase equals enums.MOVEMENT
        actions = addMovementActions(actions, deployedTokens, gs)
        actions = addDeploymentActions(actions, gs, playerId, p)
    else if gs.turnPhase equals enums.ACTION
        actions = addAttackActions(actions, deployedTokens, gs)
        actions = addEndTurnAction(actions)

    return AvailableActionsResponse{Phase: phaseStr, Actions: actions}

func addMovementActions(actions: list of ActionResponse, deployed: list of Token, gs: reference GameState) list of ActionResponse
    for t in deployed
        tRef := gs.GetToken(t.id)
        if tRef isnt empty
            effectiveRange := gs.GetTokenMovementRange(tRef)
            validMoves := getValidMoves(tRef, reference of gs.board, effectiveRange, gs.tokens)
            if validMoves isnt empty
                dests := empty list of list of int
                for m in validMoves
                    dests = append(dests, list of int{m.X, m.Y})
                actions = append(actions, MoveAction{
                    TokenID: t.id,
                    TokenPosition: list of int{t.position.X, t.position.Y},
                    TokenHealth: "{t.health}/{t.maxHealth}",
                    ValidDestinations: dests,
                    Description: "Move token #{t.id} ({t.maxHealth}hp) from ({t.position.X},{t.position.Y})",
                })
    return actions

func addDeploymentActions(actions: list of ActionResponse, gs: reference GameState, playerId: types.PlayerID, p: Player) list of ActionResponse
    reserveCounts := gs.GetReserveTokenCounts(playerId)
    cornerPositions := gs.board.getDeployablePositions(enums.PlayerIndex(p.color))
    for hv in constants.TOKEN_HEALTH_VALUES
        if reserveCounts[hv] > 0
            available := empty list of list of int
            for pos in cornerPositions
                cell := gs.board.getCellAt(pos)
                if cell isnt empty
                    if not cell.isOccupied()
                        available = append(available, list of int{pos.X, pos.Y})
            if available isnt empty
                actions = append(actions, DeployAction{
                    HealthValue: hv,
                    Positions: available,
                    Remaining: reserveCounts[hv],
                    Description: "Deploy {hv}hp token from reserve ({reserveCounts[hv]} remaining)",
                })
    return actions

func addAttackActions(actions: list of ActionResponse, deployed: list of Token, gs: reference GameState) list of ActionResponse
    for t in deployed
        tRef := gs.GetToken(t.id)
        if tRef isnt empty
            attackable := getAttackableTargets(tRef, gs.tokens)
            for target in attackable
                damage := t.health / 2
                willKillTarget := wouldKill(tRef, reference of target)
                targetPlayer := gs.GetPlayer(target.playerId)
                targetColor := "Unknown"
                if targetPlayer isnt empty
                    targetColor = colorName(dereference targetPlayer.color)

                killTag := ""
                if willKillTarget
                    killTag = " (KILL)"

                actions = append(actions, AttackAction{
                    AttackerID: t.id,
                    AttackerPosition: list of int{t.position.X, t.position.Y},
                    DefenderID: target.id,
                    DefenderPosition: list of int{target.position.X, target.position.Y},
                    DefenderOwner: targetColor,
                    Damage: damage,
                    WillKill: willKillTarget,
                    Description: "Attack token #{target.id} ({targetColor}) with token #{t.id} for {damage} damage{killTag}",
                })
    return actions

func addEndTurnAction(actions: list of ActionResponse) list of ActionResponse
    actions = append(actions, EndTurnAction{
        Description: "End your turn",
    })
    return actions

func getAttackableTargets(tok: reference Token, tokensMap: map of types.TokenID to reference Token) list of Token
    result := empty list of Token
    for _, t in tokensMap
        d := dereference t
        if d.isAlive and d.isDeployed and d.playerId isnt tok.playerId
            if tok.isAdjacentTo(d.position)
                result = append(result, d)
    return result

func explainVictoryConditions(gs: reference GameState) string
    lines := empty list of string
    lines = append(lines, "VICTORY CONDITIONS:")
    lines = append(lines, "")

    disabledCount := countDisabledGenerators(gs.generators)
    tokensRequired := 1
    reduction := disabledCount * constants.GENERATOR_TOKEN_REDUCTION
    base := constants.CRYSTAL_BASE_TOKENS_REQUIRED
    if base - reduction > 0
        tokensRequired = base - reduction

    lines = append(lines, "Win by holding the crystal with {tokensRequired} tokens for 3 consecutive turns")
    lines = append(lines, "  Base requirement: {constants.CRYSTAL_BASE_TOKENS_REQUIRED} tokens")
    if disabledCount > 0
        lines = append(
            lines,
            "  Disabled generators: {disabledCount} (-{disabledCount * constants.GENERATOR_TOKEN_REDUCTION} tokens)",
        )
    lines = append(lines, "")

    if gs.crystalInstance isnt empty
        crys := dereference gs.crystalInstance
        holders := crystalHolders(reference of crys, gs)
        if holders isnt empty
            lines = append(lines, "Current crystal progress:")
            for pid, count in holders
                pRef := gs.GetPlayer(pid)
                if pRef isnt empty
                    p := dereference pRef
                    cn := colorName(p.color)
                    turnsHeld := 0
                    if crys.holdingPlayerId equals pid
                        turnsHeld = crys.turnsHeld
                    progress := "{count}/{tokensRequired} tokens, held for {turnsHeld}/3 turns"
                    if count >= tokensRequired and turnsHeld >= 3
                        lines = append(lines, "  {p.name} ({cn}): {progress} WINNING!")
                    else if count >= tokensRequired
                        lines = append(
                            lines,
                            "  {p.name} ({cn}): {progress} (needs {3 - turnsHeld} more turn(s))",
                        )
                    else
                        lines = append(
                            lines,
                            "  {p.name} ({cn}): {progress} (needs {tokensRequired - count} more token(s))",
                        )
        else
            lines = append(lines, "  No players currently on crystal")
        lines = append(lines, "")

    lines = append(lines, "Generator bonuses:")
    lines = append(
        lines,
        "  Disable generators to reduce crystal requirement (each generator = -{constants.GENERATOR_TOKEN_REDUCTION} tokens)",
    )
    for i from 0 to len(gs.generators)
        genRef := reference of gs.generators[i]
        gen := dereference genRef
        if gen.isDisabled
            lines = append(lines, "  Generator {i + 1}: DISABLED")
        else
            status := generatorStatus(genRef, gs)
            lines = append(lines, "  Generator {i + 1}: {status}")

    return joinLines(lines)

func getSituationReport(gs: reference GameState, perspective: types.PlayerID) string
    sections := empty list of string

    sections = append(sections, describeGameState(gs, perspective))
    sections = append(sections, getBoardMap(gs, perspective))

    actionsData := listAvailableActions(gs, perspective)
    sections = append(sections, "AVAILABLE ACTIONS:")
    if actionsData.Actions isnt empty
        for i, action in actionsData.Actions
            descStr := ""
            switch action
                when MoveAction
                    descStr = action.Description
                when AttackAction
                    descStr = action.Description
                when DeployAction
                    descStr = action.Description
                when EndTurnAction
                    descStr = action.Description
            sections = append(sections, "  {i + 1}. {descStr}")
    else
        if actionsData.Phase equals "NOT_YOUR_TURN"
            sections = append(sections, "  (waiting for other player's turn)")
        else
            sections = append(sections, "  (no actions available)")
    sections = append(sections, "")

    sections = append(sections, explainVictoryConditions(gs))

    return joinLines(sections)
