petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types

type CrystalOutcome
    winnerId: types.PlayerID
    isWinner: bool

type Crystal
    position: types.Position
    holdingPlayerId: types.PlayerID
    holdingTokenIds: list of types.TokenID
    turnsHeld: int
    baseTokensRequired: int

func NewCrystal(position: types.Position) Crystal
    return Crystal{
        position: position,
        holdingPlayerId: "",
        holdingTokenIds: empty list of types.TokenID,
        turnsHeld: 0,
        baseTokensRequired: constants.CRYSTAL_BASE_TOKENS_REQUIRED,
    }

func turnsRequired on c: reference Crystal int
    return constants.CRYSTAL_CAPTURE_TURNS_REQUIRED

func Position on c: reference Crystal types.Position
    return c.position

func HoldingPlayer on c: reference Crystal types.PlayerID
    return c.holdingPlayerId

func TurnsHeld on c: reference Crystal int
    return c.turnsHeld

func getTokensRequired on c: reference Crystal(disabledGenerators: int) int
    reduction := disabledGenerators * constants.GENERATOR_TOKEN_REDUCTION
    required := c.baseTokensRequired - reduction
    if required < 1
        return 1
    return required

func updateCaptureStatus on c: reference Crystal(tokensAtPos: list of TokenAtPos, disabledGenerators: int) CrystalOutcome
    c.holdingTokenIds = empty list of types.TokenID

    counts := countTokensByPlayer(tokensAtPos)
    dominantPlayer, dominantCount, found := findDominantPlayer(counts)
    requiredTokens := c.getTokensRequired(disabledGenerators)

    if found and dominantCount >= requiredTokens
        if dominantPlayer equals c.holdingPlayerId
            c.turnsHeld = c.turnsHeld + 1
            c.holdingTokenIds = counts[dominantPlayer]
            if c.turnsHeld >= constants.CRYSTAL_CAPTURE_TURNS_REQUIRED
                return CrystalOutcome{winnerId: dominantPlayer, isWinner: true}
        else
            c.holdingPlayerId = dominantPlayer
            c.turnsHeld = 1
            c.holdingTokenIds = counts[dominantPlayer]
    else
        c.holdingPlayerId = ""
        c.turnsHeld = 0

    return CrystalOutcome{winnerId: "", isWinner: false}

func resetCapture on c: reference Crystal
    c.holdingPlayerId = ""
    c.turnsHeld = 0
    c.holdingTokenIds = empty list of types.TokenID

func getCaptureProgress on c: reference Crystal() (int, int)
    return c.turnsHeld, constants.CRYSTAL_CAPTURE_TURNS_REQUIRED

func isContested on c: reference Crystal bool
    return c.holdingPlayerId equals "" and c.holdingTokenIds isnt empty
