petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types

type Generator
    id: int
    position: types.Position
    capturingPlayerId: types.PlayerID
    captureTokenIds: list of types.TokenID
    turnsHeld: int
    isDisabled: bool

func NewGenerator(id: int, position: types.Position) Generator
    return Generator{
        id: id,
        position: position,
        capturingPlayerId: "",
        captureTokenIds: empty list of types.TokenID,
        turnsHeld: 0,
        isDisabled: false,
    }

func requiredTokens on g: reference Generator int
    return constants.GENERATOR_CAPTURE_TOKENS_REQUIRED

func requiredTurns on g: reference Generator int
    return constants.GENERATOR_CAPTURE_TURNS_REQUIRED

func tokenReductionValue on g: reference Generator int
    return constants.GENERATOR_TOKEN_REDUCTION

func Position on g: reference Generator types.Position
    return g.position

func ID on g: reference Generator int
    return g.id

func CapturingPlayer on g: reference Generator types.PlayerID
    return g.capturingPlayerId

func TurnsHeld on g: reference Generator int
    return g.turnsHeld

func IsDisabled on g: reference Generator bool
    return g.isDisabled

func updateCaptureStatus on g: reference Generator(tokensAtPos: list of TokenAtPos) bool
    if g.isDisabled
        return false

    g.captureTokenIds = empty list of types.TokenID

    counts := countTokensByPlayer(tokensAtPos)
    dominantPlayer, dominantCount, found := findDominantPlayer(counts)

    if found and dominantCount >= constants.GENERATOR_CAPTURE_TOKENS_REQUIRED
        if dominantPlayer equals g.capturingPlayerId
            g.turnsHeld = g.turnsHeld + 1
            g.captureTokenIds = counts[dominantPlayer]
            if g.turnsHeld >= constants.GENERATOR_CAPTURE_TURNS_REQUIRED
                g.isDisabled = true
                return true
        else
            g.capturingPlayerId = dominantPlayer
            g.turnsHeld = 1
            g.captureTokenIds = counts[dominantPlayer]
    else
        g.capturingPlayerId = ""
        g.turnsHeld = 0

    return false

func resetCapture on g: reference Generator
    if not g.isDisabled
        g.capturingPlayerId = ""
        g.turnsHeld = 0
        g.captureTokenIds = empty list of types.TokenID

func getCaptureProgress on g: reference Generator() (int, int)
    return g.turnsHeld, constants.GENERATOR_CAPTURE_TURNS_REQUIRED

func createGenerators(positions: list of types.Position) list of Generator
    result := empty list of Generator
    for i, pos in positions
        result = append(result, NewGenerator(i, pos))
    return result

func countDisabledGenerators(generators: list of Generator) int
    count := 0
    for gen in generators
        if gen.isDisabled
            count = count + 1
    return count

func getGeneratorAtPosition(generators: list of Generator, pos: types.Position) optional reference Generator
    for i from 0 to len(generators)
        if generators[i].position equals pos
            return reference of generators[i]
    return empty

func updateAllGenerators(generators: list of Generator, tokensByPos: map of types.Position to list of TokenAtPos) (list of int, map of int to types.PlayerID)
    newlyDisabled := empty list of int
    capturingPlayers := empty map of int to types.PlayerID

    for i from 0 to len(generators)
        taps := tokensByPos[generators[i].position]
        genRef := reference of generators[i]
        wasDisabled := genRef.updateCaptureStatus(taps)

        if wasDisabled
            newlyDisabled = append(newlyDisabled, generators[i].id)
            capturingPlayers[generators[i].id] = generators[i].capturingPlayerId

    return newlyDisabled, capturingPlayers
