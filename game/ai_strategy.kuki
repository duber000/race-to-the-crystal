petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/types" as types
import "stdlib/random"

enum AIStrategyName: string
    RANDOM = "random"
    AGGRESSIVE = "aggressive"
    DEFENSIVE = "defensive"

enum ChosenAction
    ChosenMove
        TokenID: types.TokenID
        Destination: list of int
    ChosenAttack
        AttackerID: types.TokenID
        DefenderID: types.TokenID
    ChosenDeploy
        HealthValue: int
        Position: list of int
    ChosenEndTurn

func ChosenActionName(action: ChosenAction) string
    switch action
        when ChosenMove
            return "MOVE"
        when ChosenAttack
            return "ATTACK"
        when ChosenDeploy
            return "DEPLOY"
        default
            return "END_TURN"

func ChosenToActionMap(action: ChosenAction) map of string to any
    switch action
        when ChosenMove
            return map of string to any{
                "type": "MOVE",
                "data": map of string to any{
                    "token_id": action.TokenID,
                    "destination": action.Destination,
                },
            }
        when ChosenAttack
            return map of string to any{
                "type": "ATTACK",
                "data": map of string to any{
                    "attacker_id": action.AttackerID,
                    "defender_id": action.DefenderID,
                },
            }
        when ChosenDeploy
            return map of string to any{
                "type": "DEPLOY",
                "data": map of string to any{
                    "health_value": action.HealthValue,
                    "position": action.Position,
                },
            }
        default
            return map of string to any{
                "type": "END_TURN",
                "data": empty map of string to any,
            }

func ChooseAction(strategy: AIStrategyName, actions: list of ActionResponse, gs: reference GameState, playerId: types.PlayerID) optional reference ChosenAction
    if actions is empty
        return empty

    switch strategy
        when AIStrategyName.AGGRESSIVE
            r := chooseAggressive(actions, gs, playerId)
            return reference of r
        when AIStrategyName.DEFENSIVE
            r := chooseDefensive(actions, gs, playerId)
            return reference of r
        default
            r := chooseRandom(actions)
            return reference of r

func chooseRandom(actions: list of ActionResponse) ChosenAction
    return resolveAction(random.Choice of ActionResponse from actions)

func chooseAggressive(actions: list of ActionResponse, gs: reference GameState, playerId: types.PlayerID) ChosenAction
    attacks := filterAttacks(actions)
    if attacks isnt empty
        return bestAttack(attacks)

    moves := filterMoves(actions)
    if moves isnt empty
        return bestMove(moves, gs, playerId, false)

    deploys := filterDeploys(actions)
    if deploys isnt empty
        return bestDeploy(deploys)

    return ChosenEndTurn{}

func chooseDefensive(actions: list of ActionResponse, gs: reference GameState, playerId: types.PlayerID) ChosenAction
    deploys := filterDeploys(actions)
    if deploys isnt empty and random.Int(0, 2) equals 1
        return bestDeploy(deploys)

    moves := filterMoves(actions)
    if moves isnt empty
        return bestMove(moves, gs, playerId, true)

    attacks := filterAttacks(actions)
    if attacks isnt empty and random.Int(0, 10) > 7
        return bestAttack(attacks)

    return ChosenEndTurn{}

func filterAttacks(actions: list of ActionResponse) list of AttackAction
    result := empty list of AttackAction
    for a in actions
        switch a
            when AttackAction
                result = append(result, a)
            default
                continue
    return result

func filterMoves(actions: list of ActionResponse) list of MoveAction
    result := empty list of MoveAction
    for a in actions
        switch a
            when MoveAction
                result = append(result, a)
            default
                continue
    return result

func filterDeploys(actions: list of ActionResponse) list of DeployAction
    result := empty list of DeployAction
    for a in actions
        switch a
            when DeployAction
                result = append(result, a)
            default
                continue
    return result

func bestAttack(attacks: list of AttackAction) ChosenAction
    bestDmg := 0
    var best: AttackAction

    for atk in attacks
        if atk.WillKill and atk.Damage > bestDmg
            bestDmg = atk.Damage
            best = atk

    if bestDmg > 0
        return ChosenAttack{AttackerID: best.AttackerID, DefenderID: best.DefenderID}

    for atk in attacks
        if atk.Damage > bestDmg
            bestDmg = atk.Damage
            best = atk

    return ChosenAttack{AttackerID: best.AttackerID, DefenderID: best.DefenderID}

func bestMove(moves: list of MoveAction, gs: reference GameState, playerId: types.PlayerID, prioritizeCrystal: bool) ChosenAction
    objectives := getObjectives(gs, playerId, prioritizeCrystal)

    bestTid := types.TokenID(0)
    bestDest := list of int{0, 0}
    bestScore := 999999.0

    for mv in moves
        for destList in mv.ValidDestinations
            if len(destList) < 2
                continue
            dest := types.Pos(destList[0], destList[1])
            tokRef := gs.GetToken(mv.TokenID)
            score := scoreDestination(dest, objectives, tokRef)
            if score < bestScore
                bestScore = score
                bestTid = mv.TokenID
                bestDest = destList

    return ChosenMove{TokenID: bestTid, Destination: bestDest}

func bestDeploy(deploys: list of DeployAction) ChosenAction
    bestHv := 0
    var chosen: DeployAction

    for dp in deploys
        if dp.HealthValue > bestHv
            bestHv = dp.HealthValue
            chosen = dp

    if chosen.Positions is empty
        return ChosenEndTurn{}

    pos := chosen.Positions[0]
    return ChosenDeploy{HealthValue: chosen.HealthValue, Position: pos}

func resolveAction(action: ActionResponse) ChosenAction
    switch action
        when MoveAction
            dest := action.ValidDestinations[0]
            return ChosenMove{TokenID: action.TokenID, Destination: dest}
        when AttackAction
            return ChosenAttack{AttackerID: action.AttackerID, DefenderID: action.DefenderID}
        when DeployAction
            pos := random.Choice of list of int from action.Positions
            return ChosenDeploy{HealthValue: action.HealthValue, Position: pos}
        default
            return ChosenEndTurn{}

func getObjectives(gs: reference GameState, playerId: types.PlayerID, crystalOnly: bool) list of types.Position
    crystalPos := types.Pos(constants.BOARD_WIDTH / 2, constants.BOARD_HEIGHT / 2)
    objectives := list of types.Position{crystalPos}

    if crystalOnly
        return objectives

    for gen in gs.generators
        if gen.isDisabled
            continue
        if gen.capturingPlayerId equals playerId
            objectives = append(list of types.Position{gen.position}, many objectives)
        else
            objectives = append(objectives, gen.position)

    return objectives

func scoreDestination(dest: types.Position, objectives: list of types.Position, tok: optional reference Token) float64
    minDist := 999999.0
    for obj in objectives
        dx := dest.X - obj.X
        if dx < 0
            dx = -dx
        dy := dest.Y - obj.Y
        if dy < 0
            dy = -dy
        dist := (dx + dy) as float64
        if dist < minDist
            minDist = dist

    if tok isnt empty
        if tok.movementRange() >= 2
            minDist = minDist - 0.5

    return minDist

func ActionResponseToDict(a: ActionResponse) map of string to any
    switch a
        when MoveAction
            return map of string to any{
                "type": "MOVE",
                "token_id": a.TokenID,
                "token_position": a.TokenPosition,
                "token_health": a.TokenHealth,
                "valid_destinations": a.ValidDestinations,
                "description": a.Description,
            }
        when AttackAction
            return map of string to any{
                "type": "ATTACK",
                "attacker_id": a.AttackerID,
                "attacker_position": a.AttackerPosition,
                "defender_id": a.DefenderID,
                "defender_position": a.DefenderPosition,
                "defender_owner": a.DefenderOwner,
                "damage": a.Damage,
                "will_kill": a.WillKill,
                "description": a.Description,
            }
        when DeployAction
            return map of string to any{
                "type": "DEPLOY",
                "health_value": a.HealthValue,
                "positions": a.Positions,
                "remaining": a.Remaining,
                "description": a.Description,
            }
        when EndTurnAction
            return map of string to any{
                "type": "END_TURN",
                "description": a.Description,
            }

func ActionsToDicts(actions: list of ActionResponse) list of map of string to any
    result := empty list of map of string to any
    for a in actions
        result = append(result, ActionResponseToDict(a))
    return result

func ActionDictToResponse(d: map of string to any) (ActionResponse, bool)
    typeAny, has := d["type"]
    if not has
        return EndTurnAction{Description: "unknown"}, false
    typeStr := ""
    if typeAny is string as ts
        typeStr = ts
    if typeStr equals ""
        return EndTurnAction{Description: "unknown"}, false
    switch typeStr
        when "MOVE"
            tokId := 0
            tidAny, hasTid := d["token_id"]
            if hasTid
                if tidAny is int as tidVal
                    tokId = tidVal
            dests := empty list of list of int
            destsAny, hasD := d["valid_destinations"]
            if hasD
                if destsAny is list of list of int as destsVal
                    dests = destsVal
            health := ""
            if d["token_health"] is string as h
                health = h
            tpos := empty list of int
            if d["token_position"] is list of int as tp
                tpos = tp
            desc := ""
            if d["description"] is string as ds
                desc = ds
            return MoveAction{
                TokenID: types.TokenID(tokId),
                TokenPosition: tpos,
                TokenHealth: health,
                ValidDestinations: dests,
                Description: desc,
            }, true
        when "ATTACK"
            aid := 0
            if d["attacker_id"] is int as aidVal
                aid = aidVal
            did := 0
            if d["defender_id"] is int as didVal
                did = didVal
            atkPos := empty list of int
            if d["attacker_position"] is list of int as ap
                atkPos = ap
            defPos := empty list of int
            if d["defender_position"] is list of int as dp
                defPos = dp
            owner := ""
            if d["defender_owner"] is string as ow
                owner = ow
            dmg := 0
            if d["damage"] is int as dmgVal
                dmg = dmgVal
            wk := false
            if d["will_kill"] is bool as wkVal
                wk = wkVal
            desc := ""
            if d["description"] is string as ds
                desc = ds
            return AttackAction{
                AttackerID: types.TokenID(aid),
                AttackerPosition: atkPos,
                DefenderID: types.TokenID(did),
                DefenderPosition: defPos,
                DefenderOwner: owner,
                Damage: dmg,
                WillKill: wk,
                Description: desc,
            }, true
        when "DEPLOY"
            hv := 0
            if d["health_value"] is int as hvVal
                hv = hvVal
            positions := empty list of list of int
            if d["positions"] is list of list of int as ps
                positions = ps
            rem := 0
            if d["remaining"] is int as remVal
                rem = remVal
            desc := ""
            if d["description"] is string as ds
                desc = ds
            return DeployAction{
                HealthValue: hv,
                Positions: positions,
                Remaining: rem,
                Description: desc,
            }, true
        when "END_TURN"
            desc := ""
            if d["description"] is string as ds
                desc = ds
            return EndTurnAction{Description: desc}, true
    return EndTurnAction{Description: "unknown"}, false

func ActionsFromDicts(dicts: list of map of string to any) list of ActionResponse
    result := empty list of ActionResponse
    for d in dicts
        r, ok := ActionDictToResponse(d)
        if ok
            result = append(result, r)
    return result
