petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/types" as types
import "stdlib/cast"
import "stdlib/random"

enum AIStrategyName: string
    RANDOM = "random"
    AGGRESSIVE = "aggressive"
    DEFENSIVE = "defensive"

enum ChosenAction
    ChosenMove
        TokenID: types.TokenID
        Destination: list of int
    ChosenAttack
        AttackerID: types.TokenID
        DefenderID: types.TokenID
    ChosenDeploy
        HealthValue: int
        Position: list of int
    ChosenEndTurn

func ChosenActionName(action: ChosenAction) string
    switch action
        when ChosenMove
            return "MOVE"
        when ChosenAttack
            return "ATTACK"
        when ChosenDeploy
            return "DEPLOY"
        default
            return "END_TURN"

func ChosenToActionMap(action: ChosenAction) JSONMap
    switch action
        when ChosenMove
            return JSONMap{
                "type": "MOVE",
                "data": JSONMap{
                    "token_id": action.TokenID,
                    "destination": action.Destination,
                },
            }
        when ChosenAttack
            return JSONMap{
                "type": "ATTACK",
                "data": JSONMap{
                    "attacker_id": action.AttackerID,
                    "defender_id": action.DefenderID,
                },
            }
        when ChosenDeploy
            return JSONMap{
                "type": "DEPLOY",
                "data": JSONMap{
                    "health_value": action.HealthValue,
                    "position": action.Position,
                },
            }
        default
            return JSONMap{
                "type": "END_TURN",
                "data": empty JSONMap,
            }

func ChooseAction(strategy: AIStrategyName, actions: list of ActionResponse, gs: optional reference GameState, playerId: types.PlayerID) optional reference ChosenAction
    if actions is empty
        return empty

    switch strategy
        when AIStrategyName.AGGRESSIVE
            r := chooseAggressive(actions, gs, playerId)
            return reference of r
        when AIStrategyName.DEFENSIVE
            r := chooseDefensive(actions, gs, playerId)
            return reference of r
        default
            r := chooseRandom(actions)
            return reference of r

func chooseRandom(actions: list of ActionResponse) ChosenAction
    return resolveAction(random.Choice of ActionResponse from actions)

func chooseAggressive(actions: list of ActionResponse, gs: optional reference GameState, playerId: types.PlayerID) ChosenAction
    attacks := filterAttacks(actions)
    if attacks isnt empty
        return bestAttack(attacks)

    moves := filterMoves(actions)
    if moves isnt empty and gs isnt empty
        return bestMove(moves, gs, playerId, false)
    if moves isnt empty
        mv := random.Choice of MoveAction from moves
        if mv.ValidDestinations isnt empty
            return ChosenMove{TokenID: mv.TokenID, Destination: mv.ValidDestinations[0]}

    deploys := filterDeploys(actions)
    if deploys isnt empty
        return bestDeploy(deploys)

    return ChosenEndTurn{}

func chooseDefensive(actions: list of ActionResponse, gs: optional reference GameState, playerId: types.PlayerID) ChosenAction
    deploys := filterDeploys(actions)
    if deploys isnt empty and random.Int(0, 2) equals 1
        return bestDeploy(deploys)

    moves := filterMoves(actions)
    if moves isnt empty and gs isnt empty
        return bestMove(moves, gs, playerId, true)
    if moves isnt empty
        mv := random.Choice of MoveAction from moves
        if mv.ValidDestinations isnt empty
            return ChosenMove{TokenID: mv.TokenID, Destination: mv.ValidDestinations[0]}

    attacks := filterAttacks(actions)
    if attacks isnt empty and random.Int(0, 10) > 7
        return bestAttack(attacks)

    return ChosenEndTurn{}

func filterAttacks(actions: list of ActionResponse) list of AttackAction
    result := empty list of AttackAction
    for a in actions
        switch a
            when AttackAction
                result = append(result, a)
            default
                continue
    return result

func filterMoves(actions: list of ActionResponse) list of MoveAction
    result := empty list of MoveAction
    for a in actions
        switch a
            when MoveAction
                result = append(result, a)
            default
                continue
    return result

func filterDeploys(actions: list of ActionResponse) list of DeployAction
    result := empty list of DeployAction
    for a in actions
        switch a
            when DeployAction
                result = append(result, a)
            default
                continue
    return result

func bestAttack(attacks: list of AttackAction) ChosenAction
    bestDmg := 0
    var best: AttackAction

    for atk in attacks
        if atk.WillKill and atk.Damage > bestDmg
            bestDmg = atk.Damage
            best = atk

    if bestDmg > 0
        return ChosenAttack{AttackerID: best.AttackerID, DefenderID: best.DefenderID}

    for atk in attacks
        if atk.Damage > bestDmg
            bestDmg = atk.Damage
            best = atk

    return ChosenAttack{AttackerID: best.AttackerID, DefenderID: best.DefenderID}

func isOnObjective(pos: types.Position, objectives: list of types.Position) bool
    for obj in objectives
        if obj equals pos
            return true
    return false

func bestMove(moves: list of MoveAction, gs: reference GameState, playerId: types.PlayerID, prioritizeCrystal: bool) ChosenAction
    objectives := getObjectives(gs, playerId, prioritizeCrystal)

    bestTid := types.TokenID(0)
    bestDest := list of int{0, 0}
    bestScore := 999999.0
    found := false

    for mv in moves
        tokRef := gs.GetToken(mv.TokenID)
        if tokRef isnt empty
            if isOnObjective(tokRef.position, objectives)
                continue
        for destList in mv.ValidDestinations
            if len(destList) < 2
                continue
            dest := types.Pos(destList[0], destList[1])
            score := scoreDestination(dest, objectives, tokRef)
            if score < bestScore
                bestScore = score
                bestTid = mv.TokenID
                bestDest = destList
                found = true

    if not found
        return ChosenEndTurn{}
    return ChosenMove{TokenID: bestTid, Destination: bestDest}

func bestDeploy(deploys: list of DeployAction) ChosenAction
    bestHv := 0
    var chosen: DeployAction

    for dp in deploys
        if dp.HealthValue > bestHv
            bestHv = dp.HealthValue
            chosen = dp

    if chosen.Positions is empty
        return ChosenEndTurn{}

    pos := chosen.Positions[0]
    return ChosenDeploy{HealthValue: chosen.HealthValue, Position: pos}

func resolveAction(action: ActionResponse) ChosenAction
    switch action
        when MoveAction
            if action.ValidDestinations is empty
                return ChosenEndTurn{}
            dest := action.ValidDestinations[0]
            return ChosenMove{TokenID: action.TokenID, Destination: dest}
        when AttackAction
            return ChosenAttack{AttackerID: action.AttackerID, DefenderID: action.DefenderID}
        when DeployAction
            # An empty DeployAction (no legal cells left for this strength)
            # must not crash the client — end the turn instead.
            if action.Positions is empty
                return ChosenEndTurn{}
            pos := random.Choice of list of int from action.Positions
            return ChosenDeploy{HealthValue: action.HealthValue, Position: pos}
        default
            return ChosenEndTurn{}

func getObjectives(gs: reference GameState, playerId: types.PlayerID, crystalOnly: bool) list of types.Position
    crystalPos := types.Pos(constants.BOARD_WIDTH / 2, constants.BOARD_HEIGHT / 2)
    objectives := list of types.Position{crystalPos}

    if crystalOnly
        return objectives

    for gen in gs.generators
        if gen.capturingPlayerId equals playerId
            objectives = append(list of types.Position{gen.position}, many objectives)
        else if not gen.isDisabled
            objectives = append(objectives, gen.position)

    return objectives

func scoreDestination(dest: types.Position, objectives: list of types.Position, tok: optional reference Token) float64
    minDist := 999999.0
    for obj in objectives
        dist := getDistance(dest, obj) as float64
        if dist < minDist
            minDist = dist

    if tok isnt empty
        if tok.movementRange() >= 2
            minDist = minDist - 0.5

    return minDist

func ActionResponseToDict(a: ActionResponse) JSONMap
    switch a
        when MoveAction
            return JSONMap{
                "type": "MOVE",
                "token_id": a.TokenID,
                "token_position": a.TokenPosition,
                "token_health": a.TokenHealth,
                "valid_destinations": a.ValidDestinations,
                "description": a.Description,
            }
        when AttackAction
            return JSONMap{
                "type": "ATTACK",
                "attacker_id": a.AttackerID,
                "attacker_position": a.AttackerPosition,
                "defender_id": a.DefenderID,
                "defender_position": a.DefenderPosition,
                "defender_owner": a.DefenderOwner,
                "damage": a.Damage,
                "will_kill": a.WillKill,
                "description": a.Description,
            }
        when DeployAction
            return JSONMap{
                "type": "DEPLOY",
                "health_value": a.HealthValue,
                "positions": a.Positions,
                "remaining": a.Remaining,
                "description": a.Description,
            }
        when EndTurnAction
            return JSONMap{
                "type": "END_TURN",
                "description": a.Description,
            }

func ActionsToDicts(actions: list of ActionResponse) list of JSONMap
    result := empty list of JSONMap
    for a in actions
        result = append(result, ActionResponseToDict(a))
    return result

# Wire payloads decode numbers as float64 and arrays as []any (jsonv2
# decodes into `any`). Never assert a nested slice type — the decoder
# never produces one — so walk one level at a time.
func numToInt(v: any) int
    return cast.ToIntOr(v, 0)

func numList(v: any) list of int
    result := empty list of int
    if v is list of int as xs
        return xs
    if v is list of any as xs
        for x in xs
            result = append(result, cast.ToIntOr(x, 0))
        return result
    return result

func numListList(v: any) list of list of int
    result := empty list of list of int
    if v is list of list of int as xs
        return xs
    if v is list of any as outer
        for x in outer
            result = append(result, numList(x))
        return result
    return result

func ActionDictToResponse(d: JSONMap) (ActionResponse, bool)
    typeAny, has := d["type"]
    if not has
        return EndTurnAction{Description: "unknown"}, false
    typeStr := ""
    if typeAny is string as ts
        typeStr = ts
    if typeStr is empty
        return EndTurnAction{Description: "unknown"}, false
    switch typeStr
        when "MOVE"
            health := ""
            if d["token_health"] is string as h
                health = h
            desc := ""
            if d["description"] is string as ds
                desc = ds
            return MoveAction{
                TokenID: types.TokenID(numToInt(d["token_id"])),
                TokenPosition: numList(d["token_position"]),
                TokenHealth: health,
                ValidDestinations: numListList(d["valid_destinations"]),
                Description: desc,
            }, true
        when "ATTACK"
            atkPos := numList(d["attacker_position"])
            defPos := numList(d["defender_position"])
            owner := ""
            if d["defender_owner"] is string as ow
                owner = ow
            desc := ""
            if d["description"] is string as ds
                desc = ds
            willKill := false
            if d["will_kill"] is bool as wkVal
                willKill = wkVal
            return AttackAction{
                AttackerID: types.TokenID(numToInt(d["attacker_id"])),
                AttackerPosition: atkPos,
                DefenderID: types.TokenID(numToInt(d["defender_id"])),
                DefenderPosition: defPos,
                DefenderOwner: owner,
                Damage: numToInt(d["damage"]),
                WillKill: willKill,
                Description: desc,
            }, true
        when "DEPLOY"
            rem := numToInt(d["remaining"])
            desc := ""
            if d["description"] is string as ds
                desc = ds
            return DeployAction{
                HealthValue: numToInt(d["health_value"]),
                Positions: numListList(d["positions"]),
                Remaining: rem,
                Description: desc,
            }, true
        when "END_TURN"
            desc := ""
            if d["description"] is string as ds
                desc = ds
            return EndTurnAction{Description: desc}, true
    return EndTurnAction{Description: "unknown"}, false

func ActionsFromDicts(dicts: list of JSONMap) list of ActionResponse
    result := empty list of ActionResponse
    for d in dicts
        r, ok := ActionDictToResponse(d)
        if ok
            result = append(result, r)
    return result
