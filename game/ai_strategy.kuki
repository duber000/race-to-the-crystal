petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/types" as types
import "stdlib/random"

enum AIStrategyName: string
    RANDOM = "random"
    AGGRESSIVE = "aggressive"
    DEFENSIVE = "defensive"

enum ChosenAction
    ChosenMove
        TokenID: types.TokenID
        Destination: list of int
    ChosenAttack
        AttackerID: types.TokenID
        DefenderID: types.TokenID
    ChosenDeploy
        HealthValue: int
        Position: list of int
    ChosenEndTurn

func ChosenActionName(action: ChosenAction) string
    switch action
        when ChosenMove
            return "MOVE"
        when ChosenAttack
            return "ATTACK"
        when ChosenDeploy
            return "DEPLOY"
        default
            return "END_TURN"

func ChosenToActionMap(action: ChosenAction) map of string to any
    switch action
        when ChosenMove
            return map of string to any{
                "type": "MOVE",
                "data": map of string to any{
                    "token_id": action.TokenID,
                    "destination": action.Destination,
                },
            }
        when ChosenAttack
            return map of string to any{
                "type": "ATTACK",
                "data": map of string to any{
                    "attacker_id": action.AttackerID,
                    "defender_id": action.DefenderID,
                },
            }
        when ChosenDeploy
            return map of string to any{
                "type": "DEPLOY",
                "data": map of string to any{
                    "health_value": action.HealthValue,
                    "position": action.Position,
                },
            }
        default
            return map of string to any{
                "type": "END_TURN",
                "data": empty map of string to any,
            }

func ChooseAction(strategy: AIStrategyName, actions: list of ActionResponse, gs: reference GameState, player_id: types.PlayerID) optional reference ChosenAction
    if len(actions) equals 0
        return empty

    switch strategy
        when AIStrategyName.AGGRESSIVE
            r := choose_aggressive(actions, gs, player_id)
            return reference of r
        when AIStrategyName.DEFENSIVE
            r := choose_defensive(actions, gs, player_id)
            return reference of r
        default
            r := choose_random(actions)
            return reference of r

func choose_random(actions: list of ActionResponse) ChosenAction
    idx := random.Int(0, len(actions))
    return resolve_action(actions[idx])

func choose_aggressive(actions: list of ActionResponse, gs: reference GameState, player_id: types.PlayerID) ChosenAction
    attacks := filter_attacks(actions)
    if len(attacks) > 0
        return best_attack(attacks)

    moves := filter_moves(actions)
    if len(moves) > 0
        return best_move(moves, gs, player_id, false)

    deploys := filter_deploys(actions)
    if len(deploys) > 0
        return best_deploy(deploys)

    return ChosenEndTurn{}

func choose_defensive(actions: list of ActionResponse, gs: reference GameState, player_id: types.PlayerID) ChosenAction
    deploys := filter_deploys(actions)
    if len(deploys) > 0 and random.Int(0, 2) equals 1
        return best_deploy(deploys)

    moves := filter_moves(actions)
    if len(moves) > 0
        return best_move(moves, gs, player_id, true)

    attacks := filter_attacks(actions)
    if len(attacks) > 0 and random.Int(0, 10) > 7
        return best_attack(attacks)

    return ChosenEndTurn{}

func filter_attacks(actions: list of ActionResponse) list of AttackAction
    result := empty list of AttackAction
    for a in actions
        switch a
            when AttackAction
                result = append(result, a)
            default
                continue
    return result

func filter_moves(actions: list of ActionResponse) list of MoveAction
    result := empty list of MoveAction
    for a in actions
        switch a
            when MoveAction
                result = append(result, a)
            default
                continue
    return result

func filter_deploys(actions: list of ActionResponse) list of DeployAction
    result := empty list of DeployAction
    for a in actions
        switch a
            when DeployAction
                result = append(result, a)
            default
                continue
    return result

func best_attack(attacks: list of AttackAction) ChosenAction
    best_dmg := 0
    var best: AttackAction

    for atk in attacks
        if atk.WillKill and atk.Damage > best_dmg
            best_dmg = atk.Damage
            best = atk

    if best_dmg > 0
        return ChosenAttack{AttackerID: best.AttackerID, DefenderID: best.DefenderID}

    for atk in attacks
        if atk.Damage > best_dmg
            best_dmg = atk.Damage
            best = atk

    return ChosenAttack{AttackerID: best.AttackerID, DefenderID: best.DefenderID}

func best_move(moves: list of MoveAction, gs: reference GameState, player_id: types.PlayerID, prioritize_crystal: bool) ChosenAction
    objectives := get_objectives(gs, player_id, prioritize_crystal)

    best_tid := types.TokenID(0)
    best_dest := list of int{0, 0}
    best_score := 999999.0

    for mv in moves
        for dest_list in mv.ValidDestinations
            if len(dest_list) < 2
                continue
            dest := types.Pos(dest_list[0], dest_list[1])
            tok_ref := gs.GetToken(mv.TokenID)
            score := score_destination(dest, objectives, tok_ref)
            if score < best_score
                best_score = score
                best_tid = mv.TokenID
                best_dest = dest_list

    return ChosenMove{TokenID: best_tid, Destination: best_dest}

func best_deploy(deploys: list of DeployAction) ChosenAction
    best_hv := 0
    var chosen: DeployAction

    for dp in deploys
        if dp.HealthValue > best_hv
            best_hv = dp.HealthValue
            chosen = dp

    if len(chosen.Positions) equals 0
        return ChosenEndTurn{}

    pos := chosen.Positions[0]
    return ChosenDeploy{HealthValue: chosen.HealthValue, Position: pos}

func resolve_action(action: ActionResponse) ChosenAction
    switch action
        when MoveAction
            dest := action.ValidDestinations[0]
            return ChosenMove{TokenID: action.TokenID, Destination: dest}
        when AttackAction
            return ChosenAttack{AttackerID: action.AttackerID, DefenderID: action.DefenderID}
        when DeployAction
            pos := action.Positions[random.Int(0, len(action.Positions))]
            return ChosenDeploy{HealthValue: action.HealthValue, Position: pos}
        default
            return ChosenEndTurn{}

func get_objectives(gs: reference GameState, player_id: types.PlayerID, crystal_only: bool) list of types.Position
    crystal_pos := types.Pos(constants.BOARD_WIDTH / 2, constants.BOARD_HEIGHT / 2)
    objectives := list of types.Position{crystal_pos}

    if crystal_only
        return objectives

    for gen in gs.generators
        if gen.is_disabled
            continue
        if gen.capturing_player_id equals player_id
            objectives = append(list of types.Position{gen.position}, many objectives)
        else
            objectives = append(objectives, gen.position)

    return objectives

func score_destination(dest: types.Position, objectives: list of types.Position, tok: optional reference Token) float64
    min_dist := 999999.0
    for obj in objectives
        dx := dest.X - obj.X
        if dx < 0
            dx = -dx
        dy := dest.Y - obj.Y
        if dy < 0
            dy = -dy
        dist := (dx + dy) as float64
        if dist < min_dist
            min_dist = dist

    if tok isnt empty
        if dereference tok.movement_range() >= 2
            min_dist = min_dist - 0.5

    return min_dist

func ActionResponseToDict(a: ActionResponse) map of string to any
    switch a
        when MoveAction
            return map of string to any{
                "type": "MOVE",
                "token_id": a.TokenID,
                "token_position": a.TokenPosition,
                "token_health": a.TokenHealth,
                "valid_destinations": a.ValidDestinations,
                "description": a.Description,
            }
        when AttackAction
            return map of string to any{
                "type": "ATTACK",
                "attacker_id": a.AttackerID,
                "attacker_position": a.AttackerPosition,
                "defender_id": a.DefenderID,
                "defender_position": a.DefenderPosition,
                "defender_owner": a.DefenderOwner,
                "damage": a.Damage,
                "will_kill": a.WillKill,
                "description": a.Description,
            }
        when DeployAction
            return map of string to any{
                "type": "DEPLOY",
                "health_value": a.HealthValue,
                "positions": a.Positions,
                "remaining": a.Remaining,
                "description": a.Description,
            }
        when EndTurnAction
            return map of string to any{
                "type": "END_TURN",
                "description": a.Description,
            }

func ActionsToDicts(actions: list of ActionResponse) list of map of string to any
    result := empty list of map of string to any
    for a in actions
        result = append(result, ActionResponseToDict(a))
    return result

func ActionDictToResponse(d: map of string to any) (ActionResponse, bool)
    type_any, has := d["type"]
    if not has
        return EndTurnAction{Description: "unknown"}, false
    type_str := ""
    if type_any is string as ts
        type_str = ts
    if type_str equals ""
        return EndTurnAction{Description: "unknown"}, false
    switch type_str
        when "MOVE"
            tok_id := 0
            tid_any, has_tid := d["token_id"]
            if has_tid
                if tid_any is int as tid_val
                    tok_id = tid_val
            dests := empty list of list of int
            dests_any, has_d := d["valid_destinations"]
            if has_d
                if dests_any is list of list of int as dests_val
                    dests = dests_val
            health := ""
            if d["token_health"] is string as h
                health = h
            tpos := empty list of int
            if d["token_position"] is list of int as tp
                tpos = tp
            desc := ""
            if d["description"] is string as ds
                desc = ds
            return MoveAction{
                TokenID: types.TokenID(tok_id),
                TokenPosition: tpos,
                TokenHealth: health,
                ValidDestinations: dests,
                Description: desc,
            }, true
        when "ATTACK"
            aid := 0
            if d["attacker_id"] is int as aid_val
                aid = aid_val
            did := 0
            if d["defender_id"] is int as did_val
                did = did_val
            atk_pos := empty list of int
            if d["attacker_position"] is list of int as ap
                atk_pos = ap
            def_pos := empty list of int
            if d["defender_position"] is list of int as dp
                def_pos = dp
            owner := ""
            if d["defender_owner"] is string as ow
                owner = ow
            dmg := 0
            if d["damage"] is int as dmg_val
                dmg = dmg_val
            wk := false
            if d["will_kill"] is bool as wk_val
                wk = wk_val
            desc := ""
            if d["description"] is string as ds
                desc = ds
            return AttackAction{
                AttackerID: types.TokenID(aid),
                AttackerPosition: atk_pos,
                DefenderID: types.TokenID(did),
                DefenderPosition: def_pos,
                DefenderOwner: owner,
                Damage: dmg,
                WillKill: wk,
                Description: desc,
            }, true
        when "DEPLOY"
            hv := 0
            if d["health_value"] is int as hv_val
                hv = hv_val
            positions := empty list of list of int
            if d["positions"] is list of list of int as ps
                positions = ps
            rem := 0
            if d["remaining"] is int as rem_val
                rem = rem_val
            desc := ""
            if d["description"] is string as ds
                desc = ds
            return DeployAction{
                HealthValue: hv,
                Positions: positions,
                Remaining: rem,
                Description: desc,
            }, true
        when "END_TURN"
            desc := ""
            if d["description"] is string as ds
                desc = ds
            return EndTurnAction{Description: desc}, true
    return EndTurnAction{Description: "unknown"}, false

func ActionsFromDicts(dicts: list of map of string to any) list of ActionResponse
    result := empty list of ActionResponse
    for d in dicts
        r, ok := ActionDictToResponse(d)
        if ok
            result = append(result, r)
    return result
