petiole game

import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/test"
import "testing"

func TestNewPlayer(t: reference testing.T)
    p := NewPlayer(types.PlayerID("p1"), "Alice", enums.PlayerColor.CYAN)
    test.AssertEqual(t, p.id, types.PlayerID("p1"))
    test.AssertEqual(t, p.name, "Alice")
    test.AssertEqual(t, p.color, enums.PlayerColor.CYAN)
    test.AssertTrue(t, p.isActive)
    test.AssertEqual(t, p.tokenCount(), 0)

func TestPlayerAddToken(t: reference testing.T)
    p := NewPlayer(types.PlayerID("p1"), "Alice", enums.PlayerColor.CYAN)
    p.addToken(types.TokenID(1))
    p.addToken(types.TokenID(2))
    test.AssertEqual(t, p.tokenCount(), 2)
    test.AssertTrue(t, p.hasToken(types.TokenID(1)))
    test.AssertTrue(t, p.hasToken(types.TokenID(2)))

func TestPlayerRemoveToken(t: reference testing.T)
    p := NewPlayer(types.PlayerID("p1"), "Alice", enums.PlayerColor.CYAN)
    p.addToken(types.TokenID(1))
    p.addToken(types.TokenID(2))
    p.removeToken(types.TokenID(1))
    test.AssertEqual(t, p.tokenCount(), 1)
    test.AssertFalse(t, p.hasToken(types.TokenID(1)))

func TestPlayerSetReady(t: reference testing.T)
    p := NewPlayer(types.PlayerID("p1"), "Alice", enums.PlayerColor.CYAN)
    test.AssertFalse(t, p.isReady)
    p.setReady(true)
    test.AssertTrue(t, p.isReady)
    p.setReady(false)
    test.AssertFalse(t, p.isReady)

func TestPlayerEliminate(t: reference testing.T)
    p := NewPlayer(types.PlayerID("p1"), "Alice", enums.PlayerColor.CYAN)
    test.AssertTrue(t, p.isActive)
    p.eliminate()
    test.AssertFalse(t, p.isActive)

func TestPlayerColorIndex(t: reference testing.T)
    p0 := NewPlayer(types.PlayerID("p0"), "P0", enums.PlayerColor.CYAN)
    p1 := NewPlayer(types.PlayerID("p1"), "P1", enums.PlayerColor.MAGENTA)
    p2 := NewPlayer(types.PlayerID("p2"), "P2", enums.PlayerColor.YELLOW)
    p3 := NewPlayer(types.PlayerID("p3"), "P3", enums.PlayerColor.GREEN)
    test.AssertEqual(t, enums.PlayerIndex(p0.color), 0)
    test.AssertEqual(t, enums.PlayerIndex(p1.color), 1)
    test.AssertEqual(t, enums.PlayerIndex(p2.color), 2)
    test.AssertEqual(t, enums.PlayerIndex(p3.color), 3)
