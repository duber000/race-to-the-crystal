petiole game

import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/slice"

type Player
    id types.PlayerID
    name string
    color enums.PlayerColor
    token_ids list of types.TokenID
    is_ready bool
    is_active bool
    team optional reference int

func NewPlayer(id: types.PlayerID, name: string, color: enums.PlayerColor) Player
    return Player{
        id: id,
        name: name,
        color: color,
        token_ids: empty list of types.TokenID,
        is_ready: false,
        is_active: true,
    }

func token_count on p: reference Player int
    return len(p.token_ids)

func add_token on p: reference Player(token_id: types.TokenID)
    if not slice.Contains(p.token_ids, token_id)
        p.token_ids = append(p.token_ids, token_id)

func remove_token on p: reference Player(token_id: types.TokenID)
    if slice.Contains(p.token_ids, token_id)
        p.token_ids = slice.Filter(p.token_ids, (tid: types.TokenID) => tid isnt token_id)

func has_token on p: reference Player(token_id: types.TokenID) bool
    return slice.Contains(p.token_ids, token_id)

func set_ready on p: reference Player(ready: bool)
    p.is_ready = ready

func eliminate on p: reference Player
    p.is_active = false
