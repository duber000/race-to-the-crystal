petiole game

import "race-to-the-crystal/shared/types" as types
import "race-to-the-crystal/shared/enums" as enums
import "github.com/kukichalang/kukicha/stdlib/slice"

type Player
    id          types.PlayerID
    name        string
    color       enums.PlayerColor
    token_ids   list of types.TokenID
    is_ready    bool
    is_active   bool
    team        nullable reference int

func NewPlayer(id: types.PlayerID, name: string, color: enums.PlayerColor) Player
    return Player{
        id: id, name: name, color: color,
        token_ids: list of types.TokenID{},
        is_ready: false, is_active: true,
    }

func (p: reference Player) token_count() int
    return len(p.token_ids)

func (p: reference Player) add_token(token_id: types.TokenID)
    if not slice.Contains(p.token_ids, token_id)
        p.token_ids = append(p.token_ids, token_id)

func (p: reference Player) remove_token(token_id: types.TokenID)
    if slice.Contains(p.token_ids, token_id)
        p.token_ids = slice.Filter(p.token_ids, (tid: types.TokenID) => tid != token_id)

func (p: reference Player) has_token(token_id: types.TokenID) bool
    return slice.Contains(p.token_ids, token_id)

func (p: reference Player) set_ready(ready: bool)
    p.is_ready = ready

func (p: reference Player) eliminate()
    p.is_active = false
