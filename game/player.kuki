petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/slice"

type Player
    id: types.PlayerID
    name: string
    color: enums.PlayerColor
    tokenIds: list of types.TokenID
    isReady: bool
    isActive: bool
    team: optional reference int
    # How long this player has to complete a turn before it is passed on.
    # The server sets it from the player's client type: a human gets less
    # time than an agent, which may be thinking for a while.
    turnTimeoutSeconds: int

func NewPlayer(id: types.PlayerID, name: string, color: enums.PlayerColor) Player
    return Player{
        id: id,
        name: name,
        color: color,
        tokenIds: empty list of types.TokenID,
        isReady: false,
        isActive: true,
        turnTimeoutSeconds: constants.TURN_TIMEOUT_SECONDS,
    }

func tokenCount on p: reference Player int
    return len(p.tokenIds)

func Name on p: reference Player string
    return p.name

# Set the player's display name. The server uses this to carry the lobby
# name (e.g. "Alice", or an agent's model name) into the match, so the HUD
# and the agent comms show real names instead of "Player 1".
func SetName on p: reference Player(playerName: string)
    p.name = playerName

func ID on p: reference Player types.PlayerID
    return p.id

func Color on p: reference Player enums.PlayerColor
    return p.color

# How long this player has to complete a turn, in seconds.
func TurnTimeout on p: reference Player int
    return p.turnTimeoutSeconds

# Set the turn timeout. The server sets it from the player's client type.
func SetTurnTimeout on p: reference Player(seconds: int)
    if seconds > 0
        p.turnTimeoutSeconds = seconds

func IsActive on p: reference Player bool
    return p.isActive

func addToken on p: reference Player(tokenId: types.TokenID)
    if not slice.Contains(p.tokenIds, tokenId)
        p.tokenIds = append(p.tokenIds, tokenId)

func removeToken on p: reference Player(tokenId: types.TokenID)
    if slice.Contains(p.tokenIds, tokenId)
        p.tokenIds = slice.Filter(p.tokenIds, (tid: types.TokenID) => tid isnt tokenId)

func hasToken on p: reference Player(tokenId: types.TokenID) bool
    return slice.Contains(p.tokenIds, tokenId)

func setReady on p: reference Player(ready: bool)
    p.isReady = ready

func eliminate on p: reference Player
    p.isActive = false
