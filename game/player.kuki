petiole game

import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/slice"

type Player
    id: types.PlayerID
    name: string
    color: enums.PlayerColor
    tokenIds: list of types.TokenID
    isReady: bool
    isActive: bool
    team: optional reference int

func NewPlayer(id: types.PlayerID, name: string, color: enums.PlayerColor) Player
    return Player{
        id: id,
        name: name,
        color: color,
        tokenIds: empty list of types.TokenID,
        isReady: false,
        isActive: true,
    }

func tokenCount on p: reference Player int
    return len(p.tokenIds)

func Name on p: reference Player string
    return p.name

func ID on p: reference Player types.PlayerID
    return p.id

func Color on p: reference Player enums.PlayerColor
    return p.color

func IsActive on p: reference Player bool
    return p.isActive

func addToken on p: reference Player(tokenId: types.TokenID)
    if not slice.Contains(p.tokenIds, tokenId)
        p.tokenIds = append(p.tokenIds, tokenId)

func removeToken on p: reference Player(tokenId: types.TokenID)
    if slice.Contains(p.tokenIds, tokenId)
        p.tokenIds = slice.Filter(p.tokenIds, (tid: types.TokenID) => tid isnt tokenId)

func hasToken on p: reference Player(tokenId: types.TokenID) bool
    return slice.Contains(p.tokenIds, tokenId)

func setReady on p: reference Player(ready: bool)
    p.isReady = ready

func eliminate on p: reference Player
    p.isActive = false
