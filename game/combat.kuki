petiole game

import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types

type CombatOutcome
    result: enums.CombatResult
    damageDealt: int
    attackerId: types.TokenID
    defenderId: types.TokenID
    defenderKilled: bool
    counterDamage: int
    attackerKilled: bool

func canAttack(attacker: reference Token, defender: reference Token) bool
    if not attacker.isAlive or not defender.isAlive
        return false
    if attacker.playerId equals defender.playerId
        return false
    if not attacker.isAdjacentTo(defender.position)
        return false
    return true

func resolveCombat(attacker: reference Token, defender: reference Token) CombatOutcome
    if not canAttack(attacker, defender)
        return CombatOutcome{
            result: enums.INVALID,
            damageDealt: 0,
            attackerId: attacker.id,
            defenderId: defender.id,
            defenderKilled: false,
            counterDamage: 0,
            attackerKilled: false,
        }

    damage := attacker.attackPower()
    wasKilled := defender.takeDamage(damage)

    counterDamage := 0
    attackerKilled := false
    if not wasKilled and defender.isAlive
        counterDamage = defender.counterAttackPower()
        if counterDamage > 0
            attackerKilled = attacker.takeDamage(counterDamage)

    if wasKilled
        return CombatOutcome{
            result: enums.KILLED,
            damageDealt: damage,
            attackerId: attacker.id,
            defenderId: defender.id,
            defenderKilled: true,
            counterDamage: 0,
            attackerKilled: false,
        }
    else
        return CombatOutcome{
            result: enums.HIT,
            damageDealt: damage,
            attackerId: attacker.id,
            defenderId: defender.id,
            defenderKilled: false,
            counterDamage: counterDamage,
            attackerKilled: attackerKilled,
        }

func wouldKill(attacker: reference Token, defender: reference Token) bool
    if not canAttack(attacker, defender)
        return false
    damage := attacker.attackPower()
    return defender.health <= damage
