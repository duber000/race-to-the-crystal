petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types

type Token
    id: types.TokenID
    player_id: types.PlayerID
    health: int
    max_health: int
    position: types.Position
    is_alive: bool
    is_deployed: bool

func NewToken(id: types.TokenID, player_id: types.PlayerID, health: int, max_health: int, position: types.Position) (Token, error)
    if health < 0
        return Token{}, error "health must be >= 0"
    if max_health < 0
        return Token{}, error "max_health must be >= 0"
    if health > max_health
        return Token{}, error "health cannot exceed max_health"
    valid_health := false
    for hv in constants.TOKEN_HEALTH_VALUES
        if health equals hv
            valid_health = true
            break
    if not valid_health
        return Token{}, error "health must be one of {constants.TOKEN_HEALTH_VALUES}"
    return Token{
        id: id,
        player_id: player_id,
        health: health,
        max_health: max_health,
        position: position,
        is_alive: true,
        is_deployed: false,
    }, empty

func movement_range on t: reference Token int
    if t.health <= 6
        return 2
    return 1

func attack_power on t: reference Token int
    return t.health / 2

func take_damage on t: reference Token(damage: int) bool
    t.health = t.health - damage
    if t.health <= 0
        t.health = 0
        t.is_alive = false
        return true
    valid_health := 0
    for hv in constants.TOKEN_HEALTH_VALUES
        if t.health >= hv
            valid_health = hv
            break
    if valid_health equals 0
        t.health = 0
        t.is_alive = false
        return true
    t.health = valid_health
    return false

func heal_to_full on t: reference Token
    t.health = t.max_health

func heal on t: reference Token(amount: int)
    t.health = t.health + amount
    if t.health > t.max_health
        t.health = t.max_health

func move_to on t: reference Token(new_position: types.Position)
    t.position = new_position

func distance_to on t: Token(other: types.Position) int
    dx := t.position.X - other.X
    if dx < 0
        dx = -dx
    dy := t.position.Y - other.Y
    if dy < 0
        dy = -dy
    return dx + dy

func is_adjacent_to on t: Token(other: types.Position) bool
    dx := t.position.X - other.X
    if dx < 0
        dx = -dx
    dy := t.position.Y - other.Y
    if dy < 0
        dy = -dy
    return dx <= 1 and dy <= 1 and dx + dy > 0
