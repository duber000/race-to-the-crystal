petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/slice"

type Token
    id: types.TokenID
    playerId: types.PlayerID
    health: int
    maxHealth: int
    position: types.Position
    isAlive: bool
    isDeployed: bool

func NewToken(id: types.TokenID, playerId: types.PlayerID, health: int, maxHealth: int, position: types.Position) (Token, error)
    if health < 0
        return Token{}, error "health must be >= 0"
    if maxHealth < 0
        return Token{}, error "max_health must be >= 0"
    if health > maxHealth
        return Token{}, error "health cannot exceed max_health"
    if not slice.Contains(constants.TOKEN_HEALTH_VALUES, health)
        return Token{}, error "health must be one of {constants.TOKEN_HEALTH_VALUES}"
    return Token{
        id: id,
        playerId: playerId,
        health: health,
        maxHealth: maxHealth,
        position: position,
        isAlive: true,
        isDeployed: false,
    }, empty

func movementRange on t: reference Token int
    if t.health <= 6
        return 2
    return 1

func Position on t: reference Token types.Position
    return t.position

func ID on t: reference Token types.TokenID
    return t.id

func PlayerID on t: reference Token types.PlayerID
    return t.playerId

func Health on t: reference Token int
    return t.health

func MaxHealth on t: reference Token int
    return t.maxHealth

func IsAlive on t: reference Token bool
    return t.isAlive

func IsDeployed on t: reference Token bool
    return t.isDeployed

func attackPower on t: reference Token int
    return t.health / 2

func takeDamage on t: reference Token(damage: int) bool
    t.health = t.health - damage
    if t.health <= 0
        t.health = 0
        t.isAlive = false
        return true
    validHealth := 0
    for hv in constants.TOKEN_HEALTH_VALUES
        if t.health >= hv
            validHealth = hv
            break
    if validHealth equals 0
        t.health = 0
        t.isAlive = false
        return true
    t.health = validHealth
    return false

func healToFull on t: reference Token
    t.health = t.maxHealth

func heal on t: reference Token(amount: int)
    t.health = t.health + amount
    if t.health > t.maxHealth
        t.health = t.maxHealth

func moveTo on t: reference Token(newPosition: types.Position)
    t.position = newPosition

func distanceTo on t: Token(other: types.Position) int
    dx := t.position.X - other.X
    if dx < 0
        dx = -dx
    dy := t.position.Y - other.Y
    if dy < 0
        dy = -dy
    return dx + dy

func isAdjacentTo on t: Token(other: types.Position) bool
    dx := t.position.X - other.X
    if dx < 0
        dx = -dx
    dy := t.position.Y - other.Y
    if dy < 0
        dy = -dy
    return dx <= 1 and dy <= 1 and dx + dy > 0
