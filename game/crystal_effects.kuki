petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/random"
import "stdlib/slice"

type ActiveEffect
    effectType: enums.CrystalEffect
    turnsRemaining: int
    appliedTurn: int

func reduceDuration on e: reference ActiveEffect(amount: int)
    e.turnsRemaining = e.turnsRemaining - amount
    if e.turnsRemaining < 0
        e.turnsRemaining = 0

func isActive on e: ActiveEffect bool
    return e.turnsRemaining > 0

type PhantomToken
    phantomId: int
    apparentPlayerId: types.PlayerID
    position: types.Position
    apparentHealth: int

type PlayerEffects
    playerId: types.PlayerID
    activeEffects: list of ActiveEffect
    phantomTokens: list of PhantomToken

func hasEffect on e: reference PlayerEffects(et: enums.CrystalEffect) bool
    for eff in e.activeEffects
        if eff.effectType equals et and eff.isActive()
            return true
    return false

func getEffect on e: reference PlayerEffects(et: enums.CrystalEffect) optional reference ActiveEffect
    for i from 0 to len(e.activeEffects)
        if e.activeEffects[i].effectType equals et and e.activeEffects[i].isActive()
            return reference of e.activeEffects[i]
    return empty

func addEffect on e: reference PlayerEffects(et: enums.CrystalEffect, duration: int, turnNumber: int) reference ActiveEffect
    e.activeEffects = slice.Filter(e.activeEffects, eff => eff.effectType isnt et)
    eff := ActiveEffect{effectType: et, turnsRemaining: duration, appliedTurn: turnNumber}
    e.activeEffects = append(e.activeEffects, eff)
    return reference of e.activeEffects[len(e.activeEffects) - 1]

func reduceAllDurations on e: reference PlayerEffects(amount: int)
    for i from 0 to len(e.activeEffects)
        e.activeEffects[i].reduceDuration(amount)
    e.activeEffects = slice.Filter(e.activeEffects, eff => eff.isActive())
    if not e.hasEffect(enums.PHANTOM_ENEMIES)
        e.phantomTokens = empty list of PhantomToken

type CrystalEffectsManager
    playerEffects: map of types.PlayerID to reference PlayerEffects
    _next_phantom_id: int

func NewCrystalEffectsManager() CrystalEffectsManager
    return CrystalEffectsManager{
        playerEffects: empty map of types.PlayerID to reference PlayerEffects,
        _next_phantom_id: -1,
    }

func getPlayerEffects on m: reference CrystalEffectsManager(playerId: types.PlayerID) reference PlayerEffects
    pe, ok := m.playerEffects[playerId]
    if ok
        return pe
    newPe := PlayerEffects{playerId: playerId}
    m.playerEffects[playerId] = reference of newPe
    return m.playerEffects[playerId]

func applyEffect on m: reference CrystalEffectsManager(playerId: types.PlayerID, et: enums.CrystalEffect, turnNumber: int, duration: int)
    if duration equals 0
        duration = constants.CRYSTAL_EFFECT_INITIAL_DURATION
    pe := m.getPlayerEffects(playerId)
    pe.addEffect(et, duration, turnNumber)

func endTurnUpdate on m: reference CrystalEffectsManager
    for _, peRef in m.playerEffects
        peRef.reduceAllDurations(1)

func generatePhantomTokens on m: reference CrystalEffectsManager(affectedPlayerId: types.PlayerID, otherPlayerIds: list of types.PlayerID, bw: int, bh: int, occupied: map of types.Position to bool) list of PhantomToken
    pe := m.getPlayerEffects(affectedPlayerId)
    pe.phantomTokens = empty list of PhantomToken

    if not pe.hasEffect(enums.PHANTOM_ENEMIES)
        return empty list of PhantomToken

    for _ from 0 to constants.PHANTOM_ENEMIES_COUNT
        for _ from 0 to 50
            x := safeRandomInt(0, bw)
            y := safeRandomInt(0, bh)
            pos := types.Pos(x, y)

            if pos not in occupied
                apparentPlayer := random.ChoiceOr of types.PlayerID(otherPlayerIds, affectedPlayerId)

                apparentHealth := random.Choice of int from constants.TOKEN_HEALTH_VALUES

                phantom := PhantomToken{
                    phantomId: m._next_phantom_id,
                    apparentPlayerId: apparentPlayer,
                    position: pos,
                    apparentHealth: apparentHealth,
                }

                pe.phantomTokens = append(pe.phantomTokens, phantom)
                m._next_phantom_id = m._next_phantom_id - 1
                break

    return pe.phantomTokens

func hasFogOfWar on m: reference CrystalEffectsManager(playerId: types.PlayerID) bool
    pe := m.getPlayerEffects(playerId)
    return pe.hasEffect(enums.FOG_OF_WAR)
