petiole game

import "race-to-the-crystal/shared/types"
import "stdlib/test"
import "testing"

# --- Objective capture progress ---------------------------------------------
#
# The client draws the capture progress of the generators and the crystal.
# The requirements and the progress come from the rules, so the browser
# does not have to know them.

# A started two-player game.
func newObjectiveGame() reference GameState
    gs := CreateGame(2)
    gs.StartGame()
    return reference of gs

# The generator dict at an index.
func generatorDict(state: StateDict, index: int) StateDict
    gensVal := state["generators"]
    if gensVal is list of StateDict as gens
        return gens[index]
    return StateDict{}

# The crystal dict.
func crystalDict(state: StateDict) StateDict
    crysVal := state["crystal"]
    if crysVal is StateDict as crys
        return crys
    return StateDict{}

# Put a token on a cell and deploy it.
func placeObjectiveToken(gs: reference GameState, tokenId: types.TokenID, x: int, y: int)
    tRef := gs.GetToken(tokenId)
    if tRef is empty
        return
    tRef.position = types.Pos(x, y)
    tRef.isDeployed = true
    gs.board.setOccupant(types.Pos(x, y), tokenId)

# A generator shows the requirements of a capture even when the viewer
# cannot see it: the numbers are rules, not secrets.
func TestGeneratorAlwaysShowsTheCaptureRequirements(t: reference testing.T)
    gs := newObjectiveGame()
    state := gs.VisibleStateDict(types.PlayerID("player_0"))

    gen := generatorDict(state, 0)
    test.AssertEqual(t, gen["tokens_required"], 2)
    test.AssertEqual(t, gen["turns_required"], 2)

# A generator out of sight hides who is capturing it and how far along the
# capture is, but not the requirements.
func TestGeneratorOutOfViewMasksTheCaptureProgress(t: reference testing.T)
    gs := newObjectiveGame()
    # The viewer has no tokens on the board, so nothing is in sight.
    for tid in gs.GetPlayerTokens(types.PlayerID("player_0"))
        tRef := gs.GetToken(tid.id)
        if tRef isnt empty
            tRef.isDeployed = false

    state := gs.VisibleStateDict(types.PlayerID("player_0"))
    gen := generatorDict(state, 0)
    test.AssertEqual(t, gen["tokens_required"], 2)
    test.AssertEqual(t, gen["turns_required"], 2)
    test.AssertEqual(t, gen["turns_held"], 0)
    test.AssertEqual(t, gen["tokens_present"], 0)
    test.AssertEqual(t, gen["capturing_player_id"], "")

# The token count is live: a token standing on the generator is counted
# before the capture has been updated by an end turn. The capture only
# advances on an end turn, but the player wants to know what is on the
# cell right now.
func TestGeneratorTokenCountIsLive(t: reference testing.T)
    gs := newObjectiveGame()
    gen := gs.generators[0]

    state := gs.VisibleStateDict(types.PlayerID("player_0"))
    test.AssertEqual(t, generatorDict(state, 0)["tokens_present"], 0)

    placeObjectiveToken(gs, types.TokenID(0), gen.position.X, gen.position.Y)
    state = gs.VisibleStateDict(types.PlayerID("player_0"))
    test.AssertEqual(t, generatorDict(state, 0)["tokens_present"], 1)

    placeObjectiveToken(gs, types.TokenID(1), gen.position.X, gen.position.Y)
    state = gs.VisibleStateDict(types.PlayerID("player_0"))
    test.AssertEqual(t, generatorDict(state, 0)["tokens_present"], 2)

# A contested cell -- one token each -- is not being captured by anyone,
# so the count is zero.
func TestContestedCellHasNoTokenCount(t: reference testing.T)
    gs := newObjectiveGame()
    gen := gs.generators[0]

    placeObjectiveToken(gs, types.TokenID(0), gen.position.X, gen.position.Y)
    placeObjectiveToken(gs, types.TokenID(20), gen.position.X, gen.position.Y)

    state := gs.VisibleStateDict(types.PlayerID("player_0"))
    test.AssertEqual(t, generatorDict(state, 0)["tokens_present"], 0)

# The crystal's token count is live too.
func TestCrystalTokenCountIsLive(t: reference testing.T)
    gs := newObjectiveGame()
    crys := gs.crystalInstance
    if crys is empty
        return
    placeObjectiveToken(gs, types.TokenID(0), crys.position.X, crys.position.Y)

    state := gs.VisibleStateDict(types.PlayerID("player_0"))
    test.AssertEqual(t, crystalDict(state)["tokens_present"], 1)

func TestCrystalShowsTheCaptureRequirements(t: reference testing.T)
    gs := newObjectiveGame()
    state := gs.VisibleStateDict(types.PlayerID("player_0"))

    crys := crystalDict(state)
    test.AssertEqual(t, crys["turns_required"], 3)
    test.AssertEqual(t, crys["tokens_required"], 12)
    test.AssertEqual(t, crys["tokens_present"], 0)

# Every generator that falls takes two tokens off the crystal's
# requirement, and the client is told the new number.
func TestCrystalRequirementFallsWithEachGenerator(t: reference testing.T)
    gs := newObjectiveGame()
    gens := gs.generators

    for i from 0 to len(gens)
        state := gs.VisibleStateDict(types.PlayerID("player_0"))
        crys := crystalDict(state)
        test.AssertEqual(t, crys["tokens_required"], 12 - 2 * i)
        gens[i].isDisabled = true

    state := gs.VisibleStateDict(types.PlayerID("player_0"))
    crys := crystalDict(state)
    test.AssertEqual(t, crys["tokens_required"], 4)
