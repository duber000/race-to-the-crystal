petiole game

import "race-to-the-crystal/shared/types" as types
import "stdlib/maps"

type TokenAtPos
    tokenId: types.TokenID
    playerId: types.PlayerID

func countTokensByPlayer(tokens: list of TokenAtPos) map of types.PlayerID to list of types.TokenID
    result := empty map of types.PlayerID to list of types.TokenID
    for tap in tokens
        if not maps.Contains(result, tap.playerId)
            result[tap.playerId] = empty list of types.TokenID
        result[tap.playerId] = append(result[tap.playerId], tap.tokenId)
    return result

func findDominantPlayer(counts: map of types.PlayerID to list of types.TokenID) (types.PlayerID, int, bool)
    dominantPlayer := types.PlayerID("")
    dominantCount := 0
    contested := false
    for playerId, tokenIds in counts
        n := len(tokenIds)
        if n > dominantCount
            dominantPlayer = playerId
            dominantCount = n
            contested = false
        else if n equals dominantCount and dominantCount > 0
            contested = true
    if contested
        return types.PlayerID(""), dominantCount, false
    if dominantCount > 0
        return dominantPlayer, dominantCount, true
    return types.PlayerID(""), 0, false
