petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/random"
import "stdlib/sort"

type CrystalEvent
    player_id: types.PlayerID
    effect_type: enums.CrystalEffect

type MysteryEvent
    TokenID: types.TokenID
    Position: types.Position
    effect: string

type GameState
    board: Board
    players: map of types.PlayerID to reference Player
    tokens: map of types.TokenID to reference Token
    generators: list of Generator
    crystal_instance: optional reference Crystal
    crystal_effects: CrystalEffectsManager
    current_turn_player_id: types.PlayerID
    turn_number: int
    phase: enums.GamePhase
    turn_phase: enums.TurnPhase
    winner_id: types.PlayerID
    _next_token_id: int
    last_triggered_crystal_effect: optional reference CrystalEvent
    last_triggered_mystery_event: optional reference MysteryEvent

func NewGameState() GameState
    return GameState{
        board: NewBoard(),
        players: empty map of types.PlayerID to reference Player,
        tokens: empty map of types.TokenID to reference Token,
        generators: empty list of Generator,
        crystal_effects: NewCrystalEffectsManager(),
        phase: enums.SETUP,
        turn_phase: enums.MOVEMENT,
        _next_token_id: 0,
    }

func CreateGame(num_players: int) GameState
    gs := NewGameState()
    colors := list of enums.PlayerColor{enums.CYAN, enums.MAGENTA, enums.YELLOW, enums.GREEN}

    for i from 0 to num_players
        pid := types.PlayerID("player_{i}")
        p := NewPlayer(pid, "Player {i + 1}", colors[i])
        gs.players[pid] = reference of p

    gen_positions := gs.board.get_generator_positions()
    gs.generators = create_generators(gen_positions)

    crystal_pos := gs.board.get_crystal_position()
    c := NewCrystal(crystal_pos)
    gs.crystal_instance = reference of c

    return gs

func add_player on gs: reference GameState(player_id: types.PlayerID, name: string, color: enums.PlayerColor) Player
    p := NewPlayer(player_id, name, color)
    gs.players[player_id] = reference of p
    return p

func remove_player on gs: reference GameState(player_id: types.PlayerID)
    delete gs.players[player_id]

func GetPlayer on gs: reference GameState(player_id: types.PlayerID) optional reference Player
    p, ok := gs.players[player_id]
    if ok
        return p
    return empty

func GetCurrentPlayer on gs: reference GameState optional reference Player
    return gs.GetPlayer(gs.current_turn_player_id)

func GetToken on gs: reference GameState(token_id: types.TokenID) optional reference Token
    t, ok := gs.tokens[token_id]
    if ok
        return t
    return empty

func create_tokens_for_player on gs: reference GameState(player_id: types.PlayerID)
    p_ref := gs.GetPlayer(player_id)
    if p_ref equals empty
        return

    corner_pos := gs.board.get_starting_position(enums.PlayerIndex(p_ref.color))

    for hv in constants.TOKEN_HEALTH_VALUES
        for _ from 0 to constants.TOKENS_PER_HEALTH_VALUE
            tid := types.TokenID(gs._next_token_id)
            t := NewToken(tid, player_id, hv, hv, corner_pos) onerr
                continue

            gs.tokens[tid] = reference of t
            p_ref.add_token(tid)
            gs._next_token_id = gs._next_token_id + 1

func GetPlayerTokens on gs: reference GameState(player_id: types.PlayerID) list of Token
    result := empty list of Token
    p_ref := gs.GetPlayer(player_id)
    if p_ref equals empty
        return result
    p := dereference p_ref
    for tid in p.token_ids
        t_ref := gs.GetToken(tid)
        if t_ref isnt empty
            t := dereference t_ref
            if t.is_alive and t.is_deployed
                result = append(result, t)
    return result

func GetReserveTokens on gs: reference GameState(player_id: types.PlayerID) list of Token
    result := empty list of Token
    p_ref := gs.GetPlayer(player_id)
    if p_ref equals empty
        return result
    p := dereference p_ref
    for tid in p.token_ids
        t_ref := gs.GetToken(tid)
        if t_ref isnt empty
            t := dereference t_ref
            if not t.is_deployed
                result = append(result, t)
    return result

func GetReserveTokenCounts on gs: reference GameState(player_id: types.PlayerID) map of int to int
    counts := empty map of int to int
    for hv in constants.TOKEN_HEALTH_VALUES
        counts[hv] = 0
    reserve := gs.GetReserveTokens(player_id)
    for t in reserve
        counts[t.max_health] = counts[t.max_health] + 1
    return counts

func DeployToken on gs: reference GameState(player_id: types.PlayerID, health_value: int, position: types.Position) optional reference Token
    reserve := gs.GetReserveTokens(player_id)
    for i from 0 to len(reserve)
        if reserve[i].max_health equals health_value
            t_ref := gs.GetToken(reserve[i].id)
            if t_ref equals empty
                return empty
            t_ref.position = position
            t_ref.is_deployed = true
            gs.board.set_occupant(position, t_ref.id)
            return t_ref
    return empty

func GetTokensAtPosition on gs: reference GameState(pos: types.Position) list of Token
    result := empty list of Token
    for _, t in gs.tokens
        d := dereference t
        if d.position equals pos and d.is_alive
            result = append(result, d)
    return result

func GetTokenMovementRange on gs: reference GameState(tok: reference Token) int
    base := tok.movement_range()
    pe := gs.crystal_effects.get_player_effects(tok.player_id)
    if pe.has_effect(enums.SPEED_BOOST)
        return base + constants.CRYSTAL_SPEED_BOOST_AMOUNT
    return base

func MoveToken on gs: reference GameState(token_id: types.TokenID, new_pos: types.Position) bool
    t_ref := gs.GetToken(token_id)
    if t_ref equals empty
        return false
    t := dereference t_ref
    if not t.is_alive
        return false

    gs.board.clear_occupant(t.position, token_id)
    t.move_to(new_pos)
    gs.board.set_occupant(new_pos, token_id)
    return true

func remove_token on gs: reference GameState(token_id: types.TokenID)
    t_ref := gs.GetToken(token_id)
    if t_ref equals empty
        return
    t := dereference t_ref

    gs.board.clear_occupant(t.position, token_id)

    p_ref := gs.GetPlayer(t.player_id)
    if p_ref isnt empty
        p_ref.remove_token(token_id)

    t.is_alive = false

func AttackToken on gs: reference GameState(attacker_id: types.TokenID, defender_id: types.TokenID) optional reference CombatOutcome
    a_ref := gs.GetToken(attacker_id)
    if a_ref equals empty
        return empty
    d_ref := gs.GetToken(defender_id)
    if d_ref equals empty
        return empty

    if not can_attack(a_ref, d_ref)
        return empty

    damage := a_ref.attack_power()
    pe := gs.crystal_effects.get_player_effects(a_ref.player_id)
    if pe.has_effect(enums.DAMAGE_BOOST)
        damage = (damage as float64 * constants.CRYSTAL_DAMAGE_BOOST_MULTIPLIER) as int

    was_killed := d_ref.take_damage(damage)
    if was_killed
        gs.remove_token(defender_id)

    var result: enums.CombatResult
    if was_killed
        result = enums.KILLED
    else
        result = enums.HIT
    outcome := CombatOutcome{
        result: result,
        damage_dealt: damage,
        attacker_id: attacker_id,
        defender_id: defender_id,
        defender_killed: was_killed,
    }
    return reference of outcome

func _auto_deploy_starting_tokens on gs: reference GameState(player_id: types.PlayerID, player_index: int)
    deploy_positions := gs.board.get_deployable_positions(player_index)
    reserve := gs.GetReserveTokens(player_id)

    sort_slice(reserve) # strongest first
    deployed := 0

    for pos in deploy_positions
        if deployed >= 3
            break
        cell := gs.board.get_cell_at(pos)
        if cell isnt empty
            dc := dereference cell
            if dc.is_occupied()
                continue
            if dc.cell_type isnt enums.NORMAL
                continue

            tok := reserve[deployed]
            t_ref := gs.GetToken(tok.id)
            if t_ref isnt empty
                t_ref.position = pos
                t_ref.is_deployed = true
                gs.board.set_occupant(pos, t_ref.id)
                deployed = deployed + 1

func sort_slice(tokens: list of Token)
    sort.ByKeyDesc of Token(tokens, (t: Token) => t.max_health)

func StartGame on gs: reference GameState
    if gs.phase isnt enums.SETUP
        return

    for pid, _ in gs.players
        gs.create_tokens_for_player(pid)

    for pid, p_ref in gs.players
        gs._auto_deploy_starting_tokens(pid, enums.PlayerIndex(p_ref.color))

    for pid, _ in gs.players
        gs.current_turn_player_id = pid
        break

    gs.phase = enums.PLAYING
    gs.turn_number = 1

func EndTurn on gs: reference GameState
    if gs.current_turn_player_id equals ""
        return

    gs.clear_turn_state()
    gs.advance_to_next_player()
    gs.turn_phase = enums.MOVEMENT

func clear_turn_state on gs: reference GameState
    gs.last_triggered_mystery_event = empty

func advance_to_next_player on gs: reference GameState
    gs.crystal_effects.end_turn_update()
    active := gs.get_active_players()

    if len(active) equals 0
        return

    next_idx := gs.calculate_next_player_index(active)
    gs.current_turn_player_id = active[next_idx]

    if next_idx equals 0
        gs.turn_number = gs.turn_number + 1
        if gs.turn_number > 0 and gs.turn_number % constants.CRYSTAL_RANDOM_EFFECT_ROUND_INTERVAL equals 0
            gs.trigger_random_crystal_effect()

func get_active_players on gs: reference GameState list of types.PlayerID
    result := empty list of types.PlayerID
    for pid, p_ref in gs.players
        if p_ref.is_active
            result = append(result, pid)
    return result

func calculate_next_player_index on gs: reference GameState(active: list of types.PlayerID) int
    current_idx := -1
    for i, pid in active
        if pid equals gs.current_turn_player_id
            current_idx = i
            break
    return (current_idx + 1) % len(active)

func trigger_random_crystal_effect on gs: reference GameState() (types.PlayerID, enums.CrystalEffect, bool)
    if len(gs.players) equals 0
        return types.PlayerID(""), "", false

    effects := list of enums.CrystalEffect{
        enums.FOG_OF_WAR,
        enums.PHANTOM_ENEMIES,
        enums.DAMAGE_BOOST,
        enums.SPEED_BOOST,
    }
    effect := random.Choice of enums.CrystalEffect from effects
    target_player := types.PlayerID("")

    for pid, _ in gs.players
        target_player = pid
        break

    gs.crystal_effects.apply_effect(
        target_player,
        effect,
        gs.turn_number,
        constants.CRYSTAL_EFFECT_INITIAL_DURATION,
    )
    gs.last_triggered_crystal_effect = reference of CrystalEvent{player_id: target_player, effect_type: effect}
    return target_player, effect, true

func update_generators_and_crystal on gs: reference GameState() (list of int, bool)
    tokens_by_pos := empty map of types.Position to list of TokenAtPos

    for _, t in gs.tokens
        if t.is_alive and t.is_deployed
            taps := TokenAtPos{token_id: t.id, player_id: t.player_id}
            tokens_by_pos[t.position] = append(tokens_by_pos[t.position], taps)

    newly_disabled, _ := update_all_generators(gs.generators, tokens_by_pos)

    disabled_count := count_disabled_generators(gs.generators)

    crystal_captured := false
    if gs.crystal_instance isnt empty
        c := dereference gs.crystal_instance
        crystal_pos := c.position
        taps := tokens_by_pos[crystal_pos]
        outcome := c.update_capture_status(taps, disabled_count)
        if outcome.is_winner
            gs.winner_id = outcome.winner_id
            gs.phase = enums.ENDED
            crystal_captured = true

    return newly_disabled, crystal_captured

func EndTurnWithObjectiveUpdate on gs: reference GameState() (list of int, bool, bool)
    newly_disabled, crystal_captured := gs.update_generators_and_crystal()
    gs.EndTurn()
    return newly_disabled, crystal_captured, gs.phase equals enums.ENDED

func set_winner on gs: reference GameState(player_id: types.PlayerID)
    gs.winner_id = player_id
    gs.phase = enums.ENDED

func apply_crystal_effect on gs: reference GameState(player_id: types.PlayerID, et: enums.CrystalEffect, duration: int)
    gs.crystal_effects.apply_effect(player_id, et, gs.turn_number, duration)

func Phase on gs: GameState enums.GamePhase
    return gs.phase

func WinnerID on gs: GameState types.PlayerID
    return gs.winner_id

func CurrentTurnPlayerID on gs: GameState types.PlayerID
    return gs.current_turn_player_id

func TurnNumber on gs: GameState int
    return gs.turn_number

func TurnPhase on gs: GameState enums.TurnPhase
    return gs.turn_phase

func ToDict on gs: reference GameState map of string to any
    result := empty map of string to any
    result["phase"] = enums.GamePhaseName(gs.phase)
    result["turn_number"] = gs.turn_number
    result["current_turn_player_id"] = gs.current_turn_player_id as string
    if gs.winner_id isnt ""
        result["winner_id"] = gs.winner_id as string
    result["turn_phase"] = enums.TurnPhaseName(gs.turn_phase)
    player_list := empty list of map of string to any
    for pid, p in gs.players
        pd := map of string to any{
            "id": pid as string,
            "name": p.name,
            "is_active": p.is_active,
            "is_ready": p.is_ready,
        }
        player_list = append(player_list, pd)
    result["players"] = player_list
    return result
