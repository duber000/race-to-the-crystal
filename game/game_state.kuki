petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/random"
import "stdlib/sort"

type CrystalEvent
    playerId: types.PlayerID
    effectType: enums.CrystalEffect

type MysteryEvent
    TokenID: types.TokenID
    Position: types.Position
    effect: string

type GameState
    board: Board
    players: map of types.PlayerID to reference Player
    tokens: map of types.TokenID to reference Token
    generators: list of Generator
    crystalInstance: optional reference Crystal
    crystalEffects: CrystalEffectsManager
    currentTurnPlayerId: types.PlayerID
    turnNumber: int
    phase: enums.GamePhase
    turnPhase: enums.TurnPhase
    winnerId: types.PlayerID
    nextTokenId: int
    lastTriggeredCrystalEffect: optional reference CrystalEvent
    lastTriggeredMysteryEvent: optional reference MysteryEvent

func NewGameState() GameState
    return GameState{
        board: NewBoard(),
        players: empty map of types.PlayerID to reference Player,
        tokens: empty map of types.TokenID to reference Token,
        generators: empty list of Generator,
        crystalEffects: NewCrystalEffectsManager(),
        phase: enums.SETUP,
        turnPhase: enums.MOVEMENT,
        nextTokenId: 0,
    }

func CreateGame(numPlayers: int) GameState
    gs := NewGameState()
    colors := list of enums.PlayerColor{enums.CYAN, enums.MAGENTA, enums.YELLOW, enums.GREEN}

    for i from 0 to numPlayers
        pid := types.PlayerID("player_{i}")
        p := NewPlayer(pid, "Player {i + 1}", colors[i])
        gs.players[pid] = reference of p

    genPositions := gs.board.getGeneratorPositions()
    gs.generators = createGenerators(genPositions)

    crystalPos := gs.board.getCrystalPosition()
    c := NewCrystal(crystalPos)
    gs.crystalInstance = reference of c

    return gs

func addPlayer on gs: reference GameState(playerId: types.PlayerID, name: string, color: enums.PlayerColor) Player
    p := NewPlayer(playerId, name, color)
    gs.players[playerId] = reference of p
    return p

func removePlayer on gs: reference GameState(playerId: types.PlayerID)
    delete gs.players[playerId]

func GetPlayer on gs: reference GameState(playerId: types.PlayerID) optional reference Player
    return gs.players[playerId]

func GetCurrentPlayer on gs: reference GameState optional reference Player
    return gs.GetPlayer(gs.currentTurnPlayerId)

func GetToken on gs: reference GameState(tokenId: types.TokenID) optional reference Token
    return gs.tokens[tokenId]

func createTokensForPlayer on gs: reference GameState(playerId: types.PlayerID)
    pRef := gs.GetPlayer(playerId)
    if pRef is empty
        return

    cornerPos := gs.board.getStartingPosition(enums.PlayerIndex(pRef.color))

    for hv in constants.TOKEN_HEALTH_VALUES
        for _ from 0 to constants.TOKENS_PER_HEALTH_VALUE
            tid := types.TokenID(gs.nextTokenId)
            t := NewToken(tid, playerId, hv, hv, cornerPos) onerr
                continue

            gs.tokens[tid] = reference of t
            pRef.addToken(tid)
            gs.nextTokenId = gs.nextTokenId + 1

func GetPlayerTokens on gs: reference GameState(playerId: types.PlayerID) list of Token
    result := empty list of Token
    pRef := gs.GetPlayer(playerId)
    if pRef is empty
        return result
    p := dereference pRef
    for tid in p.tokenIds
        tRef := gs.GetToken(tid)
        if tRef isnt empty
            t := dereference tRef
            if t.isAlive and t.isDeployed
                result = append(result, t)
    return result

func GetReserveTokens on gs: reference GameState(playerId: types.PlayerID) list of Token
    result := empty list of Token
    pRef := gs.GetPlayer(playerId)
    if pRef is empty
        return result
    p := dereference pRef
    for tid in p.tokenIds
        tRef := gs.GetToken(tid)
        if tRef isnt empty
            t := dereference tRef
            if not t.isDeployed
                result = append(result, t)
    return result

func GetReserveTokenCounts on gs: reference GameState(playerId: types.PlayerID) map of int to int
    counts := empty map of int to int
    for hv in constants.TOKEN_HEALTH_VALUES
        counts[hv] = 0
    reserve := gs.GetReserveTokens(playerId)
    for t in reserve
        counts[t.maxHealth] = counts[t.maxHealth] + 1
    return counts

func DeployToken on gs: reference GameState(playerId: types.PlayerID, healthValue: int, position: types.Position) optional reference Token
    reserve := gs.GetReserveTokens(playerId)
    for i from 0 to len(reserve)
        if reserve[i].maxHealth equals healthValue
            tRef := gs.GetToken(reserve[i].id)
            if tRef is empty
                return empty
            tRef.position = position
            tRef.isDeployed = true
            gs.board.setOccupant(position, tRef.id)
            return tRef
    return empty

func GetTokensAtPosition on gs: reference GameState(pos: types.Position) list of Token
    result := empty list of Token
    for _, t in gs.tokens
        d := dereference t
        if d.position equals pos and d.isAlive
            result = append(result, d)
    return result

func GetTokenMovementRange on gs: reference GameState(tok: reference Token) int
    base := tok.movementRange()
    pe := gs.crystalEffects.getPlayerEffects(tok.playerId)
    if pe.hasEffect(enums.SPEED_BOOST)
        return base + constants.CRYSTAL_SPEED_BOOST_AMOUNT
    return base

func MoveToken on gs: reference GameState(tokenId: types.TokenID, newPos: types.Position) bool
    tRef := gs.GetToken(tokenId)
    if tRef is empty
        return false
    if not tRef.isAlive
        return false

    gs.board.clearOccupant(tRef.position, tokenId)
    tRef.moveTo(newPos)
    gs.board.setOccupant(newPos, tokenId)
    return true

func removeToken on gs: reference GameState(tokenId: types.TokenID)
    tRef := gs.GetToken(tokenId)
    if tRef is empty
        return
    gs.board.clearOccupant(tRef.position, tokenId)

    pRef := gs.GetPlayer(tRef.playerId)
    if pRef isnt empty
        pRef.removeToken(tokenId)

    tRef.isAlive = false

func AttackToken on gs: reference GameState(attackerId: types.TokenID, defenderId: types.TokenID) optional reference CombatOutcome
    aRef := gs.GetToken(attackerId)
    if aRef is empty
        return empty
    dRef := gs.GetToken(defenderId)
    if dRef is empty
        return empty

    if not canAttack(aRef, dRef)
        return empty

    damage := aRef.attackPower()
    pe := gs.crystalEffects.getPlayerEffects(aRef.playerId)
    if pe.hasEffect(enums.DAMAGE_BOOST)
        damage = (damage as float64 * constants.CRYSTAL_DAMAGE_BOOST_MULTIPLIER) as int

    wasKilled := dRef.takeDamage(damage)
    if wasKilled
        gs.removeToken(defenderId)

    var result: enums.CombatResult
    if wasKilled
        result = enums.KILLED
    else
        result = enums.HIT
    outcome := CombatOutcome{
        result: result,
        damageDealt: damage,
        attackerId: attackerId,
        defenderId: defenderId,
        defenderKilled: wasKilled,
    }
    return reference of outcome

func _auto_deploy_starting_tokens on gs: reference GameState(playerId: types.PlayerID, playerIndex: int)
    deployPositions := gs.board.getDeployablePositions(playerIndex)
    reserve := gs.GetReserveTokens(playerId)

    sortSlice(reserve) # strongest first
    deployed := 0

    for pos in deployPositions
        if deployed >= 3
            break
        cell := gs.board.getCellAt(pos)
        if cell isnt empty
            dc := dereference cell
            if dc.isOccupied()
                continue
            if dc.cellType isnt enums.NORMAL
                continue

            tok := reserve[deployed]
            tRef := gs.GetToken(tok.id)
            if tRef isnt empty
                tRef.position = pos
                tRef.isDeployed = true
                gs.board.setOccupant(pos, tRef.id)
                deployed = deployed + 1

func sortSlice(tokens: list of Token)
    sort.ByKeyDesc of Token(tokens, (t: Token) => t.maxHealth)

func StartGame on gs: reference GameState
    if gs.phase isnt enums.SETUP
        return

    for pid, _ in gs.players
        gs.createTokensForPlayer(pid)

    for pid, pRef in gs.players
        gs._auto_deploy_starting_tokens(pid, enums.PlayerIndex(pRef.color))

    for pid, _ in gs.players
        gs.currentTurnPlayerId = pid
        break

    gs.phase = enums.PLAYING
    gs.turnNumber = 1

func EndTurn on gs: reference GameState
    if gs.currentTurnPlayerId equals ""
        return

    gs.clearTurnState()
    gs.advanceToNextPlayer()
    gs.turnPhase = enums.MOVEMENT

func clearTurnState on gs: reference GameState
    gs.lastTriggeredMysteryEvent = empty

func advanceToNextPlayer on gs: reference GameState
    gs.crystalEffects.endTurnUpdate()
    active := gs.getActivePlayers()

    if active is empty
        return

    nextIdx := gs.calculateNextPlayerIndex(active)
    gs.currentTurnPlayerId = active[nextIdx]

    if nextIdx equals 0
        gs.turnNumber = gs.turnNumber + 1
        if gs.turnNumber > 0 and gs.turnNumber % constants.CRYSTAL_RANDOM_EFFECT_ROUND_INTERVAL equals 0
            gs.triggerRandomCrystalEffect()

func getActivePlayers on gs: reference GameState list of types.PlayerID
    result := empty list of types.PlayerID
    for pid, pRef in gs.players
        if pRef.isActive
            result = append(result, pid)
    return result

func calculateNextPlayerIndex on gs: reference GameState(active: list of types.PlayerID) int
    currentIdx := -1
    for i, pid in active
        if pid equals gs.currentTurnPlayerId
            currentIdx = i
            break
    return (currentIdx + 1) % len(active)

func triggerRandomCrystalEffect on gs: reference GameState() (types.PlayerID, enums.CrystalEffect, bool)
    if gs.players is empty
        return types.PlayerID(""), "", false

    effects := list of enums.CrystalEffect{
        enums.FOG_OF_WAR,
        enums.PHANTOM_ENEMIES,
        enums.DAMAGE_BOOST,
        enums.SPEED_BOOST,
    }
    effect := random.Choice of enums.CrystalEffect from effects
    targetPlayer := types.PlayerID("")

    for pid, _ in gs.players
        targetPlayer = pid
        break

    gs.crystalEffects.applyEffect(
        targetPlayer,
        effect,
        gs.turnNumber,
        constants.CRYSTAL_EFFECT_INITIAL_DURATION,
    )
    gs.lastTriggeredCrystalEffect = reference of CrystalEvent{playerId: targetPlayer, effectType: effect}
    return targetPlayer, effect, true

func updateGeneratorsAndCrystal on gs: reference GameState() (list of int, bool)
    tokensByPos := empty map of types.Position to list of TokenAtPos

    for _, t in gs.tokens
        if t.isAlive and t.isDeployed
            taps := TokenAtPos{tokenId: t.id, playerId: t.playerId}
            tokensByPos[t.position] = append(tokensByPos[t.position], taps)

    newlyDisabled, _ := updateAllGenerators(gs.generators, tokensByPos)

    disabledCount := countDisabledGenerators(gs.generators)

    crystalCaptured := false
    if gs.crystalInstance isnt empty
        c := dereference gs.crystalInstance
        crystalPos := c.position
        taps := tokensByPos[crystalPos]
        outcome := c.updateCaptureStatus(taps, disabledCount)
        if outcome.isWinner
            gs.winnerId = outcome.winnerId
            gs.phase = enums.ENDED
            crystalCaptured = true

    return newlyDisabled, crystalCaptured

func EndTurnWithObjectiveUpdate on gs: reference GameState() (list of int, bool, bool)
    newlyDisabled, crystalCaptured := gs.updateGeneratorsAndCrystal()
    gs.EndTurn()
    return newlyDisabled, crystalCaptured, gs.phase equals enums.ENDED

func setWinner on gs: reference GameState(playerId: types.PlayerID)
    gs.winnerId = playerId
    gs.phase = enums.ENDED

func applyCrystalEffect on gs: reference GameState(playerId: types.PlayerID, et: enums.CrystalEffect, duration: int)
    gs.crystalEffects.applyEffect(playerId, et, gs.turnNumber, duration)

func Phase on gs: GameState enums.GamePhase
    return gs.phase

func WinnerID on gs: GameState types.PlayerID
    return gs.winnerId

func CurrentTurnPlayerID on gs: GameState types.PlayerID
    return gs.currentTurnPlayerId

func TurnNumber on gs: GameState int
    return gs.turnNumber

func TurnPhase on gs: GameState enums.TurnPhase
    return gs.turnPhase

func Players on gs: reference GameState map of types.PlayerID to reference Player
    return gs.players

func Tokens on gs: reference GameState map of types.TokenID to reference Token
    return gs.tokens

func Generators on gs: reference GameState list of Generator
    return gs.generators

func CrystalInstance on gs: reference GameState optional reference Crystal
    return gs.crystalInstance

func BoardWidth on gs: reference GameState int
    return gs.board.width

func BoardHeight on gs: reference GameState int
    return gs.board.height

func ToDict on gs: reference GameState map of string to any
    result := empty map of string to any
    result["phase"] = "{gs.phase}"
    result["turn_number"] = gs.turnNumber
    result["current_turn_player_id"] = gs.currentTurnPlayerId as string
    if gs.winnerId isnt ""
        result["winner_id"] = gs.winnerId as string
    result["turn_phase"] = "{gs.turnPhase}"
    playerList := empty list of map of string to any
    for pid, p in gs.players
        pd := map of string to any{
            "id": pid as string,
            "name": p.name,
            "is_active": p.isActive,
            "is_ready": p.isReady,
        }
        playerList = append(playerList, pd)
    result["players"] = playerList
    return result
