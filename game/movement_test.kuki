petiole game

import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/test"
import "testing"

func TestGetValidMovesFromCenter(t: reference testing.T)
    b := NewBoard()
    tok, _ := NewToken(types.TokenID(1), types.PlayerID("p1"), 6, 6, types.Pos(5, 5))
    tokensMap := map of types.TokenID to reference Token{1: reference of tok}
    moves := getValidMoves(reference of tok, reference of b, 2, tokensMap)
    test.AssertTrue(t, moves isnt empty)
    foundStart := false
    for m in moves
        if m equals types.Pos(5, 5)
            foundStart = true
    test.AssertFalse(t, foundStart, "should NOT include current position")
    foundValid := false
    for m in moves
        if m equals types.Pos(6, 5) or m equals types.Pos(7, 5) or m equals types.Pos(5, 6)
            foundValid = true
    test.AssertTrue(t, foundValid, "should include valid move positions")

func TestGetValidMovesRespectsRange(t: reference testing.T)
    b := NewBoard()
    tok, _ := NewToken(types.TokenID(1), types.PlayerID("p1"), 10, 10, types.Pos(5, 5))
    tokensMap := map of types.TokenID to reference Token{1: reference of tok}
    moves := getValidMoves(reference of tok, reference of b, 1, tokensMap)
    far := false
    for m in moves
        if m equals types.Pos(8, 5) or m equals types.Pos(5, 8)
            far = true
    test.AssertFalse(t, far, "positions beyond range should not be valid")

func TestIsValidMove(t: reference testing.T)
    b := NewBoard()
    tok, _ := NewToken(types.TokenID(1), types.PlayerID("p1"), 6, 6, types.Pos(5, 5))
    tokensMap := map of types.TokenID to reference Token{1: reference of tok}
    test.AssertTrue(t, isValidMove(reference of tok, types.Pos(7, 5), reference of b, tokensMap))
    test.AssertFalse(t, isValidMove(reference of tok, types.Pos(10, 10), reference of b, tokensMap))

func TestGetDistance(t: reference testing.T)
    test.AssertEqual(t, getDistance(types.Pos(0, 0), types.Pos(3, 4)), 7)
    test.AssertEqual(t, getDistance(types.Pos(5, 5), types.Pos(5, 5)), 0)

func TestIsAdjacent(t: reference testing.T)
    test.AssertTrue(t, isAdjacent(types.Pos(5, 5), types.Pos(6, 5)))
    test.AssertTrue(t, isAdjacent(types.Pos(5, 5), types.Pos(6, 6)))
    test.AssertFalse(t, isAdjacent(types.Pos(5, 5), types.Pos(7, 5)))

func TestGetAdjacentPositions(t: reference testing.T)
    b := NewBoard()
    adjacent := getAdjacentPositions(types.Pos(5, 5), reference of b)
    test.AssertEqual(t, len(adjacent), 8)

func TestMoveTokenUpdatesPosition(t: reference testing.T)
    gs := NewGameState()
    tok, _ := NewToken(types.TokenID(0), types.PlayerID("p0"), 6, 6, types.Pos(5, 5))
    tok.isDeployed = true
    gs.tokens[types.TokenID(0)] = reference of tok
    gs.board.setOccupant(types.Pos(5, 5), types.TokenID(0))

    moved := gs.MoveToken(types.TokenID(0), types.Pos(6, 5))
    test.AssertTrue(t, moved, "MoveToken should succeed")

    got := gs.GetToken(types.TokenID(0))
    if got isnt empty
        pos := got.Position()
        test.AssertEqual(t, pos.X, 6)
        test.AssertEqual(t, pos.Y, 5)
    else
        t.Fatal("token missing after move")

func TestCanStackOnFriendlyGenerator(t: reference testing.T)
    b := NewBoard()
    b.grid[6][6].cellType = enums.GENERATOR

    mover, _ := NewToken(types.TokenID(1), types.PlayerID("p0"), 6, 6, types.Pos(5, 6))
    mover.isDeployed = true
    ally, _ := NewToken(types.TokenID(2), types.PlayerID("p0"), 6, 6, types.Pos(6, 6))
    ally.isDeployed = true
    tokensMap := map of types.TokenID to reference Token{1: reference of mover, 2: reference of ally}

    moves := getValidMoves(reference of mover, reference of b, 2, tokensMap)
    found := false
    for m in moves
        if m equals types.Pos(6, 6)
            found = true
    test.AssertTrue(t, found, "generator occupied by a friendly token should be stackable")
