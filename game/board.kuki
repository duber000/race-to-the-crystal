petiole game

import "math"
import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/random"
import "stdlib/slice"

type Cell
    position: types.Position
    cellType: enums.CellType
    occupants: list of types.TokenID

func NewCell(x: int, y: int) Cell
    return Cell{position: types.Pos(x, y), cellType: enums.NORMAL, occupants: empty list of types.TokenID}

func isOccupied on c: Cell bool
    return c.occupants isnt empty

func hasEnemyTokens on c: Cell(playerId: types.PlayerID, tokensMap: map of types.TokenID to reference Token) bool
    for tid in c.occupants
        tok, ok := tokensMap[tid]
        if ok and tok.playerId isnt playerId
            return true
    return false

func addOccupant on c: reference Cell(tokenId: types.TokenID)
    if not slice.Contains(c.occupants, tokenId)
        c.occupants = append(c.occupants, tokenId)

func removeOccupant on c: reference Cell(tokenId: types.TokenID)
    if slice.Contains(c.occupants, tokenId)
        c.occupants = slice.Filter(c.occupants, (tid: types.TokenID) => tid isnt tokenId)

func clearOccupants on c: reference Cell
    c.occupants = empty list of types.TokenID

type Quadrant
    xMin: int
    xMax: int
    yMin: int
    yMax: int

# Guarded random.Int: random.Int panics when max - min overflows int, which the
# checker cannot rule out for computed bounds; keep spans provably safe.
# kuki:suppress "panic" "bounds guarded above: min>=0, span <= MaxInt/2, overflow impossible"
func safeRandomInt(minVal: int, maxVal: int) int
    if minVal < 0 or maxVal < minVal or maxVal > math.MaxInt / 2
        return minVal
    return random.Int(minVal, maxVal)

type Board
    width: int
    height: int
    grid: list of list of Cell
    genPositions: list of types.Position
    mysteryPositions: list of types.Position

func NewBoard() Board
    b := Board{
        width: constants.BOARD_WIDTH,
        height: constants.BOARD_HEIGHT,
    }
    b.initializeGrid()
    return b

func initializeGrid on b: reference Board
    h := b.height
    w := b.width
    b.grid = make(list of list of Cell, h)
    for y from 0 to h
        row := make(list of Cell, w)
        for x from 0 to w
            row[x] = NewCell(x, y)
        b.grid[y] = row
    b.placeCrystal()
    b.placeGenerators()
    b.placeMysterySquares()

func placeCrystal on b: reference Board
    cx := b.width / 2
    cy := b.height / 2
    b.grid[cy][cx].cellType = enums.CRYSTAL

func placeGenerators on b: reference Board
    midX := b.width / 2
    midY := b.height / 2
    qx := b.width / 4
    qy := b.height / 4

    gens := list of types.Position{
        types.Pos(qx, qy),
        types.Pos(midX + qx, qy),
        types.Pos(qx, midY + qy),
        types.Pos(midX + qx, midY + qy),
    }

    for pos in gens
        b.grid[pos.Y][pos.X].cellType = enums.GENERATOR
    b.genPositions = gens

func placeMysterySquares on b: reference Board
    if b.width < 10 or b.height < 10
        return

    midX := b.width / 2
    midY := b.height / 2
    m := 2

    quads := list of Quadrant{
        {xMin: m, xMax: midX - m, yMin: m, yMax: midY - m},
        {xMin: midX + m, xMax: b.width - m, yMin: m, yMax: midY - m},
        {xMin: m, xMax: midX - m, yMin: midY + m, yMax: b.height - m},
        {xMin: midX + m, xMax: b.width - m, yMin: midY + m, yMax: b.height - m},
    }

    for q in quads
        if q.xMax < q.xMin or q.yMax < q.yMin
            continue

        placed := 0
        for _ from 0 to constants.MYSTERY_PLACEMENT_MAX_ATTEMPTS
            if placed >= constants.MYSTERY_SQUARES_PER_QUADRANT
                break
            x := safeRandomInt(q.xMin, q.xMax + 1)
            y := safeRandomInt(q.yMin, q.yMax + 1)

            if b.grid[y][x].cellType equals enums.NORMAL
                b.grid[y][x].cellType = enums.MYSTERY
                b.mysteryPositions = append(b.mysteryPositions, types.Pos(x, y))
                placed = placed + 1

func getCell on b: reference Board(x: int, y: int) optional reference Cell
    if not b.isValidPosition(x, y)
        return empty
    return reference of b.grid[y][x]

func getCellAt on b: reference Board(pos: types.Position) optional reference Cell
    return b.getCell(pos.X, pos.Y)

func isValidPosition on b: Board(x: int, y: int) bool
    return x >= 0 and x < b.width and y >= 0 and y < b.height

func setOccupant on b: reference Board(pos: types.Position, tokenId: types.TokenID)
    cell := b.getCellAt(pos)
    if cell isnt empty
        cell.addOccupant(tokenId)

func clearOccupant on b: reference Board(pos: types.Position, tokenId: types.TokenID)
    cell := b.getCellAt(pos)
    if cell isnt empty
        cell.removeOccupant(tokenId)

func clearAllOccupants on b: reference Board(pos: types.Position)
    cell := b.getCellAt(pos)
    if cell isnt empty
        cell.clearOccupants()

func getStartingPosition on b: Board(playerIndex: int) types.Position
    if playerIndex equals 0
        return types.Pos(0, 0)
    else if playerIndex equals 1
        return types.Pos(b.width - 1, 0)
    else if playerIndex equals 2
        return types.Pos(0, b.height - 1)
    else
        return types.Pos(b.width - 1, b.height - 1)

func getDeployablePositions on b: Board(playerIndex: int) list of types.Position
    if playerIndex equals 0
        return list of types.Position{
            types.Pos(0, 0),
            types.Pos(1, 0),
            types.Pos(2, 0),
            types.Pos(0, 1),
            types.Pos(1, 1),
            types.Pos(2, 1),
            types.Pos(0, 2),
            types.Pos(1, 2),
            types.Pos(2, 2),
        }
    else if playerIndex equals 1
        return list of types.Position{
            types.Pos(21, 0),
            types.Pos(22, 0),
            types.Pos(23, 0),
            types.Pos(21, 1),
            types.Pos(22, 1),
            types.Pos(23, 1),
            types.Pos(21, 2),
            types.Pos(22, 2),
            types.Pos(23, 2),
        }
    else if playerIndex equals 2
        return list of types.Position{
            types.Pos(0, 21),
            types.Pos(1, 21),
            types.Pos(2, 21),
            types.Pos(0, 22),
            types.Pos(1, 22),
            types.Pos(2, 22),
            types.Pos(0, 23),
            types.Pos(1, 23),
            types.Pos(2, 23),
        }
    else
        return list of types.Position{
            types.Pos(21, 21),
            types.Pos(22, 21),
            types.Pos(23, 21),
            types.Pos(21, 22),
            types.Pos(22, 22),
            types.Pos(23, 22),
            types.Pos(21, 23),
            types.Pos(22, 23),
            types.Pos(23, 23),
        }

func getCrystalPosition on b: Board types.Position
    return types.Pos(b.width / 2, b.height / 2)

func getGeneratorPositions on b: Board list of types.Position
    return b.genPositions

func getMysteryPositions on b: Board list of types.Position
    return b.mysteryPositions
