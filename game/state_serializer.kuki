petiole game

import "race-to-the-crystal/shared/constants" as constants
import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/maps"
import "stdlib/parse"
import "stdlib/sort"
import "strings"

type StateDict = map of string to any

# Numeric seat index of a game player id ("player_2" -> 2). Player ids that
# do not follow the pattern sort as 0.
func playerIdIndex(pid: string) int
    if not strings.HasPrefix(pid, "player_")
        return 0
    suffix := strings.TrimPrefix(pid, "player_")
    return parse.IntOr(suffix, 0)

# Wire format for crystal effects: numeric, matching the frontend's
# CRYSTAL_EFFECT mapping (FOG_OF_WAR=1 .. SPEED_BOOST=4).
func crystalEffectNumber(e: enums.CrystalEffect) int
    switch e
        when enums.FOG_OF_WAR
            return 1
        when enums.PHANTOM_ENEMIES
            return 2
        when enums.DAMAGE_BOOST
            return 3
        when enums.SPEED_BOOST
            return 4
        default
            return 0

func tokenToDict(t: reference Token) StateDict
    return StateDict{
        "id": t.id as int,
        "player_id": t.playerId as string,
        "health": t.health,
        "max_health": t.maxHealth,
        "position": list of int{t.position.X, t.position.Y},
        "is_alive": t.isAlive,
        "is_deployed": t.isDeployed,
    }

func playerToDict(p: reference Player, colorIndex: int) StateDict
    tokenIds := empty list of int
    for tid in p.tokenIds
        tokenIds = append(tokenIds, tid as int)
    return StateDict{
        "id": p.id as string,
        "player_id": p.id as string,
        "name": p.name,
        "player_name": p.name,
        "color": p.color,
        "color_index": colorIndex,
        "token_ids": tokenIds,
        "is_ready": p.isReady,
        "is_active": p.isActive,
    }

func cellToDict(c: Cell) StateDict
    occupants := empty list of int
    for tid in c.occupants
        occupants = append(occupants, tid as int)
    return StateDict{
        "position": list of int{c.position.X, c.position.Y},
        "cell_type": c.cellType as int,
        "occupants": occupants,
    }

func boardToDict(b: reference Board) StateDict
    grid := empty list of list of StateDict
    for row in b.grid
        rowDicts := empty list of StateDict
        for cell in row
            rowDicts = append(rowDicts, cellToDict(cell))
        grid = append(grid, rowDicts)
    return StateDict{
        "width": b.width,
        "height": b.height,
        "grid": grid,
    }

func crystalToDict(c: reference Crystal) StateDict
    holdingIds := empty list of int
    for tid in c.holdingTokenIds
        holdingIds = append(holdingIds, tid as int)
    return StateDict{
        "position": list of int{c.position.X, c.position.Y},
        "holding_player_id": c.holdingPlayerId as string,
        "controlling_player_id": c.holdingPlayerId as string,
        "holding_token_ids": holdingIds,
        "turns_held": c.turnsHeld,
        "base_tokens_required": c.baseTokensRequired,
        "tokens_present": len(holdingIds),
        "turns_required": c.turnsRequired(),
    }
    # How many tokens are on the crystal, and how many turns the
    # capture takes. `tokens_required` is added by the caller: it
    # depends on how many generators have fallen.

func generatorToDict(g: Generator) StateDict
    capIds := empty list of int
    for tid in g.captureTokenIds
        capIds = append(capIds, tid as int)
    return StateDict{
        "id": g.id,
        "position": list of int{g.position.X, g.position.Y},
        "capturing_player_id": g.capturingPlayerId as string,
        "capture_token_ids": capIds,
        "turns_held": g.turnsHeld,
        "is_disabled": g.isDisabled,
        "tokens_present": len(capIds),
        "tokens_required": constants.GENERATOR_CAPTURE_TOKENS_REQUIRED,
        "turns_required": constants.GENERATOR_CAPTURE_TURNS_REQUIRED,
    }
    # The capture requirements and how far along the capture is. The
    # client draws the progress from these, so it must not have to
    # know the rules itself.

func activeEffectToDict(e: ActiveEffect) StateDict
    return StateDict{
        "effect_type": crystalEffectNumber(e.effectType),
        "turns_remaining": e.turnsRemaining,
        "applied_turn": e.appliedTurn,
    }

func effectsToDict on m: reference CrystalEffectsManager(mapOfPlayers: map of types.PlayerID to reference Player) StateDict
    playerEffects := empty map of string to StateDict
    for pid in mapOfPlayers
        pe := m.getPlayerEffects(pid)
        active := empty list of StateDict
        for eff in pe.activeEffects
            active = append(active, activeEffectToDict(eff))
        playerEffects[pid as string] = StateDict{"active_effects": active}
    return StateDict{"player_effects": playerEffects}

# Game player ids in stable seat order. `gs.players` is a map, so raw
# iteration order is random — always use this for anything order-dependent
# (colour index, seat order, player listing).
func orderedPlayerIds on gs: reference GameState list of types.PlayerID
    return sort.ByKey(maps.Keys(gs.players), (pid: types.PlayerID) => playerIdIndex(pid as string))

# Colour index per player id, in seat order. This is the single source of
# truth for the "color_index" field in the client state dict — the mapping
# must never depend on map iteration order, or a player's colour would
# change between broadcasts.
func PlayerColorIndexes on gs: reference GameState map of string to int
    result := empty map of string to int
    idx := 0
    for pid in gs.orderedPlayerIds()
        result[pid as string] = idx
        idx = idx + 1
    return result

# Colour index of a single player, or -1 if the player does not exist.
func PlayerColorIndex on gs: reference GameState(playerId: types.PlayerID) int
    indexes := gs.PlayerColorIndexes()
    idx, has := indexes[playerId as string]
    if not has
        return -1
    return idx

# Full client-facing state dict. `perspective` is the game player id
# ("player_0") to annotate the state with; pass "" to omit.
func ClientStateDict on gs: reference GameState(perspective: string) StateDict
    playersMap := empty map of string to StateDict
    # `gs.players` is a map, so iterating it directly assigns colour indices
    # in random order — the player's colour would change between broadcasts.
    # Sort by the numeric player id ("player_0", "player_1", ...) instead.
    colorIndexes := gs.PlayerColorIndexes()
    for pid in gs.orderedPlayerIds()
        pRef := gs.GetPlayer(pid)
        if pRef is empty
            continue
        playersMap[pid as string] = playerToDict(pRef, colorIndexes[pid as string])

    tokensMap := empty map of string to StateDict
    for tid, t in gs.tokens
        tokensMap["{tid}"] = tokenToDict(t)

    gens := empty list of StateDict
    for g in gs.generators
        gens = append(gens, generatorToDict(g))

    result := StateDict{
        "board": boardToDict(reference of gs.board),
        "players": playersMap,
        "tokens": tokensMap,
        "generators": gens,
        "crystal_effects": gs.crystalEffects.effectsToDict(gs.players),
        "current_turn_player_id": gs.currentTurnPlayerId as string,
        "turn_number": gs.turnNumber,
        "phase": "{gs.phase}",
        "turn_phase": "{gs.turnPhase}",
    }
    if gs.winnerId isnt empty
        result["winner_id"] = gs.winnerId as string
    crys := gs.crystalInstance
    if crys isnt empty
        crystalDict := crystalToDict(crys)
        crystalDict["tokens_required"] = gs.CrystalTokensRequired()
        result["crystal"] = crystalDict
    if gs.lastTriggeredCrystalEffect isnt empty
        ev := dereference gs.lastTriggeredCrystalEffect
        result["last_triggered_crystal_effect"] = list of any{
            ev.playerId as string,
            crystalEffectNumber(ev.effectType),
        }
    if gs.lastTriggeredMysteryEvent isnt empty
        ev := dereference gs.lastTriggeredMysteryEvent
        result["last_triggered_mystery_event"] = list of any{
            ev.TokenID as int,
            list of int{ev.Position.X, ev.Position.Y},
            ev.effect,
        }
    if perspective isnt empty
        result["perspective_player_id"] = perspective
        result["your_player_id"] = perspective
    return result
