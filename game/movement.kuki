petiole game

import "race-to-the-crystal/shared/enums" as enums
import "race-to-the-crystal/shared/types" as types
import "stdlib/slice"

type DirOffset
    dx: int
    dy: int

var DIRECTIONS = list of DirOffset{
    {dx: -1, dy: -1},
    {dx: -1, dy: 0},
    {dx: -1, dy: 1},
    {dx: 0, dy: -1},
    {dx: 0, dy: 1},
    {dx: 1, dy: -1},
    {dx: 1, dy: 0},
    {dx: 1, dy: 1},
}

type BfsItem
    pos: types.Position
    dist: int

type PathItem
    pos: types.Position
    path: list of types.Position

func getValidMoves(tok: reference Token, brd: reference Board, maxRange: int, tokensMap: map of types.TokenID to reference Token) list of types.Position
    result := empty list of types.Position
    if not tok.isAlive
        return result

    start := tok.position
    playerId := tok.playerId

    visited := empty map of types.Position to bool
    visited[start] = true

    queue := empty list of BfsItem
    queue = append(queue, BfsItem{pos: start, dist: 0})

    for queue isnt empty
        item := queue[0]
        queue = queue[1:]
        x := item.pos.X
        y := item.pos.Y
        distance := item.dist

        if distance >= maxRange
            continue

        for dir in DIRECTIONS
            nx := x + dir.dx
            ny := y + dir.dy
            npos := types.Pos(nx, ny)

            _, seen := visited[npos]
            if seen
                continue

            if not brd.isValidPosition(nx, ny)
                continue

            cell := brd.getCell(nx, ny)
            if cell isnt empty
                dc := dereference cell
                if dc.isOccupied() and tokensMap isnt empty
                    if dc.hasEnemyTokens(playerId, tokensMap)
                        continue
                    if dc.cellType isnt enums.GENERATOR and dc.cellType isnt enums.CRYSTAL
                        continue

                visited[npos] = true

                if npos isnt start
                    result = append(result, npos)

                queue = append(queue, BfsItem{pos: npos, dist: distance + 1})

    return result

func isValidMove(tok: reference Token, dest: types.Position, brd: reference Board, tokensMap: map of types.TokenID to reference Token) bool
    if not tok.isAlive
        return false
    moves := getValidMoves(tok, brd, tok.movementRange(), tokensMap)
    return slice.Contains(moves, dest)

func findPath(start: types.Position, end: types.Position, brd: reference Board, maxDistance: int) (list of types.Position, bool)
    if start equals end
        return list of types.Position{start}, true

    visited := empty map of types.Position to bool
    visited[start] = true

    queue := empty list of PathItem
    queue = append(queue, PathItem{pos: start, path: list of types.Position{start}})

    for queue isnt empty
        item := queue[0]
        queue = queue[1:]
        x := item.pos.X
        y := item.pos.Y

        if len(item.path) > maxDistance
            continue

        for dir in DIRECTIONS
            nx := x + dir.dx
            ny := y + dir.dy
            npos := types.Pos(nx, ny)

            _, seen := visited[npos]
            if seen
                continue

            if not brd.isValidPosition(nx, ny)
                continue

            if npos equals end
                newPath := append(item.path, npos)
                return newPath, true

            cell := brd.getCell(nx, ny)
            if cell isnt empty
                if cell.isOccupied()
                    continue

                visited[npos] = true
                newPath := append(item.path, npos)
                queue = append(queue, PathItem{pos: npos, path: newPath})

    return empty list of types.Position, false

func getDistance(pos1: types.Position, pos2: types.Position) int
    dx := pos1.X - pos2.X
    if dx < 0
        dx = -dx
    dy := pos1.Y - pos2.Y
    if dy < 0
        dy = -dy
    return dx + dy

func isAdjacent(pos1: types.Position, pos2: types.Position) bool
    dx := pos1.X - pos2.X
    if dx < 0
        dx = -dx
    dy := pos1.Y - pos2.Y
    if dy < 0
        dy = -dy
    return dx <= 1 and dy <= 1 and dx + dy > 0

func getAdjacentPositions(pos: types.Position, brd: reference Board) list of types.Position
    result := empty list of types.Position
    for dir in DIRECTIONS
        nx := pos.X + dir.dx
        ny := pos.Y + dir.dy
        if brd.isValidPosition(nx, ny)
            result = append(result, types.Pos(nx, ny))
    return result
