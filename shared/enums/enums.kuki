petiole enums

enum CellType
    NORMAL = 0
    GENERATOR = 1
    CRYSTAL = 2
    MYSTERY = 3
    START = 4

enum GamePhase
    SETUP = 0
    PLAYING = 1
    ENDED = 2

enum TurnPhase
    MOVEMENT = 0
    ACTION = 1
    END_TURN = 2

enum PlayerColor: string
    CYAN = "cyan"
    MAGENTA = "magenta"
    YELLOW = "yellow"
    GREEN = "green"

func PlayerIndex(c: PlayerColor) int
    switch c
        when PlayerColor.CYAN
            return 0
        when PlayerColor.MAGENTA
            return 1
        when PlayerColor.YELLOW
            return 2
        when PlayerColor.GREEN
            return 3
        default
            return 0

enum MysteryEffect
    HEAL = 0
    TELEPORT = 1

enum CombatResult
    HIT = 0
    KILLED = 1
    INVALID = 2

enum CrystalEffect: string
    FOG_OF_WAR = "fog_of_war"
    PHANTOM_ENEMIES = "phantom_enemies"
    DAMAGE_BOOST = "damage_boost"
    SPEED_BOOST = "speed_boost"

enum Direction
    UP = 0
    DOWN = 1
    LEFT = 2
    RIGHT = 3
    UP_LEFT = 4
    UP_RIGHT = 5
    DOWN_LEFT = 6
    DOWN_RIGHT = 7
