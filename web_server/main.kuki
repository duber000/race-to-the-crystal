petiole main

import "net/http"
import "net/http/httputil"
import "net/url"
import "stdlib/env"
import "stdlib/log"
import "stdlib/signal"

type WebServerConfig
    port: int
    staticDir: string
    indexPath: string
    gameServerUrl: string

func WebServerConfigFromEnv() WebServerConfig
    port := env.GetIntOr("WEB_PORT", 8000) onerr panic "invalid WEB_PORT: {error}"
    return WebServerConfig{
        port: port,
        staticDir: env.GetOr("STATIC_DIR", "web_server/static"),
        indexPath: env.GetOr("INDEX_PATH", "web_server/templates/index.html"),
        gameServerUrl: env.GetOr("GAME_SERVER_URL", "http://localhost:8080"),
    }

type WebServer
    config: WebServerConfig
    proxy: optional reference httputil.ReverseProxy

func NewWebServer(config: WebServerConfig) (WebServer, error)
    target := url.Parse(config.gameServerUrl) onerr return WebServer{}, error "invalid GAME_SERVER_URL"
    proxy := httputil.NewSingleHostReverseProxy(target)
    return WebServer{config: config, proxy: proxy}, empty

func Start on ws: reference WebServer
    mux := http.NewServeMux()
    mux.HandleFunc(`GET /{$}`, ws.handleRoot)
    mux.Handle(
        "GET /static/",
        http.StripPrefix("/static/", http.FileServer(http.Dir(ws.config.staticDir))),
    )
    proxy := ws.proxy
    if proxy isnt empty
        mux.Handle("/api/", proxy)
        mux.Handle("/ws", proxy)

    addr := ":{ws.config.port}"
    log.Info("Web server starting on {addr}")
    log.Info("Serving static files from {ws.config.staticDir}")
    log.Info("Proxying API to {ws.config.gameServerUrl}")

    go
        err := http.ListenAndServe(addr, mux)
        if err isnt empty
            log.Error("HTTP server error: {err}")

    ch := make(channel of bool)
    signal.OnInterrupt(() =>
        log.Info("Shutting down web server...")
        send true to ch
    )

    receive from ch

func handleRoot on ws: reference WebServer(w: http.ResponseWriter, r: reference http.Request)
    http.ServeFile(w, r, ws.config.indexPath)

func main()
    config := WebServerConfigFromEnv()
    server, err := NewWebServer(config)
    if err isnt empty
        log.Fatal("{err}")
    server.Start()
