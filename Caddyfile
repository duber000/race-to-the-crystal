# Development/local configuration
http://:80 {
    # Enable Vulcain push/preload support
    vulcain

    # Proxy Mercure SSE requests to the Mercure container (with anonymous access via JWT query param)
    reverse_proxy /.well-known/mercure* race-mercure:3000 {
        header_up Host {http.request.header.Host}
    }

    # Proxy to FastAPI backend
    reverse_proxy race-game-api:8080 {
        # Preserve original host header
        header_up Host {http.request.header.Host}
        header_up X-Real-IP {http.request.remote.host}
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Forwarded-Proto {http.request.proto}
    }

    # WebSocket support for real-time game updates
    reverse_proxy /ws* race-game-api:8080 {
        header_up Connection "upgrade"
        header_up Upgrade "websocket"
    }
}
